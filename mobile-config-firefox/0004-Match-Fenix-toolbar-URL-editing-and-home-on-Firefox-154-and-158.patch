+
+/* Not in the narrow layout: the buttons FenixToolbar.sys.mjs adds. */
+#mcf-newtab-button,
+#mcf-tabcounter-button {
+    display: none;
+}
+
+@media (max-width: 700px) {
+
+    #nav-bar {
+        position: relative;
+    }
+    #mcf-progress:not([hidden]) {
+        display: block;
+        position: absolute;
+        inset-inline: 0;
+        inset-block-start: 0;
+        height: 5px;
+        pointer-events: none;
+        z-index: 1;
+        background: linear-gradient(96deg, #b393ff 0%, light-dark(#ff8f5d, #764edd) 71%);
+        transform-origin: left;
+        animation: mcf-progress 10s steps(5, end) forwards;
+
+        &:-moz-locale-dir(rtl) {
+            transform-origin: right;
+        }
+
+        @media -moz-pref("mcf.toolbar.positionOnTop") {
+            inset-block: auto 0;
+        }
+    }
+    :root {
+        /* What the awesomebar, the find bar and the popups position
+         * against: the one toolbar. */
+        --mcf-toolbar-height: 64px;
+    }
+
+    /* One bar: the tab strip is only reachable through the tab counter. */
+    #TabsToolbar {
+        visibility: collapse !important;
+    }
+
+    #navigator-toolbox {
+        background-color: var(--mcf-fx-surface) !important;
+        border: 0 !important;
+        box-shadow: none !important;
+    }
+
+    #nav-bar {
+        --toolbar-bgcolor: var(--mcf-fx-surface);
+        --toolbar-color: var(--mcf-fx-on-surface);
+        --toolbarbutton-icon-fill: var(--mcf-fx-on-surface);
+        box-sizing: border-box !important;
+        height: var(--mcf-toolbar-height) !important;
+        min-height: var(--mcf-toolbar-height) !important;
+        margin: 0 !important;
+        padding: 0 !important;
+        border: 0 !important;
+        border-radius: 0 !important;
+        box-shadow: none !important;
+        background: var(--mcf-fx-surface) !important;
+        color: var(--mcf-fx-on-surface) !important;
+        align-items: center;
+        /* FullDisplayToolbar: the divider is on the edge facing the page. */
+        border-block-start: 1px solid var(--mcf-fx-divider) !important;
+        position: relative;
+
+        @media -moz-pref("mcf.toolbar.positionOnTop") {
+            border-block-start: 0 !important;
+            border-block-end: 1px solid var(--mcf-fx-divider) !important;
+        }
+    }
+
+    #nav-bar-customization-target {
+        flex: 1 1 0 !important;
+        min-width: 0 !important;
+        margin: 0 !important;
+        padding: 0 !important;
+        gap: 0 !important;
+    }
+
+    /* Only the address bar stays of everything desktop puts in the bar:
+     * back, forward, reload, home, downloads, extensions and their buttons,
+     * account, library, whatever else got added. The Fenix equivalents are in
+     * the menu. With vertical tabs the sidebar button is the tab counter. */
+    #nav-bar-customization-target > :not(#urlbar-container, #unified-extensions-button),
+    #nav-bar > :not(#nav-bar-customization-target, #PanelUI-button,
+                    #mcf-newtab-button, #mcf-tabcounter-button, #mcf-progress) {
+        display: none !important;
+    }
+
+    /* The extensions panel (menu > Extensions) anchors to the extensions
+     * button, so it stays in the layout, invisible, over the menu button. */
+    #unified-extensions-button {
+        position: absolute !important;
+        inset-block: 0;
+        inset-inline-end: 0;
+        width: 48px !important;
+        height: auto !important;
+        margin: 0 !important;
+        padding: 0 !important;
+        opacity: 0;
+        pointer-events: none;
+
+        /* Popups of extension buttons anchor to its icon: span the bar so
+         * they stop at its edge. */
+        > :is(.toolbarbutton-icon, .toolbarbutton-badge-stack) {
+            position: absolute;
+            inset: 0;
+            width: auto !important;
+            height: auto !important;
+            margin: 0 !important;
+            padding: 0 !important;
+        }
+    }
+
+    @media -moz-pref("sidebar.verticalTabs") {
+        #nav-bar-customization-target > #sidebar-button {
+            display: flex !important;
+        }
+    }
+
+    /* Address bar: the 48dp pill with 8dp around it (start, top, bottom;
+     * the buttons after it need no gap). */
+    #urlbar-container {
+        --urlbar-height: 48px;
+        --urlbar-min-height: 48px;
+        --urlbar-container-height: var(--mcf-toolbar-height);
+        box-sizing: border-box !important;
+        height: var(--mcf-toolbar-height) !important;
+        min-width: 0 !important;
+        margin: 0 !important;
+        padding: 8px 0 8px 8px !important;
+    }
+
+    #urlbar {
+        --urlbar-height: 48px;
+        --urlbar-min-height: 48px;
+        height: 48px !important;
+        min-height: 48px !important;
+        margin: 0 !important;
+        padding: 0 !important;
+        color: var(--mcf-fx-on-surface) !important;
+        font-size: 15px !important;
+    }
+
+    #urlbar:not([breakout-extend]) > .urlbar-background {
+        border: 0 !important;
+        border-radius: 24px !important;
+        outline: 0 !important;
+        box-shadow: none !important;
+        background: var(--mcf-fx-pill) !important;
+    }
+
+    #urlbar:not([breakout-extend]) .urlbar-input-container {
+        height: 48px !important;
+        min-height: 48px !important;
+        padding: 0 !important;
+        align-items: center;
+    }
+
+    /* Origin.kt: URL 15sp, onSurfaceVariant (the domain is emphasised by the
+     * URL formatting), fading out over its last 66dp. */
+    #urlbar-input {
+        font-size: 15px !important;
+        padding: 0 8px !important;
+        color: var(--mcf-fx-on-surface-variant) !important;
+        mask-image: none !important;
+    }
+    /* The fade is only there where the text is cut off (FadedText), and it
+     * is 66dp, not desktop's 3ch. Desktop reports the cut side in
+     * [textoverflow] ("right" is the end of an LTR URL, "left" its start). */
+    #urlbar:not([focused])[textoverflow="right"] #urlbar-input {
+        mask-image: linear-gradient(to left, transparent, black 66px) !important;
+    }
+    #urlbar:not([focused])[textoverflow="left"] #urlbar-input {
+        mask-image: linear-gradient(to right, transparent, black 66px) !important;
+    }
+    #urlbar:not([focused])[textoverflow="both"] #urlbar-input {
+        mask-image: linear-gradient(to right, transparent, black 66px, black calc(100% - 66px), transparent) !important;
+    }
+
+    #urlbar[focused] #urlbar-input {
+        mask-image: none !important;
+        color: var(--mcf-fx-on-surface) !important;
+    }
+
+    /* Everything desktop adds to the address bar that Fenix's pill hasn't:
+     * bookmark star, page actions, zoom, permissions... Reader mode stays
+     * (ToolbarAction.ReaderMode, page end action when available). */
+    #urlbar:not([focused]) #page-action-buttons > :not(#reader-mode-button),
+    #urlbar #star-button-box,
+    #urlbar #pageActionButton,
+    #urlbar #urlbar-zoom-button,
+    #urlbar #translations-button,
+    #urlbar #picture-in-picture-button,
+    #urlbar #identity-permission-box,
+    #urlbar:not([focused]) .searchmode-switcher:not([open]) {
+        display: none !important;
+    }
+
+    /* Site info (SiteInfo action, start of the pill): a 48dp button with the
+     * shield that Fenix shows for the connection (BrowserToolbarMiddleware.kt
+     * ToolbarAction.SiteInfo): checkmark for a secure page, slashed for an
+     * insecure one, a page for local files, a globe otherwise. The FF 149+
+     * trust icon and the older identity box both. */
+    #urlbar #trust-icon-container,
+    #urlbar #identity-box {
+        box-sizing: border-box;
+        width: 48px !important;
+        height: 48px !important;
+        min-width: 48px;
+        margin: 0 !important;
+        padding: 12px !important;
+        border-radius: 50% !important;
+        background: transparent !important;
+        outline: 0 !important;
+        align-items: center;
+        justify-content: center;
+        color: var(--mcf-fx-on-surface);
+        -moz-context-properties: fill, fill-opacity, stroke;
+        fill: var(--mcf-fx-on-surface) !important;
+        fill-opacity: 1 !important;
+        stroke: none;
+        --mcf-icon: var(--mcf-fx-icon-shield-checkmark);
+
+        &.insecure {
+            --mcf-icon: var(--mcf-fx-icon-shield-slash);
+        }
+    }
+    #urlbar #trust-icon-container > #trust-icon,
+    #urlbar #identity-icon {
+        width: 24px !important;
+        height: 24px !important;
+        margin: 0 !important;
+        padding: 0 !important;
+        fill: var(--mcf-fx-on-surface) !important;
+        fill-opacity: 1 !important;
+        -moz-context-properties: fill, fill-opacity;
+    }
+    /* One of the two, as in Firefox: the trust icon with its feature gate,
+     * the identity box without. */
+    @media -moz-pref("browser.urlbar.trustPanel.featureGate") {
+        #urlbar #identity-box {
+            display: none !important;
+        }
+    }
+    #urlbar #identity-box { --mcf-icon: var(--mcf-fx-icon-globe); }
+    #urlbar #identity-box:is(.verifiedDomain, .verifiedIdentity, .mixedActiveBlocked) { --mcf-icon: var(--mcf-fx-icon-shield-checkmark); }
+    #urlbar #identity-box:is(.notSecure, .insecure, .mixedActiveContent, .mixedDisplayContent, .weakCipher) { --mcf-icon: var(--mcf-fx-icon-shield-slash); }
+    #urlbar #identity-box:is(.localResource, .chromeUI, .extensionPage, .fileURI) { --mcf-icon: var(--mcf-fx-icon-page-portrait); }
+    #urlbar #identity-box > .identity-box-button,
+    #urlbar #identity-box #identity-icon-box {
+        padding: 0 !important;
+        margin: 0 !important;
+        background: transparent !important;
+    }
+
+    /* Buttons after the pill: 48dp touch targets with 24dp icons, pressed
+     * state a 12% circle (IconButton ripple). */
+    #mcf-newtab-button,
+    #mcf-tabcounter-button,
+    #PanelUI-button {
+        display: flex;
+        flex: none;
+        box-sizing: border-box;
+        width: 48px;
+        height: 48px;
+        margin: 0 !important;
+        padding: 0 !important;
+        align-items: center;
+        justify-content: center;
+    }
+
+    #mcf-newtab-button,
+    #mcf-tabcounter-button,
+    #PanelUI-menu-button {
+        -moz-context-properties: fill, fill-opacity;
+        fill: var(--mcf-fx-on-surface);
+        fill-opacity: 1;
+        color: var(--mcf-fx-on-surface);
+        width: 48px !important;
+        height: 48px !important;
+        min-width: 48px !important;
+        margin: 0 !important;
+        padding: 0 !important;
+        border: 0 !important;
+        border-radius: 50% !important;
+        background: transparent !important;
+        appearance: none !important;
+
+        &:active {
+            background: var(--mcf-fx-pressed) !important;
+        }
+
+        > .toolbarbutton-icon,
+        > .toolbarbutton-badge-stack,
+        > .toolbarbutton-badge-stack > .toolbarbutton-icon {
+            width: 24px !important;
+            height: 24px !important;
+            min-width: 0 !important;
+            padding: 0 !important;
+            margin: 0 !important;
+            border-radius: 0 !important;
+        }
+        > .toolbarbutton-badge-stack {
+            background: none !important;
+            width: 48px !important;
+            height: 48px !important;
+            display: flex;
+            align-items: center;
+            justify-content: center;
+        }
+    }
+
+    /* Icons are masks painted in the text colour: -moz-context-properties
+     * (context-fill) doesn't work in a user style sheet. */
+    #mcf-newtab-button > .toolbarbutton-icon,
+    #mcf-tabcounter-button > .toolbarbutton-icon,
+    #PanelUI-menu-button .toolbarbutton-icon,
+    #urlbar #trust-icon,
+    #urlbar #identity-icon {
+        list-style-image: none !important;
+        background-color: var(--mcf-fx-on-surface) !important;
+        mask-repeat: no-repeat;
+        mask-position: center;
+        mask-size: 24px 24px;
+        mask-image: var(--mcf-icon, none);
+    }
+    #PanelUI-menu-button { --mcf-icon: var(--mcf-fx-icon-ellipsis-vertical); }
+    #mcf-newtab-button { --mcf-icon: var(--mcf-fx-icon-plus); }
+
+    /* Tab counter: the tab icon with the count in it. */
+    #mcf-tabcounter-button {
+        position: relative;
+        --mcf-icon: var(--mcf-fx-icon-tab);
+
+        &[tabcount="∞"] {
+            --mcf-icon: var(--mcf-fx-icon-infinite-tabs);
+        }
+
+        &::after {
+            content: attr(tabcount);
+            position: absolute;
+            inset: 0;
+            display: grid;
+            place-items: center;
+            font-size: 12px;
+            font-weight: 700;
+            line-height: 1;
+            color: var(--mcf-fx-on-surface);
+            pointer-events: none;
+        }
+        &[tabcount-wide]::after {
+            font-size: 9.6px;
+        }
+        &[tabcount="∞"]::after {
+            content: none;
+        }
+
+        /* Private mode mask badge (showPrivacyBadge): top end of the icon,
+         * 8dp out of it. */
+        :root[privatebrowsingmode="temporary"] &::before {
+            content: "";
+            position: absolute;
+            width: 20px;
+            height: 20px;
+            top: 4px;
+            right: 4px;
+            background: var(--mcf-fx-icon-private-badge) center / 100% no-repeat;
+            pointer-events: none;
+            z-index: 1;
+        }
+    }
+
+    /* Editing the address (BrowserEditToolbar): the edit field takes the
+     * whole bar, the browser actions are gone. FF 157+ (the results are a
+     * popover); with the breakout of FF <= 156 the urlbar overlays them. */
+    #nav-bar:has(#urlbar[focused]:not([breakout])) :is(#mcf-newtab-button,
+        #mcf-tabcounter-button, #PanelUI-button) {
+        display: none !important;
+    }
+    #nav-bar:has(#urlbar[focused]:not([breakout])) #urlbar-container {
+        padding-inline-end: 8px !important;
+    }
+
+    /* Editing the address: Fenix shows the awesomebar over the whole page
+     * (SearchSuggestions below/above the edit toolbar, fenix
+     * AwesomeBarComposable), not a dropdown. Same pill while editing, no
+     * focus ring. FF 157+ popover results; the <= 156 path is in urlbar.css. */
+    #urlbar[focused] > .urlbar-background,
+    #urlbar[breakout][breakout-extend] > .urlbar-background,
+    #urlbar[popover-open] > .urlbar-background {
+        inset: 0 !important;
+        border: 0 !important;
+        outline: 0 !important;
+        box-shadow: none !important;
+        border-radius: 24px !important;
+        clip-path: none !important;
+        background: var(--mcf-fx-pill) !important;
+    }
+    #urlbar[focused], #urlbar[focused] :is(.urlbar-input-container, #urlbar-input, #urlbar-container) {
+        outline: 0 !important;
+        --focus-outline-color: transparent;
+    }
+    #urlbar > .urlbarView > .urlbarView-background {
+        display: none !important;
+    }
+    /* FF <= 156: the urlbar is always a breakout popover (a permanent
+     * [breakout]), so only while editing ([focused], or its results open) it
+     * becomes the edit pill over the toolbar's address bar, and its results (a child,
+     * fixed to the window once .urlbar's will-change is off) the awesomebar. */
+    /* At rest the breakout popover is as wide as the container measures,
+     * padding included; the container's 8dp end padding is the gap to the
+     * browser actions. */
+    #urlbar[breakout]:not([focused], [breakout-extend]) {
+        width: calc(var(--urlbar-width) - 8px) !important;
+    }
+    #urlbar[breakout]:is([focused], [breakout-extend]) {
+        will-change: auto !important;
+        translate: none !important;
+        position: fixed !important;
+        inset: auto 8px 8px 8px !important;
+        width: auto !important;
+        height: 48px !important;
+        margin: 0 !important;
+        z-index: 5 !important;
+        border-radius: 24px !important;
+        color: var(--mcf-fx-on-surface) !important;
+
+        @media -moz-pref("mcf.toolbar.positionOnTop") {
+            inset: 8px 8px auto 8px !important;
+        }
+    }
+    #urlbar[breakout]:is([focused], [breakout-extend]) > .urlbar-input-container {
+        height: 48px !important;
+        min-height: 48px !important;
+        padding: 0 !important;
+        outline: 0 !important;
+        border: 0 !important;
+        background: transparent !important;
+        box-shadow: none !important;
+    }
+
+    .urlbarView:popover-open,
+    #urlbar[breakout]:is([focused], [breakout-extend]) > .urlbarView {
+        position: fixed !important;
+        position-area: none !important;
+        inset: auto 0 var(--mcf-toolbar-height) 0 !important;
+        width: 100vw !important;
+        height: calc(100vh - var(--mcf-toolbar-height)) !important;
+        max-height: none !important;
+        margin: 0 !important;
+        border: 0 !important;
+        border-radius: 0 !important;
+        box-shadow: none !important;
+        overflow: hidden auto !important;
+        background: var(--mcf-fx-surface) !important;
+        color: var(--mcf-fx-on-surface) !important;
+
+        @media -moz-pref("mcf.toolbar.positionOnTop") {
+            inset: var(--mcf-toolbar-height) 0 auto 0 !important;
+        }
+    }
+    #urlbar[breakout]:is([focused], [breakout-extend]) > .urlbarView {
+        /* The pill is 8dp inside the window; the view is outside of it. */
+        left: 0 !important;
+        right: 0 !important;
+        box-sizing: border-box;
+        padding: 11px !important;
+    }
+    /* Rows as FF 158's results lay them out (wrapper-less, 24 radius). */
+    #urlbar[breakout]:is([focused], [breakout-extend]) .urlbarView-body-inner {
+        margin: 0 !important;
+        width: 100% !important;
+        border: 0 !important;
+    }
+    #urlbar[breakout]:is([focused], [breakout-extend]) .urlbarView-title-separator::before {
+        content: "\2022" !important;
+    }
+    #urlbar[breakout]:is([focused], [breakout-extend]) #urlbar-results {
+        padding: 0 !important;
+    }
+    #urlbar[breakout]:is([focused], [breakout-extend]) .urlbarView-row {
+        padding: 3.67px !important;
+        border-radius: 24px !important;
+    }
+    #urlbar[breakout]:is([focused], [breakout-extend]) .urlbarView-row-inner {
+        padding: 7.33px 3px !important;
+    }
+
+    /* Suggestions bottom-up with a bottom toolbar (AwesomeBarOrientation:
+     * BOTTOM_TO_TOP), the first one next to the edit bar; the list sticks to
+     * the bottom. A top toolbar lists them top-down. */
+    @media not (-moz-pref("mcf.toolbar.positionOnTop")) {
+        .urlbarView:popover-open,
+        #urlbar[breakout]:is([focused], [breakout-extend]) > .urlbarView {
+            display: flex !important;
+            /* Reversed so the list starts at the bottom and, when it is
+             * longer than the screen, is scrolled to the bottom. */
+            flex-direction: column-reverse !important;
+        }
+        #urlbar-results {
+            display: flex !important;
+            flex-direction: column-reverse;
+        }
+    }
+
+    /* The tab counter is the sidebar button with vertical tabs. */
+    @media -moz-pref("sidebar.verticalTabs") {
+        #mcf-tabcounter-button {
+            display: none !important;
+        }
+    }
+}
