diff --git a/src/modules/FenixToolbar.sys.mjs b/src/modules/FenixToolbar.sys.mjs
new file mode 100644
index 0000000..6171d09
--- /dev/null
+++ b/src/modules/FenixToolbar.sys.mjs
@@ -0,0 +1,287 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Firefox for Android's one-row browser toolbar on narrow windows
+ * (toolbar.css has the layout and the sources).
+ *
+ * Fenix's phone toolbar is [address bar | new tab | tab counter | menu]
+ * (BrowserToolbarMiddleware.kt buildEndBrowserActions()). Desktop has the
+ * menu and the address bar, so this adds the "new tab" button and the tab
+ * counter after the address bar. They are plain toolbar buttons next to the
+ * app menu button, not CustomizableUI widgets, so customizing the toolbar
+ * leaves them alone; toolbar.css hides them on wide windows.
+ *
+ * The counter's click opens the tab tray (TabTray.sys.mjs) and its long
+ * press the counter menu (TabCounterMenu.sys.mjs).
+ *
+ * Fenix also has no extension buttons in the toolbar: all extensions are in
+ * the menu's Extensions entry (MainMenu.kt). Pinned extensions don't show in
+ * Firefox's extensions panel, so on narrow windows they're moved to it (the
+ * panel's own area) and put back when the window gets wide again.
+ */
+
+const NARROW = 700; // toolbar.css switches to the mobile layout at this width
+const MOVED_PREF = 'mcf.toolbar.extensionsInPanel';
+
+export class FenixToolbar {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+        document.l10n.addResourceIds([{ path: 'browser/mobileconfig/fenix.ftl', optional: true }]);
+
+        const menuButton = document.getElementById('PanelUI-button');
+        if (!menuButton) return;
+
+        const newTab = document.createXULElement('toolbarbutton');
+        newTab.id = 'mcf-newtab-button';
+        newTab.className = 'toolbarbutton-1 chromeclass-toolbar-additional';
+        document.l10n.setAttributes(newTab, 'mcf-toolbar-new-tab');
+        newTab.addEventListener('command', (event) => window.BrowserCommands.openTab({ event }));
+
+        const counter = document.createXULElement('toolbarbutton');
+        counter.id = 'mcf-tabcounter-button';
+        counter.className = 'toolbarbutton-1 chromeclass-toolbar-additional';
+        // The click is handled in TabTray.sys.mjs, which also stops the
+        // all-tabs panel; the command here is for keyboard activation.
+        document.l10n.setAttributes(counter, 'mcf-toolbar-tab-counter', { count: 1 });
+
+        menuButton.before(newTab, counter);
+
+        const update = () => {
+            // The tab being closed is still in the list during TabClose.
+            const count = window.gBrowser.tabs.filter(tab => !tab.closing).length;
+            // Fenix shows an infinity icon above 99 tabs (TabCounter.kt).
+            counter.setAttribute('tabcount', count > 99 ? '∞' : String(count));
+            counter.toggleAttribute('tabcount-wide', count > 9);
+            document.l10n.setAttributes(counter, 'mcf-toolbar-tab-counter', { count });
+        };
+        update();
+        const container = window.gBrowser.tabContainer;
+        for (const type of ['TabOpen', 'TabClose', 'TabShow', 'TabHide']) {
+            container.addEventListener(type, update);
+        }
+
+        this._extensionsToMenu(window);
+        this._privateHome(window);
+        this._placeholder(window);
+        this._progressBar(window);
+        this._awesomebarKeys(window);
+    }
+
+    /**
+     * With a bottom toolbar the suggestions are listed bottom-up (toolbar.css),
+     * the first one nearest to the edit bar. Up and down then follow what
+     * is on screen: Up goes to the suggestion above, which is the next one
+     * in the list.
+     */
+    _awesomebarKeys(window) {
+        const input = window.document.getElementById('urlbar-input');
+        if (!input) return;
+        input.addEventListener('keydown', (event) => {
+            if ((event.key !== 'ArrowUp' && event.key !== 'ArrowDown') ||
+                event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+            const urlbar = window.gURLBar;
+            if (!urlbar?.view?.isOpen || window.innerWidth > NARROW ||
+                Services.prefs.getBoolPref('mcf.toolbar.positionOnTop', false)) return;
+            event.preventDefault();
+            event.stopImmediatePropagation();
+            urlbar.view.selectBy(1, { reverse: event.key === 'ArrowDown' });
+        }, true);
+    }
+
+    /**
+     * The progress bar on the toolbar's edge facing the page
+     * (FullDisplayToolbar.kt: AnimatedProgressBar, 5dp, the accent gradient,
+     * transparent track, shown from 1 to 99 percent).
+     *
+     * Fenix feeds it Gecko's page load progress. Desktop Firefox doesn't
+     * deliver onProgressChange to the tab progress listeners (checked on 154
+     * and 158: only the start and stop states arrive), so the bar moves
+     * towards 90 percent while the tab is loading and is removed when it
+     * stops.
+     *
+     * The movement is a CSS animation of the bar's transform (toolbar.css),
+     * which the compositor runs: nothing on the main thread while a page
+     * loads. Setting the width from a timer restyled, laid out and repainted
+     * the toolbar ten times a second instead, on the thread that also
+     * handles the page's network data.
+     */
+    _progressBar(window) {
+        const document = window.document;
+        const navBar = document.getElementById('nav-bar');
+        const gBrowser = window.gBrowser;
+        if (!navBar || !gBrowser) return;
+        const bar = document.createXULElement('box');
+        bar.id = 'mcf-progress';
+        bar.hidden = true;
+        navBar.append(bar);
+
+        const stop = () => {
+            bar.hidden = true;
+        };
+        const start = () => {
+            if (!bar.hidden) return;
+            bar.hidden = false;
+            // Showing the bar starts its animation at 5 percent. A stop and
+            // a start before the next restyle would leave the old one
+            // running, so rewind it (one style flush per page load).
+            for (const animation of bar.getAnimations()) animation.currentTime = 0;
+        };
+        const listener = {
+            QueryInterface: ChromeUtils.generateQI(['nsIWebProgressListener', 'nsISupportsWeakReference']),
+            onStateChange: (webProgress, request, flags) => {
+                if (!webProgress.isTopLevel) return;
+                const { STATE_START, STATE_STOP, STATE_IS_NETWORK } = Ci.nsIWebProgressListener;
+                if ((flags & STATE_IS_NETWORK) && (flags & STATE_START)) start();
+                else if ((flags & STATE_IS_NETWORK) && (flags & STATE_STOP)) stop();
+            },
+        };
+        gBrowser.addProgressListener(listener, Ci.nsIWebProgress.NOTIFY_STATE_NETWORK);
+        gBrowser.tabContainer.addEventListener('TabSelect', () => {
+            if (gBrowser.selectedTab.hasAttribute('busy')) start();
+            else stop();
+        });
+    }
+
+    /**
+     * Fenix's address bar hint is "Search or enter address" (search_hint),
+     * desktop says "Search with <engine> or enter address". Desktop sets its
+     * hint through the input's l10n id, and again whenever the engine or the
+     * search mode changes, so this swaps the two ids that carry the default
+     * hint and leaves the search mode hints ("Search <engine>") alone.
+     */
+    _placeholder(window) {
+        const input = window.document.getElementById('urlbar-input');
+        if (!input) return;
+        const DESKTOP = new Set(['urlbar-placeholder-with-name', 'urlbar-placeholder']);
+        let desktop = null; // the desktop hint, to put back on wide windows
+        const apply = () => {
+            const l10n = window.document.l10n;
+            const id = input.getAttribute('data-l10n-id');
+            if (DESKTOP.has(id)) {
+                desktop = l10n.getAttributes(input);
+                if (window.innerWidth <= NARROW) l10n.setAttributes(input, 'mcf-urlbar-placeholder');
+            } else if (id === 'mcf-urlbar-placeholder' && window.innerWidth > NARROW && desktop) {
+                l10n.setAttributes(input, desktop.id, desktop.args);
+            }
+        };
+        new window.MutationObserver(apply).observe(input, { attributes: true, attributeFilter: ['data-l10n-id'] });
+        window.addEventListener('resize', apply);
+        apply();
+    }
+
+    /**
+     * A private window starts on about:privatebrowsing, which is hard-wired
+     * in browser.js. Fenix's private home is the same screen as the normal
+     * home (private colours, the "Leave no traces" text), which is the new
+     * tab page here (boot.sys.mjs), so the first tab goes there too.
+     */
+    _privateHome(window) {
+        if (!window.PrivateBrowsingUtils?.isWindowPrivate(window)) return;
+        const gBrowser = window.gBrowser;
+        if (!gBrowser) return;
+        const listener = {
+            QueryInterface: ChromeUtils.generateQI(['nsIWebProgressListener', 'nsISupportsWeakReference']),
+            onLocationChange: (webProgress, request, location) => {
+                if (!webProgress.isTopLevel || location.spec !== 'about:privatebrowsing') return;
+                gBrowser.removeProgressListener(listener);
+                if (gBrowser.tabs.length !== 1) return;
+                window.setTimeout(() => {
+                    gBrowser.selectedBrowser.loadURI(Services.io.newURI('about:fenixhome'), {
+                        triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal(),
+                    });
+                }, 0);
+            },
+        };
+        gBrowser.addProgressListener(listener, Ci.nsIWebProgress.NOTIFY_LOCATION);
+        window.setTimeout(() => {
+            try { gBrowser.removeProgressListener(listener); } catch (e) {}
+        }, 10000);
+    }
+
+    _extensionsToMenu(window) {
+        let CUI;
+        try {
+            CUI = window.CustomizableUI;
+            if (!CUI?.isWebExtensionWidget) return;
+        } catch (e) {
+            return;
+        }
+        const narrow = () => window.innerWidth <= NARROW;
+        const readMoved = () => {
+            try {
+                return new Set(JSON.parse(Services.prefs.getStringPref(MOVED_PREF, '[]')));
+            } catch (e) {
+                return new Set();
+            }
+        };
+        const writeMoved = (set) => Services.prefs.setStringPref(MOVED_PREF, JSON.stringify([...set]));
+        let busy = false;
+
+        const apply = () => {
+            if (busy) return;
+            busy = true;
+            try {
+                const moved = readMoved();
+                if (narrow()) {
+                    for (const id of CUI.getWidgetIdsInArea(CUI.AREA_NAVBAR)) {
+                        if (!CUI.isWebExtensionWidget(id)) continue;
+                        CUI.addWidgetToArea(id, CUI.AREA_ADDONS);
+                        moved.add(id);
+                    }
+                } else {
+                    for (const id of moved) {
+                        if (CUI.getPlacementOfWidget(id)?.area === CUI.AREA_ADDONS) {
+                            CUI.addWidgetToArea(id, CUI.AREA_NAVBAR);
+                        }
+                    }
+                    moved.clear();
+                }
+                writeMoved(moved);
+            } catch (e) {
+                console.error('Moving extension buttons failed:', e);
+            } finally {
+                busy = false;
+            }
+        };
+
+        // New extensions pinned by their manifest (default_area navbar).
+        const listener = {
+            onWidgetAdded: (id, area) => {
+                if (!busy && narrow() && area === CUI.AREA_NAVBAR && CUI.isWebExtensionWidget(id)) {
+                    window.setTimeout(apply, 0);
+                }
+            },
+        };
+        CUI.addListener(listener);
+        window.addEventListener('unload', () => CUI.removeListener(listener), { once: true });
+
+        let wasNarrow = null;
+        window.addEventListener('resize', () => {
+            if (wasNarrow === narrow()) return;
+            wasNarrow = narrow();
+            apply();
+        });
+        // After CustomizableUI built the toolbars.
+        (window.delayedStartupPromise || Promise.resolve()).then(() => {
+            wasNarrow = narrow();
+            apply();
+        });
+    }
+}
diff --git a/src/modules/MemoryTrim.sys.mjs b/src/modules/MemoryTrim.sys.mjs
new file mode 100644
index 0000000..8744f55
--- /dev/null
+++ b/src/modules/MemoryTrim.sys.mjs
@@ -0,0 +1,157 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Trims memory when the browser is in the background and the system runs
+ * short of memory, like Firefox for Android.
+ *
+ * Android tells GeckoView with ComponentCallbacks2.onTrimMemory(), which
+ * GeckoRuntime registers a MemoryController for
+ * (mobile/android/geckoview/.../gecko/process/MemoryController.java, same in
+ * FIREFOX_154_0_RELEASE and main):
+ *   TRIM_MEMORY_UI_HIDDEN (20)                  -> nothing (below BACKGROUND)
+ *   TRIM_MEMORY_BACKGROUND (40) / MODERATE (60) -> notifyObservers
+ *       "memory-pressure": "low-memory", or "low-memory-ongoing" when the
+ *       last "low-memory" was less than 10 s ago
+ *   TRIM_MEMORY_COMPLETE (80) / RUNNING_CRITICAL (15) / onLowMemory()
+ *                                               -> "low-memory", always
+ *
+ * When Android sends what (frameworks/base services/core/java/com/android/
+ * server/am/AppProfiler.java updateLowMemStateLSP()):
+ * - Hiding the UI only ever gets UI_HIDDEN, which GeckoView ignores. That is
+ *   all a backgrounded app gets as long as memory is fine (memFactor
+ *   NORMAL), and all it gets at all with the modern trim of Android 14+.
+ * - BACKGROUND, MODERATE and COMPLETE go to background processes only while
+ *   the memory factor is not NORMAL. LowMemDetector (services/core/jni/
+ *   com_android_server_am_LowMemDetector.cpp) raises it from the kernel's
+ *   memory pressure stall information: 15 ms of "some" stall in a 1 s
+ *   window is low pressure, 30 / 50 ms of "full" stall medium / high.
+ *
+ * So a short trip to the home screen, the lock screen or a screen-off does
+ * nothing: purging then only cost time when the browser came back
+ * (WebRender re-rasterising and re-uploading every glyph and tile, JIT code
+ * compiled again). While every browser window is hidden (all minimized, or
+ * suspended by the compositor: KWin suspends windows that are minimized,
+ * behind show-desktop, under the lock screen or on a screen that is off),
+ * this reads /proc/pressure/memory once a second, and on the first second
+ * with 15 ms of stall sends what Android sends at the BACKGROUND level: the
+ * gfx caches (gfx/layers/MemoryPressureObserver.cpp), WebRender's texture
+ * and glyph caches, GC, CC and the caches that listen for memory-pressure
+ * let go. Again only after the pressure went away and came back. Without
+ * PSI, low pressure is less than 10% of the memory available (Firefox
+ * itself unloads tabs at 5%, AvailableMemoryWatcherLinux.cpp).
+ */
+const POLL_MS = 1000; // LowMemDetector's PSI window
+const STALL_US = 15000; // PSI_LOW_STALL_US: "some" stall per window
+const FALLBACK_AVAILABLE_PERCENT = 10; // without PSI
+const ONGOING_RESET_MS = 10000; // MemoryController.LOW_MEMORY_ONGOING_RESET_TIME_MS
+const PSI_PATH = '/proc/pressure/memory';
+const MEMINFO_PATH = '/proc/meminfo';
+
+// /proc files report a size of 0, so IOUtils.readUTF8() returns nothing;
+// read up to a limit instead.
+async function readProc(path) {
+    return new TextDecoder().decode(await IOUtils.read(path, { maxBytes: 8192 }));
+}
+
+export class MemoryTrim {
+    init() {
+        this._timer = null;
+        this._lastLowMemory = 0;
+        this._lastStall = null; // "some" total, µs
+        this._psi = true;
+        this._pressure = false; // trimmed for the current pressure episode
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic !== 'domwindowopened') return;
+                const window = subject;
+                window.addEventListener('load', () => {
+                    if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                    this._setupForWindow(window);
+                }, { once: true });
+            }
+        };
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _isHidden(window) {
+        if (window.closed) return true;
+        return window.windowState === window.STATE_MINIMIZED || window.document.hidden;
+    }
+
+    _allHidden() {
+        for (const window of Services.wm.getEnumerator('navigator:browser')) {
+            if (!this._isHidden(window)) return false;
+        }
+        return true;
+    }
+
+    _setupForWindow(window) {
+        const check = () => this._update();
+        window.addEventListener('sizemodechange', check);
+        window.document.addEventListener('visibilitychange', check);
+        window.addEventListener('unload', () => Services.tm.dispatchToMainThread(check), { once: true });
+    }
+
+    /** Watch the memory pressure only while nothing is visible. */
+    _update() {
+        if (!this._allHidden()) {
+            this._timer?.cancel();
+            this._timer = null;
+            this._lastStall = null;
+            this._pressure = false;
+            return;
+        }
+        if (this._timer) return;
+        this._timer = Cc['@mozilla.org/timer;1'].createInstance(Ci.nsITimer);
+        this._timer.initWithCallback(() => this._poll(), POLL_MS, Ci.nsITimer.TYPE_REPEATING_SLACK_LOW_PRIORITY);
+        this._poll();
+    }
+
+    async _poll() {
+        let low;
+        try {
+            low = await this._isMemoryLow();
+        } catch (e) {
+            return;
+        }
+        if (!this._timer) return; // visible again meanwhile
+        if (!low) {
+            this._pressure = false;
+            return;
+        }
+        if (this._pressure) return;
+        this._pressure = true;
+        this.trim();
+    }
+
+    async _isMemoryLow() {
+        if (this._psi) {
+            try {
+                // "some avg10=0.00 avg60=0.00 avg300=0.00 total=12345"
+                const text = await readProc(PSI_PATH);
+                const total = Number(/^some .*total=(\d+)/m.exec(text)?.[1]);
+                if (Number.isFinite(total)) {
+                    const last = this._lastStall;
+                    this._lastStall = total;
+                    return last !== null && total - last >= STALL_US;
+                }
+            } catch (e) {}
+            this._psi = false;
+        }
+        const text = await readProc(MEMINFO_PATH);
+        const kb = (key) => Number(new RegExp(`^${key}:\\s+(\\d+)`, 'm').exec(text)?.[1]);
+        const total = kb('MemTotal');
+        const available = kb('MemAvailable');
+        if (!total || !Number.isFinite(available)) return false;
+        return available * 100 / total < FALLBACK_AVAILABLE_PERCENT;
+    }
+
+    trim() {
+        const now = Date.now();
+        // MemoryController.onMemoryNotification()
+        const arg = now - this._lastLowMemory >= ONGOING_RESET_MS ? 'low-memory' : 'low-memory-ongoing';
+        if (arg === 'low-memory') this._lastLowMemory = now;
+        Services.obs.notifyObservers(null, 'memory-pressure', arg);
+    }
+}
