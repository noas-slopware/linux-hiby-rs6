+++ b/src/modules/fenixhome/home.css
@@ -0,0 +1,373 @@
+/* Copyright 2026 Noa Himesaka
+ * SPDX-License-Identifier: MPL-2.0 */
+
+/* The home screen of Firefox for Android (Fenix), as a new tab page.
+ * Sources (mozilla-firefox/firefox, mobile/android/fenix/app/src/main/java/
+ * org/mozilla/fenix/home): ui/Homepage.kt (section order and spacing),
+ * ui/HomepageHeader.kt, ui/WordmarkAndLogo.kt, topsites/TopSites.kt and
+ * TopSitesLayout.kt (4 columns, 84dp items, 60dp favicon cards),
+ * recenttabs/view/RecentTabs.kt, bookmarks/view/Bookmarks.kt,
+ * recentvisits/view/RecentlyVisited.kt, compose/home/HomeSectionHeader.kt,
+ * ui/PrivateBrowsingDescription.kt; colours from AcornColors.kt (Nova) and
+ * the AcornTypography.kt text styles. dp are CSS px, as elsewhere. */
+
+:root {
+    color-scheme: light dark;
+    --surface: light-dark(#f7f6fb, #1d1b1f);
+    --on-surface: light-dark(#180e30, #f2f0f8);
+    --on-surface-variant: light-dark(rgb(24 14 48 / 70%), rgb(242 240 248 / 70%));
+    --card: light-dark(#ffffff, #131215);
+    --card-border: light-dark(#e3e2e7, #3f3e42);
+    --favicon-card: light-dark(#ffffff, #312f33);
+    --placeholder: light-dark(#e3e2e7, #312f33);
+    --favicon-surface: light-dark(#ffffff, #131215);
+    --secondary: light-dark(#67666a, #d6d5da);
+    --divider: light-dark(#e3e2e7, #3f3e42);
+    --pressed: color-mix(in srgb, var(--on-surface) 12%, transparent);
+    --horizontal-margin: 16px;
+}
+
+/* The private colour scheme (acornPrivateColorScheme). */
+:root.private {
+    --surface: #180e30;
+    --on-surface: #f2f0f8;
+    --on-surface-variant: rgb(242 240 248 / 70%);
+    --card-border: #332752;
+    --divider: #332752;
+}
+
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+
+html, body {
+    margin: 0;
+    background: var(--surface);
+    color: var(--on-surface);
+    font: 400 16px/24px system-ui, sans-serif;
+    letter-spacing: 0.15px;
+    -moz-user-select: none;
+    user-select: none;
+}
+
+body {
+    min-height: 100vh;
+    padding-bottom: 24px;
+}
+
+button {
+    font: inherit;
+    color: inherit;
+    background: none;
+    border: 0;
+    padding: 0;
+}
+
+/* HomepageHeader: private mode toggle at the end, wordmark below. */
+header {
+    display: flex;
+    align-items: flex-start;
+    padding: 4px 4px 0;
+}
+header .spacer { flex: 1; }
+.icon-button {
+    width: 48px;
+    height: 48px;
+    border-radius: 50%;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    -moz-context-properties: fill;
+    fill: var(--on-surface);
+}
+.icon-button::before {
+    content: "";
+    width: 24px;
+    height: 24px;
+    background: var(--icon) center / 24px no-repeat;
+    -moz-context-properties: fill;
+    fill: var(--on-surface);
+}
+.icon-button:active { background: var(--pressed); }
+.private-button {
+    --icon: url("chrome://browser/skin/privateBrowsing.svg");
+    background: light-dark(#e3e2e7, #312f33);
+}
+:root.private .private-button { background: #332752; }
+.wordmark {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 4px 0 20px;
+}
+.wordmark .logo { height: 40px; padding-inline-end: 10px; box-sizing: content-box; }
+.wordmark .text {
+    height: 26px;
+    -moz-context-properties: fill;
+    fill: var(--on-surface);
+}
+body.is-private .wordmark { display: none; }
+
+/* HomeSectionHeader: subtitle1, the optional "Show all >" text button. */
+section { margin-top: 40px; }
+section:first-of-type { margin-top: 0; }
+.section-header {
+    display: flex;
+    align-items: center;
+    padding: 0 var(--horizontal-margin);
+}
+.section-header h2 {
+    flex: 1;
+    margin: 0;
+    font: 400 16px/24px system-ui, sans-serif;
+    letter-spacing: 0.15px;
+    overflow: hidden;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+}
+.text-button {
+    display: flex;
+    align-items: center;
+    gap: 4px;
+    min-height: 48px;
+    padding: 0 12px;
+    margin-inline-end: -12px;
+    border-radius: 20px;
+    font-size: 16px;
+}
+.text-button::after {
+    content: "";
+    width: 16px;
+    height: 16px;
+    background: url("chrome://global/skin/icons/arrow-right.svg") center / 16px no-repeat;
+    -moz-context-properties: fill;
+    fill: var(--on-surface);
+}
+.text-button:active { background: var(--pressed); }
+.section-header + * { margin-top: 16px; }
+
+/* HomepageCard: a rounded card with a 1dp outline. */
+.card {
+    background: var(--card);
+    border: 1px solid var(--card-border);
+    border-radius: 16px;
+    box-shadow: 0 2px 6px rgb(0 0 0 / 12%);
+    color: var(--on-surface);
+}
+
+/* Shortcuts: 4 columns, 8dp gaps, 84dp items at most, 60dp favicon cards. */
+.shortcuts-grid {
+    display: grid;
+    grid-template-columns: repeat(4, minmax(0, 84px));
+    justify-content: center;
+    column-gap: 8px;
+    row-gap: 12px;
+    padding: 0 var(--horizontal-margin);
+}
+.shortcut {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    padding: 4px 0 6px;
+    text-decoration: none;
+    color: var(--on-surface);
+    position: relative;
+}
+.favicon-card {
+    width: 60px;
+    height: 60px;
+    border-radius: 16px;
+    background: var(--favicon-card);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    box-shadow: 0 1px 4px rgb(0 0 0 / 16%);
+    position: relative;
+}
+.favicon-card img { width: 36px; height: 36px; border-radius: 8px; }
+.favicon-card .letter { font: 500 22px/1 system-ui, sans-serif; color: var(--secondary); text-transform: uppercase; }
+.shortcut.pinned .favicon-card::after {
+    content: "";
+    position: absolute;
+    inset-block-start: 4px;
+    inset-inline-start: 4px;
+    width: 8px;
+    height: 8px;
+    background: url("chrome://browser/skin/pin-12.svg") center / contain no-repeat;
+    -moz-context-properties: fill;
+    fill: var(--secondary);
+}
+.shortcut .title {
+    width: 100%;
+    margin-top: 6px;
+    padding: 0 4px;
+    font: 700 12px/16px system-ui, sans-serif;
+    letter-spacing: 0.4px;
+    text-align: center;
+    overflow: hidden;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+}
+.shortcut.add .favicon-card { background: var(--placeholder); box-shadow: none; }
+.shortcut.add .favicon-card::before {
+    content: "";
+    width: 24px;
+    height: 24px;
+    background: url("chrome://global/skin/icons/plus.svg") center / 24px no-repeat;
+    -moz-context-properties: fill;
+    fill: var(--on-surface);
+}
+.shortcut:active .favicon-card { filter: brightness(0.92); }
+
+/* Recent tabs: a 108x80 thumbnail, title (14sp, 2 lines), favicon and URL (12sp). */
+.recent-tabs-list {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+    padding: 0 var(--horizontal-margin);
+}
+.recent-tab {
+    display: flex;
+    align-items: center;
+    gap: 16px;
+    padding: 8px 16px 8px 8px;
+    border-radius: 8px;
+    border: 0;
+    box-shadow: 0 1px 2px rgb(0 0 0 / 14%);
+    text-decoration: none;
+    color: var(--on-surface);
+    background: var(--card);
+}
+.recent-tab .thumb {
+    flex: none;
+    width: 108px;
+    height: 80px;
+    border-radius: 8px;
+    background: var(--placeholder);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+.recent-tab .thumb img { width: 36px; height: 36px; }
+.recent-tab .text { flex: 1; min-width: 0; align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; }
+.recent-tab .name {
+    font-size: 14px;
+    line-height: 20px;
+    letter-spacing: 0;
+    overflow: hidden;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+}
+.recent-tab .url-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.recent-tab .url-row img { width: 18px; height: 18px; border-radius: 2px; flex: none; }
+.recent-tab .url {
+    font-size: 12px;
+    line-height: 16px;
+    letter-spacing: 0.4px;
+    color: var(--on-surface-variant);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+/* Bookmarks: 134dp cards in a row, a 126x82 image, caption below. */
+.bookmarks-row {
+    display: flex;
+    gap: 8px;
+    padding: 0 16px;
+    overflow-x: auto;
+    scrollbar-width: none;
+}
+.bookmark {
+    flex: none;
+    width: 134px;
+    padding: 4px 4px 8px;
+    text-decoration: none;
+    color: var(--on-surface);
+}
+.bookmark .image {
+    width: 126px;
+    height: 82px;
+    border-radius: 8px;
+    background: var(--favicon-surface);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+.bookmark .image img { width: 36px; height: 36px; }
+.bookmark .name {
+    margin: 8px 4px 0;
+    font: 400 12px/16px system-ui, sans-serif;
+    letter-spacing: 0.4px;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+/* Recently visited: one card, 3 items per column, a divider between them,
+ * more than three scroll sideways in columns up to 320dp wide. */
+.recent-visits-wrap { padding: 8px 16px; overflow-x: auto; scrollbar-width: none; }
+.recent-visits-card {
+    display: grid;
+    grid-auto-flow: column;
+    grid-template-rows: repeat(3, auto);
+    column-gap: 32px;
+    width: 100%;
+    overflow: clip;
+}
+.recent-visits-wrap.multi .recent-visits-card { grid-auto-columns: minmax(0, 320px); width: max-content; max-width: none; }
+.visit {
+    display: flex;
+    align-items: center;
+    gap: 16px;
+    min-height: 56px;
+    padding: 8px 16px;
+    text-decoration: none;
+    color: var(--on-surface);
+    position: relative;
+    min-width: 0;
+}
+.visit img { width: 24px; height: 24px; border-radius: 4px; flex: none; }
+.visit .label {
+    flex: 1;
+    min-width: 0;
+    font: 400 16px/24px system-ui, sans-serif;
+    letter-spacing: 0.15px;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+.visit.divider::after {
+    content: "";
+    position: absolute;
+    inset-inline: 16px;
+    inset-block-end: 0;
+    border-bottom: 1px solid var(--divider);
+}
+.visit:active { background: var(--pressed); }
+
+/* PrivateBrowsingDescription (felt privacy): icon, headline5, subtitle1, link. */
+#private {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    padding: 0 24px;
+    text-align: center;
+}
+#private .private-circle {
+    width: 72px;
+    height: 72px;
+    padding: 16px;
+    border-radius: 50%;
+    background: #332752;
+    margin-bottom: 24px;
+}
+#private h1 { margin: 0 0 8px; font: 400 24px/32px system-ui, sans-serif; letter-spacing: 0.18px; }
+#private p { margin: 0 0 8px; font-size: 16px; line-height: 24px; letter-spacing: 0.15px; }
+#private a { color: var(--on-surface); text-decoration: underline; font-size: 16px; line-height: 24px; }
+
+/* The globe page-icon shows for sites without a favicon (yet). */
+img { -moz-context-properties: fill; fill: var(--secondary); }
+.wordmark .text { fill: var(--on-surface); }
diff --git a/src/modules/fenixhome/home.js b/src/modules/fenixhome/home.js
new file mode 100644
index 0000000..3a913e0
--- /dev/null
+++ b/src/modules/fenixhome/home.js
@@ -0,0 +1,189 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * The Fenix home screen (home.css has the sources). A privileged about page
+ * (about:fenixhome, registered by boot.sys.mjs and set as the new tab URL),
+ * so it reads Places and the browser window directly.
+ */
+const { PlacesUtils } = ChromeUtils.importESModule("resource://gre/modules/PlacesUtils.sys.mjs");
+const { PrivateBrowsingUtils } = ChromeUtils.importESModule("resource://gre/modules/PrivateBrowsingUtils.sys.mjs");
+
+const SHORTCUT_COLUMNS = 4;
+const SHORTCUT_ROWS = 2; // collapsed (TOP_SITES_COLLAPSED_ROWS)
+const BOOKMARKS = 8;
+const VISITS = 9; // 3 per column
+const topWin = () => window.browsingContext?.topChromeWindow;
+
+const el = (tag, props = {}, ...kids) => {
+    const e = document.createElement(tag);
+    for (const [k, v] of Object.entries(props)) {
+        if (k === "class") e.className = v;
+        else if (k === "text") e.textContent = v;
+        else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
+        else e.setAttribute(k, v);
+    }
+    e.append(...kids);
+    return e;
+};
+const icon = (url) => "page-icon:" + url;
+const host = (url) => { try { return new URL(url).host.replace(/^www\./, ""); } catch (e) { return url; } };
+// URLStringUtils.toLosslessDisplayUrl: no scheme, no www, no trailing slash.
+const display = (url) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
+
+const open = (url) => { window.location.href = url; };
+
+async function query(sql, params = {}) {
+    const db = await PlacesUtils.promiseDBConnection();
+    return db.executeCached(sql, params);
+}
+
+async function topSites() {
+    const rows = await query(
+        `SELECT url, title FROM moz_places
+          WHERE hidden = 0 AND frecency > 0 AND visit_count > 0
+            AND substr(url, 1, 4) = 'http'
+          ORDER BY frecency DESC LIMIT 40`);
+    const seen = new Set();
+    const out = [];
+    let pinned = [];
+    try {
+        const { NewTabUtils } = ChromeUtils.importESModule("resource://gre/modules/NewTabUtils.sys.mjs");
+        pinned = (NewTabUtils.pinnedLinks.links || []).filter(Boolean);
+    } catch (e) {}
+    for (const p of pinned) {
+        seen.add(host(p.url));
+        out.push({ url: p.url, title: p.title || host(p.url), pinned: true });
+    }
+    for (const r of rows) {
+        const url = r.getResultByName("url");
+        const h = host(url);
+        if (seen.has(h)) continue;
+        seen.add(h);
+        out.push({ url, title: r.getResultByName("title") || h, pinned: false });
+    }
+    return out;
+}
+
+function renderShortcuts(sites) {
+    const grid = document.getElementById("shortcuts-grid");
+    const max = SHORTCUT_COLUMNS * SHORTCUT_ROWS;
+    for (const s of sites.slice(0, max)) {
+        grid.append(el("a", { class: "shortcut" + (s.pinned ? " pinned" : ""), href: s.url },
+            el("div", { class: "favicon-card" }, el("img", { src: icon(s.url), alt: "" })),
+            el("div", { class: "title", text: s.title })));
+    }
+    if (sites.length < max) {
+        const add = el("a", { class: "shortcut add", href: "#", onclick: async (e) => {
+            e.preventDefault();
+            const typed = window.prompt("Address", "https://");
+            if (!typed) return;
+            try {
+                const url = new URL(typed).href;
+                const { NewTabUtils } = ChromeUtils.importESModule("resource://gre/modules/NewTabUtils.sys.mjs");
+                NewTabUtils.pinnedLinks.pin({ url, title: host(url) }, Math.min(sites.length, max - 1));
+                location.reload();
+            } catch (err) {}
+        } },
+            el("div", { class: "favicon-card" }),
+            el("div", { class: "title", "data-l10n-id": "fenixhome-add-shortcut" }));
+        grid.append(add);
+    }
+    document.getElementById("shortcuts").hidden = !grid.childElementCount;
+}
+
+function renderRecentTabs() {
+    const win = topWin();
+    if (!win?.gBrowser) return;
+    const gB = win.gBrowser;
+    const own = gB.getTabForBrowser?.(window.browsingContext.top.embedderElement);
+    const tabs = [...gB.tabs]
+        .filter(t => t !== own && !t.closing && t.linkedBrowser?.currentURI?.spec &&
+                     /^https?:/.test(t.linkedBrowser.currentURI.spec) &&
+                     PrivateBrowsingUtils.isBrowserPrivate(t.linkedBrowser) === PrivateBrowsingUtils.isContentWindowPrivate(window))
+        .sort((a, b) => b.lastAccessed - a.lastAccessed)
+        .slice(0, 1);
+    const list = document.getElementById("recent-tabs-list");
+    for (const t of tabs) {
+        const url = t.linkedBrowser.currentURI.spec;
+        list.append(el("a", { class: "recent-tab", href: "#", onclick: (e) => { e.preventDefault(); gB.selectedTab = t; } },
+            el("div", { class: "thumb" }, el("img", { src: icon(url), alt: "" })),
+            el("div", { class: "text" },
+                el("div", { class: "name", text: t.label || display(url) }),
+                el("div", { class: "url-row" }, el("img", { src: icon(url), alt: "" }), el("div", { class: "url", text: display(url) })))));
+    }
+    document.getElementById("recent-tabs").hidden = !tabs.length;
+}
+
+async function recentBookmarks() {
+    return (await PlacesUtils.bookmarks.getRecent(BOOKMARKS * 2))
+        .filter(b => b.url && /^https?:/.test(b.url.href)).slice(0, BOOKMARKS);
+}
+
+function renderBookmarks(items) {
+    const row = document.getElementById("bookmarks-row");
+    for (const b of items) {
+        row.append(el("a", { class: "bookmark card", href: b.url.href },
+            el("div", { class: "image" }, el("img", { src: icon(b.url.href), alt: "" })),
+            el("div", { class: "name", text: b.title || display(b.url.href) })));
+    }
+    document.getElementById("bookmarks").hidden = !items.length;
+    document.getElementById("bookmarks-all").addEventListener("click", () => topWin()?.PlacesCommandHook?.showPlacesOrganizer?.("UnfiledBookmarks"));
+}
+
+async function recentVisits() {
+    // The newest visits by the visit date index, deduplicated here: grouping
+    // by page first reads the whole history on every new tab.
+    const rows = await query(
+        `SELECT p.url AS url, p.title AS title
+           FROM moz_historyvisits v JOIN moz_places p ON p.id = v.place_id
+          WHERE p.hidden = 0 AND substr(p.url, 1, 4) = 'http'
+          ORDER BY v.visit_date DESC LIMIT 200`);
+    const seen = new Set();
+    const items = [];
+    for (const r of rows) {
+        const url = r.getResultByName("url");
+        if (seen.has(url)) continue;
+        seen.add(url);
+        items.push({ url, title: r.getResultByName("title") || display(url) });
+        if (items.length === VISITS) break;
+    }
+    return items;
+}
+
+function renderVisits(items) {
+    const card = document.getElementById("recent-visits-card");
+    items.forEach((v, i) => {
+        const last = (i + 1) % 3 === 0 || i === items.length - 1;
+        card.append(el("a", { class: "visit" + (last ? "" : " divider"), href: v.url },
+            el("img", { src: icon(v.url), alt: "" }),
+            el("div", { class: "label", text: v.title })));
+    });
+    document.getElementById("recent-visits-wrap").classList.toggle("multi", items.length > 3);
+    document.getElementById("recent-visits").hidden = !items.length;
+    document.getElementById("history-all").addEventListener("click", () => topWin()?.PlacesCommandHook?.showPlacesOrganizer?.("History"));
+}
+
+window.addEventListener("DOMContentLoaded", async () => {
+    const isPrivate = PrivateBrowsingUtils.isContentWindowPrivate(window);
+    document.documentElement.classList.toggle("private", isPrivate);
+    document.body.classList.toggle("is-private", isPrivate);
+    document.getElementById("normal").hidden = isPrivate;
+    document.getElementById("private").hidden = !isPrivate;
+    // The toggle opens a window in the other mode, as desktop has no per-tab mode.
+    document.getElementById("private-toggle").addEventListener("click", () => {
+        topWin()?.OpenBrowserWindow({ private: !isPrivate });
+    });
+    if (isPrivate) return;
+    try {
+        // All queries first, then the whole page in one go: one layout and
+        // paint instead of one per section, and nothing moves around.
+        const [sites, bookmarks, visits] = await Promise.all([topSites(), recentBookmarks(), recentVisits()]);
+        renderShortcuts(sites);
+        renderRecentTabs();
+        renderBookmarks(bookmarks);
+        renderVisits(visits);
+    } catch (e) {
+        console.error("Fenix home failed:", e);
+    }
+});
