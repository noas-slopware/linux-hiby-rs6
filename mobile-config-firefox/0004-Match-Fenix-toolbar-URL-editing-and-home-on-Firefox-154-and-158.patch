+/* Private mode: acornPrivateColorScheme (AcornColors.kt), the toolbar is
+ * tinted like the rest of the private UI. */
+:root[privatebrowsingmode="temporary"] {
+    --mcf-fx-surface: #180e30;
+    --mcf-fx-pill: #281d44;
+    --mcf-fx-on-surface: #f2f0f8;
+    --mcf-fx-on-surface-variant: rgb(242 240 248 / 70%);
+    --mcf-fx-divider: #332752;
+}
+
+/* Progress bar (FenixToolbar.sys.mjs): AnimatedProgressBar on the edge facing
+ * the page, 5dp, the accent gradient (AcornGradientScheme.kt: Violet30 to
+ * Orange30 in light, to Violet50 in dark), no track. */
+#mcf-progress {
+    display: none;
+}
+
+/* The estimate (FenixToolbar.sys.mjs): from 5 towards 90 percent, each
+ * 100 ms 6 percent closer, 90 - 85 * 0.94^(t / 100 ms): a keyframe per
+ * 500 ms, five steps each, so it moves ten times a second like before.
+ * A transform animation, so the compositor runs it and the main thread
+ * isn't involved. In steps, because the compositor only renders a frame
+ * when the value changes: a smooth bar renders and composites a frame on
+ * every vsync for as long as a page loads. */
+@keyframes mcf-progress {
+    0% { transform: scaleX(0.050); }
+    5% { transform: scaleX(0.276); }
+    10% { transform: scaleX(0.442); }
+    15% { transform: scaleX(0.564); }
+    20% { transform: scaleX(0.653); }
+    25% { transform: scaleX(0.719); }
+    30% { transform: scaleX(0.767); }
