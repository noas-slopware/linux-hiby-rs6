+<html lang="en-US">
+<head>
+    <meta charset="utf-8">
+    <title data-l10n-id="fenixhome-title">New tab</title>
+    <meta http-equiv="Content-Security-Policy"
+          content="default-src chrome:;
+                   img-src chrome: moz-icon: page-icon: https: blob: data:;
+                   script-src resource: chrome:;
+                   style-src chrome: data:;
+                   object-src 'none'">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <meta name="color-scheme" content="light dark">
+    <link rel="stylesheet" href="chrome://mobileconfigfirefox/content/fenixhome/home.css">
+    <link rel="localization" href="browser/mobileconfig/fenix.ftl">
+    <script src="chrome://mobileconfigfirefox/content/fenixhome/home.js"></script>
+</head>
+<body>
+    <header>
+        <button id="stories" class="icon-button" hidden data-l10n-id="fenixhome-stories"></button>
+        <span class="spacer"></span>
+        <button id="private-toggle" class="icon-button private-button" data-l10n-id="fenixhome-private-browsing"></button>
+    </header>
+    <div id="wordmark" class="wordmark">
+        <img class="logo" src="chrome://branding/content/about-logo.svg" alt="">
+        <img class="text" src="chrome://branding/content/firefox-wordmark.svg" alt="Firefox">
+    </div>
+
+    <main id="normal">
+        <section id="shortcuts" hidden>
+            <div class="section-header"><h2 data-l10n-id="fenixhome-shortcuts"></h2></div>
+            <div id="shortcuts-grid" class="shortcuts-grid"></div>
+        </section>
+        <section id="recent-tabs" hidden>
+            <div class="section-header"><h2 data-l10n-id="fenixhome-continue"></h2></div>
+            <div id="recent-tabs-list" class="recent-tabs-list"></div>
+        </section>
+        <section id="bookmarks" hidden>
+            <div class="section-header">
+                <h2 data-l10n-id="fenixhome-bookmarks"></h2>
+                <button id="bookmarks-all" class="text-button" data-l10n-id="fenixhome-show-all"></button>
+            </div>
+            <div id="bookmarks-row" class="bookmarks-row"></div>
+        </section>
+        <section id="recent-visits" hidden>
+            <div class="section-header">
+                <h2 data-l10n-id="fenixhome-recently-visited"></h2>
+                <button id="history-all" class="text-button" data-l10n-id="fenixhome-show-all"></button>
+            </div>
+            <div id="recent-visits-wrap" class="recent-visits-wrap"><div id="recent-visits-card" class="card recent-visits-card"></div></div>
+        </section>
+    </main>
+
+    <main id="private" hidden>
+        <img class="private-circle" src="chrome://browser/skin/privatebrowsing/favicon.svg" alt="">
+        <h1 data-l10n-id="fenixhome-private-title"></h1>
+        <p data-l10n-id="fenixhome-private-description"></p>
+        <a id="private-learn-more" href="https://support.mozilla.org/kb/private-browsing-use-firefox-without-history" data-l10n-id="fenixhome-private-link"></a>
+    </main>
+</body>
+</html>
