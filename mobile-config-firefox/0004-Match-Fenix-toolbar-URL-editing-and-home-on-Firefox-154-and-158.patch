@@ -0,0 +1,615 @@
+/* Copyright 2026 Noa Himesaka
+ * SPDX-License-Identifier: MPL-2.0 */
+
+/* The browser toolbar of Firefox for Android (Fenix), in place of desktop's
+ * tab strip row plus navigation bar row. FenixToolbar.sys.mjs adds the "new
+ * tab" and tab counter buttons and puts the extension buttons in the menu.
+ *
+ * Sources (mozilla-firefox/firefox, mobile/android):
+ * - fenix/.../components/toolbar/BrowserToolbarMiddleware.kt: on a phone
+ *   (narrower than 600dp, expanded toolbar off) the toolbar is one row:
+ *   [site info shield | URL | reader mode when available] inside the address
+ *   bar, then the browser actions: the "new tab" shortcut
+ *   (toolbarSimpleShortcutKey defaults to NEW_TAB), the tab counter and the
+ *   menu (buildEndBrowserActions). Back, forward and refresh only show from
+ *   600dp wide (buildStartBrowserActions); the navigation bar row only with
+ *   the expanded toolbar, whose default-expanded-toolbar is false in
+ *   nimbus.fml.yaml. No tab strip on phones (Settings.isTabStripEnabled).
+ * - android-components/.../compose/browser-toolbar/ui/FullDisplayToolbar.kt:
+ *   8dp around a 48dp tall pill (CircleShape, surfaceContainerHighest),
+ *   buttons are 48dp IconButtons with 24dp icons, a 1dp divider and the
+ *   progress bar on the edge facing the page.
+ * - .../ui/Origin.kt: 15sp URL, the registrable domain emphasised, 66dp fade.
+ * - android-components/ui/tabcounter TabCounter.kt: the 24dp mozac_ic_tab
+ *   icon with the count in 12sp (two digits 9.6sp) bold, an infinity icon
+ *   above 99 tabs, a mask badge in private mode.
+ * - .../theme/AcornColors.kt (light/dark colour schemes) with NovaColors.kt.
+ * dp are CSS px here, like in the other Fenix parity files.
+ *
+ * Wide windows keep the desktop toolbar. */
+
+:root {
+    /* Acorn (Nova) colours: light, dark. */
+    --mcf-fx-surface: light-dark(#f7f6fb, #1d1b1f);
+    --mcf-fx-pill: light-dark(#e3e2e7, #312f33);
+    --mcf-fx-on-surface: light-dark(#180e30, #f2f0f8);
+    --mcf-fx-on-surface-variant: light-dark(rgb(24 14 48 / 70%), rgb(242 240 248 / 70%));
+    --mcf-fx-divider: light-dark(#e3e2e7, #3f3e42);
+    --mcf-fx-pressed: color-mix(in srgb, var(--mcf-fx-on-surface) 12%, transparent);
+
+    /* Icons: mozac_ic_*_24 vector drawables as SVG (fill from the context). */
+    --mcf-fx-icon-plus: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22context-fill%22%20d=%22M12.5,5C12.983,5%2013.375,5.392%2013.375,5.875V11.625H19.125C19.608,11.625%2020,12.017%2020,12.5C20,12.983%2019.608,13.375%2019.125,13.375H13.375V19.125C13.375,19.608%2012.983,20%2012.5,20C12.017,20%2011.625,19.608%2011.625,19.125V13.375H5.875C5.392,13.375%205,12.983%205,12.5C5,12.017%205.392,11.625%205.875,11.625H11.625V5.875C11.625,5.392%2012.017,5%2012.5,5Z%22/%3E%3C/svg%3E");
+    --mcf-fx-icon-ellipsis-vertical: url("data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2024%2024%22%3E%3Cpath%20fill=%22context-fill%22%20d=%22M11%2017.5V20h2.5v-2.5H11zm0-6.75v2.5h2.5v-2.5H11zM11%204v2.5h2.5V4H11z%22/%3E%3C/svg%3E");
