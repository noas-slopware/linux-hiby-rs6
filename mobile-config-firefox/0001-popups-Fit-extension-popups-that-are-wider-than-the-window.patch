diff --git a/src/modules/popup-browser-content.js b/src/modules/popup-browser-content.js
new file mode 100644
index 0000000..ffa7738
--- /dev/null
+++ b/src/modules/popup-browser-content.js
@@ -0,0 +1,34 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+// Frame script for extension popup browsers, loaded by PopupFit.sys.mjs into
+// the same global as Firefox's ext-browser-content.js.
+//
+// Firefox re-measures a popup whenever its scrolled area changes. The
+// measurement (getContentSize) resizes the viewport to the preferred size,
+// rounded out to whole device pixels, and the next refresh puts the browser's
+// real size back. When the preferred size isn't a whole number of device
+// pixels (odd CSS sizes at 2.5 dppx, most zoom levels), each of those steps
+// moves the scrolled area by a fraction of a pixel, which triggers the next
+// measurement: ten times a second for as long as the popup is open.
+// Sub-pixel moves of the scrolled area are that rounding, not new content,
+// so don't measure for them. DOM changes still go through the
+// MutationObserver.
+
+"use strict";
+
+if (typeof BrowserListener === "object" && !BrowserListener.mcfScrolledArea) {
+    const { handleEvent } = BrowserListener;
+
+    BrowserListener.mcfScrolledArea = { width: 0, height: 0 };
+    BrowserListener.handleEvent = function (event) {
+        if (event.type === "MozScrolledAreaChanged") {
+            const last = this.mcfScrolledArea;
+            this.mcfScrolledArea = { width: event.width, height: event.height };
+            if (Math.abs(event.width - last.width) < 1 && Math.abs(event.height - last.height) < 1) {
+                return;
+            }
+        }
+        handleEvent.call(this, event);
+    };
+}
diff --git a/src/themes/shared/chrome/popups.css b/src/themes/shared/chrome/popups.css
index fefc856..249a183 100644
--- a/src/themes/shared/chrome/popups.css
+++ b/src/themes/shared/chrome/popups.css
@@ -136,9 +136,13 @@ browser.webextension-popup-browser {
 }
 
 /* Make large extensions (e.g., uBlock origin) popups useful
- * by allowing them to be horizontally scrolled */
+ * by allowing them to be horizontally scrolled.
+ * Firefox pins the popup browser to the content's preferred width with an
+ * inline min-width, which beats max-width, so drop it; PopupFit.sys.mjs then
+ * zooms popups that are still too wide (e.g., Bitwarden) to fit. */
 .webextension-popup-browser, .webextension-popup-stack {
     max-width: 100vw !important;
+    min-width: 0 !important;
     width: 100% !important;
     overflow-x: scroll !important;
 }
