diff --git a/src/themes/shared/chrome/pagescroll.css b/src/themes/shared/chrome/pagescroll.css
new file mode 100644
index 0000000..9439352
--- /dev/null
+++ b/src/themes/shared/chrome/pagescroll.css
@@ -0,0 +1,63 @@
+/* Copyright 2026 Noa Himesaka
+ * SPDX-License-Identifier: MPL-2.0 */
+
+/* Toolbar that hides on scroll (PageScroll.sys.mjs). The page keeps the full
+ * height and the toolbar overlays its edge, so the page is never laid out
+ * again when the toolbar moves. */
+@media (max-width: 700px) {
+    :root[mcf-dynamic-toolbar] #navigator-toolbox {
+        position: relative;
+        z-index: 1;
+        margin-top: calc(-1 * var(--mcf-dynamic-toolbar-height));
+        will-change: translate;
+    }
+    @media -moz-pref("mcf.toolbar.positionOnTop") {
+        :root[mcf-dynamic-toolbar] #navigator-toolbox {
+            margin-top: 0;
+            margin-bottom: calc(-1 * var(--mcf-dynamic-toolbar-height));
+        }
+        /* The page is pushed down by the part of the toolbar that's shown. */
+        :root[mcf-dynamic-toolbar] .browserStack > browser {
+            position: relative;
+        }
+    }
+}
+
+/* Pull to refresh indicator: SwipeRefreshLayout's 40dp circle with elevation. */
+#mcf-pull-to-refresh {
+    position: fixed;
+    z-index: 5;
+    width: 40px;
+    height: 40px;
+    box-sizing: border-box;
+    border-radius: 50%;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    color: var(--toolbar-color, currentColor);
+    background-color: var(--arrowpanel-background, Canvas);
+    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3), 0 0 1px rgba(0, 0, 0, 0.2);
+    opacity: var(--mcf-ptr-alpha, 1);
+    pointer-events: none;
+    transition: opacity 0.15s linear;
+
+    &[hidden] {
+        display: none;
+    }
+
+    &.refreshing svg {
+        animation: mcf-ptr-spin 1.333s linear infinite;
+    }
+    &.refreshing circle {
+        stroke-dasharray: 34 56;
+        animation: mcf-ptr-dash 1.333s ease-in-out infinite;
+    }
+}
+
+@keyframes mcf-ptr-spin {
+    to { transform: rotate(360deg); }
+}
+@keyframes mcf-ptr-dash {
+    0%, 100% { stroke-dasharray: 6 56; }
+    50% { stroke-dasharray: 36 56; }
+}
