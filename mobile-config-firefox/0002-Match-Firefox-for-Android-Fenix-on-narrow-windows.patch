+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Toolbar swipe gestures of Firefox for Android:
+ *
+ * - A horizontal swipe that starts on the toolbar switches to the
+ *   neighbouring tab, without wrapping around
+ *   (fenix/.../toolbar/gestures/ToolbarHorizontalGesturesHandler.kt).
+ * - A swipe away from the screen edge (up for a bottom toolbar, down for a
+ *   top one) opens the tab list
+ *   (fenix/.../toolbar/gestures/ToolbarVerticalGesturesHandler.kt).
+ *
+ * Neither starts while the URL bar is being edited (Fenix: not while the
+ * keyboard is up or search is active) or while a panel or menu is open.
+ *
+ * Distances are Android dp, which are CSS px here.
+ */
+
+// AOSP ViewConfiguration: TOUCH_SLOP = 8 dp, MINIMUM_FLING_VELOCITY = 50 dp/s.
+const TOUCH_SLOP = 8;
+const MINIMUM_FLING_VELOCITY = 50 / 1000; // px per ms
+// ToolbarHorizontalGesturesHandler: GESTURE_FINISH_PERCENT, and the gap
+// between the content and the incoming tab (dimens.xml
+// browser_fragment_gesture_preview_offset = 48dp).
+const GESTURE_FINISH_PERCENT = 0.25;
+const PREVIEW_OFFSET = 48;
+// How far the content follows the finger when there's no tab to switch to.
+const OVERSCROLL_HIDE_PERCENT = 0.2;
+// ToolbarVerticalGesturesHandler: twice the touch slop, but never more than
+// the toolbar height / 0.8.
+const TOOLBAR_HEIGHT_MAXIMUM_SWIPE_FACTOR = 0.8;
+// android.view.VelocityTracker only looks at the last 100 ms of movement.
+const VELOCITY_HORIZON_MS = 100;
+
+export class ToolbarGestures {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+        const toolbox = document.getElementById('navigator-toolbox');
+        const content = document.getElementById('tabbrowser-tabbox');
+        if (!toolbox || !content) return;
+
+        const atBottom = () => !Services.prefs.getBoolPref('mcf.toolbar.positionOnTop', false);
+        const editing = () => document.getElementById('urlbar')?.hasAttribute('focused');
+        const popupOpen = () => [...document.querySelectorAll('panel, menupopup')]
+            .some(popup => popup.state === 'open' || popup.state === 'showing');
+
+        let swipe = null;
+
+        const reset = () => {
+            content.style.removeProperty('translate');
+            swipe = null;
+        };
+
+        toolbox.addEventListener('pointerdown', (event) => {
+            if (event.pointerType !== 'touch' || !event.isPrimary || swipe) return;
+            if (editing() || popupOpen()) return;
+            swipe = {
+                id: event.pointerId,
+                x0: event.clientX,
+                y0: event.clientY,
+                samples: [{ x: event.clientX, y: event.clientY, t: event.timeStamp }],
+                axis: null,
+                destination: null,
+            };
+        }, true);
