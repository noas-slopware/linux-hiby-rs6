diff --git a/src/themes/shared/chrome/touch.css b/src/themes/shared/chrome/touch.css
new file mode 100644
index 0000000..6ea7446
--- /dev/null
+++ b/src/themes/shared/chrome/touch.css
@@ -0,0 +1,49 @@
+/* Copyright 2026 Noa Himesaka
+ * SPDX-License-Identifier: MPL-2.0 */
+
+/* Firefox for Android has no status panel: no "Waiting for..." or link
+ * target overlay at the bottom of the page. */
+#statuspanel {
+    display: none !important;
+}
+
+/* Toolbar swipe gestures (ToolbarGestures.sys.mjs) need the toolbar's
+ * pointer events; don't let a pan of the toolbar be taken as scrolling.
+ * touch-action stops at scroll containers, and the URL bar input (a long
+ * URL) and the tab strip are ones, so set it on everything in the toolbox.
+ * Not while editing the URL, so its text can still be scrolled and
+ * selected. */
+#navigator-toolbox:not(:has(#urlbar[focused])),
+#navigator-toolbox:not(:has(#urlbar[focused])) * {
+    touch-action: none;
+}
+
+/* On a touchscreen, :hover sticks to whatever was tapped last (GTK leaves
+ * its emulated pointer there), so a button stays highlighted after its
+ * panel closed. Android has no hover state; keep only the pressed (:active)
+ * and open/checked looks. boot.sys.mjs makes (hover: none) match on touch
+ * devices, like GeckoView. Not gated on window width: these rules also run
+ * inside panels. */
+@media (hover: none) {
+    /* Toolbar buttons (toolbarbuttons.css) */
+    toolbarbutton.toolbarbutton-1:not([disabled], [open], [checked], :active):hover
+        > :is(.toolbarbutton-icon, .toolbarbutton-text, .toolbarbutton-badge-stack) {
+        background-color: transparent !important;
+    }
+
+    /* Panel items (panelUI-shared.css) */
+    :is(panelview .toolbarbutton-1,
+        toolbarbutton.subviewbutton,
+        .widget-overflow-list .toolbarbutton-1,
+        .toolbaritem-combined-buttons:is(:not([cui-areatype="toolbar"]), [overflowedItem="true"]) > toolbarbutton
+    ):not([disabled], :active):hover {
+        color: var(--button-text-color-menu) !important;
+        background-color: var(--button-background-color-menu) !important;
+    }
+
+    /* Menu items (menu.css): _moz-menuactive follows the pointer. */
+    menupopup > :is(menuitem, menu):not([disabled])[_moz-menuactive] {
+        color: inherit !important;
+        background-color: transparent !important;
+    }
+}
