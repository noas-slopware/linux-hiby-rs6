+
+const HTML = 'http://www.w3.org/1999/xhtml';
+const MOBILE_MAX_WIDTH = 700;
+
+// Fenix strings.xml
+const S = {
+    normalTabs: n => `Normal Tabs Open: ${n}. Tap to switch tabs.`,
+    privateTabs: n => `Private Tabs Open: ${n}. Tap to switch tabs.`,
+    addTab: 'Add tab',
+    addPrivateTab: 'Add private tab',
+    menu: 'Open tabs menu',
+    closeTab: title => `Close tab ${title}`,
+    selectTabs: 'Select tabs',
+    selectAll: 'Select all',
+    recentlyClosed: 'Recently closed tabs',
+    recentlyClosedEmpty: 'No recently closed tabs here',
+    tabSettings: 'Tab settings',
+    closeAll: 'Close all tabs',
+    closeAllTitle: 'Close all tabs?',
+    closeAllBody: 'This will close all open tabs.',
+    closeAllConfirm: 'Close tabs',
+    cancel: 'Cancel',
+    emptyNormal: 'Create a new tab to start searching',
+    emptyPrivateHeader: 'Private browsing',
+    emptyPrivateBody: brand => `${brand} won’t remember any of your history or cookies, but new bookmarks will be saved.`,
+    selectedCount: n => `${n} selected`,
+    exitSelect: 'Exit multiselect mode',
+    bookmarkSelected: 'Bookmark selected tabs',
