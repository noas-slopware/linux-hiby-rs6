+    _openTabList(window) {
+        // The tab tray (TabTray.sys.mjs), the list of all tabs without it.
+        if (window.mcfTabTray) {
+            window.mcfTabTray.open();
+            return;
+        }
+        const anchor = Services.prefs.getBoolPref('sidebar.verticalTabs', false) ? null : 'alltabs-button';
+        if (anchor && window.document.getElementById(anchor)) {
+            window.gTabsPanel.showAllTabsPanel(null, anchor);
+        }
+    }
+}
