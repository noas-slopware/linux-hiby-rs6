 * Reason: Nova about:home is too wide, see [screenshots](https://gitlab.postmarketos.org/postmarketOS/mobile-config-firefox/-/merge_requests/131).
+
+### Firefox for Android (GeckoView) values
+
+* Value: see `set_android_preferences()` in `src/modules/boot.sys.mjs`
+* Description: touch target radius, coarse pointer / no hover, meta viewport,
+  APZ tuning, selection carets, process counts and a few page behaviours.
+* Reason: pages and Gecko should handle touch the way they do in Firefox for
+  Android. Every value comes from `StaticPrefList.yaml`, `geckoview-prefs.js`
+  or `all.js` (Android branches); the function's comments name the source of
+  each and list the Android prefs that are deliberately left out.
+
+
+## Scroll behaviour (Firefox for Android)
+
+### `mcf.toolbar.hideOnScroll.enabled` (default `true`)
+* Fenix: "Scroll to hide toolbar" (`pref_key_dynamic_toolbar`, default on)
+* The toolbar hides while the page is scrolled down and shows when it's
+  scrolled up, when the page is at its top, on tab switch, on navigation and
+  while the URL bar or the find bar is in use. Only in the narrow (mobile)
+  layout. Works with the toolbar at the bottom or on top.
+
+### `mcf.pullToRefresh.enabled` (default `true`)
+* Fenix: "Pull to refresh" (`pref_key_website_pull_to_refresh`, default on)
+* Pulling down on a page that's scrolled to the top reloads it, with
+  androidx SwipeRefreshLayout's 64dp threshold and half-rate drag. Pages that
+  scroll themselves, or opt out with `overscroll-behavior`, keep the gesture.
diff --git a/src/modules/AppMenu.sys.mjs b/src/modules/AppMenu.sys.mjs
new file mode 100644
index 0000000..9d8e353
--- /dev/null
+++ b/src/modules/AppMenu.sys.mjs
@@ -0,0 +1,129 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Arranges the app menu like Firefox for Android's main menu
+ * (fenix/.../components/menu/compose/MainMenu.kt), top to bottom:
+ *
+ *   tools:   Bookmark page, Find in page, Translate, Extensions
+ *   library: History | Bookmarks | Downloads | Passwords (tiles in one row)
+ *   account: Sign in, Settings
+ *   navigation row: Back | Forward | Refresh/Stop, at the bottom next to a
+ *   bottom toolbar and at the top under a top toolbar (MenuNavigation is
+ *   MainMenu's footer or header).
+ *
+ * appmenu.css orders and hides the existing rows; this adds the rows desktop
+ * Firefox doesn't have. Fenix also has "Desktop site", "More" and "Share";
+ * those need features mcf doesn't have yet.
+ *
+ * It also closes any mobile panel when the empty part of it is tapped:
+ * popups.css makes panels as big as the window with the menu at the bottom,
+ * so a tap above the menu lands on the panel itself and wouldn't close it.
+ */
+export class AppMenu {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+        // Only en-US exists (fenix.ftl); optional, so other UI locales don't
+        // lose their bundle over it.
+        document.l10n.addResourceIds([{ path: 'browser/mobileconfig/fenix.ftl', optional: true }]);
+
+        // The main view lives in a template until the menu is first opened.
+        const onViewShowing = (event) => {
+            if (event.target.id !== 'appMenu-mainView') return;
+            this._build(window, event.target);
+            this._update(window);
+        };
+        document.addEventListener('ViewShowing', onViewShowing, true);
+
+        // Tap on the empty part of a panel closes it.
+        document.addEventListener('click', (event) => {
+            const panel = event.target.closest?.('panel');
+            if (!panel || panel.state !== 'open' || event.button !== 0) return;
+            if (event.target.closest('panelview, .panel-header, .panel-subview-body, arrowscrollbox, browser')) return;
+            if (event.target !== panel &&
+                !event.target.matches('panelmultiview, .panel-viewcontainer, .panel-viewstack')) return;
+            window.PanelMultiView.hidePopup(panel);
+        }, true);
+    }
+
+    _build(window, view) {
+        const document = window.document;
+        const body = view.querySelector('.panel-subview-body');
+        if (!body || body.querySelector('#mcf-appmenu-bookmark')) return;
+
+        const button = (id, l10nId, className, command) => {
+            const node = document.createXULElement('toolbarbutton');
+            node.id = id;
+            node.className = className;
+            document.l10n.setAttributes(node, l10nId);
+            if (command) node.addEventListener('command', command);
+            return node;
+        };
+
+        // "Bookmark page" / "Edit bookmark" (MainMenu.kt ToolsAndActionsMenuGroup).
+        body.append(button('mcf-appmenu-bookmark', 'mcf-appmenu-bookmark-page',
+            'subviewbutton subviewbutton-iconic', () => {
+                window.PanelUI.hide();
+                // Saves at once and shows Fenix's snackbar (FenixSnackbars).
+                const { FenixSnackbars } = ChromeUtils.importESModule(
+                    'chrome://mobileconfigfirefox/content/FenixSnackbars.sys.mjs');
+                FenixSnackbars.bookmarkPage(window);
+            }));
+
+        // Group separators; desktop's own separators are hidden (appmenu.css).
+        for (const id of ['mcf-appmenu-separator-library', 'mcf-appmenu-separator-account']) {
+            const separator = document.createXULElement('toolbarseparator');
+            separator.id = id;
+            body.append(separator);
+        }
+
+        // Back, Forward, Refresh/Stop (MainMenu.kt MenuNavigation). The
+        // browser commands keep them enabled/disabled with the page.
+        const nav = document.createXULElement('toolbaritem');
+        nav.id = 'mcf-appmenu-navigation';
+        nav.setAttribute('closemenu', 'none');
+        const navButton = (id, l10nId, command) => {
+            const node = button(id, l10nId, 'subviewbutton subviewbutton-iconic');
+            node.setAttribute('command', command);
+            node.addEventListener('command', () => window.PanelUI.hide());
+            return node;
+        };
+        nav.append(
+            navButton('mcf-appmenu-back', 'mcf-appmenu-back', 'Browser:Back'),
+            navButton('mcf-appmenu-forward', 'mcf-appmenu-forward', 'Browser:Forward'),
+            navButton('mcf-appmenu-reload', 'mcf-appmenu-refresh', 'Browser:Reload'),
+            navButton('mcf-appmenu-stop', 'mcf-appmenu-stop', 'Browser:Stop'));
+        body.append(nav);
+    }
+
+    _update(window) {
+        const document = window.document;
+        const bookmark = document.getElementById('mcf-appmenu-bookmark');
+        if (bookmark) {
+            const starred = document.getElementById('star-button')?.hasAttribute('starred');
+            document.l10n.setAttributes(bookmark,
+                starred ? 'mcf-appmenu-edit-bookmark' : 'mcf-appmenu-bookmark-page');
+            bookmark.toggleAttribute('starred', !!starred);
+        }
+        // Refresh while idle, Stop while loading, like Fenix.
+        const loading = window.gBrowser.selectedBrowser.webProgress?.isLoadingDocument;
+        document.getElementById('mcf-appmenu-reload')?.toggleAttribute('hidden', !!loading);
+        document.getElementById('mcf-appmenu-stop')?.toggleAttribute('hidden', !loading);
+    }
+}
diff --git a/src/modules/ContextMenuDialog.sys.mjs b/src/modules/ContextMenuDialog.sys.mjs
new file mode 100644
index 0000000..5ad9ee1
--- /dev/null
+++ b/src/modules/ContextMenuDialog.sys.mjs
@@ -0,0 +1,318 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Shows the page context menu like Firefox for Android: a dialog in the
+ * middle of the window with the link (or image) as its title and only the
+ * items Fenix offers, in Fenix's order.
+ *
+ * Fenix: android-components feature/contextmenu ContextMenuFragment.kt (a
+ * MaterialAlertDialog: title = HitResult.getLink(), 2 lines, tap to expand
+ * to 15; 48dp rows) with the candidates of
+ * ContextMenuCandidate.defaultCandidates() / Fenix's
+ * NativeShareSheetContextMenuCandidate, each shown when its showFor() holds.
+ * Selected text gets Android's selection actions instead, ordered by
+ * HomeActivity.actionSorter().
+ *
+ * Desktop Firefox's own menu items do the work; this picks, orders and
+ * relabels them, and adds "Copy link text" and "Copy link" for media, which
+ * desktop doesn't have. Items Fenix has but Linux can't do (share, add to
+ * contact) are left out. With nothing to offer, Fenix shows no menu at all,
+ * so neither does this.
+ */
+
+const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+    'resource://gre/modules/PrivateBrowsingUtils.sys.mjs'
+);
+
+// Mobile layout only, like mcf's other layout changes (max-width: 700px).
+const MOBILE_MAX_WIDTH = 700;
+
+// Fenix item order (ContextMenuCandidate.defaultCandidates()). `when` gets
+// the hit (see _hit()); `l10n` is the Fenix label in fenix.ftl.
+const LINK_ITEMS = [
+    { id: 'context-openlinkintab', l10n: 'mcf-context-open-link-in-new-tab',
+      when: hit => hit.httpLink && !hit.isPrivate },
+    { id: 'context-openlinkprivate', l10n: 'mcf-context-open-link-in-private-window',
+      when: hit => hit.httpLink },
+    // HitResult.getLink(): the link, else the image or media source. Desktop
+    // has no such item for media, and none for mailto: links.
+    { id: 'mcf-context-copylink', l10n: 'mcf-context-copy-link',
+      when: hit => hit.uri || hit.image || hit.media,
+      copy: hit => hit.uri ? hit.link : hit.mediaURL },
+    { id: 'mcf-context-copylinktext', l10n: 'mcf-context-copy-link-text',
+      when: hit => hit.uri && !hit.image && !!hit.linkText,
+      copy: hit => hit.linkText },
+    { id: 'context-savelink', l10n: 'mcf-context-download-link',
+      when: hit => hit.httpLink && !/html?$/.test(hit.link) },
+    { id: 'context-viewimage', l10n: 'mcf-context-open-image-in-new-tab',
+      when: hit => hit.image },
+    { id: 'context-copyimage-contents', l10n: 'mcf-context-copy-image',
+      when: hit => hit.image },
+    { id: 'context-saveimage', l10n: 'mcf-context-save-image',
+      when: hit => hit.image },
+    { id: 'context-savevideo', l10n: 'mcf-context-save-file-to-device',
+      when: hit => hit.video },
+    { id: 'context-saveaudio', l10n: 'mcf-context-save-file-to-device',
+      when: hit => hit.audio },
+    { id: 'context-copyimage', l10n: 'mcf-context-copy-image-location',
+      when: hit => hit.image },
+    { id: 'context-copyemail', l10n: 'mcf-context-copy-email-address',
+      when: hit => hit.mailto },
+];
+
+// Text selection: HomeActivity.actionSorter() puts EMAIL, CALL, COPY,
+// SEARCH, SEARCH_PRIVATELY, PASTE, SELECT_ALL, SHARE first and Gecko's other
+// actions (CUT, ...) after them. Search is offered in normal tabs, Private
+// Search in private ones (DefaultSelectionActionDelegate.isActionAvailable()).
+const SELECTION_ITEMS = [
+    { id: 'context-copy', when: hit => hit.selected },
+    { id: 'context-searchselect', l10n: 'mcf-context-search',
+      when: hit => hit.selected && !hit.isPrivate },
+    { id: 'context-searchselect', l10n: 'mcf-context-search-privately',
+      when: hit => hit.selected && hit.isPrivate },
+    { id: 'context-paste', when: hit => hit.editable },
+    { id: 'context-selectall', l10n: 'mcf-context-select-all', when: () => true },
+    { id: 'context-cut', when: hit => hit.editable && hit.selected },
+];
+
+export class ContextMenuDialog {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        this._registerActor();
+        const document = window.document;
+        const menu = document.getElementById('contentAreaContextMenu');
+        if (!menu) return;
+        // Only en-US exists (fenix.ftl); optional, so other UI locales don't
+        // lose their bundle over it.
+        document.l10n.addResourceIds([{ path: 'browser/mobileconfig/fenix.ftl', optional: true }]);
+
+        // Added after the menu's onpopupshowing attribute, so this runs once
+        // nsContextMenu has set up the desktop items.
+        menu.addEventListener('popupshowing', (event) => {
+            if (event.target !== menu) return;
+            menu.removeAttribute('mcf-dialog');
+            if (event.defaultPrevented || !window.gContextMenu) return;
+            if (window.innerWidth > MOBILE_MAX_WIDTH) return;
+            if (!this._arrange(window, menu)) {
+                // Fenix shows no menu when no item applies.
+                event.preventDefault();
+                return;
+            }
+            menu.setAttribute('mcf-dialog', 'true');
+            this._center(window, menu, false);
+        });
+        menu.addEventListener('popupshown', (event) => {
+            if (event.target === menu && menu.hasAttribute('mcf-dialog')) {
+                this._center(window, menu, true);
+            }
+        });
+        menu.addEventListener('popuphidden', (event) => {
+            if (event.target !== menu) return;
+            menu.removeAttribute('mcf-dialog');
+            for (const node of menu.querySelectorAll('[mcf-item]')) {
+                node.removeAttribute('mcf-item');
+                node.style.removeProperty('order');
+                this._restoreLabel(document, node);
+            }
+        });
+    }
+
+    // The content side (McfContextMenuChild.sys.mjs), registered once, with
+    // the first browser window.
+    _registerActor() {
+        if (this._actorRegistered) return;
+        this._actorRegistered = true;
+        try {
+            ChromeUtils.registerWindowActor('McfContextMenu', {
+                child: {
+                    esModuleURI: 'chrome://mobileconfigfirefox/content/McfContextMenuChild.sys.mjs',
+                    events: {
+                        contextmenu: { mozSystemGroup: true },
+                    },
+                },
+                allFrames: true,
+                messageManagerGroups: ['browsers'],
+                // Web pages run in such processes; the child only clears a
+                // selection it caused and talks to no parent.
+                safeForUntrustedWebProcess: true,
+            });
+        } catch (e) {
+            console.error('McfContextMenu actor failed to register:', e);
+        }
+    }
+
+    // What was long-pressed, in Fenix's HitResult terms.
+    _hit(window, context) {
+        const link = context.onLink ? (context.linkURL || '') : '';
+        const video = !!context.onVideo;
+        const audio = !!context.onAudio;
+        const media = video || audio;
+        // GeckoView reports a video or audio element as such even inside a
+        // link (GeckoEngineSession.handleLongClick()).
+        const uri = !!link && !media;
+        return {
+            link,
+            uri,
+            httpLink: uri && link.startsWith('http'),
+            mailto: uri && link.startsWith('mailto:'),
+            linkText: uri ? (context.linkTextStr || '').trim() : '',
+            image: !!context.onImage && !!context.mediaURL,
+            video,
+            audio,
+            media,
+            mediaURL: context.mediaURL || '',
+            selected: !!context.isTextSelected,
+            editable: !!context.onEditable,
+            isPrivate: PrivateBrowsingUtils.isWindowPrivate(window),
+        };
+    }
+
+    // Shows the Fenix items in Fenix's order. Returns false if there's none.
+    _arrange(window, menu) {
+        const document = window.document;
+        const context = window.gContextMenu;
+        const hit = this._hit(window, context);
+        const english = Services.locale.appLocaleAsBCP47.startsWith('en');
+
+        let title = '';
+        let items = LINK_ITEMS.filter(item => item.when(hit));
+        if (items.length) {
+            // HitResult.getLink(): the link, else the image or media source.
+            title = hit.uri ? hit.link : hit.mediaURL;
+        } else if (hit.selected || hit.editable) {
+            items = SELECTION_ITEMS.filter(item => item.when(hit));
+        }
+
+        let order = 1;
+        let shown = 0;
+        for (const item of items) {
+            let node = document.getElementById(item.id);
+            if (item.copy) {
+                node = this._customItem(window, menu, item.id, () => item.copy(this._hit(window, window.gContextMenu)));
+            } else if (!node || node.hidden || node.disabled) {
+                // Firefox has nothing to do here (e.g. no clipboard
+                // contents to paste).
+                continue;
+            }
+            node.setAttribute('mcf-item', 'true');
+            node.style.order = order++;
+            if (item.l10n && (english || item.copy)) {
+                this._setLabel(document, node, item.l10n);
+            }
+            shown++;
+        }
+        if (!shown) return false;
+
+        // The inspector stays available when asked for (mcf.contextmenu.showInspector).
+        if (Services.prefs.getBoolPref('mcf.contextmenu.showInspector', false)) {
+            const inspect = document.getElementById('context-inspect');
+            if (inspect && !inspect.hidden) {
+                inspect.setAttribute('mcf-item', 'true');
+                inspect.style.order = order++;
+            }
+        }
+
+        let titleNode = menu.querySelector(':scope > .mcf-context-title');
+        if (!titleNode) {
+            titleNode = document.createElement('div');
+            titleNode.className = 'mcf-context-title';
+            // Tap the title to read all of it (ContextMenuFragment:
+            // EXPANDED_TITLE_MAX_LINES).
+            titleNode.addEventListener('click', (event) => {
+                titleNode.toggleAttribute('expanded', true);
+                event.stopPropagation();
+            });
+            menu.prepend(titleNode);
+        }
+        titleNode.textContent = title;
+        titleNode.removeAttribute('expanded');
+        titleNode.toggleAttribute('mcf-item', !!title);
+        titleNode.style.order = 0;
+        return true;
+    }
+
+    _customItem(window, menu, id, value) {
+        const document = window.document;
+        let node = document.getElementById(id);
+        if (!node) {
+            node = document.createXULElement('menuitem');
+            node.id = id;
+            node.addEventListener('command', () => {
+                const text = node._mcfValue?.();
+                if (text) {
+                    Cc['@mozilla.org/widget/clipboardhelper;1']
+                        .getService(Ci.nsIClipboardHelper)
+                        .copyString(text);
+                }
+            });
+            menu.append(node);
+        }
+        node._mcfValue = value;
+        return node;
+    }
+
+    // Swaps in the Fenix label for this menu only; desktop's comes back when
+    // the menu closes.
+    _setLabel(document, node, l10nId) {
+        if (!node.hasAttribute('mcf-desktop-l10n-id')) {
+            node.setAttribute('mcf-desktop-l10n-id', node.getAttribute('data-l10n-id') || '');
+            const args = node.getAttribute('data-l10n-args');
+            if (args) node.setAttribute('mcf-desktop-l10n-args', args);
+        }
+        document.l10n.setAttributes(node, l10nId);
+    }
+
+    _restoreLabel(document, node) {
+        if (!node.hasAttribute('mcf-desktop-l10n-id')) return;
+        const id = node.getAttribute('mcf-desktop-l10n-id');
+        const args = node.getAttribute('mcf-desktop-l10n-args');
+        node.removeAttribute('mcf-desktop-l10n-id');
+        node.removeAttribute('mcf-desktop-l10n-args');
+        if (id) {
+            document.l10n.setAttributes(node, id, args ? JSON.parse(args) : undefined);
+        } else {
+            // Firefox labels this one itself (e.g. "Search <engine> for
+            // <text>"), every time the menu opens.
+            node.removeAttribute('data-l10n-id');
+            node.removeAttribute('data-l10n-args');
+        }
+    }
+
+    // Centres the dialog in the window. When showing, its height isn't known
+    // yet, so it's estimated from the rows and corrected once shown.
+    _center(window, menu, measured) {
+        const rows = [...menu.children].filter(node => node.hasAttribute('mcf-item')).length;
+        let height = rows * 48 + 16;
+        let width = window.innerWidth - 48;
+        if (measured) {
+            // The popup's own size; its screen position may still be stale.
+            const rect = menu.getBoundingClientRect();
+            if (!rect.height) return;
+            height = rect.height;
+            width = rect.width;
+        }
+        const x = window.mozInnerScreenX + (window.innerWidth - width) / 2;
+        const y = window.mozInnerScreenY + Math.max(0, (window.innerHeight - height) / 2);
+        if (measured) {
+            const rect = menu.getOuterScreenRect();
+            if (Math.abs(rect.x - x) < 2 && Math.abs(rect.y - y) < 2) return;
+        }
+        menu.moveTo(Math.round(x), Math.round(y));
+    }
+}
diff --git a/src/modules/ExtensionPopupPage.sys.mjs b/src/modules/ExtensionPopupPage.sys.mjs
new file mode 100644
index 0000000..59c2848
--- /dev/null
+++ b/src/modules/ExtensionPopupPage.sys.mjs
@@ -0,0 +1,121 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Shows extension (browser action) popups the way Firefox for Android does.
+ *
+ * Fenix opens an extension popup as a full-screen page
+ * (fenix/.../addons/WebExtensionActionPopupFragment.kt) under an app bar
+ * with a back arrow and the extension's name (showToolbar(title), title =
+ * WebExtensionState.name, HomeActivity.kt openPopup()). Back closes it.
+ *
+ * Here the popup stays a panel anchored to its toolbar button, so tapping
+ * the button again still closes it, but popups.css makes it fill all the
+ * space above (or below) the toolbar and this module adds the app bar.
+ *
+ * The panel is as tall as --mcf-popup-space, which is kept equal to the
+ * space between the anchor and the window edge. It's updated on every
+ * window resize, so the popup follows the on-screen keyboard opening and
+ * closing. Before this, the popup browser was pinned to the height the
+ * extension page measured when it last changed, so a popup measured while
+ * the keyboard was up stayed cut off after the keyboard closed.
+ */
+export class ExtensionPopupPage {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+
+        // Extension popups live in this panel (created per popup by
+        // CustomizableUI) whether they were opened from a toolbar button or
+        // from the extensions panel.
+        const popupPanel = () => document.getElementById('customizationui-widget-panel');
+
+        const updateSpace = (panel) => {
+            const anchor = panel.anchorNode;
+            if (!anchor) return;
+            const rect = anchor.getBoundingClientRect();
+            const space = Math.max(rect.top, window.innerHeight - rect.bottom);
+            panel.style.setProperty('--mcf-popup-space', `${Math.floor(space)}px`);
+        };
+
+        // ViewShowing bubbles from the panelview before the panel is shown,
+        // so the app bar is there on the first frame.
+        document.addEventListener('ViewShowing', (event) => {
+            const view = event.target;
+            if (view.localName !== 'panelview' || !view.hasAttribute('extension')) return;
+            this._addAppBar(window, view);
+            const panel = view.closest('panel');
+            if (panel) updateSpace(panel);
+        }, true);
+
+        document.addEventListener('popupshowing', (event) => {
+            if (event.target === popupPanel()) updateSpace(event.target);
+        }, true);
+
+        // Keyboard shown or hidden, rotation, any other window resize.
+        window.addEventListener('resize', () => {
+            const panel = popupPanel();
+            if (panel && panel.state !== 'closed') updateSpace(panel);
+        });
+    }
+
+    _addAppBar(window, view) {
+        const document = window.document;
+        let bar = view.querySelector(':scope > .mcf-popup-header');
+        if (!bar) {
+            bar = document.createXULElement('box');
+            bar.className = 'mcf-popup-header';
+
+            const back = document.createXULElement('toolbarbutton');
+            back.className = 'mcf-popup-back subviewbutton subviewbutton-iconic subviewbutton-back';
+            back.setAttribute('closemenu', 'none');
+            // Same label as the back button of Firefox's own panel subviews
+            // (PanelMultiView.sys.mjs createHeaderBackButton()).
+            back.setAttribute('aria-label', Services.strings
+                .createBundle('chrome://browser/locale/browser.properties')
+                .GetStringFromName('panel.back'));
+            back.addEventListener('command', () => {
+                window.CustomizableUI.hidePanelForNode(view);
+            });
+
+            const title = document.createElement('h1');
+            title.className = 'mcf-popup-title';
+
+            bar.append(back, title);
+            // ExtensionPopups.sys.mjs appends the popup browser to the view
+            // when it opens and removes it when it closes; keep the bar first.
+            view.prepend(bar);
+        }
+
+        bar.querySelector('.mcf-popup-title').textContent = this._extensionName(view);
+    }
+
+    _extensionName(view) {
+        // The view is "PanelUI-webext-<id>-BAV" and its widget
+        // "<id>-browser-action" (ext-browserAction.js); the widget's action
+        // button carries the extension id.
+        const widgetId = view.id.replace(/^PanelUI-webext-/, '').replace(/-BAV$/, '-browser-action');
+        const id = view.ownerDocument.getElementById(widgetId)
+            ?.querySelector('[data-extensionid]')?.getAttribute('data-extensionid');
+        const policy = (id && WebExtensionPolicy.getByID(id)) ||
+            // Widget ids are makeWidgetId(extension id) (ExtensionCommon.sys.mjs).
+            WebExtensionPolicy.getActiveExtensions().find(p =>
+                `${p.id.toLowerCase().replace(/[^a-z0-9_-]/g, '_')}-browser-action` === widgetId);
+        return policy?.name || id || '';
+    }
+}
diff --git a/src/modules/FenixDialogs.sys.mjs b/src/modules/FenixDialogs.sys.mjs
new file mode 100644
index 0000000..9e18675
--- /dev/null
+++ b/src/modules/FenixDialogs.sys.mjs
@@ -0,0 +1,252 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Fenix-style dialogs and snackbars drawn inside the browser window (an HTML
+ * layer over the page), for the places where Firefox for Android shows an
+ * Android dialog or snackbar and desktop Firefox shows a panel, a window or
+ * nothing at all. Styled in themes/shared/chrome/dialogs.css.
+ *
+ * Dialog: MaterialAlertDialogBuilder dialogs (material 3): 24dp from the
+ * window sides, 28dp corners, 24dp padding, title 24sp, message 14sp, text
+ * buttons at the end (Cancel, then the positive one); choice lists are rows
+ * of 48dp with a radio button or check box at the end
+ * (mozac_feature_*_choice_item.xml, listPreferredItemHeightSmall).
+ * Snackbar: mozilla.components.compose.base.snackbar.Snackbar: 12dp from
+ * the window sides and above the toolbar, message 2 lines max, optional
+ * sub message (1 line) and an action; shown 3 s, 5 s with an action
+ * (SnackbarUtils.kt DEFAULT_SNACKBAR_TIMEOUT / ..._WITH_ACTION_TIMEOUT).
+ */
+
+const XHTML = 'http://www.w3.org/1999/xhtml';
+
+// Mobile layout only, like mcf's other layout changes.
+export const MOBILE_MAX_WIDTH = 700;
+
+export const isMobileLayout = (win) => win.innerWidth <= MOBILE_MAX_WIDTH;
+
+const make = (doc, tag, className, text) => {
+    const node = doc.createElementNS(XHTML, tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+};
+
+export const FenixDialogs = {
+    // Dialogs of a window show one after the other.
+    _queue: new WeakMap(),
+
+    /**
+     * Shows a dialog. Resolves with { button, checked, selected }: `button`
+     * is the id of the tapped button or null if it was dismissed, `selected`
+     * the indexes of the checked `items` (for a single choice, the tapped
+     * one, which also closes the dialog).
+     *
+     * opts: {
+     *   title, message, icon (css class of the icon), gravity: 'center' |
+     *   'bottom', items: [{ label, selected, disabled, header, separator }],
+     *   multiple, buttons: [{ id, label, primary, outlined }], center
+     *   (centered buttons), checkbox: { label, checked }, className,
+     *   delay (ms before the primary button reacts)
+     * }
+     */
+    dialog(win, opts) {
+        const previous = this._queue.get(win) || Promise.resolve();
+        const next = previous.then(() => this._show(win, opts), () => this._show(win, opts));
+        this._queue.set(win, next.catch(() => {}));
+        return next;
+    },
+
+    _show(win, opts) {
+        return new Promise((resolve) => {
+            const doc = win.document;
+            const layer = make(doc, 'div', 'mcf-fx-layer');
+            layer.setAttribute('gravity', opts.gravity || 'center');
+            if (opts.className) layer.classList.add(opts.className);
+            const scrim = make(doc, 'div', 'mcf-fx-scrim');
+            const dialog = make(doc, 'div', 'mcf-fx-dialog');
+            dialog.setAttribute('role', 'dialog');
+            layer.append(scrim, dialog);
+
+            const result = { button: null, checked: false, selected: [] };
+            let closed = false;
+            const close = () => {
+                if (closed) return;
+                closed = true;
+                doc.removeEventListener('keydown', onKey, true);
+                layer.remove();
+                resolve(result);
+            };
+            const onKey = (event) => {
+                if (event.key === 'Escape') {
+                    event.preventDefault();
+                    event.stopPropagation();
+                    close();
+                }
+            };
+            doc.addEventListener('keydown', onKey, true);
+            scrim.addEventListener('click', close);
+
+            const head = make(doc, 'div', 'mcf-fx-head');
+            if (opts.icon) head.append(make(doc, 'div', 'mcf-fx-icon ' + opts.icon));
+            if (opts.title) head.append(make(doc, 'div', 'mcf-fx-title', opts.title));
+            if (head.childNodes.length) dialog.append(head);
+            if (opts.message) dialog.append(make(doc, 'div', 'mcf-fx-message', opts.message));
+
+            let list = null;
+            if (opts.items) {
+                list = make(doc, 'div', 'mcf-fx-list');
+                list.setAttribute('role', opts.multiple ? 'listbox' : 'radiogroup');
+                const picked = new Set();
+                opts.items.forEach((item, index) => {
+                    if (item.separator) {
+                        list.append(make(doc, 'div', 'mcf-fx-separator'));
+                        return;
+                    }
+                    const row = make(doc, 'div', 'mcf-fx-row');
+                    row.append(make(doc, 'span', 'mcf-fx-label', item.label));
+                    if (item.header) {
+                        row.classList.add('mcf-fx-group');
+                    } else {
+                        if (item.indent) row.setAttribute('indent', item.indent);
+                        const mark = make(doc, 'span', 'mcf-fx-mark');
+                        mark.setAttribute('kind', opts.multiple ? 'check' : 'radio');
+                        row.append(mark);
+                        if (item.disabled) row.setAttribute('disabled', 'true');
+                        if (item.selected) {
+                            picked.add(index);
+                            row.setAttribute('checked', 'true');
+                        }
+                        row.setAttribute('role', opts.multiple ? 'option' : 'radio');
+                        row.setAttribute('aria-checked', item.selected ? 'true' : 'false');
+                        if (!item.disabled) {
+                            row.addEventListener('click', () => {
+                                if (opts.multiple) {
+                                    const on = !picked.has(index);
+                                    if (on) picked.add(index); else picked.delete(index);
+                                    row.toggleAttribute('checked', on);
+                                    row.setAttribute('aria-checked', on ? 'true' : 'false');
+                                    result.selected = [...picked].sort((a, b) => a - b);
+                                } else {
+                                    result.selected = [index];
+                                    result.button = 'select';
+                                    close();
+                                }
+                            });
+                        }
+                    }
+                    list.append(row);
+                });
+                result.selected = [...picked].sort((a, b) => a - b);
+                dialog.append(list);
+            }
+
+            let box = null;
+            if (opts.checkbox) {
+                const label = make(doc, 'div', 'mcf-fx-check');
+                box = make(doc, 'span', 'mcf-fx-mark');
+                box.setAttribute('kind', 'check');
+                result.checked = !!opts.checkbox.checked;
+                box.toggleAttribute('checked', result.checked);
+                label.append(box, make(doc, 'span', 'mcf-fx-label', opts.checkbox.label));
+                label.addEventListener('click', () => {
+                    result.checked = !result.checked;
+                    box.toggleAttribute('checked', result.checked);
+                });
+                dialog.append(label);
+            }
+
+            if (opts.buttons?.length) {
+                const row = make(doc, 'div', 'mcf-fx-buttons');
+                if (opts.center) row.setAttribute('center', 'true');
+                const shownAt = Date.now();
+                for (const spec of opts.buttons) {
+                    const button = make(doc, 'button', 'mcf-fx-button', spec.label);
+                    button.id = 'mcf-fx-button-' + spec.id;
+                    if (spec.primary) button.setAttribute('primary', 'true');
+                    if (spec.outlined) button.setAttribute('outlined', 'true');
+                    button.addEventListener('click', () => {
+                        // Prompt abuse guard (PromptAbuserDetector): a tap
+                        // right after the dialog appears isn't an answer.
+                        if (spec.primary && opts.delay && Date.now() - shownAt < opts.delay) return;
+                        result.button = spec.id;
+                        close();
+                    });
+                    row.append(button);
+                }
+                dialog.append(row);
+            }
+
+            doc.documentElement.append(layer);
+            // Scroll the (first) selected choice into view, like the
+            // RecyclerView's scrollToPosition().
+            list?.querySelector('[checked]')?.scrollIntoView({ block: 'center' });
+            win.addEventListener('unload', close, { once: true });
+        });
+    },
+
+    /**
+     * Shows a snackbar, replacing the one shown. opts: { text, subText,
+     * actionLabel, onAction, duration (ms; 0 = until dismissed),
+     * dismissable (a close button) }.
+     */
+    snackbar(win, opts) {
+        const doc = win.document;
+        this.dismissSnackbar(win);
+        const bar = make(doc, 'div', 'mcf-fx-snackbar');
+        bar.setAttribute('role', 'status');
+        const body = make(doc, 'div', 'mcf-fx-snackbar-body');
+        body.append(make(doc, 'div', 'mcf-fx-snackbar-text', opts.text));
+        if (opts.subText) body.append(make(doc, 'div', 'mcf-fx-snackbar-sub', opts.subText));
+        bar.append(body);
+
+        let timer = null;
+        const close = () => {
+            if (timer) win.clearTimeout(timer);
+            bar.remove();
+            if (win.mcfSnackbar === bar) win.mcfSnackbar = null;
+        };
+        if (opts.actionLabel) {
+            const action = make(doc, 'button', 'mcf-fx-snackbar-action', opts.actionLabel);
+            action.addEventListener('click', () => {
+                close();
+                try { opts.onAction?.(); } catch (e) { console.error(e); }
+            });
+            bar.append(action);
+        }
+        if (opts.dismissable) {
+            const x = make(doc, 'button', 'mcf-fx-snackbar-dismiss');
+            x.setAttribute('aria-label', 'Dismiss');
+            x.addEventListener('click', close);
+            bar.append(x);
+        }
+
+        // Above a bottom toolbar (the snackbar is anchored to it in Fenix).
+        const toolbox = doc.getElementById('navigator-toolbox');
+        let bottom = 0;
+        if (toolbox) {
+            const rect = toolbox.getBoundingClientRect();
+            if (rect.top > win.innerHeight / 2) bottom = Math.max(0, win.innerHeight - rect.top);
+        }
+        bar.style.bottom = bottom + 'px';
+
+        // Swipe sideways to dismiss (SwipeToDismissBox).
+        let startX = null;
+        bar.addEventListener('pointerdown', (event) => { startX = event.clientX; });
+        bar.addEventListener('pointerup', (event) => {
+            if (startX !== null && Math.abs(event.clientX - startX) > 60) close();
+            startX = null;
+        });
+
+        doc.documentElement.append(bar);
+        win.mcfSnackbar = bar;
+        const duration = opts.duration ?? (opts.actionLabel ? 5000 : 3000);
+        if (duration) timer = win.setTimeout(close, duration);
+        return close;
+    },
+
+    dismissSnackbar(win) {
+        win.mcfSnackbar?.remove();
+        win.mcfSnackbar = null;
+    },
+};
diff --git a/src/modules/FenixDownloads.sys.mjs b/src/modules/FenixDownloads.sys.mjs
new file mode 100644
index 0000000..e1dcef4
--- /dev/null
+++ b/src/modules/FenixDownloads.sys.mjs
@@ -0,0 +1,162 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Downloads like Firefox for Android:
+ *
+ * - A download a page starts asks first: "Download file? (85.7 MB)", the
+ *   file name as the message, Cancel / Download (BaseBrowserFragment.kt
+ *   showFirstPartyDownloadDialog(), strings of mozac_feature_downloads:
+ *   mozac_feature_downloads_dialog_title_3 / _title_with_unknown_size,
+ *   _dialog_cancel, _dialog_download). Desktop saves without asking, so
+ *   this wraps the helper app dialog's promptForSaveToFileAsync(), which
+ *   runs for every such download.
+ * - Snackbars instead of the downloads panel and its arrow animation
+ *   (SnackbarBinding.kt): "Download in progress..." with Details when one
+ *   starts, "Download completed" with the file name and Open when it
+ *   succeeds, "Download failed" with the file name and Details (until
+ *   dismissed). Details opens the downloads list.
+ */
+
+import { FenixDialogs, isMobileLayout } from 'chrome://mobileconfigfirefox/content/FenixDialogs.sys.mjs';
+
+const { Downloads } = ChromeUtils.importESModule('resource://gre/modules/Downloads.sys.mjs');
+
+// Android's Formatter.formatFileSize() (DefaultFileSizeFormatter): 1000-based,
+// "kB", two decimals.
+function formatSize(bytes) {
+    const units = ['B', 'kB', 'MB', 'GB', 'TB'];
+    let value = bytes;
+    let unit = 0;
+    while (value >= 1000 && unit < units.length - 1) {
+        value /= 1000;
+        unit++;
+    }
+    return value.toFixed(unit === 0 ? 0 : 2) + ' ' + units[unit];
+}
+
+const windowFor = () => {
+    const win = Services.wm.getMostRecentWindow('navigator:browser');
+    return win && !win.closed ? win : null;
+};
+
+export class FenixDownloads {
+    init() {
+        this._patchHelperAppDialog();
+        this._watchDownloads();
+    }
+
+    _patchHelperAppDialog() {
+        try {
+            const { nsUnknownContentTypeDialog } = ChromeUtils.importESModule(
+                'resource://gre/modules/HelperAppDlg.sys.mjs');
+            const proto = nsUnknownContentTypeDialog.prototype;
+            if (proto._mcfPatched) return;
+            proto._mcfPatched = true;
+            const original = proto.promptForSaveToFileAsync;
+            proto.promptForSaveToFileAsync = function (launcher, context, defaultName, extension, forcePrompt) {
+                const args = arguments;
+                let win = null;
+                try {
+                    win = context.getInterface(Ci.nsIDOMWindow)
+                        .docShell.browsingContext.topChromeWindow;
+                } catch (e) {
+                    // No window to show in: let desktop handle it.
+                }
+                if (!win || win.closed || !win.document.getElementById('navigator-toolbox') ||
+                    !isMobileLayout(win) || forcePrompt) {
+                    return original.apply(this, args);
+                }
+                let size = -1;
+                try { size = launcher.contentLength; } catch (e) { /* unknown */ }
+                const title = size > 0
+                    ? `Download file? (${formatSize(size)})`
+                    : 'Download file?';
+                FenixDialogs.dialog(win, {
+                    title,
+                    message: defaultName,
+                    buttons: [
+                        { id: 'cancel', label: 'Cancel' },
+                        { id: 'download', label: 'Download', primary: true },
+                    ],
+                }).then((result) => {
+                    if (result.button === 'download') {
+                        original.apply(this, args);
+                    } else {
+                        // Cancelled, or dismissed (onCancelListener).
+                        launcher.saveDestinationAvailable(null);
+                    }
+                });
+                return undefined;
+            };
+        } catch (e) {
+            console.error('FenixDownloads: HelperAppDlg patch failed:', e);
+        }
+    }
+
+    async _watchDownloads() {
+        try {
+            const list = await Downloads.getList(Downloads.ALL);
+            const known = new WeakSet();
+            const finished = new WeakSet();
+            const details = (win) => () => {
+                win.openTrustedLinkIn('about:downloads', 'tab');
+            };
+            await list.addView({
+                onDownloadAdded: (download) => {
+                    known.add(download);
+                    // Downloads of earlier sessions.
+                    if (download.stopped) {
+                        finished.add(download);
+                        return;
+                    }
+                    const win = windowFor();
+                    if (!win || !isMobileLayout(win)) return;
+                    FenixDialogs.snackbar(win, {
+                        text: 'Download in progress…',
+                        actionLabel: 'Details',
+                        onAction: details(win),
+                    });
+                },
+                onDownloadChanged: (download) => {
+                    if (!download.stopped || finished.has(download)) return;
+                    const win = windowFor();
+                    if (download.succeeded) {
+                        finished.add(download);
+                        if (!win || !isMobileLayout(win)) return;
+                        const name = download.target.path.split('/').pop();
+                        FenixDialogs.snackbar(win, {
+                            text: 'Download completed',
+                            subText: name,
+                            actionLabel: 'Open',
+                            onAction: () => {
+                                download.launch().catch(() => {
+                                    FenixDialogs.snackbar(win, { text: 'Could not open file' });
+                                });
+                            },
+                        });
+                    } else if (download.error) {
+                        finished.add(download);
+                        if (!win || !isMobileLayout(win)) return;
+                        FenixDialogs.snackbar(win, {
+                            text: 'Download failed',
+                            subText: download.target.path?.split('/').pop(),
+                            actionLabel: 'Details',
+                            onAction: details(win),
+                            duration: 0,
+                            dismissable: true,
+                        });
+                    } else if (download.canceled) {
+                        // DownloadSnackbar.kt: a cancelled download takes its
+                        // "in progress" snackbar away.
+                        finished.add(download);
+                        if (win) FenixDialogs.dismissSnackbar(win);
+                    }
+                },
+                onDownloadRemoved: () => {},
+            });
+        } catch (e) {
+            console.error('FenixDownloads: watching downloads failed:', e);
+        }
+    }
+}
diff --git a/src/modules/FenixSnackbars.sys.mjs b/src/modules/FenixSnackbars.sys.mjs
new file mode 100644
index 0000000..3701391
--- /dev/null
+++ b/src/modules/FenixSnackbars.sys.mjs
@@ -0,0 +1,143 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Snackbars for the transient confirmations Firefox for Android shows as
+ * snackbars and desktop shows as a panel or not at all
+ * (fenix/.../snackbar/SnackbarBinding.kt, android-components
+ * feature/contextmenu strings):
+ *
+ * - Bookmark page: saves at once and says "Saved in "Bookmarks"" with EDIT
+ *   (showBookmarkAddedSnackbarFor(); desktop opens the edit panel instead).
+ *   Fenix's own bookmarks live in the "mobile" root, shown as "Bookmarks"
+ *   (friendlyRootTitle()).
+ * - Closing a tab: "Tab closed" with UNDO (SnackbarState.CurrentTabClosed,
+ *   snackbar_tab_closed / snackbar_private_tab_closed / snackbar_deleted_undo).
+ * - Context menu: "New tab opened" with Switch, "New private tab opened",
+ *   "Link copied to clipboard", "Link text copied to clipboard", "Email
+ *   address copied to clipboard" (ContextMenuCandidate, mozac_feature_
+ *   contextmenu_snackbar_*).
+ */
+
+import { FenixDialogs, isMobileLayout } from 'chrome://mobileconfigfirefox/content/FenixDialogs.sys.mjs';
+
+const { PrivateBrowsingUtils } = ChromeUtils.importESModule(
+    'resource://gre/modules/PrivateBrowsingUtils.sys.mjs'
+);
+const { PlacesUtils } = ChromeUtils.importESModule(
+    'resource://gre/modules/PlacesUtils.sys.mjs'
+);
+
+// Context menu items and what Fenix says after them.
+const CONTEXT_MESSAGES = {
+    'mcf-context-copylink': 'Link copied to clipboard',
+    'mcf-context-copylinktext': 'Link text copied to clipboard',
+    'context-copyemail': 'Email address copied to clipboard',
+    'context-copyimage': 'Link copied to clipboard',
+};
+
+export class FenixSnackbars {
+    init() {
+        Services.obs.addObserver({
+            observe: (subject, topic) => {
+                if (topic !== 'domwindowopened') return;
+                const window = subject;
+                window.addEventListener('load', () => {
+                    if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                    this._setupForWindow(window);
+                }, { once: true });
+            },
+        }, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+
+        // Closing a tab. Not when the window closes or the tab moves to
+        // another window.
+        window.addEventListener('TabClose', (event) => {
+            if (!isMobileLayout(window) || event.detail?.isWindowClosing || event.detail?.adoptedBy) return;
+            if (window.gBrowser._removingTabs?.size > 1 || window.closed) return;
+            // Blank new tabs closing isn't news.
+            const isPrivate = PrivateBrowsingUtils.isWindowPrivate(window);
+            FenixDialogs.snackbar(window, {
+                text: isPrivate ? 'Private tab closed' : 'Tab closed',
+                actionLabel: isPrivate ? undefined : 'UNDO',
+                onAction: () => this._undoCloseTab(window),
+            });
+        });
+
+        // New tabs opened in the background by the context menu.
+        let lastOpened = null;
+        window.addEventListener('TabOpen', (event) => {
+            lastOpened = { tab: event.target, time: Date.now() };
+        });
+
+        document.addEventListener('command', (event) => {
+            const id = event.target?.id;
+            if (!id || !isMobileLayout(window)) return;
+            if (id === 'context-openlinkintab') {
+                // The tab opens right after this event.
+                window.setTimeout(() => {
+                    const tab = lastOpened && Date.now() - lastOpened.time < 1500 ? lastOpened.tab : null;
+                    FenixDialogs.snackbar(window, {
+                        text: 'New tab opened',
+                        actionLabel: tab ? 'Switch' : undefined,
+                        onAction: () => {
+                            if (tab && !tab.closing) window.gBrowser.selectedTab = tab;
+                        },
+                    });
+                }, 150);
+            } else if (id === 'context-openlinkprivate') {
+                FenixDialogs.snackbar(window, { text: 'New private tab opened' });
+            } else if (CONTEXT_MESSAGES[id]) {
+                FenixDialogs.snackbar(window, { text: CONTEXT_MESSAGES[id] });
+            }
+        }, true);
+    }
+
+    // undoCloseTab() moved from the window to SessionWindowUI.
+    _undoCloseTab(window) {
+        if (typeof window.undoCloseTab === 'function') {
+            window.undoCloseTab();
+            return;
+        }
+        try {
+            const { SessionWindowUI } = ChromeUtils.importESModule(
+                'resource:///modules/sessionstore/SessionWindowUI.sys.mjs');
+            SessionWindowUI.undoCloseTab(window);
+        } catch (e) {
+            window.SessionStore.undoCloseTab(window, 0);
+        }
+    }
+
+    /**
+     * "Bookmark page" of the app menu: saves the page and shows the
+     * snackbar; an already bookmarked page opens the editor (Fenix: "Edit
+     * bookmark").
+     */
+    static async bookmarkPage(window) {
+        const url = window.gBrowser.currentURI.spec;
+        const title = window.gBrowser.contentTitle || url;
+        try {
+            const existing = await PlacesUtils.bookmarks.fetch({ url });
+            if (existing) {
+                window.PlacesCommandHook.bookmarkPage();
+                return;
+            }
+            await PlacesUtils.bookmarks.insert({
+                parentGuid: PlacesUtils.bookmarks.mobileGuid,
+                url,
+                title,
+            });
+        } catch (e) {
+            FenixDialogs.snackbar(window, { text: 'Invalid URL' });
+            return;
+        }
+        FenixDialogs.snackbar(window, {
+            text: 'Saved in “Bookmarks”',
+            actionLabel: 'EDIT',
+            onAction: () => window.PlacesCommandHook.bookmarkPage(),
+        });
+    }
+}
diff --git a/src/modules/FindBar.sys.mjs b/src/modules/FindBar.sys.mjs
new file mode 100644
index 0000000..3abcc22
--- /dev/null
+++ b/src/modules/FindBar.sys.mjs
@@ -0,0 +1,161 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Find in page like Firefox for Android.
+ *
+ * Desktop's <findbar> still does the finding; this makes it behave like
+ * Fenix's FindInPageBar (android-components feature/findinpage,
+ * mozac_feature_findinpage_view.xml and fenix component_find_in_page_bar.xml,
+ * FindInPageIntegration.kt):
+ *
+ * - 56 dp bar at the bottom of the window with the query field, the result
+ *   count, previous, next and close (styling in findbar.css).
+ * - The toolbar goes away while the bar is open (FindInPageIntegration
+ *   .launch(): toolbarsHideCallback), and comes back when it closes.
+ * - The count reads "%1$d/%2$d" (mozac_feature_findindpage_result): the
+ *   position is 0 without matches, in the error colour; it is empty while the
+ *   query is empty (FindInPageBar.displayResult()/onQueryChange()).
+ * - Previous and next take the focus (and so the keyboard) off the field
+ *   (FindInPageInteractor.onPreviousResult()/onNextResult()).
+ * - Closing clears the query (FindInPageBar.clear()), and so does navigating
+ *   to another page or going full screen (BaseBrowserFragment
+ *   .closeFindInPageBarOnNavigation()/fullScreenChanged()).
+ *
+ * Mobile layout only, like mcf's other layout changes (max-width: 700px).
+ */
+
+const MOBILE_MAX_WIDTH = 700;
+
+// mozac_feature_findindpage_input / _previous_result / _next_result / _dismiss
+const HINT = 'Find in page';
+const PREVIOUS = 'Find previous result';
+const NEXT = 'Find next result';
+const DISMISS = 'Dismiss find in page';
+
+export class FindBar {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+        const root = document.documentElement;
+        const mobile = () => window.innerWidth <= MOBILE_MAX_WIDTH;
+        const prepared = new WeakSet();
+
+        // Tells findbar.css to hide the toolbar: set while the selected tab's
+        // bar is open.
+        const refresh = () => {
+            const bar = window.gBrowser.getCachedFindBar?.(window.gBrowser.selectedTab);
+            root.toggleAttribute('mcf-findbar-open', !!bar && !bar.hidden && mobile());
+        };
+
+        const prepare = (bar) => {
+            if (prepared.has(bar)) return;
+            prepared.add(bar);
+
+            const field = bar.getElement('findbar-textbox');
+            const wrapper = bar.getElement('findbar-textbox-wrapper');
+            const previous = bar.getElement('find-previous');
+            const next = bar.getElement('find-next');
+            const close = bar.getElement('find-closebutton');
+            if (!field || !wrapper || !previous || !next) return;
+
+            field.setAttribute('placeholder', HINT);
+            field.setAttribute('type', 'search');
+            // textNoSuggestions
+            field.setAttribute('autocomplete', 'off');
+            field.setAttribute('autocorrect', 'off');
+            field.setAttribute('spellcheck', 'false');
+            previous.setAttribute('tooltiptext', PREVIOUS);
+            previous.setAttribute('aria-label', PREVIOUS);
+            next.setAttribute('tooltiptext', NEXT);
+            next.setAttribute('aria-label', NEXT);
+            close?.setAttribute('tooltiptext', DISMISS);
+            close?.setAttribute('aria-label', DISMISS);
+
+            const count = document.createElementNS('http://www.w3.org/1999/xhtml', 'span');
+            count.className = 'mcf-findbar-count';
+            count.setAttribute('aria-live', 'polite');
+            wrapper.insertBefore(count, previous);
+
+            const show = (current, total) => {
+                if (!field.value.trim()) {
+                    count.textContent = '';
+                    count.removeAttribute('nomatches');
+                    return;
+                }
+                const position = total > 0 ? current : 0;
+                count.textContent = `${position}/${total}`;
+                count.toggleAttribute('nomatches', total <= 0);
+            };
+
+            // FindInPageBar.displayResult()
+            const original = bar.onMatchesCountResult;
+            bar.onMatchesCountResult = function(result) {
+                original.call(this, result);
+                show(result.current, result.total);
+            };
+            field.addEventListener('input', () => {
+                if (!field.value.trim()) show(0, 0);
+            });
+
+            // FindInPageInteractor: the field gives up the focus.
+            const unfocus = () => field.blur();
+            previous.addEventListener('command', unfocus);
+            next.addEventListener('command', unfocus);
+        };
+
+        document.addEventListener('findbaropen', (event) => {
+            if (event.target.localName !== 'findbar') return;
+            prepare(event.target);
+            refresh();
+        });
+
+        document.addEventListener('findbarclose', (event) => {
+            if (event.target.localName !== 'findbar') return;
+            // FindInPageBar.clear()
+            const bar = event.target;
+            const field = bar.getElement('findbar-textbox');
+            if (field && mobile()) {
+                field.value = '';
+                bar.querySelector('.mcf-findbar-count')?.replaceChildren();
+            }
+            refresh();
+        });
+
+        window.gBrowser.tabContainer.addEventListener('TabSelect', refresh);
+        window.addEventListener('resize', refresh);
+
+        // closeFindInPageBarOnNavigation(): another page, not a fragment.
+        window.gBrowser.addTabsProgressListener({
+            onLocationChange(browser, webProgress, request, location, flags) {
+                if (!mobile() || !webProgress.isTopLevel) return;
+                if (flags & Ci.nsIWebProgressListener.LOCATION_CHANGE_SAME_DOCUMENT) return;
+                const tab = window.gBrowser.getTabForBrowser(browser);
+                const bar = tab && window.gBrowser.getCachedFindBar?.(tab);
+                if (bar && !bar.hidden) bar.close(true);
+            },
+        });
+
+        // fullScreenChanged()
+        window.addEventListener('fullscreen', () => {
+            if (!mobile() || !window.fullScreen) return;
+            const bar = window.gBrowser.getCachedFindBar?.(window.gBrowser.selectedTab);
+            if (bar && !bar.hidden) bar.close(true);
+        });
+    }
+}
diff --git a/src/modules/McfContextMenuChild.sys.mjs b/src/modules/McfContextMenuChild.sys.mjs
new file mode 100644
index 0000000..7ad522b
--- /dev/null
+++ b/src/modules/McfContextMenuChild.sys.mjs
@@ -0,0 +1,83 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Content side of ContextMenuDialog.sys.mjs: a long press on a link, image,
+ * video or audio opens the context menu without also selecting the word
+ * under the finger, like Firefox for Android.
+ *
+ * After a long tap, Gecko fires contextmenu and then, unless that was
+ * preventDefault()ed, eMouseLongTap, which selects the word under the finger
+ * (APZEventState::FireContextmenuEvents()). GeckoView prevents the event when
+ * it shows its menu. Doing that here would stop the selection too, but on
+ * Linux APZ takes "not prevented" to mean a menu opened
+ * (APZEventState::ProcessLongTap()), so the page would get a touchend instead
+ * of the touchcancel it gets on Android, and could act on it as a tap. So
+ * let the word be selected, and drop that selection before it's painted.
+ * Plain text keeps Gecko's long-press word selection.
+ */
+export class McfContextMenuChild extends JSWindowActorChild {
+    handleEvent(event) {
+        if (event.type !== 'contextmenu' || event.defaultPrevented) return;
+        // Only a long press: a mouse right-click doesn't select anything.
+        if (event.pointerType !== 'touch' && event.mozInputSource !== event.MOZ_SOURCE_TOUCH) return;
+        if (!this._onLinkOrMedia(event.composedTarget)) return;
+
+        const win = this.contentWindow;
+        const selection = win?.getSelection();
+        if (!selection) return;
+        // A long press inside an existing selection keeps it
+        // (AccessibleCaretManager::SelectWordOrShortcut()); only drop a
+        // selection this long press made.
+        const key = () => selection.isCollapsed ? null
+            : [selection.anchorNode, selection.anchorOffset, selection.focusNode, selection.focusOffset];
+        const before = key();
+        const changed = () => {
+            const now = key();
+            return now && (!before || now.some((value, i) => value !== before[i]));
+        };
+
+        // The word is selected by eMouseLongTap right after this event; APZ
+        // then sends the touchcancel that ends the long press, in the same
+        // task, so dropping the selection there happens before it's painted.
+        // selectionchange covers a selection that comes later than that.
+        const drop = () => {
+            if (changed()) {
+                selection.removeAllRanges();
+            }
+        };
+        const listeners = [
+            [win, 'touchcancel'], [win, 'touchend'], [win.document, 'selectionchange'],
+        ];
+        for (const [target, type] of listeners) {
+            target.addEventListener(type, drop, true);
+        }
+        // The long press is over by then; a selection made after that is the
+        // user's.
+        win.setTimeout(() => {
+            for (const [target, type] of listeners) {
+                target.removeEventListener(type, drop, true);
+            }
+        }, 1000);
+    }
+
+    // What ContextMenuChild reports as onLink, onImage, onVideo or onAudio.
+    _onLinkOrMedia(node) {
+        const HTML = 'http://www.w3.org/1999/xhtml';
+        const SVG = 'http://www.w3.org/2000/svg';
+        for (let element = node?.nodeType === node?.ELEMENT_NODE ? node : node?.parentElement;
+             element; element = element.flattenedTreeParentNode) {
+            if (element.nodeType !== element.ELEMENT_NODE) continue;
+            const name = element.localName;
+            if (element.namespaceURI === HTML &&
+                (((name === 'a' || name === 'area') && element.hasAttribute('href')) ||
+                 name === 'img' || name === 'video' || name === 'audio')) {
+                return true;
+            }
+            if (element.namespaceURI === SVG && name === 'a') {
+                return true;
+            }
+        }
+        return false;
+    }
+}
diff --git a/src/modules/McfScrollChild.sys.mjs b/src/modules/McfScrollChild.sys.mjs
new file mode 100644
index 0000000..79edab1
--- /dev/null
+++ b/src/modules/McfScrollChild.sys.mjs
@@ -0,0 +1,156 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Content side of PageScroll.sys.mjs. Reports to the browser window:
+ *
+ * - how far the page was scrolled (for the toolbar that hides on scroll),
+ *   at most once per frame, and whether a finger is down;
+ * - how far a finger has pulled down on a page that's scrolled to the top
+ *   (for pull to refresh).
+ *
+ * Everything is passive and nothing here touches the page, so APZ never
+ * waits on it and scrolling stays off the main thread.
+ */
+
+const PREF_HIDE = 'mcf.toolbar.hideOnScroll.enabled';
+const PREF_PULL = 'mcf.pullToRefresh.enabled';
+// AOSP ViewConfiguration TOUCH_SLOP, dp.
+const TOUCH_SLOP = 8;
+
+export class McfScrollChild extends JSWindowActorChild {
+    handleEvent(event) {
+        switch (event.type) {
+            case 'DOMWindowCreated':
+                this._attach();
+                break;
+            case 'scroll':
+                this._onScroll();
+                break;
+            case 'touchstart':
+                this._onTouchStart(event);
+                break;
+            case 'touchmove':
+                this._onTouchMove(event);
+                break;
+            case 'touchend':
+            case 'touchcancel':
+                this._onTouchEnd(event);
+                break;
+        }
+    }
+
+    _attach() {
+        const win = this.contentWindow;
+        if (!win || this._attached) return;
+        this._attached = true;
+        const opts = { passive: true, mozSystemGroup: true };
+        win.addEventListener('scroll', this, opts);
+        win.addEventListener('touchstart', this, { ...opts, capture: true });
+        win.addEventListener('touchmove', this, opts);
+        win.addEventListener('touchend', this, opts);
+        win.addEventListener('touchcancel', this, opts);
+    }
+
+    _pref(name) {
+        return Services.prefs.getBoolPref(name, true);
+    }
+
+    _top() {
+        const win = this.contentWindow;
+        const vv = win.visualViewport;
+        return Math.max(0, win.scrollY + (vv ? vv.offsetTop : 0));
+    }
+
+    // ---- hide on scroll ------------------------------------------------
+
+    _onScroll() {
+        const win = this.contentWindow;
+        if (!win || !this._pref(PREF_HIDE)) return;
+        if (this._raf) return;
+        this._raf = win.requestAnimationFrame(() => {
+            this._raf = 0;
+            const y = this._top();
+            // The first scroll may be the position being restored.
+            if (this._last === undefined) this._last = y;
+            const dy = y - this._last;
+            this._last = y;
+            if (dy || y === 0) this.sendAsyncMessage('McfScroll:Scroll', { dy, y });
+        });
+    }
+
+    // ---- touches -------------------------------------------------------
+
+    _onTouchStart(event) {
+        const win = this.contentWindow;
+        if (!win) return;
+        if (this._last === undefined) this._last = this._top();
+        if (event.touches.length === 1) {
+            this.sendAsyncMessage('McfScroll:Touch', { down: true });
+            this._pull = null;
+            if (this._pref(PREF_PULL) && !this._blocked(event.target)) {
+                const scale = win.visualViewport ? win.visualViewport.scale : 1;
+                this._pull = { scale, y: event.touches[0].clientY * scale, total: 0, active: false };
+            }
+        } else if (this._pull) {
+            this._finishPull(false);
+        }
+    }
+
+    _onTouchMove(event) {
+        const pull = this._pull;
+        if (!pull) return;
+        if (event.touches.length !== 1 || event.defaultPrevented) {
+            this._finishPull(false);
+            return;
+        }
+        const y = event.touches[0].clientY * pull.scale;
+        const dy = y - pull.y;
+        pull.y = y;
+        // SwipeRefreshLayout, nested scrolling: what the page can't scroll
+        // any further piles up as the pull, and pulling back eats it first.
+        if (dy > 0 && this._top() <= 0) pull.total += dy;
+        else if (dy < 0) pull.total = Math.max(0, pull.total + dy);
+        if (!pull.active && pull.total > 0) {
+            // A tap that wobbles isn't a pull.
+            if (pull.total < TOUCH_SLOP) return;
+            pull.active = true;
+        }
+        if (pull.active) this.sendAsyncMessage('McfScroll:Pull', { total: pull.total });
+    }
+
+    _onTouchEnd(event) {
+        if (event.touches.length > 0) return;
+        this.sendAsyncMessage('McfScroll:Touch', { down: false });
+        this._finishPull(event.type === 'touchend');
+    }
+
+    _finishPull(release) {
+        const pull = this._pull;
+        this._pull = null;
+        if (pull && pull.active) this.sendAsyncMessage('McfScroll:PullEnd', { total: pull.total, release });
+    }
+
+    /**
+     * Whether the page itself deals with a downward drag from `target`: a
+     * scroller around the touch is scrolled, or the page opts out of scroll chaining (overscroll-behavior), or of panning (touch-action).
+     */
+    _blocked(target) {
+        const win = this.contentWindow;
+        const doc = win.document;
+        const root = doc.scrollingElement || doc.documentElement;
+        const rootStyle = win.getComputedStyle(doc.documentElement);
+        const bodyStyle = doc.body ? win.getComputedStyle(doc.body) : rootStyle;
+        const stops = v => v === 'contain' || v === 'none';
+        if (stops(rootStyle.overscrollBehaviorY) || stops(bodyStyle.overscrollBehaviorY)) return true;
+        for (let el = target; el && el.nodeType === 1; el = el.parentElement || el.getRootNode()?.host) {
+            if (el === root || el === doc.body || el === doc.documentElement) break;
+            const style = win.getComputedStyle(el);
+            if (style.touchAction === 'none') return true;
+            if (/auto|scroll|overlay/.test(style.overflowY) && el.scrollHeight > el.clientHeight) {
+                if (el.scrollTop > 0 || stops(style.overscrollBehaviorY)) return true;
+            }
+        }
+        return false;
+    }
+}
diff --git a/src/modules/McfScrollParent.sys.mjs b/src/modules/McfScrollParent.sys.mjs
