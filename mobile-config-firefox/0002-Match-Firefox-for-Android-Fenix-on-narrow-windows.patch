+.mcf-tt-snack button { color: light-dark(#cb9eff, #592acb); font-weight: 500; height: 40px; padding: 0 12px; }
+`;
+
+const ICONS = {
+    close: 'chrome://global/skin/icons/close.svg',
+    plus: 'chrome://global/skin/icons/plus.svg',
+    more: 'chrome://global/skin/icons/more.svg',
+    mask: 'chrome://browser/skin/privateBrowsing.svg',
+    back: 'chrome://global/skin/icons/arrow-left.svg',
+    check: 'chrome://global/skin/icons/check.svg',
+    selectAll: 'chrome://global/skin/icons/double-checkmark.svg',
+    del: 'chrome://global/skin/icons/delete.svg',
+    settings: 'chrome://global/skin/icons/settings.svg',
+    history: 'chrome://browser/skin/history.svg',
+    tab: 'chrome://browser/skin/tab.svg',
+    bookmark: 'chrome://browser/skin/bookmark.svg',
+    favicon: 'chrome://global/skin/icons/defaultFavicon.svg',
+};
+
+export class TabTray {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const tray = new TabTrayUI(window);
+        window.mcfTabTray = tray;
+
+        // The tab counter opens the tray instead of the all-tabs panel.
+        // navigator-toolbox.js opens the panel on mousedown and on click (key
+        // presses), so both are stopped before they get there.
+        const isCounter = (event) => {
+            if (window.innerWidth > MOBILE_MAX_WIDTH) return false;
+            if (!Services.prefs.getBoolPref('mcf.toolbar.tabCounter.enabled', true)) return false;
+            if (Services.prefs.getBoolPref('sidebar.verticalTabs', false)) return false;
+            return !!event.target?.closest?.('#alltabs-button');
+        };
+        for (const type of ['mousedown', 'mouseup', 'keypress']) {
+            window.addEventListener(type, (event) => {
+                if (!isCounter(event)) return;
+                if (type === 'keypress' && event.key !== 'Enter' && event.key !== ' ') return;
+                event.preventDefault();
+                event.stopImmediatePropagation();
+            }, true);
+        }
+        window.addEventListener('click', (event) => {
+            if (!isCounter(event)) return;
+            event.preventDefault();
+            event.stopImmediatePropagation();
+            tray.open();
+        }, true);
+        window.addEventListener('keypress', (event) => {
+            if (!isCounter(event) || (event.key !== 'Enter' && event.key !== ' ')) return;
+            tray.open();
+        }, true);
+    }
+}
+
+class TabTrayUI {
+    constructor(window) {
+        this.window = window;
+        this.document = window.document;
+        this.root = null;
+        this.page = 'normal';
+        this.selecting = null; // Set of selected tabs, or null
+        this.thumbs = new WeakMap();
+        this.sub = null; // 'closed' while the recently-closed page shows
+        this._render = this._render.bind(this);
+        this._pending = false;
+        this._onKey = (event) => {
+            if (event.key === 'Escape' || event.key === 'BrowserBack') {
+                event.preventDefault();
+                event.stopPropagation();
+                if (this._popup) this._dismissPopup();
+                else if (this.sub) { this.sub = null; this._render(); }
+                else if (this.selecting) { this.selecting = null; this._render(); }
+                else this.close();
+            }
+        };
+    }
+
+    get isOpen() {
+        return !!this.root && !this.root.hidden;
+    }
+
+    el(tag, cls, attrs = {}, ...kids) {
+        const node = this.document.createElementNS(HTML, tag);
+        if (cls) node.className = cls;
+        for (const [k, v] of Object.entries(attrs)) {
+            if (v === false || v == null) continue;
+            node.setAttribute(k, v === true ? '' : v);
+        }
+        node.append(...kids.filter(k => k != null));
+        return node;
+    }
+
+    icon(name, small) {
+        const node = this.el('span', small ? 'mcf-tt-icon small' : 'mcf-tt-icon');
+        node.style.setProperty('--icon', `url(${ICONS[name]})`);
+        return node;
+    }
+
+    button(cls, label, ...kids) {
+        const node = this.el('button', cls, { 'aria-label': label, title: label, type: 'button' }, ...kids);
+        return node;
+    }
+
+    _ensureRoot() {
+        if (this.root) return;
+        const doc = this.document;
+        this.root = this.el('div', null, { id: 'mcf-tabtray', hidden: true });
+        const style = this.el('style');
+        style.textContent = CSS;
+        this.root.append(style);
+        (doc.body || doc.documentElement).append(this.root);
+    }
+
+    open(page) {
+        const w = this.window;
+        this._ensureRoot();
+        // ToolbarVerticalGesturesHandler: the page of the current mode.
+        this.page = page || (PrivateBrowsingUtils.isWindowPrivate(w) ? 'private' : 'normal');
+        this.selecting = null;
+        this.sub = null;
+        w.document.activeElement?.blur?.();
+        this.root.hidden = false;
+        w.addEventListener('keydown', this._onKey, true);
+        const c = w.gBrowser.tabContainer;
+        this._events = ['TabOpen', 'TabClose', 'TabSelect', 'TabAttrModified', 'TabMove'];
+        for (const e of this._events) c.addEventListener(e, this._schedule ||= () => this._queue());
+        this._render();
+        this._captureAll();
+    }
+
+    close() {
+        if (!this.root || this.root.hidden) return;
+        this.root.hidden = true;
+        this._dismissPopup();
+        this._snackEl?.remove();
+        this._snackEl = null;
+        this.window.removeEventListener('keydown', this._onKey, true);
+        const c = this.window.gBrowser.tabContainer;
+        for (const e of this._events || []) c.removeEventListener(e, this._schedule);
+        this.root.querySelector('.mcf-tt-body')?.remove();
+    }
+
+    _queue() {
+        if (this._pending) return;
+        this._pending = true;
+        this.window.requestAnimationFrame(() => { this._pending = false; if (this.isOpen) this._render(); });
+    }
+
+    // Windows of one kind (private browsing is per window on desktop).
+    _windows(priv) {
+        const out = [];
+        for (const w of Services.wm.getEnumerator('navigator:browser')) {
+            if (w.closed || !w.gBrowser || !w.gBrowserInit?.delayedStartupFinished) continue;
+            if (PrivateBrowsingUtils.isWindowPrivate(w) === priv) out.push(w);
+        }
+        return out;
+    }
+
+    _tabs(priv = this.page === 'private') {
+        const tabs = [];
+        for (const w of this._windows(priv)) {
+            for (const tab of w.gBrowser.tabs) {
+                if (!tab.closing && !tab.hidden) tabs.push(tab);
+            }
+        }
+        return tabs;
+    }
+
+    _isBlank(tab) {
+        const uri = tab.linkedBrowser?.currentURI?.spec || '';
+        return BLANK.test(uri) && !tab.linkedBrowser?.canGoBack;
+    }
+
+    // Fenix has no tab for its home screen: a window with nothing but a new
+    // tab shows the empty page.
+    _visible(tabs) {
+        return tabs.length === 1 && this._isBlank(tabs[0]) ? [] : tabs;
+    }
+
+    _title(tab) {
+        const spec = tab.linkedBrowser?.currentURI?.spec || '';
+        return tab.label || spec || S.newTab;
+    }
+
+    _shortUrl(tab) {
+        const spec = tab.linkedBrowser?.currentURI?.spec || '';
+        try {
+            const uri = Services.io.newURI(spec);
+            if (uri.scheme === 'http' || uri.scheme === 'https') return uri.host.replace(/^www\./, '');
+        } catch (e) { /* not a URL we can shorten */ }
+        return spec;
+    }
+
+    _columns() {
+        const w = this.window.innerWidth, landscape = w > this.window.innerHeight;
+        if (landscape) return w >= 1280 ? 5 : w >= 917 ? 4 : 3;
+        return w >= 800 ? 4 : w >= 480 ? 3 : 2;
+    }
+
+    _render() {
+        if (!this.root) return;
+        const priv = this.page === 'private';
+        const all = this._tabs();
+        const tabs = this._visible(all);
+        const keep = this.root.querySelector('style');
+        const body = this.el('div', 'mcf-tt-body');
+        body.style.cssText = 'display:flex;flex-direction:column;flex:1;min-height:0;';
+        const scroll = this.root.querySelector('.mcf-tt-content')?.scrollTop || 0;
+
+        if (this.sub === 'closed') {
+            this._renderClosed(body);
+            this.root.replaceChildren(keep, body);
+            if (this._popup) this.root.append(this._popup);
+            return;
+        }
+
+        // Banner (TabsTrayBanner.kt)
+        const normalCount = this._visible(this._tabs(false)).length;
+        const privateCount = this._tabs(true).length;
+        if (this.selecting) {
+            this.selecting = new Set([...this.selecting].filter(t => all.includes(t)));
+            const n = this.selecting.size;
+            const bookmark = this.button('mcf-tt-iconbtn', S.bookmarkSelected, this.icon('bookmark'));
+            const del = this.button('mcf-tt-iconbtn', S.closeSelected, this.icon('del'));
+            bookmark.disabled = del.disabled = n === 0;
+            bookmark.style.opacity = del.style.opacity = n ? '' : '0.4';
+            const back = this.button('mcf-tt-iconbtn', S.exitSelect, this.icon('back'));
+            back.addEventListener('click', () => { this.selecting = null; this._render(); });
+            bookmark.addEventListener('click', () => this._bookmarkSelected());
+            del.addEventListener('click', () => this._closeSelected());
+            body.append(this.el('div', 'mcf-tt-selectbanner', {},
+                back, this.el('div', 'mcf-tt-title', {}, n ? S.selectedCount(n) : S.selectTabs), bookmark, del));
+        } else {
+            const privBtn = this.button('mcf-tt-page', S.privateTabs(privateCount), this.icon('mask'));
+            const normBtn = this.button('mcf-tt-page', S.normalTabs(normalCount),
+                this.el('div', 'mcf-tt-counter', {}, String(normalCount > 99 ? '∞' : normalCount)));
+            privBtn.toggleAttribute('selected', priv);
+            normBtn.toggleAttribute('selected', !priv);
+            privBtn.addEventListener('click', () => this._setPage('private'));
+            normBtn.addEventListener('click', () => this._setPage('normal'));
+            body.append(this.el('div', 'mcf-tt-banner', {}, privBtn, normBtn));
+        }
+
+        // Pages
+        const content = this.el('div', 'mcf-tt-content');
+        if (!tabs.length) {
+            content.append(this._emptyPage());
+        } else if (Services.prefs.getBoolPref('mcf.tabtray.gridView', true)) {
+            const grid = this.el('div', 'mcf-tt-grid');
+            grid.style.setProperty('--cols', this._columns());
+            for (const tab of tabs) grid.append(this._card(tab));
+            content.append(grid);
+        } else {
+            const list = this.el('div', 'mcf-tt-list');
+            for (const tab of tabs) list.append(this._row(tab));
+            content.append(list);
+        }
+        body.append(content);
+
+        // Floating toolbar (TabManagerFloatingToolbar.kt); the pill's search
+        // button is for tab search, which isn't here.
+        const more = this.button('mcf-tt-iconbtn', S.menu, this.icon('more'));
+        more.addEventListener('click', () => this._menu(more, tabs));
+        const fab = this.button('mcf-tt-fab', priv ? S.addPrivateTab : S.addTab, this.icon('plus'));
+        fab.addEventListener('click', () => this._newTab());
+        // isFloatingToolbarVisible: not while selecting tabs.
+        if (!this.selecting) body.append(this.el('div', 'mcf-tt-fabrow', {}, this.el('div', 'mcf-tt-pill', {}, more), fab));
+
+        this.root.replaceChildren(keep, body);
+        for (const kept of [this._snackEl, this._popup]) if (kept) this.root.append(kept);
+        content.scrollTop = scroll;
+    }
+
+    _setPage(page) {
+        if (this.page === page) return;
+        this.page = page;
+        this.selecting = null;
+        this._render();
+        this._captureAll();
+    }
+
+    _emptyPage() {
+        // NormalTabsPage.kt / PrivateTabsPage.kt
+        if (this.page === 'private') {
+            const brand = Services.appinfo.name || 'Firefox';
+            return this.el('div', 'mcf-tt-empty', {}, this.icon('mask'),
+                this.el('h2', null, {}, S.emptyPrivateHeader), this.el('p', null, {}, S.emptyPrivateBody(brand)));
+        }
+        return this.el('div', 'mcf-tt-empty', {}, this.icon('tab'), this.el('h2', null, {}, S.emptyNormal));
+    }
+
+    _isFocused(tab) {
+        return tab.selected && tab.ownerDocument === this.document;
+    }
+
+    _favicon(tab) {
+        const img = this.el('img', 'mcf-tt-fav', { alt: '' });
+        const src = tab.getAttribute('image');
+        img.src = src && /^(https?|data|chrome|moz-icon|page-icon|resource):/.test(src) ? src : ICONS.favicon;
+        img.addEventListener('error', () => { img.src = ICONS.favicon; }, { once: true });
+        return img;
+    }
+
+    _closeButton(tab) {
+        const btn = this.button('mcf-tt-iconbtn', S.closeTab(this._title(tab)), this.icon('close', true));
+        btn.addEventListener('click', (event) => { event.stopPropagation(); this._closeTab(tab); });
+        return btn;
+    }
+
+    _check(tab) {
+        return this.el('div', 'mcf-tt-check', { on: this.selecting.has(tab) }, this.icon('check'));
+    }
+
+    _thumb(tab, cls) {
+        const canvas = this.el('canvas', cls);
+        canvas.dataset.mcfTab = '1';
+        canvas._mcfTab = tab;
+        const cached = this.thumbs.get(tab);
+        if (cached) this._paint(canvas, cached);
+        return canvas;
+    }
+
+    _card(tab) {
+        const selecting = !!this.selecting;
+        const card = this.el('div', 'mcf-tt-card', { role: 'button', tabindex: '0',
+            selected: selecting && this.selecting.has(tab), focused: this._isFocused(tab) });
+        const trail = selecting ? this._check(tab) : this._closeButton(tab);
+        const wrap = this.el('div', 'mcf-tt-thumbwrap', {}, this._thumb(tab, 'mcf-tt-thumb'));
+        if (!this.thumbs.has(tab)) wrap.append(this._favicon(tab));
+        card.append(
+            this.el('div', 'mcf-tt-head', {}, this._favicon(tab), this.el('div', 'mcf-tt-name', {}, this._title(tab)), trail),
+            wrap);
+        this._wireItem(card, tab);
+        return card;
+    }
+
+    _row(tab) {
+        const selecting = !!this.selecting;
+        const row = this.el('div', 'mcf-tt-row', { role: 'button', tabindex: '0',
+            selected: selecting && this.selecting.has(tab), focused: this._isFocused(tab) });
+        const thumb = this.el('div', 'mcf-tt-rowthumb', {}, this._thumb(tab, 'mcf-tt-thumb'));
+        if (!this.thumbs.has(tab)) thumb.append(this._favicon(tab));
+        row.append(thumb,
+            this.el('div', 'mcf-tt-rowtext', {}, this.el('div', 'mcf-tt-rowtitle', {}, this._title(tab)),
+                this.el('div', 'mcf-tt-rowurl', {}, this._shortUrl(tab))),
+            selecting ? this.el('div', 'mcf-tt-iconbtn', {}, this._check(tab)) : this._closeButton(tab));
+        this._wireItem(row, tab);
+        return row;
+    }
+
+    // Tap, long press (multi-select) and swipe to dismiss (SwipeToDismissBox).
+    _wireItem(node, tab) {
+        node.addEventListener('click', () => {
+            if (this.selecting) {
+                if (!this.selecting.delete(tab)) this.selecting.add(tab);
+                this._render();
+            } else {
+                this._pick(tab);
+            }
+        });
+        node.addEventListener('contextmenu', (event) => {
+            event.preventDefault();
+            if (!this.selecting) {
+                this.selecting = new Set([tab]);
+                this._render();
+            }
+        });
+        let drag = null;
+        node.addEventListener('pointerdown', (event) => {
+            if (event.pointerType !== 'touch' || !event.isPrimary || this.selecting) return;
+            drag = { id: event.pointerId, x: event.clientX, y: event.clientY, on: false, dx: 0 };
+        });
+        node.addEventListener('pointermove', (event) => {
+            if (!drag || event.pointerId !== drag.id) return;
+            const dx = event.clientX - drag.x, dy = event.clientY - drag.y;
+            if (!drag.on) {
+                if (Math.abs(dx) < 8 || Math.abs(dx) < Math.abs(dy)) return;
+                drag.on = true;
+                node.setPointerCapture(event.pointerId);
+                node.style.transition = 'none';
+            }
+            drag.dx = dx;
+            node.style.translate = `${dx}px 0`;
+            node.style.opacity = String(Math.max(0, 1 - Math.abs(dx) / node.offsetWidth));
+        });
+        const end = (event) => {
+            if (!drag || event.pointerId !== drag.id) return;
+            const { on, dx } = drag; drag = null;
+            if (!on) return;
+            node.style.transition = 'translate 0.15s, opacity 0.15s';
+            if (Math.abs(dx) > node.offsetWidth * 0.5 && event.type === 'pointerup') {
+                node.style.translate = `${Math.sign(dx) * node.offsetWidth}px 0`;
+                node.style.opacity = '0';
+                this.window.setTimeout(() => this._closeTab(tab), 150);
+            } else {
+                node.style.translate = '';
+                node.style.opacity = '';
+            }
+            // The click that follows a drag must not pick the tab.
+            node.addEventListener('click', e => e.stopImmediatePropagation(), { capture: true, once: true });
+        };
+        node.addEventListener('pointerup', end);
+        node.addEventListener('pointercancel', end);
+    }
+
+    _pick(tab) {
+        const w = tab.ownerDocument.defaultView;
+        this.close();
+        if (tab.ownerDocument !== this.document) w.focus();
+        w.gBrowser.selectedTab = tab;
+    }
+
+    _closeTab(tab, quiet) {
+        const w = tab.ownerDocument.defaultView;
+        w.gBrowser.removeTab(tab, { animate: false, closeWindowWithLastTab: false });
+        if (!quiet) this._snack(S.tabClosed, w);
+        this._render();
+    }
+
+    _snack(text, w) {
+        this._snackEl?.remove();
+        const undo = this.button(null, S.undo, S.undo);
+        const previous = w.gBrowser.selectedTab;
+        undo.addEventListener('click', () => {
+            try {
+                w.SessionStore.undoCloseTab(w, 0);
+                // Undoing brings the tab back, not to the front.
+                if (!previous.closing && w.gBrowser.tabs.includes(previous)) w.gBrowser.selectedTab = previous;
+            } catch (e) { console.error(e); }
+            snack.remove();
+            this._snackEl = null;
+            this._queue();
+        });
+        const snack = this.el('div', 'mcf-tt-snack', {}, this.el('span', null, {}, text), undo);
+        this._snackEl = snack;
+        this.root.append(snack);
+        this.window.setTimeout(() => { snack.remove(); if (this._snackEl === snack) this._snackEl = null; }, 8000);
+    }
+
+    _newTab() {
+        if (this.page === 'private') {
+            const [w] = this._windows(true);
+            this.close();
+            if (w) {
+                w.focus();
+                w.BrowserCommands.openTab();
+            } else {
+                this.window.OpenBrowserWindow({ private: true });
+            }
+        } else {
+            this.close();
+            this.window.BrowserCommands.openTab();
+        }
+    }
+
+    _closeSelected() {
+        const tabs = [...this.selecting];
+        this.selecting = null;
+        for (const tab of tabs) tab.ownerDocument.defaultView.gBrowser.removeTab(tab, { animate: false, closeWindowWithLastTab: false });
+        this._render();
+    }
+
+    _bookmarkSelected() {
+        const tabs = [...this.selecting];
+        try {
+            const uris = tabs.map(t => t.linkedBrowser.currentURI);
+            this.window.PlacesUIUtils.showBookmarkPagesDialog(
+                uris.map((uri, i) => ({ uri, title: this._title(tabs[i]) })), ['folderPicker'], this.window);
+        } catch (e) { console.error(e); }
+        this.selecting = null;
+        this._render();
+    }
+
+    // DropdownMenu of the three-dot button: generateMenuItems()
+    _menu(anchor, tabs) {
+        const priv = this.page === 'private';
+        const item = (label, icon, run, critical) => ({ label, icon, run, critical });
+        const recently = item(S.recentlyClosed, 'history', () => { this.sub = 'closed'; this._render(); });
+        const settings = item(S.tabSettings, 'settings', () => {
+            this.close();
+            this.window.openTrustedLinkIn('about:preferences#general', 'tab');
+        });
+        const select = item(S.selectTabs, 'check', () => { this.selecting = new Set(); this._render(); });
+        const selectAll = item(S.selectAll, 'selectAll', () => { this.selecting = new Set(tabs); this._render(); });
+        const closeAll = item(S.closeAll, 'del', () => this._confirmCloseAll(tabs), true);
+        const items = tabs.length
+            ? (priv ? [recently, settings, closeAll] : [select, selectAll, recently, settings, closeAll])
+            : [recently, settings];
+        this._popup = this.el('div', 'mcf-tt-scrim');
+        const menu = this.el('div', 'mcf-tt-menu');
+        for (const it of items) {
+            const btn = this.button('mcf-tt-menuitem', it.label, this.icon(it.icon), this.el('span', null, {}, it.label));
+            if (it.critical) btn.setAttribute('critical', '');
+            btn.addEventListener('click', () => { this._dismissPopup(); it.run(); });
+            menu.append(btn);
+        }
+        this._popup.append(menu);
+        this._popup.addEventListener('click', (event) => { if (event.target === this._popup) this._dismissPopup(); });
+        this.root.append(this._popup);
+    }
+
+    _dismissPopup() {
+        this._popup?.remove();
+        this._popup = null;
+    }
+
+    // CloseAllTabsConfirmationDialog
+    _confirmCloseAll(tabs) {
+        const cancel = this.button(null, S.cancel, S.cancel);
+        const ok = this.button(null, S.closeAllConfirm, S.closeAllConfirm);
+        this._popup = this.el('div', 'mcf-tt-scrim', { dialog: true }, this.el('div', 'mcf-tt-dialog', { role: 'alertdialog' },
+            this.el('h2', null, {}, S.closeAllTitle), this.el('p', null, {}, S.closeAllBody),
+            this.el('div', 'mcf-tt-buttons', {}, cancel, ok)));
+        cancel.addEventListener('click', () => this._dismissPopup());
+        ok.addEventListener('click', () => {
+            this._dismissPopup();
+            const byWindow = new Map();
+            for (const tab of tabs) {
+                const w = tab.ownerDocument.defaultView;
+                if (!byWindow.has(w)) byWindow.set(w, []);
+                byWindow.get(w).push(tab);
+            }
+            for (const [w, list] of byWindow) {
+                // Keep the window: it gets a fresh tab, like Fenix's home screen.
+                const all = w.gBrowser.tabs.filter(t => !t.closing);
+                if (list.length >= all.length) w.BrowserCommands.openTab?.();
+                w.gBrowser.removeTabs(list, { animate: false, closeWindowWithLastTab: false });
+            }
+            this._render();
+        });
+        this.root.append(this._popup);
+    }
+
+    // RecentlyClosedFragment: back arrow and the closed tabs of this window.
+    _renderClosed(body) {
+        const back = this.button('mcf-tt-iconbtn', 'Back', this.icon('back'));
+        back.addEventListener('click', () => { this.sub = null; this._render(); });
+        body.append(this.el('div', 'mcf-tt-selectbanner', {}, back,
+            this.el('div', 'mcf-tt-title', {}, S.recentlyClosed)));
+        const content = this.el('div', 'mcf-tt-content');
+        let closed = [];
+        try { closed = this.window.SessionStore.getClosedTabDataForWindow(this.window) || []; } catch (e) { /* none */ }
+        if (!closed.length) {
+            content.append(this.el('div', 'mcf-tt-empty', {}, this.el('h2', null, {}, S.recentlyClosedEmpty)));
+        } else {
+            const list = this.el('div', 'mcf-tt-list');
+            closed.forEach((data, index) => {
+                const state = data.state;
+                const entry = state.entries?.[state.index - 1] || state.entries?.[0] || {};
+                const img = this.el('img', 'mcf-tt-fav', { alt: '' });
+                img.src = data.image && /^(https?|data|chrome|moz-icon|page-icon):/.test(data.image) ? data.image : ICONS.favicon;
+                const row = this.el('div', 'mcf-tt-row', { role: 'button', tabindex: '0' },
+                    this.el('div', 'mcf-tt-rowthumb', {}, img),
+                    this.el('div', 'mcf-tt-rowtext', {}, this.el('div', 'mcf-tt-rowtitle', {}, data.title || entry.title || entry.url || ''),
+                        this.el('div', 'mcf-tt-rowurl', {}, entry.url || '')));
+                row.addEventListener('click', () => {
+                    this.close();
+                    this.window.SessionStore.undoCloseTab(this.window, index);
+                });
+                list.append(row);
+            });
+            content.append(list);
+        }
+        body.append(content);
+    }
+
+    // Thumbnails: what the tab shows now, cropped from the top to the shape
+    // of the card (Fenix: the engine's snapshot, top aligned).
+    async _captureAll() {
+        const tabs = this._tabs();
+        // The current tab first.
+        tabs.sort((a, b) => (b.selected - a.selected));
+        for (const tab of tabs) {
+            if (!this.isOpen) return;
+            await this._capture(tab);
+        }
+    }
+
+    async _capture(tab) {
+        try {
+            const browser = tab.linkedBrowser;
+            const wg = browser?.browsingContext?.currentWindowGlobal;
+            if (!wg || (this._isBlank(tab) && !browser.canGoBack)) return;
+            const width = browser.clientWidth, height = browser.clientHeight;
+            if (!width || !height) return;
+            const cardWidth = 200;
+            const crop = Math.min(height, width * 1.1);
+            const scale = Math.min(1, (cardWidth * this.window.devicePixelRatio) / width);
+            const bitmap = await wg.drawSnapshot(new this.window.DOMRect(0, 0, width, crop), scale, 'white');
+            this.thumbs.set(tab, bitmap);
+            for (const canvas of this.root.querySelectorAll('canvas[data-mcf-tab]')) {
+                if (canvas._mcfTab === tab) this._paint(canvas, bitmap);
+            }
+        } catch (e) { /* no snapshot for this tab (unloaded, crashed...) */ }
+    }
+
+    _paint(canvas, bitmap) {
+        canvas.width = bitmap.width;
+        canvas.height = bitmap.height;
+        canvas.getContext('2d').drawImage(bitmap, 0, 0);
+        canvas.parentNode?.querySelector('.mcf-tt-fav')?.remove();
+    }
+}
