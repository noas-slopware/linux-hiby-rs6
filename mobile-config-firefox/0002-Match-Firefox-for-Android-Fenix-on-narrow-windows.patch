diff --git a/src/modules/SelectDialog.sys.mjs b/src/modules/SelectDialog.sys.mjs
new file mode 100644
index 0000000..b4b06ca
--- /dev/null
+++ b/src/modules/SelectDialog.sys.mjs
@@ -0,0 +1,159 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * <select> like Firefox for Android: a dialog with the options as rows, not
+ * a dropdown menu.
+ *
+ * Fenix: android-components feature/prompts ChoiceDialogFragment.kt (a
+ * MaterialAlertDialog), ChoiceAdapter.kt and mozac_feature_*_choice_item.xml:
+ * 48dp rows with a radio button at the end for a single choice (tap = choose
+ * and close, the chosen one scrolled into view), check boxes and Cancel / OK
+ * buttons (centered) for a multiple choice, <optgroup>s as disabled headers
+ * with their options indented, separators for <hr>.
+ *
+ * - A dropdown <select>: desktop builds its menu items (SelectParentHelper
+ *   .populate()) and then opens the popup (.open()); the dialog is shown in
+ *   place of that popup and answers with the same messages the menu does.
+ * - <select multiple>: desktop shows a list box in the page. McfSelectChild
+ *   (content side) catches the tap and asks McfSelectParent for the dialog.
+ */
+
+import { FenixDialogs, isMobileLayout, MOBILE_MAX_WIDTH } from 'chrome://mobileconfigfirefox/content/FenixDialogs.sys.mjs';
+
+const HELPER_URLS = [
+    'resource://gre/actors/SelectParent.sys.mjs',
+    'moz-src:///toolkit/actors/SelectParent.sys.mjs',
+];
+
+export class SelectDialog {
+    init() {
+        this._patchDropdown();
+        this._registerActor();
+        // The content side needs to know whether the layout is a mobile one.
+        Services.obs.addObserver({
+            observe: (subject, topic) => {
+                if (topic !== 'domwindowopened') return;
+                const window = subject;
+                window.addEventListener('load', () => {
+                    if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                    const update = () => Services.prefs.getDefaultBranch('')
+                        .setBoolPref('mcf.layout.mobile', window.innerWidth <= MOBILE_MAX_WIDTH);
+                    window.addEventListener('resize', update);
+                    update();
+                }, { once: true });
+            },
+        }, 'domwindowopened');
+    }
+
+    // The actor's module has a different URL in different Firefox versions,
+    // and a URL that is only an alias can be a module of its own: patch
+    // every one that loads.
+    _patchDropdown() {
+        let found = 0;
+        for (const url of HELPER_URLS) {
+            try {
+                const helper = ChromeUtils.importESModule(url).SelectParentHelper;
+                if (helper) {
+                    this._patchHelper(helper);
+                    found++;
+                }
+            } catch (e) {
+                // Other Firefox version.
+            }
+        }
+        if (!found) console.error('SelectDialog: SelectParentHelper not found');
+    }
+
+    _patchHelper(helper) {
+        if (helper._mcfPatched) return;
+        helper._mcfPatched = true;
+        const open = helper.open;
+        const hide = helper.hide;
+
+        helper.open = function (browser, menulist, rect, isOpenedViaTouch, actor) {
+            const win = menulist.ownerDocument.defaultView;
+            if (!browser || !win || !isMobileLayout(win)) {
+                return open.apply(this, arguments);
+            }
+            const tabbrowser = browser.getTabBrowser?.();
+            if ((actor.browsingContext && actor.browsingContext.canOpenModalPicker === false) ||
+                (tabbrowser && tabbrowser.selectedBrowser !== browser)) {
+                actor.sendAsyncMessage('Forms:DismissedDropDown', {});
+                return undefined;
+            }
+
+            // The menu's items (SelectParentHelper.populateChildren()).
+            const items = [];
+            const values = [];
+            const selected = menulist.selectedItem;
+            for (const node of menulist.menupopup.children) {
+                if (node.hidden) continue;
+                if (node.localName === 'menuseparator') {
+                    items.push({ separator: true });
+                    values.push(null);
+                } else if (node.localName === 'menucaption') {
+                    items.push({ label: node.getAttribute('label'), header: true });
+                    values.push(null);
+                } else if (node.localName === 'menuitem') {
+                    items.push({
+                        label: node.getAttribute('label'),
+                        selected: node === selected,
+                        disabled: node.hasAttribute('disabled'),
+                        indent: node.hasAttribute('indented') ? 1 : 0,
+                    });
+                    values.push(node.getAttribute('value'));
+                }
+            }
+
+            helper._mcfDialog = { browser, actor };
+            FenixDialogs.dialog(win, { items }).then((result) => {
+                if (helper._mcfDialog?.actor !== actor) return;
+                helper._mcfDialog = null;
+                if (result.button === 'select' && values[result.selected[0]] !== null) {
+                    actor.sendAsyncMessage('Forms:SelectDropDownItem', {
+                        value: values[result.selected[0]],
+                        closedWithEnter: false,
+                    });
+                }
+                actor.sendAsyncMessage('Forms:DismissedDropDown', {});
+            });
+            return undefined;
+        };
+
+        helper.hide = function (menulist, browser) {
+            // The page took the <select> away.
+            if (helper._mcfDialog && helper._mcfDialog.browser === browser) {
+                const { actor } = helper._mcfDialog;
+                helper._mcfDialog = null;
+                browser.ownerDocument.defaultView?.document.querySelector('.mcf-fx-layer')?.remove();
+                actor.sendAsyncMessage('Forms:DismissedDropDown', {});
+                return undefined;
+            }
+            return hide.apply(this, arguments);
+        };
+    }
+
+    _registerActor() {
+        try {
+            ChromeUtils.registerWindowActor('McfSelect', {
+                parent: {
+                    esModuleURI: 'chrome://mobileconfigfirefox/content/McfSelectParent.sys.mjs',
+                },
+                child: {
+                    esModuleURI: 'chrome://mobileconfigfirefox/content/McfSelectChild.sys.mjs',
+                    events: {
+                        mousedown: { capture: true },
+                    },
+                },
+                allFrames: true,
+                messageManagerGroups: ['browsers'],
+                // Web pages run in such processes. The parent only shows a
+                // dialog for what the page lists and answers with indexes.
+                safeForUntrustedWebProcess: true,
+            });
+        } catch (e) {
+            console.error('McfSelect actor failed to register:', e);
+        }
+    }
+}
diff --git a/src/modules/TabCounterMenu.sys.mjs b/src/modules/TabCounterMenu.sys.mjs
new file mode 100644
index 0000000..dbc8d64
--- /dev/null
+++ b/src/modules/TabCounterMenu.sys.mjs
@@ -0,0 +1,91 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Long-pressing the tab counter opens a small menu, like Firefox for Android:
+ * New tab, New private tab, Close tab (BrowserToolbarMiddleware.kt
+ * buildTabCounterMenu(), strings from android-components' TabCounterMenu).
+ * The order is reversed when the toolbar is at the bottom, so "New tab" is
+ * nearest to the finger.
+ *
+ * A long press on a touchscreen fires a contextmenu event (APZ long tap);
+ * without this it opens the desktop toolbar context menu.
+ */
+export class TabCounterMenu {
+    init() {
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+        // Only en-US exists (fenix.ftl); optional, so other UI locales don't
+        // lose their bundle over it.
+        document.l10n.addResourceIds([{ path: 'browser/mobileconfig/fenix.ftl', optional: true }]);
+
+        const menu = document.createXULElement('menupopup');
+        menu.id = 'mcf-tabcounter-menu';
+        const item = (id, l10nId, icon, command) => {
+            const menuitem = document.createXULElement('menuitem');
+            menuitem.id = id;
+            menuitem.className = 'menuitem-iconic';
+            menuitem.setAttribute('image', icon);
+            document.l10n.setAttributes(menuitem, l10nId);
+            menuitem.addEventListener('command', command);
+            return menuitem;
+        };
+        const newTab = item('mcf-tabcounter-new-tab', 'mcf-tabcounter-new-tab',
+            'chrome://global/skin/icons/plus.svg',
+            (event) => window.BrowserCommands.openTab({ event }));
+        const newPrivate = item('mcf-tabcounter-new-private', 'mcf-tabcounter-new-private-window',
+            'chrome://browser/skin/privateBrowsing.svg',
+            () => window.OpenBrowserWindow({ private: true }));
+        const closeTab = item('mcf-tabcounter-close-tab', 'mcf-tabcounter-close-tab',
+            'chrome://global/skin/icons/close.svg',
+            // Fenix shows the home screen after closing the last tab rather
+            // than closing the browser (CloseCurrentTab in
+            // BrowserToolbarMiddleware.kt); Firefox then opens a new tab.
+            () => window.gBrowser.removeTab(window.gBrowser.selectedTab, {
+                closeWindowWithLastTab: false,
+                animate: false,
+            }));
+        const separator = document.createXULElement('menuseparator');
+
+        menu.addEventListener('popupshowing', (event) => {
+            if (event.target !== menu) return;
+            const items = [newTab, newPrivate, separator, closeTab];
+            const bottom = !Services.prefs.getBoolPref('mcf.toolbar.positionOnTop', false);
+            menu.replaceChildren(...(bottom ? items.reverse() : items));
+        });
+        document.getElementById('mainPopupSet').appendChild(menu);
+
+        // The tab counter is the all-tabs button, or the sidebar button with
+        // vertical tabs (tabcounter.css).
+        const isCounter = (node) => {
+            if (!Services.prefs.getBoolPref('mcf.toolbar.tabCounter.enabled', true)) return null;
+            const id = Services.prefs.getBoolPref('sidebar.verticalTabs', false) ? 'sidebar-button' : 'alltabs-button';
+            return node?.closest?.(`#${id}`);
+        };
+
+        window.addEventListener('contextmenu', (event) => {
+            const button = isCounter(event.target);
+            if (!button) return;
+            event.preventDefault();
+            event.stopPropagation();
+            const bottom = !Services.prefs.getBoolPref('mcf.toolbar.positionOnTop', false);
+            menu.openPopup(button, bottom ? 'before_end' : 'after_end', 0, 0,
+                           /* isContextMenu */ true, false, event);
+        }, true);
+    }
+}
