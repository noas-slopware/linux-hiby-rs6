+
+/** Parent side of PageScroll.sys.mjs: hands the child's messages to the window. */
+export class McfScrollParent extends JSWindowActorParent {
+    receiveMessage(message) {
+        const browser = this.manager?.browsingContext?.top?.embedderElement;
+        const win = browser?.ownerDocument?.defaultView;
+        const handler = win?.mcfPageScroll;
+        if (handler) handler.onMessage(browser, message.name, message.data);
+    }
+}
diff --git a/src/modules/McfSelectChild.sys.mjs b/src/modules/McfSelectChild.sys.mjs
new file mode 100644
index 0000000..0582515
--- /dev/null
+++ b/src/modules/McfSelectChild.sys.mjs
@@ -0,0 +1,73 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Content side of the multiple choice dialog (SelectDialog.sys.mjs): a tap
+ * on a <select multiple> list box opens the dialog of Fenix (ChoiceDialog
+ * Fragment, MULTIPLE_CHOICE_DIALOG_TYPE) instead of toggling options in the
+ * page. OK sets the options and fires input and change like the user
+ * choosing them in the page would; Cancel changes nothing.
+ */
+export class McfSelectChild extends JSWindowActorChild {
+    handleEvent(event) {
+        if (event.type !== 'mousedown' || event.button !== 0 || event.defaultPrevented) return;
+        if (!Services.prefs.getBoolPref('mcf.layout.mobile', false)) return;
+        const target = event.composedTarget;
+        const select = target?.closest?.('select');
+        if (!select || !select.multiple || select.disabled) return;
+        // Scrollbar of the list box.
+        if (target === select && select.scrollHeight > select.clientHeight &&
+            event.offsetX > select.clientWidth) return;
+
+        event.preventDefault();
+        this._open(select);
+    }
+
+    async _open(select) {
+        const items = [];
+        const add = (option, indent) => {
+            items.push({
+                label: option.text,
+                selected: option.selected,
+                disabled: option.disabled || option.parentNode.disabled,
+                indent,
+                optionIndex: option.index,
+            });
+        };
+        for (const child of select.children) {
+            if (child.localName === 'optgroup') {
+                items.push({ label: child.label, header: true, optionIndex: -1 });
+                for (const option of child.children) {
+                    if (option.localName === 'option') add(option, 1);
+                }
+            } else if (child.localName === 'hr') {
+                items.push({ separator: true, optionIndex: -1 });
+            } else if (child.localName === 'option') {
+                add(child, 0);
+            }
+        }
+
+        let chosen;
+        try {
+            chosen = await this.sendQuery('McfSelect:Open', { items });
+        } catch (e) {
+            return;
+        }
+        if (!chosen) return;
+        const win = this.contentWindow;
+        if (!win || !select.isConnected) return;
+        const picked = new Set(chosen);
+        let changed = false;
+        for (const option of select.options) {
+            const on = picked.has(option.index);
+            if (option.selected !== on) {
+                option.selected = on;
+                changed = true;
+            }
+        }
+        if (changed) {
+            select.dispatchEvent(new win.Event('input', { bubbles: true, composed: true }));
+            select.dispatchEvent(new win.Event('change', { bubbles: true }));
+        }
+    }
+}
diff --git a/src/modules/McfSelectParent.sys.mjs b/src/modules/McfSelectParent.sys.mjs
new file mode 100644
index 0000000..f2cd106
--- /dev/null
+++ b/src/modules/McfSelectParent.sys.mjs
@@ -0,0 +1,42 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Parent side of McfSelectChild.sys.mjs: shows the multiple choice dialog
+ * (see SelectDialog.sys.mjs) and returns the chosen option indexes, or null
+ * if the dialog was cancelled.
+ */
+
+import { FenixDialogs } from 'chrome://mobileconfigfirefox/content/FenixDialogs.sys.mjs';
+
+export class McfSelectParent extends JSWindowActorParent {
+    async receiveMessage(message) {
+        if (message.name !== 'McfSelect:Open') return null;
+        const win = this.browsingContext.topChromeWindow;
+        if (!win || win.closed) return null;
+        // Comes from a web page: take only what's expected.
+        const items = (Array.isArray(message.data?.items) ? message.data.items : [])
+            .slice(0, 5000)
+            .map((item) => ({
+                label: String(item.label ?? ''),
+                selected: !!item.selected,
+                disabled: !!item.disabled,
+                header: !!item.header,
+                separator: !!item.separator,
+                indent: item.indent ? 1 : 0,
+                optionIndex: Number.isInteger(item.optionIndex) ? item.optionIndex : -1,
+            }));
+        const result = await FenixDialogs.dialog(win, {
+            items,
+            multiple: true,
+            center: true,
+            buttons: [
+                { id: 'cancel', label: 'Cancel' },
+                { id: 'ok', label: 'OK' },
+            ],
+        });
+        if (result.button !== 'ok') return null;
+        // `selected` are positions in `items`; give back option indexes.
+        return result.selected.map((position) => items[position].optionIndex).filter((index) => index >= 0);
+    }
+}
diff --git a/src/modules/PageScroll.sys.mjs b/src/modules/PageScroll.sys.mjs
new file mode 100644
index 0000000..72b747f
--- /dev/null
+++ b/src/modules/PageScroll.sys.mjs
@@ -0,0 +1,441 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Two scroll behaviours of Firefox for Android:
+ *
+ * 1. The toolbar slides away while the page is scrolled down and comes back
+ *    when it's scrolled up (AC's ViewHideOnScrollBehavior on the toolbar,
+ *    Fenix pref "Scroll to hide toolbar", default on).
+ * 2. Pull down on a page that's at its top to reload it (androidx
+ *    SwipeRefreshLayout through AC's SwipeRefreshFeature, Fenix pref
+ *    "Pull to refresh", default on).
+ *
+ * The page reports scrolls and touches through McfScrollChild; the rest is
+ * chrome. The toolbar is moved with Gecko's own dynamic toolbar support
+ * (InspectorUtils.setDynamicToolbarMaxHeight / setVerticalClipping, which
+ * GeckoView uses on Android and RDM uses on desktop): the page's browser
+ * element always has the full height and the toolbar overlays its edge, so
+ * hiding it resizes the visual viewport without ever laying the page out
+ * again. 100svh/100lvh/100dvh and position: fixed behave as on Android.
+ *
+ * Distances are Android dp, which are CSS px here.
+ */
+
+const PREF_HIDE = 'mcf.toolbar.hideOnScroll.enabled';
+const PREF_PULL = 'mcf.pullToRefresh.enabled';
+const PREF_TOP = 'mcf.toolbar.positionOnTop';
+// Snap animation of Gecko's own dynamic toolbar simulation (RDM,
+// devtools/client/responsive/ui.js DYNAMIC_TOOLBAR_SNAP_ANIMATION_DURATION_MS).
+const SNAP_MS = 120;
+// How long after the last scroll (and with no finger down) the toolbar snaps.
+const SETTLE_MS = 100;
+// androidx SwipeRefreshLayout.
+const CIRCLE = 40; // CIRCLE_DIAMETER
+const TOTAL_DRAG = 64; // DEFAULT_CIRCLE_TARGET / mTotalDragDistance
+const DRAG_RATE = 0.5;
+const ANIMATE_TO_START_MS = 200;
+const MAX_PROGRESS_ANGLE = 0.8;
+const NARROW = 700; // browser.css switches to the mobile layout at this width
+const HTML = 'http://www.w3.org/1999/xhtml';
+const SVG = 'http://www.w3.org/2000/svg';
+
+export class PageScroll {
+    init() {
+        try {
+            ChromeUtils.registerWindowActor('McfScroll', {
+                parent: { esModuleURI: 'chrome://mobileconfigfirefox/content/McfScrollParent.sys.mjs' },
+                child: {
+                    esModuleURI: 'chrome://mobileconfigfirefox/content/McfScrollChild.sys.mjs',
+                    events: { DOMWindowCreated: {} },
+                },
+                allFrames: false,
+                messageManagerGroups: ['browsers'],
+                // Web pages run in such processes; the parent only reads
+                // numbers from the messages and clamps them.
+                safeForUntrustedWebProcess: true,
+            });
+        } catch (e) {
+            console.error('McfScroll actor failed to register:', e);
+        }
+        Services.obs.addObserver((window, topic) => {
+            if (topic !== 'domwindowopened') return;
+            window.addEventListener('load', () => {
+                if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                try {
+                    window.mcfPageScroll = new WindowScroll(window);
+                } catch (e) {
+                    console.error('PageScroll failed for window:', e);
+                }
+            }, { once: true });
+        }, 'domwindowopened');
+    }
+}
+
+class WindowScroll {
+    constructor(win) {
+        this.win = win;
+        this.doc = win.document;
+        this.toolbox = this.doc.getElementById('navigator-toolbox');
+        this.root = this.doc.documentElement;
+        this.gBrowser = win.gBrowser;
+        this.hide = new HideOnScroll(this);
+        this.pull = new PullToRefresh(this);
+    }
+
+    onMessage(browser, name, data) {
+        if (browser !== this.gBrowser.selectedBrowser) return;
+        switch (name) {
+            case 'McfScroll:Scroll': this.hide.onScroll({ dy: Number(data.dy) || 0, y: Number(data.y) || 0 }); break;
+            case 'McfScroll:Touch': this.hide.onTouch(!!data.down); break;
+            case 'McfScroll:Pull': this.pull.onPull(Math.max(0, Number(data.total) || 0)); break;
+            case 'McfScroll:PullEnd': this.pull.onPullEnd({ release: !!data.release }); break;
+        }
+    }
+}
+
+class HideOnScroll {
+    constructor(owner) {
+        this.o = owner;
+        const { win, doc, toolbox } = owner;
+        this.height = 0; // toolbar height, max
+        this.visible = 0; // part of it that is shown
+        this.active = false;
+        this.touching = false;
+        this.anim = null;
+        this.timer = 0;
+        this.quietUntil = 0;
+        this.dir = 0;
+
+        for (const name of [PREF_HIDE, PREF_TOP]) Services.prefs.addObserver(name, this);
+        win.addEventListener('unload', () => {
+            for (const name of [PREF_HIDE, PREF_TOP]) Services.prefs.removeObserver(name, this);
+        }, { once: true });
+        new win.ResizeObserver(() => this.update()).observe(toolbox);
+        win.addEventListener('resize', () => this.update());
+        win.addEventListener('fullscreen', () => this.update());
+        // The tab changed or a page started loading: Fenix shows the toolbar.
+        win.gBrowser.tabContainer.addEventListener('TabSelect', () => this.expand());
+        win.gBrowser.addTabsProgressListener({
+            onLocationChange: (browser, webProgress, request, location, flags) => {
+                if (browser === win.gBrowser.selectedBrowser && webProgress.isTopLevel) {
+                    this.apply(browser);
+                    if (!(flags & Ci.nsIWebProgressListener.LOCATION_CHANGE_SAME_DOCUMENT)) this.expand();
+                }
+            },
+        });
+        // The URL bar is being used, or a find bar takes the bottom of the page.
+        doc.addEventListener('focusin', e => { if (e.target.id === 'urlbar-input') this.expand(); });
+        doc.addEventListener('findbaropen', () => this.update(), true);
+        doc.addEventListener('findbarclose', () => this.update(), true);
+        this.update();
+    }
+
+    observe() { this.update(); }
+
+    get _browser() { return this.o.gBrowser.selectedBrowser; }
+    get _atTop() { return Services.prefs.getBoolPref(PREF_TOP, false); }
+
+    _findBarOpen() {
+        const bar = this.o.gBrowser.getCachedFindBar?.(this.o.gBrowser.selectedTab);
+        return !!bar && !bar.hidden;
+    }
+
+    _wanted() {
+        const { win, toolbox } = this.o;
+        return Services.prefs.getBoolPref(PREF_HIDE, true) &&
+            win.innerWidth <= NARROW &&
+            !win.fullScreen &&
+            !toolbox.hidden && !this._findBarOpen();
+    }
+
+    // (De)activate and re-measure.
+    update() {
+        const { root, toolbox } = this.o;
+        const wanted = this._wanted();
+        const h = wanted ? Math.round(toolbox.getBoundingClientRect().height) : 0;
+        if (wanted && !h) return;
+        if (!wanted) {
+            if (this.active) this._deactivate();
+            return;
+        }
+        if (!this.active) {
+            this.active = true;
+            // The page is resized now; the scroll that causes isn't the user's.
+            this.quietUntil = this.o.win.performance.now() + 500;
+            root.setAttribute('mcf-dynamic-toolbar', '');
+        }
+        if (h !== this.height) {
+            this.height = h;
+            this.visible = h;
+            root.style.setProperty('--mcf-dynamic-toolbar-height', h + 'px');
+            this.apply(this._browser);
+        }
+    }
+
+    _deactivate() {
+        const { root, toolbox } = this.o;
+        this.active = false;
+        this._stopAnim();
+        root.removeAttribute('mcf-dynamic-toolbar');
+        root.style.removeProperty('--mcf-dynamic-toolbar-height');
+        toolbox.style.removeProperty('translate');
+        this._browser.style.removeProperty('top');
+        this.height = 0;
+        this.visible = 0;
+        this._setBrowser(this._browser, 0, 0);
+    }
+
+    _setBrowser(browser, max, offset) {
+        try {
+            const bc = browser?.browsingContext;
+            if (!bc) return;
+            InspectorUtils.setDynamicToolbarMaxHeight(bc, max);
+            InspectorUtils.setVerticalClipping(bc, offset);
+        } catch (e) { /* no browsing context yet */ }
+    }
+
+    // Push the current state to the selected page.
+    apply(browser) {
+        if (!this.active) return;
+        this._setBrowser(browser, this.height, this.visible - this.height);
+    }
+
+    render() {
+        const { toolbox } = this.o;
+        const hidden = this.height - this.visible;
+        // Bottom toolbar slides down, a top one slides up (and pushes the page up).
+        toolbox.style.translate = hidden ? `0 ${this._atTop ? -hidden : hidden}px` : '';
+        if (this._atTop) this._browser.style.top = this.visible + 'px';
+        this.apply(this._browser);
+    }
+
+    setVisible(px) {
+        this.visible = Math.min(this.height, Math.max(0, px));
+        this.render();
+    }
+
+    expand() {
+        if (!this.active) return;
+        this._stopAnim();
+        this.setVisible(this.height);
+    }
+
+    editing() {
+        return this.o.doc.getElementById('urlbar')?.hasAttribute('focused');
+    }
+
+    onTouch(down) {
+        this.touching = down;
+        if (down) this._stopAnim();
+        this._schedule();
+    }
+
+    onScroll({ dy, y }) {
+        if (!this.active || this.editing() || this.o.win.performance.now() < this.quietUntil) return;
+        this._stopAnim();
+        if (y <= 0) {
+            // At the top the toolbar is always there.
+            this.dir = -1;
+            this.setVisible(this.height);
+        } else if (dy) {
+            this.dir = Math.sign(dy);
+            // The toolbar follows the content: down hides, up shows.
+            this.setVisible(this.visible - dy);
+        }
+        this._schedule();
+    }
+
+    // Once the finger is up and the page has stopped, snap all the way in the
+    // direction of the last scroll: any scroll up brings the toolbar back, any
+    // scroll down takes it away (AC's ViewHideOnScrollBehavior snapping; RDM's
+    // simulation snaps to the nearer end instead).
+    _schedule() {
+        const { win } = this.o;
+        win.clearTimeout(this.timer);
+        this.timer = win.setTimeout(() => {
+            if (this.touching || !this.active) return;
+            if (this.visible <= 0 || this.visible >= this.height) return;
+            this._snapTo(this.dir > 0 ? 0 : this.height);
+        }, SETTLE_MS);
+    }
+
+    _snapTo(target) {
+        const { win } = this.o;
+        const from = this.visible;
+        const start = win.performance.now();
+        const step = (now) => {
+            const t = Math.min(1, (now - start) / SNAP_MS);
+            const k = t * t * (2 - t);
+            this.setVisible(from + (target - from) * k);
+            this.anim = t < 1 ? win.requestAnimationFrame(step) : null;
+        };
+        this.anim = win.requestAnimationFrame(step);
+    }
+
+    _stopAnim() {
+        if (this.anim) this.o.win.cancelAnimationFrame(this.anim);
+        this.anim = null;
+    }
+}
+
+class PullToRefresh {
+    constructor(owner) {
+        this.o = owner;
+        this.el = null;
+        this.state = 'idle'; // idle | dragging | refreshing | returning
+        this.top = -CIRCLE;
+        this.raf = 0;
+        const { win, gBrowser } = owner;
+        gBrowser.addTabsProgressListener({
+            onStateChange: (browser, webProgress, request, flags) => {
+                const stop = Ci.nsIWebProgressListener.STATE_STOP | Ci.nsIWebProgressListener.STATE_IS_NETWORK;
+                if (this.state === 'refreshing' && browser === gBrowser.selectedBrowser &&
+                    webProgress.isTopLevel && (flags & stop) === stop) {
+                    this.finish();
+                }
+            },
+        });
+        gBrowser.tabContainer.addEventListener('TabSelect', () => this.reset());
+    }
+
+    _build() {
+        if (this.el) return;
+        const { doc } = this.o;
+        const el = doc.createElementNS(HTML, 'div');
+        el.id = 'mcf-pull-to-refresh';
+        const svg = doc.createElementNS(SVG, 'svg');
+        svg.setAttribute('viewBox', '-20 -20 40 40');
+        svg.setAttribute('width', CIRCLE);
+        svg.setAttribute('height', CIRCLE);
+        const g = doc.createElementNS(SVG, 'g');
+        const arc = doc.createElementNS(SVG, 'circle');
+        arc.setAttribute('r', 7.5 + 1.25); // CircularProgressDrawable.DEFAULT: radius 7.5, stroke 2.5
+        arc.setAttribute('fill', 'none');
+        arc.setAttribute('stroke', 'currentColor');
+        arc.setAttribute('stroke-width', 2.5);
+        const arrow = doc.createElementNS(SVG, 'path');
+        arrow.setAttribute('fill', 'currentColor');
+        g.append(arc, arrow);
+        svg.append(g);
+        el.append(svg);
+        this.o.doc.documentElement.append(el);
+        this.el = el;
+        this.g = g;
+        this.arc = arc;
+        this.arrow = arrow;
+        this.circumference = 2 * Math.PI * (7.5 + 1.25);
+    }
+
+    // Place the circle: its top edge `top` dp below the top of the page.
+    _place(top) {
+        this.top = top;
+        const rect = this.o.gBrowser.selectedBrowser.getBoundingClientRect();
+        const el = this.el;
+        el.style.left = rect.left + rect.width / 2 - CIRCLE / 2 + 'px';
+        el.style.top = rect.top + top + 'px';
+    }
+
+    // The spinner while a finger drags, the geometry of SwipeRefreshLayout.moveSpinner().
+    onPull(total) {
+        if (!Services.prefs.getBoolPref(PREF_PULL, true)) return;
+        this._build();
+        if (this.state === 'returning' || this.state === 'refreshing') {
+            if (this.state === 'refreshing') return;
+            this._stopReturn();
+        }
+        this.state = 'dragging';
+        const over = total * DRAG_RATE;
+        const originalDragPercent = over / TOTAL_DRAG;
+        const dragPercent = Math.min(1, Math.abs(originalDragPercent));
+        const adjustedPercent = Math.max(dragPercent - 0.4, 0) * 5 / 3;
+        const extraOS = Math.abs(over) - TOTAL_DRAG;
+        const slingshot = TOTAL_DRAG;
+        const tensionSlingshotPercent = Math.max(0, Math.min(extraOS, slingshot * 2) / slingshot);
+        const tensionPercent = (tensionSlingshotPercent / 4 - Math.pow(tensionSlingshotPercent / 4, 2)) * 2;
+        const extraMove = slingshot * tensionPercent * 2;
+        this._place(-CIRCLE + slingshot * dragPercent + extraMove);
+        const el = this.el;
+        el.hidden = false;
+        el.classList.remove('refreshing');
+        // Alpha: 30% while the pull is short, full once it'd refresh.
+        el.style.setProperty('--mcf-ptr-alpha', dragPercent < 1 ? '0.3' : '1');
+        // The arc grows with the pull; the arrow head with it.
+        const trimEnd = adjustedPercent * MAX_PROGRESS_ANGLE;
+        const rotation = (-0.25 + 0.4 * adjustedPercent + tensionPercent * 2) * 0.5;
+        this.arc.setAttribute('stroke-dasharray', `${this.circumference * trimEnd} ${this.circumference}`);
+        this.g.setAttribute('transform', `rotate(${rotation * 360})`);
+        this._arrow(trimEnd, Math.min(1, adjustedPercent));
+        this.armed = over > TOTAL_DRAG;
+    }
+
+    _arrow(trimEnd, scale) {
+        // A triangle at the end of the arc, pointing along it.
+        const r = 7.5 + 1.25;
+        const a = trimEnd * 2 * Math.PI;
+        const w = 5 * scale;
+        if (w < 0.5) { this.arrow.setAttribute('d', ''); return; }
+        const cx = r * Math.cos(a), cy = r * Math.sin(a);
+        const tx = -Math.sin(a), ty = Math.cos(a); // tangent
+        const nx = Math.cos(a), ny = Math.sin(a); // radial
+        const p = (u, v) => `${(cx + tx * u + nx * v).toFixed(2)},${(cy + ty * u + ny * v).toFixed(2)}`;
+        this.arrow.setAttribute('d', `M${p(w, 0)} L${p(0, w / 1.2)} L${p(0, -w / 1.2)} Z`);
+    }
+
+    onPullEnd({ release }) {
+        if (this.state !== 'dragging') return;
+        if (release && this.armed) this.startRefresh();
+        else this._returnToStart();
+    }
+
+    startRefresh() {
+        this.state = 'refreshing';
+        const el = this.el;
+        el.classList.add('refreshing');
+        el.style.setProperty('--mcf-ptr-alpha', '1');
+        this.arc.removeAttribute('stroke-dasharray');
+        this.arrow.setAttribute('d', '');
+        this.g.removeAttribute('transform');
+        // Settle at the spinning position (SwipeRefreshLayout: mSpinnerOffsetEnd - circle).
+        this._animateTo(TOTAL_DRAG - CIRCLE, 200);
+        try { this.o.gBrowser.selectedBrowser.reload(); } catch (e) { console.error(e); }
+        // A page that never finishes loading shouldn't leave it spinning for good.
+        this.o.win.clearTimeout(this.giveUp);
+        this.giveUp = this.o.win.setTimeout(() => this.finish(), 30000);
+    }
+
+    finish() {
+        this.o.win.clearTimeout(this.giveUp);
+        if (this.state === 'refreshing') this._returnToStart();
+    }
+
+    _returnToStart() {
+        this.state = 'returning';
+        this._animateTo(-CIRCLE, ANIMATE_TO_START_MS, () => this.reset());
+    }
+
+    _animateTo(target, ms, done) {
+        const { win } = this.o;
+        this._stopReturn();
+        const from = this.top;
+        const start = win.performance.now();
+        const step = (now) => {
+            const t = Math.min(1, (now - start) / ms);
+            this._place(from + (target - from) * (1 - (1 - t) * (1 - t)));
+            if (t < 1) this.raf = win.requestAnimationFrame(step);
+            else { this.raf = 0; done?.(); }
+        };
+        this.raf = win.requestAnimationFrame(step);
+    }
+
+    _stopReturn() {
+        if (this.raf) this.o.win.cancelAnimationFrame(this.raf);
+        this.raf = 0;
+    }
+
+    reset() {
+        this._stopReturn();
+        this.state = 'idle';
+        if (this.el) { this.el.hidden = true; this.el.classList.remove('refreshing'); }
+    }
+}
diff --git a/src/modules/PanelToggle.sys.mjs b/src/modules/PanelToggle.sys.mjs
new file mode 100644
index 0000000..37f2d3d
--- /dev/null
+++ b/src/modules/PanelToggle.sys.mjs
@@ -0,0 +1,119 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Backport of the fix for Firefox bug 2067688 (fixed in Firefox 158), so
+ * that tapping a toolbar button again closes its panel or popup.
+ *
+ * On GTK, a touch that starts outside an open popup rolls the popup up in
+ * nsWindow::OnTouchEvent(). Up to Firefox 157, OnTouchEvent() then returns
+ * FALSE even when the popup manager asked for the touch to be consumed, so
+ * GTK's gtk_widget_real_touch_event() replays it as a mouse press, in the
+ * same event dispatch. That press reaches whatever is under the finger: the
+ * toolbar button that opened the panel opens it again (extension buttons,
+ * the extensions button, the app menu, all tabs, downloads...), and a tap
+ * on the page to dismiss a panel clicks the page. Firefox 158 returns TRUE
+ * there instead, so nothing is replayed.
+ *
+ * Here: when a panel or menu hides, remember it until the current task ends.
+ * A mousedown that arrives before then is the replayed press of the touch
+ * that rolled the popup up, and is swallowed if the popup manager would have
+ * consumed it (nsXULPopupManager::RollupInternal(): consumeoutsideclicks
+ * "true" or unset consumes every press, "false" only presses on the anchor,
+ * "never" none). A real mouse press goes through the same rollup check
+ * before it reaches the DOM and is already consumed in exactly those cases,
+ * so no mouse press that Firefox would deliver is swallowed.
+ */
+export class PanelToggle {
+    init() {
+        // Firefox 158+ consumes the touch itself.
+        if (parseInt(Services.appinfo.version, 10) >= 158) return;
+
+        const windowObserver = {
+            observe: (subject, topic) => {
+                if (topic === 'domwindowopened') {
+                    const window = subject;
+                    window.addEventListener('load', () => {
+                        if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                        this._setupForWindow(window);
+                    }, { once: true });
+                }
+            }
+        };
+
+        Services.obs.addObserver(windowObserver, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+        // Popups that hid during the current task.
+        let rolledUp = [];
+        // After swallowing a press, also swallow the rest of that click.
+        let swallowUntil = 0;
+
+        document.addEventListener('popuphiding', (event) => {
+            const popup = event.target;
+            if (popup.localName !== 'panel' && popup.localName !== 'menupopup') return;
+            // A popup inside another (a submenu) rolls up with its parent.
+            const anchorRect = this._consumeAnchorRect(popup);
+            if (!rolledUp.length) {
+                // The replayed press is dispatched before the task that
+                // rolled the popup up ends; anything later is a new input.
+                Services.tm.dispatchToMainThread(() => { rolledUp = []; });
+            }
+            rolledUp.push({ mode: popup.getAttribute('consumeoutsideclicks'), anchorRect });
+        }, true);
+
+        const swallow = (event) => {
+            event.preventDefault();
+            event.stopImmediatePropagation();
+            // Don't forward it to a remote page under the finger either.
+            event.stopCrossProcessForwarding?.();
+        };
+
+        window.addEventListener('mousedown', (event) => {
+            swallowUntil = 0;
+            if (!rolledUp.length || event.button !== 0) return;
+            const consumed = rolledUp.some(({ mode, anchorRect }) => {
+                if (mode === 'never') return false;
+                if (mode !== 'false') return true;
+                return !!anchorRect &&
+                    event.clientX >= anchorRect.left && event.clientX < anchorRect.right &&
+                    event.clientY >= anchorRect.top && event.clientY < anchorRect.bottom;
+            });
+            rolledUp = [];
+            if (!consumed) return;
+            swallow(event);
+            swallowUntil = window.performance.now() + 1000;
+        }, true);
+
+        // GTK only replays the press (the touch end is handled), but should a
+        // release follow, it belongs to the swallowed press. Any new input
+        // ends that.
+        window.addEventListener('touchstart', () => { swallowUntil = 0; }, true);
+        for (const type of ['mouseup', 'click']) {
+            window.addEventListener(type, (event) => {
+                if (!swallowUntil) return;
+                if (window.performance.now() > swallowUntil) {
+                    swallowUntil = 0;
+                    return;
+                }
+                swallow(event);
+                if (type === 'click') swallowUntil = 0;
+            }, true);
+        }
+    }
+
+    // The anchor area that consumes presses for consumeoutsideclicks="false"
+    // popups: the anchor, or the element named by its consumeanchor
+    // attribute (nsXULPopupManager::RollupInternal()).
+    _consumeAnchorRect(popup) {
+        let anchor = popup.anchorNode;
+        if (!anchor || !anchor.getBoundingClientRect) return null;
+        const consumeAnchor = anchor.getAttribute?.('consumeanchor');
+        if (consumeAnchor) {
+            anchor = popup.ownerDocument.getElementById(consumeAnchor) || anchor;
+        }
+        return anchor.getBoundingClientRect();
+    }
+}
diff --git a/src/modules/PermissionDialog.sys.mjs b/src/modules/PermissionDialog.sys.mjs
new file mode 100644
index 0000000..87297c0
--- /dev/null
+++ b/src/modules/PermissionDialog.sys.mjs
@@ -0,0 +1,149 @@
+// Copyright 2026 Noa Himesaka
+// SPDX-License-Identifier: MPL-2.0
+
+/**
+ * Site permission prompts like Firefox for Android: the doorhanger becomes
+ * Fenix's SitePermissionsDialogFragment, a sheet at the bottom of the
+ * window with the permission's icon and the question as its title, an
+ * optional "Remember decision for this site" check box, and "Don't allow"
+ * (outlined) and "Allow" buttons. Dimming, layout and sizes are in
+ * dialogs.css (#notification-popup[mcf-sheet]).
+ *
+ * Desktop's own doorhanger does the work (its buttons and check box); this
+ * relabels it and hides what Fenix doesn't show (Learn more, device pickers).
+ *
+ * Fenix: android-components feature/sitepermissions
+ * SitePermissionsFeature.kt handlingSingleContentPermissions() (titles,
+ * icons, which prompts have the check box), SitePermissionsDialogFragment
+ * .kt (buttons, notification prompts say Always / Never),
+ * mozac_site_permissions_prompt.xml, strings.xml.
+ */
+
+import { isMobileLayout } from 'chrome://mobileconfigfirefox/content/FenixDialogs.sys.mjs';
+
+const ICON = (name) => `chrome://browser/skin/notification-icons/${name}.svg`;
+
+// popupid of desktop's notification -> Fenix's prompt.
+// `remember`: 'ask' = check box (not checked), 'always' = no check box and
+// the decision is remembered (shouldSelectDoNotAskAgainCheckBox = true).
+const PROMPTS = {
+    'geolocation': { title: (h) => `Allow ${h} to use your location?`, icon: 'geo', remember: 'ask' },
+    'web-notifications': { title: (h) => `Allow ${h} to send notifications?`, icon: 'desktop-notification', remember: 'always', notification: true },
+    'persistent-storage': { title: (h) => `Allow ${h} to store data in persistent storage?`, icon: 'persistent-storage', remember: 'always' },
+    'webRTC-shareMicrophone': { title: (h) => `Allow ${h} to use your microphone?`, icon: 'microphone', remember: 'ask' },
+    'webRTC-shareDevices': { title: null, icon: 'camera', remember: 'ask' },
+};
+
+// Fenix: trimOriginHttpsSchemeAndPort(): no https scheme, no default port.
+function trimOrigin(uri) {
+    try {
+        const url = new URL(uri.prePath);
+        const scheme = url.protocol === 'https:' ? '' : url.protocol + '//';
+        return scheme + url.host;
+    } catch (e) {
+        return uri.host;
+    }
+}
+
+export class PermissionDialog {
+    init() {
+        Services.obs.addObserver({
+            observe: (subject, topic) => {
+                if (topic !== 'domwindowopened') return;
+                const window = subject;
+                window.addEventListener('load', () => {
+                    if (window.location.href !== 'chrome://browser/content/browser.xhtml') return;
+                    this._setupForWindow(window);
+                }, { once: true });
+            },
+        }, 'domwindowopened');
+    }
+
+    _setupForWindow(window) {
+        const document = window.document;
+        const panel = document.getElementById('notification-popup');
+        if (!panel) return;
+
+        panel.addEventListener('popupshowing', (event) => {
+            if (event.target !== panel) return;
+            panel.removeAttribute('mcf-sheet');
+            if (!isMobileLayout(window)) return;
+            const notification = panel.querySelector('popupnotification:not([hidden])');
+            const spec = notification && PROMPTS[notification.getAttribute('popupid')];
+            if (!spec) return;
+            this._restyle(window, notification, spec);
+            panel.setAttribute('mcf-sheet', notification.getAttribute('popupid'));
+        });
+        // The sheet is as wide as the window (popups.css), so it starts at the
+        // window's side whatever the doorhanger's anchor is; a popup that
+        // would stick out of the screen gets moved by the compositor and the
+        // taps then land beside the buttons they're on.
+        panel.addEventListener('popupshown', (event) => {
+            if (event.target !== panel || !panel.hasAttribute('mcf-sheet')) return;
+            const rect = panel.getOuterScreenRect();
+            if (Math.abs(rect.x - window.mozInnerScreenX) > 1) {
+                panel.moveTo(Math.round(window.mozInnerScreenX), Math.round(rect.y));
+            }
+        });
+        panel.addEventListener('popuphidden', (event) => {
+            if (event.target === panel) panel.removeAttribute('mcf-sheet');
+        });
+    }
+
+    _restyle(window, notification, spec) {
+        const document = window.document;
+        const host = trimOrigin(window.gBrowser.currentURI);
+
+        let title = spec.title?.(host);
+        let icon = spec.icon;
+        if (!title) {
+            // webRTC-shareDevices: camera, or camera and microphone.
+            const mic = document.getElementById('webRTC-selectMicrophone');
+            const camera = document.getElementById('webRTC-selectCamera');
+            const hasMic = mic && !mic.hidden && mic.closest('popupnotification') === notification;
+            const hasCamera = !camera || camera.hidden ? false : true;
+            if (hasMic && hasCamera) {
+                title = `Allow ${host} to use your camera and microphone?`;
+                icon = 'microphone';
+            } else if (hasMic) {
+                title = `Allow ${host} to use your microphone?`;
+                icon = 'microphone';
+            } else {
+                title = `Allow ${host} to use your camera?`;
+            }
+        }
+
+        const description = notification.querySelector('.popup-notification-description');
+        description.textContent = title;
+        notification.style.setProperty('--mcf-perm-icon', `url("${ICON(icon)}")`);
+
+        // Buttons.
+        notification.removeAttribute('buttonaccesskey');
+        notification.removeAttribute('secondarybuttonaccesskey');
+        const primary = notification.querySelector('.popup-notification-primary-button');
+        const secondary = notification.querySelector('.popup-notification-secondary-button');
+        const allow = spec.notification ? 'Always' : 'Allow';
+        const deny = spec.notification ? 'Never' : 'Don’t allow';
+        for (const [button, label] of [[primary, allow], [secondary, deny]]) {
+            if (!button) continue;
+            button.setAttribute('label', label);
+            button.label = label;
+            // No "(B)" access key hint on a touch screen.
+            button.removeAttribute('accesskey');
+            button.accessKey = '';
+        }
+
+        // "Remember decision for this site" only where Fenix has it.
+        const checkbox = notification.querySelector('.popup-notification-checkbox');
+        if (checkbox) {
+            if (spec.remember === 'ask') {
+                checkbox.checked = false;
+                checkbox.label = 'Remember decision for this site';
+            } else {
+                // Always remembered.
+                checkbox.checked = true;
+                checkbox.hidden = true;
+            }
+        }
+    }
+}
