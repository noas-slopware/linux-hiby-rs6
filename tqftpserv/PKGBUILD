# Maintainer: Noa Himesaka <himesaka@noa.codes>
#
# TFTP over QRTR for the remote processors (the modem fetches files from the rootfs), 1.3 as on Alpine
# (with zstd/xz support for compressed firmware). Not in the Arch Ports repos (the AUR has 1.2).

pkgname=tqftpserv
pkgver=1.3
pkgrel=1
pkgdesc='Trivial File Transfer Protocol server over AF_QIPCRTR'
url='https://github.com/linux-msm/tqftpserv'
arch=(aarch64)
license=(BSD-3-Clause)
depends=(glibc qrtr xz zstd)
makedepends=(meson systemd)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver/tqftpserv-v$pkgver.tar.gz")
sha256sums=('87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f')

build() {
  arch-meson $pkgname-$pkgver build \
    -D systemd-unit-prefix=/usr/lib/systemd/system
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
  install -Dm644 $pkgname-$pkgver/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
