+#pragma once
+
+#include "hangulinputsession.h"
+
+#include <QElapsedTimer>
+#include <QVirtualKeyboardAbstractInputMethod>
+#include <qqmlintegration.h>
+
+/**
+ * Korean (dubeolsik) input method that composes syllables in the preedit.
+ *
+ * Replaces Qt Virtual Keyboard's HangulInputMethod, which composes by
+ * rewriting the character before the cursor (commit with replacement).
+ * plasma-keyboard can only forward that as delete_surrounding_text followed
+ * by commit_string, against surrounding text that lags behind the
+ * application. That gave separated jamo (ㅎㅓ instead of 허) and, in Firefox,
+ * doubled text.
+ */
+class HangulPreeditInputMethod : public QVirtualKeyboardAbstractInputMethod
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+public:
+    explicit HangulPreeditInputMethod(QObject *parent = nullptr);
+
+    QList<QVirtualKeyboardInputEngine::InputMode> inputModes(const QString &locale) override;
+    bool setInputMode(const QString &locale, QVirtualKeyboardInputEngine::InputMode inputMode) override;
+    bool setTextCase(QVirtualKeyboardInputEngine::TextCase textCase) override;
+
+    bool keyEvent(Qt::Key key, const QString &text, Qt::KeyboardModifiers modifiers) override;
+
+    void reset() override;
+    void update() override;
+
+private:
+    HangulInputSession::Snapshot snapshot() const;
+    void apply(const HangulInputSession::Actions &actions);
+
+    HangulInputSession m_session;
+    QElapsedTimer m_clock;
+};
