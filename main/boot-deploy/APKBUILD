a243975b9850d9933e0f917f7eb38fc4a76ea658c3dcc56f035f60ee6c62d6740c1107143b8210bdc0231d4c9b6b2003e458120985604eb09649322d359ae89f  os-customization
535b8c355a777acab9d53a60a2ca0cfa5acbfcf2c3858793cfdecfadf489190966e3a2854feba96a99521c9a75bae4c962f901dcb7c5b8512d0d8f28d4168701  0001-extlinux-add-the-entries-from-extlinux.d.patch
