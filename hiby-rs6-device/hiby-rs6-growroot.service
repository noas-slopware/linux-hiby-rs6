# SPDX-License-Identifier: MIT
# HiBy RS6 (hiby-rs6-boot), initramfs only: grow the F2FS root to the whole arch_root partition.
# Images ship the root file system sized to its content; F2FS can only grow offline, so this runs
# before the root is checked and mounted. On a file system that already fills the partition
# resize.f2fs prints "Nothing to resize." and writes nothing; on one that was not unmounted
# cleanly it refuses (the kernel replays the log at mount) and the next boot grows it.
# -F only skips resize.f2fs's interactive "continue? [y/n]" prompt.
# One time only: it runs while the kernel command line has hiby_rs6.growroot, which hiby-rs6-extlinux
# adds until /var/lib/hiby-rs6/root-grown exists; hiby-rs6-growroot-done.service writes that marker on
# the real root once the file system fills the partition and rewrites extlinux.conf without the flag.
[Unit]
Description=Grow the root file system to the arch_root partition
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
ConditionKernelCommandLine=hiby_rs6.growroot
BindsTo=dev-disk-by\x2dpartlabel-arch_root.device
After=dev-disk-by\x2dpartlabel-arch_root.device
Before=systemd-fsck-root.service sysroot.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/resize.f2fs -F /dev/disk/by-partlabel/arch_root
StandardInput=null
StandardOutput=journal+console
