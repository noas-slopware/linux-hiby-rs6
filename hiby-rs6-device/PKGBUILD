_us() { echo "$srcdir/linux-hiby-rs6-$_rs6commit/userspace"; }

prepare() {
  cd "$(_us)"
  # Arch has no /usr/libexec convention: the VT lock helper lives with the other RS6 helpers
  # (userspace/ should move it there for every distro, dumps/arch-ports-plan.md section 8)
  sed -i 's|/usr/libexec/rs6-vt-lock|/usr/lib/hiby-rs6/rs6-vt-lock|' vt-lock/rs6-vt-lock.service
}

build() {
  cd "$(_us)"
  # plain cc: the same commands build them on musl and glibc
  ${CC:-cc} $CFLAGS -shared -fPIC -Wall -o "$srcdir"/firefox-v4l2-fix.so firefox/firefox-v4l2-fix.c \
    $(pkg-config --cflags libavcodec) -ldl -lpthread $LDFLAGS
  ${CC:-cc} $CFLAGS -Wall -o "$srcdir"/rs6-touchboost touchboost/rs6-touchboost.c $LDFLAGS
  ${CC:-cc} $CFLAGS -Wall -o "$srcdir"/darwinctl darwinctl/darwinctl.c -lasound $LDFLAGS
  ${CC:-cc} $CFLAGS -Wall -o "$srcdir"/rs6-vt-lock vt-lock/rs6-vt-lock.c $LDFLAGS
}

package_hiby-rs6-device() {
  pkgdesc="$pkgdesc (meta package)"
  depends=(
    firmware-hiby-rs6
    hiby-rs6-audio
    hiby-rs6-boot
    hiby-rs6-plasma
    hiby-rs6-system
    linux-hiby-rs6
    linux-hiby-rs6-dtbs
    rs6-dac-plasma
    rs6-mirrorlist
    rs6-spdif
  )
  optdepends=('hiby-rs6-firefox: hardware video decoding in Firefox')
}

package_hiby-rs6-system() {
  pkgdesc="$pkgdesc (system configuration and helpers)"
  depends=(
    bluez
    bluez-utils
    bootmac
    dnsmasq
    glibc
    iio-sensor-proxy
    networkmanager
    nftables
    qcom-diag
    rmtfs
    swclock-offset
    systemd
    tqftpserv
    util-linux
    wireless-regdb
    zram-generator
  )
  local us; us=$(_us)

  install -Dm644 "$us"/system/udev-rs6-no-ssc.rules "$pkgdir"/usr/lib/udev/rules.d/91-hiby-rs6-no-ssc.rules
  install -Dm644 "$us"/system/90-hiby-rs6-perf.rules -t "$pkgdir"/usr/lib/udev/rules.d/
  install -Dm644 "$us"/system/hiby-rs6-perf.conf -t "$pkgdir"/usr/lib/tmpfiles.d/

  # 8 GiB swap on arch_swap1 + arch_swap2 behind zram: systemd-gpt-auto-generator activates them
  install -Dm644 "$srcdir"/zram-generator.conf -t "$pkgdir"/usr/lib/systemd/
  install -Dm644 "$srcdir"/90-hiby-rs6-zram.sysctl "$pkgdir"/usr/lib/sysctl.d/90-hiby-rs6-zram.conf

  # touch boost, VT lock
  install -Dm755 "$srcdir"/rs6-touchboost "$srcdir"/rs6-vt-lock -t "$pkgdir"/usr/lib/hiby-rs6/
  install -Dm644 "$us"/touchboost/rs6-touchboost.service "$us"/vt-lock/rs6-vt-lock.service \
    -t "$pkgdir"/usr/lib/systemd/system/

  # one VT, no gettys on the others
  install -Dm644 "$us"/system/logind-hiby-rs6.conf "$pkgdir"/usr/lib/systemd/logind.conf.d/50-hiby-rs6.conf

  # shutdown/reboot can never hang: stop timeouts, forced targets, watchdog in the last stage
  install -Dm644 "$us"/system/hiby-rs6-shutdown.conf \
    "$pkgdir"/usr/lib/systemd/system.conf.d/50-hiby-rs6-shutdown.conf
  local t
  for t in poweroff reboot halt; do
    install -Dm644 "$us"/system/hiby-rs6-shutdown-target.conf \
      "$pkgdir"/usr/lib/systemd/system/$t.target.d/50-hiby-rs6.conf
  done

  # no cellular on a DAP: the modem DSP stays (WCN3990 Wi-Fi runs on it), ModemManager does not
  install -dm755 "$pkgdir"/etc/systemd/system
  ln -s /dev/null "$pkgdir"/etc/systemd/system/ModemManager.service

  # firewall: only SSH and Tailscale open (plus DHCP/DNS for the host on the USB network)
  install -Dm644 "$srcdir"/nftables-hiby-rs6.conf "$pkgdir"/usr/share/hiby-rs6/nftables.conf
  install -Dm644 "$srcdir"/nftables-hiby-rs6.service.conf \
    "$pkgdir"/usr/lib/systemd/system/nftables.service.d/50-hiby-rs6.conf

  # USB network at 172.16.42.1 (replaces usb-signaller + unudhcpd; no MTP)
  install -Dm755 "$srcdir"/hiby-rs6-usbnet -t "$pkgdir"/usr/lib/hiby-rs6/
  install -Dm644 "$srcdir"/hiby-rs6-usbnet.service -t "$pkgdir"/usr/lib/systemd/system/
  install -Dm644 "$srcdir"/90-hiby-rs6-usbnet.rules -t "$pkgdir"/usr/lib/udev/rules.d/
  install -Dm644 "$srcdir"/86-hiby-rs6-usbnet-nm.rules -t "$pkgdir"/usr/lib/udev/rules.d/
  install -Dm600 "$srcdir"/hiby-rs6-usb.nmconnection -t "$pkgdir"/usr/lib/NetworkManager/system-connections/
  install -Dm644 "$srcdir"/NetworkManager-hiby-rs6-wifi.conf "$pkgdir"/usr/lib/NetworkManager/conf.d/60-hiby-rs6-wifi.conf

  install -Dm644 "$srcdir"/80-hiby-rs6.preset -t "$pkgdir"/usr/lib/systemd/system-preset/
}

package_hiby-rs6-boot() {
  pkgdesc="$pkgdesc (extlinux.conf for U-Boot, initramfs)"
  depends=(
    coreutils
    f2fs-tools
    firmware-hiby-rs6
    mkinitcpio
    sed
  )
  backup=(etc/mkinitcpio.conf.d/hiby-rs6.conf)
  local us; us=$(_us)

  install -Dm755 "$srcdir"/hiby-rs6-extlinux -t "$pkgdir"/usr/bin/
  install -Dm644 "$srcdir"/95-hiby-rs6-extlinux.hook -t "$pkgdir"/usr/share/libalpm/hooks/
  install -Dm644 "$us"/system/kernel-cmdline.conf -t "$pkgdir"/usr/share/hiby-rs6/
  install -dm755 "$pkgdir"/usr/share/hiby-rs6/extlinux.d "$pkgdir"/etc/hiby-rs6/extlinux.d

  install -Dm644 "$us"/system/modules-initfs -t "$pkgdir"/usr/share/hiby-rs6/
  install -Dm644 "$srcdir"/hiby-rs6.initcpio-install "$pkgdir"/usr/lib/initcpio/install/hiby-rs6
  # initramfs only (the hook adds it): grows the F2FS root to the whole arch_root partition
  install -Dm644 "$srcdir"/hiby-rs6-growroot.service -t "$pkgdir"/usr/lib/systemd/system/
  install -Dm644 "$srcdir"/hiby-rs6-growroot-done.service -t "$pkgdir"/usr/lib/systemd/system/
  install -Dm644 "$srcdir"/mkinitcpio-hiby-rs6.conf "$pkgdir"/etc/mkinitcpio.conf.d/hiby-rs6.conf
}

package_hiby-rs6-audio() {
  pkgdesc="$pkgdesc (UCM, PipeWire and WirePlumber configuration, darwinctl)"
  depends=(
    alsa-lib
    alsa-ucm-conf
    alsa-utils
    firmware-hiby-rs6
    glibc
    pipewire
    pipewire-alsa
    pipewire-pulse
    rs6-spdif
    rtkit
    # Elisa's libvlc: without it VLC falls back to ALSA, where the exclusive pulse.rules for Elisa
    # and its bit-perfect stream volume lock never apply
    vlc-plugin-pulse
    wireplumber
  )
  backup=(etc/xdg/plasmaparc etc/security/limits.d/25-hiby-rs6-audio.conf)
  local us; us=$(_us)

  install -Dm644 "$us"/audio/ucm-card.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sdm660/HiBy RS6.conf"
  install -Dm644 "$us"/audio/ucm-HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/HiBy/RS6/HiFi.conf
  install -Dm644 "$us"/audio/pipewire-rs6.conf \
    "$pkgdir"/usr/share/pipewire/pipewire.conf.d/50-hiby-rs6.conf
  install -Dm644 "$srcdir"/limits-hiby-rs6-audio.conf "$pkgdir"/etc/security/limits.d/25-hiby-rs6-audio.conf
  install -Dm644 "$us"/audio/pipewire-pulse-rs6.conf \
    "$pkgdir"/usr/share/pipewire/pipewire-pulse.conf.d/50-hiby-rs6.conf
  install -Dm644 "$us"/audio/wireplumber-rs6.conf \
    "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/50-hiby-rs6.conf
  install -Dm644 "$us"/audio/wireplumber-exclusive-takeover.lua \
    "$pkgdir"/usr/share/wireplumber/scripts/hiby-rs6/exclusive-takeover.lua
  install -Dm644 "$us"/audio/wireplumber-output-handover.lua \
    "$pkgdir"/usr/share/wireplumber/scripts/hiby-rs6/output-handover.lua
  # one wheel detent = 1 % = one NJW1195A step
  install -Dm644 "$us"/audio/plasmaparc "$pkgdir"/etc/xdg/plasmaparc

  # the DAC filter from the command line (Darwin filters: firmware-hiby-rs6)
  install -Dm755 "$srcdir"/darwinctl -t "$pkgdir"/usr/bin/
  install -Dm644 "$us"/darwinctl/darwinctl.tmpfiles "$pkgdir"/usr/lib/tmpfiles.d/darwinctl.conf
  install -Dm644 "$us"/darwinctl/darwinctl-restore.service -t "$pkgdir"/usr/lib/systemd/system/
}

package_hiby-rs6-firefox() {
  pkgdesc="$pkgdesc (Firefox: Venus V4L2 hardware video decoding, display defaults)"
  depends=(ffmpeg firefox glibc hiby-rs6-system mobile-config-firefox)
  local us; us=$(_us)

  install -Dm755 "$srcdir"/firefox-v4l2-fix.so -t "$pkgdir"/usr/lib/hiby-rs6/
  install -Dm755 "$us"/firefox/firefox-hiby-rs6 "$pkgdir"/usr/lib/hiby-rs6/firefox
  # our firefox.desktop, found ahead of Firefox's own through XDG_DATA_DIRS
  install -Dm644 "$us"/firefox/firefox-hiby-rs6.desktop \
    "$pkgdir"/usr/share/hiby-rs6/applications/firefox.desktop
  install -Dm644 "$us"/firefox/firefox-hiby-rs6-env.conf \
    "$pkgdir"/usr/lib/environment.d/60-hiby-rs6-firefox.conf
  # Plasma only keeps XDG_* variables it got from its own env scripts
  install -Dm644 "$us"/firefox/firefox-hiby-rs6-plasma-env.sh \
    "$pkgdir"/etc/xdg/plasma-workspace/env/hiby-rs6-firefox.sh
  install -Dm644 "$us"/firefox/firefox-hiby-rs6.js "$pkgdir"/usr/lib/firefox/defaults/pref/hiby-rs6.js
}

package_hiby-rs6-plasma() {
  pkgdesc="$pkgdesc (Plasma Mobile: KWin effects, lock screen at start, no X11 proxies, flashlight)"
  depends=(kwin plasma-mobile systemd)
  backup=(etc/xdg/kwinrc etc/xdg/kscreenlockerrc)
  local us; us=$(_us)

  install -Dm644 "$us"/system/kwinrc "$pkgdir"/etc/xdg/kwinrc
  # the session on tty1 for uid 1000, no display manager: plasma-mobile's own unit (CC0-1.0,
  # plasma-mobile 6.8.0), which Arch's plasma-mobile does not install (INSTALL_SYSTEMD_SERVICE=OFF)
  install -Dm644 "$srcdir"/plasma-mobile.service -t "$pkgdir"/usr/lib/systemd/system/
  # the lock screen is the login (plasma-mobile.service starts the session without a display manager)
  install -Dm644 "$srcdir"/kscreenlockerrc "$pkgdir"/etc/xdg/kscreenlockerrc
  install -Dm644 "$us"/system/99-flashlight.rules -t "$pkgdir"/usr/lib/udev/rules.d/
  # Plasma Mobile takes the power key, not logind (systemd would power off)
  install -Dm644 "$srcdir"/logind-hiby-rs6-plasma.conf "$pkgdir"/usr/lib/systemd/logind.conf.d/60-hiby-rs6-plasma.conf

  # No X11 helpers: Plasma Mobile has no X11 tray or global menu to proxy, and these two X11
  # clients made KWin start Xwayland at every login (an X11 app still gets it on demand)
  install -dm755 "$pkgdir"/etc/systemd/user
  local u
  for u in plasma-xembedsniproxy.service plasma-gmenudbusmenuproxy.service; do
    ln -s /dev/null "$pkgdir"/etc/systemd/user/$u
  done
}
