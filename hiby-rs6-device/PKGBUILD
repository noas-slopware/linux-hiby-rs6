# Maintainer: Noa Himesaka <himesaka@noa.codes>
#
# HiBy RS6 device packages for Arch Linux Ports AArch64 (arch.bens.haus, ARMv8.0). The device files come
# from userspace/ on the main branch of noas-slopware/linux-hiby-rs6 (the same files the Nura package
# device-hiby-rs6 carries); the files next to this PKGBUILD are the Arch side: extlinux.conf writer
# (replaces boot-deploy), mkinitcpio hook and config, zram-generator + sysctl (replace postmarketos-zram),
# systemd preset (replaces Nura's), firewall, and the USB network gadget (replaces usb-signaller +
# unudhcpd). No user, locale, timezone or other personal settings: the image is generic.
#
#   hiby-rs6-device    meta package: everything below plus kernel, DTBs and firmware
#   hiby-rs6-system    udev, tmpfiles, logind, shutdown watchdog, swap + zram, preset, firewall, touch
#                      boost, VT lock, USB network, no cellular
#   hiby-rs6-boot      extlinux.conf for U-Boot, mkinitcpio hook + config (F2FS root, grown to the
#                      whole arch_root partition in the initramfs)
#   hiby-rs6-audio     UCM, PipeWire/WirePlumber config and scripts, darwinctl, Plasma volume step
#   hiby-rs6-firefox   Venus V4L2 decoding shim, wrapper, desktop override, prefs
#   hiby-rs6-plasma    KWin effects config, lock screen at session start, no X11 tray/menu proxies,
#                      flashlight permissions

pkgbase=hiby-rs6-device
pkgname=(
  hiby-rs6-device
  hiby-rs6-system
  hiby-rs6-boot
  hiby-rs6-audio
  hiby-rs6-firefox
  hiby-rs6-plasma
)
pkgver=1
pkgrel=19
pkgdesc='HiBy RS6'
url='https://github.com/noas-slopware/linux-hiby-rs6'
arch=(aarch64)
license=(MIT)
makedepends=(alsa-lib ffmpeg linux-api-headers)
# senpai branch (default) of noas-slopware/linux-hiby-rs6
_rs6commit=19fbcf36d7afefcf0cc121030db571c4b0bc5e20
source=(
  "linux-hiby-rs6-$_rs6commit.tar.gz::https://github.com/noas-slopware/linux-hiby-rs6/archive/$_rs6commit.tar.gz"
  hiby-rs6-extlinux
  95-hiby-rs6-extlinux.hook
  hiby-rs6.initcpio-install
  mkinitcpio-hiby-rs6.conf
  zram-generator.conf
  90-hiby-rs6-zram.sysctl
  80-hiby-rs6.preset
  hiby-rs6-usbnet
  hiby-rs6-usbnet.service
  90-hiby-rs6-usbnet.rules
  hiby-rs6-usb.nmconnection
  kscreenlockerrc
  nftables-hiby-rs6.conf
  nftables-hiby-rs6.service.conf
  plasma-mobile.service
  NetworkManager-hiby-rs6-wifi.conf
  86-hiby-rs6-usbnet-nm.rules
  logind-hiby-rs6-plasma.conf
  limits-hiby-rs6-audio.conf
  hiby-rs6-growroot.service
  hiby-rs6-growroot-done.service
)
