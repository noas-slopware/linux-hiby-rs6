[Unit]
Description=HiBy RS6 swap partitions (arch_swap1 + arch_swap2, 2x RAM)
DefaultDependencies=no
Before=swap.target
Wants=dev-disk-by\x2dpartlabel-arch_swap1.device dev-disk-by\x2dpartlabel-arch_swap2.device
After=dev-disk-by\x2dpartlabel-arch_swap1.device dev-disk-by\x2dpartlabel-arch_swap2.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/swapon /dev/disk/by-partlabel/arch_swap1 /dev/disk/by-partlabel/arch_swap2
ExecStop=/usr/bin/swapoff /dev/disk/by-partlabel/arch_swap1 /dev/disk/by-partlabel/arch_swap2

[Install]
WantedBy=swap.target
