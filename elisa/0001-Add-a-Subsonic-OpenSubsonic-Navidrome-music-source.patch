+
+#ifndef SUBSONICLISTENER_H
+#define SUBSONICLISTENER_H
+
+#include "elisaLib_export.h"
+
+#include "datatypes.h"
+#include "subsonicapi.h"
+
+#include <QDateTime>
+#include <QHash>
+#include <QJsonObject>
+#include <QObject>
+#include <QSet>
+#include <QUrl>
+
+#include <atomic>
+#include <functional>
+#include <memory>
+
+class QNetworkAccessManager;
+class QNetworkReply;
+
+/**
+ * Imports the songs of a Subsonic / OpenSubsonic server (e.g. Navidrome) into
+ * Elisa's database, the same way the local file indexer does: it emits
+ * tracksList() and removedTracksList() which are connected to
+ * DatabaseInterface::insertTracksList() and DatabaseInterface::removeTracksList().
+ *
+ * Lives in the listener thread. Network failures never remove tracks: tracks
+ * are only removed after a complete listing of the server succeeded.
+ */
+class ELISALIB_EXPORT SubsonicListener : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit SubsonicListener(QObject *parent = nullptr);
+
+    ~SubsonicListener() override;
+
+    /** Converts one song (Child) object of the API to Elisa's track data. */
+    static DataTypes::TrackDataType
+    trackFromSong(const QJsonObject &song, const QUrl &serverUrl, const QString &albumArtistFallback = {}, const QString &coverArtFallback = {});
+
+Q_SIGNALS:
+
+    void tracksList(const DataTypes::ListTrackDataType &tracks);
+
+    void removedTracksList(const QList<QUrl> &removedTracks);
+
+    void askRestoredTracks();
+
+    void indexingStarted();
+
+    void indexingFinished();
+
+public Q_SLOTS:
+
+    /** Lists the whole server again (uses SubsonicApi::settings()). */
+    void refresh();
+
+    /** Snapshot of all tracks known by the database. */
+    void setIndexedTracks(const QHash<QUrl, QDateTime> &allTracks);
+
+    /** The database was cleared (hard rescan). */
+    void databaseCleaned();
+
+    void trackStartedPlaying(const QUrl &url, const QDateTime &time);
+
+    void trackFinishedPlaying(const QUrl &url, const QDateTime &time);
+
+    void applicationAboutToQuit();
+
+private:
+    using JsonHandler = std::function<void(const QJsonObject &response)>;
+    using ErrorHandler = std::function<void(const QString &message)>;
+
+    QNetworkAccessManager *networkManager();
+
+    void
+    get(const SubsonicApi::Settings &settings, QLatin1StringView method, const QUrlQuery &query, const JsonHandler &onSuccess, const ErrorHandler &onError);
+
+    void startSync();
+
+    void fetchSongsPage(int offset);
+
+    void fetchAlbumListPage(int offset);
+
+    void fetchNextAlbums();
+
+    void addTracks(const DataTypes::ListTrackDataType &tracks);
+
+    void finishSync(bool complete);
+
+    void applyRemovals();
+
+    void scrobble(const QUrl &url, const QDateTime &time, bool submission);
+
+    QNetworkAccessManager *mNetworkManager = nullptr;
+
+    SubsonicApi::Settings mSyncSettings;
+
+    QSet<QUrl> mKnownTracks;
+
+    QSet<QUrl> mFetchedTracks;
+
+    QSet<QUrl> mLastCompleteListing;
+
+    QStringList mPendingAlbumIds;
+
+    QHash<QUrl, QDateTime> mPlayStartTimes;
+
+    int mSyncGeneration = 0;
+
+    int mAlbumRequestsInFlight = 0;
+
+    bool mHaveDatabaseSnapshot = false;
+
+    bool mDiffPending = false;
+
+    bool mSyncRunning = false;
+
+    bool mSyncFailed = false;
+
+    bool mRefreshQueued = false;
+
+    std::atomic_bool mStopRequested = false;
+};
+
+#endif // SUBSONICLISTENER_H
