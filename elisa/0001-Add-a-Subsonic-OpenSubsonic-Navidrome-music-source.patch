+void MusicListenersManager::updateSubsonicConfiguration()
+{
+    const auto subsonicSettings = SubsonicApi::settingsFromConfiguration();
+    SubsonicApi::setSettings(subsonicSettings);
+
+    if (d->mSubsonicSettingsApplied && subsonicSettings == d->mPreviousSubsonicSettings) {
+        return;
+    }
+
+    const bool firstConfiguration = !d->mSubsonicSettingsApplied;
+    d->mSubsonicSettingsApplied = true;
+    d->mPreviousSubsonicSettings = subsonicSettings;
+
+    // at startup only list an enabled server; later, any change (including
+    // disabling the source) refreshes the imported tracks
+    if (!firstConfiguration || subsonicSettings.isUsable()) {
+        QMetaObject::invokeMethod(&d->mSubsonicListener, &SubsonicListener::refresh, Qt::QueuedConnection);
+    }
+}
