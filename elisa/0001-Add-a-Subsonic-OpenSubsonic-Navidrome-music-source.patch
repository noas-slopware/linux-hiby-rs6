diff --git a/src/subsonic/subsonicapi.cpp b/src/subsonic/subsonicapi.cpp
new file mode 100644
index 0000000..26ef6db
--- /dev/null
+++ b/src/subsonic/subsonicapi.cpp
@@ -0,0 +1,227 @@
+/*
+   SPDX-FileCopyrightText: 2026 (c) Noa Himesaka <himesaka@noa.codes>
+
+   SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#include "subsonicapi.h"
+
+#include "elisa_settings.h"
+
+#include <QCryptographicHash>
+#include <QMutex>
+#include <QMutexLocker>
+#include <QRandomGenerator>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+
+QMutex &settingsMutex()
+{
+    static QMutex mutex;
+    return mutex;
+}
+
+SubsonicApi::Settings &currentSettings()
+{
+    static SubsonicApi::Settings settings;
+    return settings;
+}
+
+const QString restPathSegment = u"/rest/"_s;
+
+QString basePath(const QUrl &serverUrl)
+{
+    auto path = serverUrl.path();
+    while (path.endsWith(u'/')) {
+        path.chop(1);
+    }
+    return path;
+}
+
+// QUrlQuery leaves '+' and other sub-delimiters alone, which servers decode as
+// form encoding. Fully percent-encode every value we send.
+void addItem(QUrlQuery &query, const QString &key, const QString &value)
+{
+    query.addQueryItem(key, QString::fromLatin1(QUrl::toPercentEncoding(value)));
+}
+
+QString randomSalt()
+{
+    QByteArray salt(8, Qt::Uninitialized);
+    QRandomGenerator::system()->generate(salt.begin(), salt.end());
+    return QString::fromLatin1(salt.toHex());
+}
+
+bool sameServerAuthority(const QUrl &url, const QUrl &serverUrl)
+{
+    return url.scheme() == serverUrl.scheme() && url.host().compare(serverUrl.host(), Qt::CaseInsensitive) == 0
+        && url.port(url.scheme() == u"https"_s ? 443 : 80) == serverUrl.port(serverUrl.scheme() == u"https"_s ? 443 : 80);
+}
+
+}
+
+bool SubsonicApi::Settings::isUsable() const
+{
+    return enabled && serverUrl.isValid() && !serverUrl.host().isEmpty() && (serverUrl.scheme() == u"http"_s || serverUrl.scheme() == u"https"_s)
+        && !userName.isEmpty();
+}
+
+void SubsonicApi::setSettings(const Settings &settings)
+{
+    QMutexLocker locker(&settingsMutex());
+    currentSettings() = settings;
+}
+
+SubsonicApi::Settings SubsonicApi::settings()
+{
+    QMutexLocker locker(&settingsMutex());
+    return currentSettings();
+}
+
+SubsonicApi::Settings SubsonicApi::settingsFromConfiguration()
+{
+    Settings result;
+    result.enabled = Elisa::ElisaConfiguration::subsonicEnabled();
+    result.serverUrl = normalizedServerUrl(Elisa::ElisaConfiguration::subsonicServerUrl());
+    result.userName = Elisa::ElisaConfiguration::subsonicUserName();
+    result.password = Elisa::ElisaConfiguration::subsonicPassword();
+    return result;
+}
+
+QUrl SubsonicApi::normalizedServerUrl(const QString &userInput)
+{
+    const auto trimmed = userInput.trimmed();
+    if (trimmed.isEmpty()) {
+        return {};
+    }
+
+    auto url = QUrl::fromUserInput(trimmed);
+    if (!trimmed.contains(u"://"_s)) {
+        // fromUserInput() defaults to http, prefer TLS when the user gave no scheme
+        url.setScheme(u"https"_s);
+    }
+    url.setQuery(QString{});
+    url.setFragment(QString{});
+    url.setUserInfo(QString{});
+
+    auto path = basePath(url);
+    // accept a pasted ".../rest" or ".../rest/ping.view" URL too
+    const auto restIndex = path.indexOf(u"/rest"_s);
+    if (restIndex >= 0 && (path.size() == restIndex + 5 || path.at(restIndex + 5) == u'/')) {
+        path.truncate(restIndex);
+    }
+    url.setPath(path);
+
+    return url;
+}
+
+QUrl SubsonicApi::methodUrl(const QUrl &serverUrl, QLatin1StringView method, const QUrlQuery &query)
+{
+    auto url = serverUrl;
+    url.setPath(basePath(serverUrl) + restPathSegment + method + u".view"_s);
+    url.setQuery(query);
+    return url;
+}
+
+QUrl SubsonicApi::authenticated(const QUrl &url, const Settings &settings, bool json)
+{
+    auto query = QUrlQuery{url};
+    const auto salt = randomSalt();
+    const auto token = QCryptographicHash::hash(QByteArray{settings.password.toUtf8() + salt.toLatin1()}, QCryptographicHash::Md5).toHex();
+
+    addItem(query, u"u"_s, settings.userName);
+    addItem(query, u"t"_s, QString::fromLatin1(token));
+    addItem(query, u"s"_s, salt);
+    addItem(query, u"v"_s, QString{apiVersion});
+    addItem(query, u"c"_s, QString{clientName});
+    if (json) {
+        addItem(query, u"f"_s, u"json"_s);
+    }
+
+    auto result = url;
+    result.setQuery(query);
+    return result;
+}
+
+QUrl SubsonicApi::streamUrl(const QUrl &serverUrl, const QString &songId)
+{
+    QUrlQuery query;
+    addItem(query, u"id"_s, songId);
+    addItem(query, u"format"_s, u"raw"_s);
+    return methodUrl(serverUrl, "stream"_L1, query);
+}
+
+bool SubsonicApi::isStreamUrl(const QUrl &url)
+{
+    if (url.scheme() != u"http"_s && url.scheme() != u"https"_s) {
+        return false;
+    }
+
+    return url.path().endsWith(u"/rest/stream.view"_s) && QUrlQuery{url}.hasQueryItem(u"id"_s);
+}
+
+bool SubsonicApi::belongsToServer(const QUrl &url, const QUrl &serverUrl)
+{
+    if (!serverUrl.isValid() || serverUrl.host().isEmpty()) {
+        return false;
+    }
+
+    return sameServerAuthority(url, serverUrl) && url.path().startsWith(basePath(serverUrl) + restPathSegment);
+}
+
+QString SubsonicApi::songId(const QUrl &streamUrl)
+{
+    return QUrlQuery{streamUrl}.queryItemValue(u"id"_s, QUrl::FullyDecoded);
+}
+
+QUrl SubsonicApi::playableUrl(const QUrl &url)
+{
+    if (!isStreamUrl(url)) {
+        return url;
+    }
+
+    const auto current = settings();
+    if (!current.isUsable() || !belongsToServer(url, current.serverUrl)) {
+        return url;
+    }
+
+    return authenticated(url, current);
+}
+
+QUrl SubsonicApi::coverImageUrl(const QString &coverArtId)
+{
+    if (coverArtId.isEmpty()) {
+        return {};
+    }
+
+    return QUrl{u"image://"_s + imageProviderId + u'/' + QString::fromLatin1(QUrl::toPercentEncoding(coverArtId))};
+}
+
+QUrl SubsonicApi::coverArtDownloadUrl(const QUrl &coverImageUrl, int size)
+{
+    if (coverImageUrl.scheme() != u"image"_s || coverImageUrl.host() != imageProviderId) {
+        return {};
+    }
+
+    const auto current = settings();
+    if (!current.isUsable()) {
+        return {};
+    }
+
+    const auto coverArtId = QUrl::fromPercentEncoding(coverImageUrl.path(QUrl::FullyEncoded).mid(1).toLatin1());
+    return coverArtDownloadUrl(coverArtId, current, size);
+}
+
+QUrl SubsonicApi::coverArtDownloadUrl(const QString &coverArtId, const Settings &settings, int size)
+{
+    QUrlQuery query;
+    addItem(query, u"id"_s, coverArtId);
+    if (size > 0) {
+        addItem(query, u"size"_s, QString::number(size));
+    }
+
+    return authenticated(methodUrl(settings.serverUrl, "getCoverArt"_L1, query), settings);
+}
diff --git a/src/subsonic/subsonicapi.h b/src/subsonic/subsonicapi.h
new file mode 100644
index 0000000..c850824
--- /dev/null
+++ b/src/subsonic/subsonicapi.h
@@ -0,0 +1,95 @@
+/*
+   SPDX-FileCopyrightText: 2026 (c) Noa Himesaka <himesaka@noa.codes>
+
+   SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#ifndef SUBSONICAPI_H
+#define SUBSONICAPI_H
+
+#include "elisaLib_export.h"
+
+#include <QString>
+#include <QUrl>
+#include <QUrlQuery>
+
+/**
+ * Helpers for the Subsonic / OpenSubsonic REST API (Navidrome, Gonic, ...).
+ *
+ * Tracks are stored in the database with a canonical stream URL that carries
+ * no credentials (http(s)://server/rest/stream.view?id=<id>&format=raw), so the
+ * database key stays stable. Authentication (token = md5(password + salt),
+ * API 1.13.0+) is added with a fresh salt every time a URL is actually used.
+ */
+namespace SubsonicApi
+{
+
+struct ELISALIB_EXPORT Settings {
+    bool enabled = false;
+    QUrl serverUrl;
+    QString userName;
+    QString password;
+
+    [[nodiscard]] bool isUsable() const;
+
+    bool operator==(const Settings &other) const = default;
+};
+
+/** API version sent as the v parameter. Token authentication needs 1.13.0 or later. */
+inline constexpr QLatin1StringView apiVersion{"1.16.1"};
+
+/** Client name sent as the c parameter. */
+inline constexpr QLatin1StringView clientName{"Elisa"};
+
+/** Id of the QML image provider serving cover art: image://subsonic/<coverArt id> */
+inline constexpr QLatin1StringView imageProviderId{"subsonic"};
+
+/** Number of songs requested per search3 page */
+inline constexpr int songPageSize = 500;
+
+/** Process-wide copy of the current settings, safe to read from any thread. */
+ELISALIB_EXPORT void setSettings(const Settings &settings);
+ELISALIB_EXPORT Settings settings();
+
+/** Reads the settings from Elisa's configuration. Call from the main thread only. */
+ELISALIB_EXPORT Settings settingsFromConfiguration();
+
+/** Normalizes user input like "music.example.org/navidrome/" to https://music.example.org/navidrome */
+ELISALIB_EXPORT QUrl normalizedServerUrl(const QString &userInput);
+
+/** URL of a REST method, without authentication parameters. */
+ELISALIB_EXPORT QUrl methodUrl(const QUrl &serverUrl, QLatin1StringView method, const QUrlQuery &query = {});
+
+/** Adds u, t, s, v and c (and f=json if requested) with a new random salt. */
+ELISALIB_EXPORT QUrl authenticated(const QUrl &url, const Settings &settings, bool json = false);
+
+/** Canonical (credential-free) stream URL of a song. format=raw disables server side transcoding. */
+ELISALIB_EXPORT QUrl streamUrl(const QUrl &serverUrl, const QString &songId);
+
+/** True for canonical stream URLs of any Subsonic server. */
+ELISALIB_EXPORT bool isStreamUrl(const QUrl &url);
+
+/** True if url is a REST URL of the given server. */
+ELISALIB_EXPORT bool belongsToServer(const QUrl &url, const QUrl &serverUrl);
+
+/** Song id of a canonical stream URL. */
+ELISALIB_EXPORT QString songId(const QUrl &streamUrl);
+
+/**
+ * URL to hand to the audio backend: stream URLs of the configured server get
+ * fresh authentication parameters, anything else is returned unchanged.
+ */
+ELISALIB_EXPORT QUrl playableUrl(const QUrl &url);
+
+/** URL used for the album cover in the database: image://subsonic/<coverArt id> */
+ELISALIB_EXPORT QUrl coverImageUrl(const QString &coverArtId);
+
+/** Authenticated getCoverArt URL for an image://subsonic/ URL (empty if not one). */
+ELISALIB_EXPORT QUrl coverArtDownloadUrl(const QUrl &coverImageUrl, int size = 0);
+
+/** Authenticated getCoverArt URL for a cover art id. */
+ELISALIB_EXPORT QUrl coverArtDownloadUrl(const QString &coverArtId, const Settings &settings, int size = 0);
+
+}
+
+#endif // SUBSONICAPI_H
diff --git a/src/subsonic/subsonicimageprovider.cpp b/src/subsonic/subsonicimageprovider.cpp
new file mode 100644
index 0000000..f248988
--- /dev/null
+++ b/src/subsonic/subsonicimageprovider.cpp
@@ -0,0 +1,231 @@
+/*
+   SPDX-FileCopyrightText: 2026 (c) Noa Himesaka <himesaka@noa.codes>
+
+   SPDX-License-Identifier: LGPL-3.0-or-later
+ */
+
+#include "subsonicimageprovider.h"
+
+#include "subsonic/subsonicLogging.h"
+#include "subsonicapi.h"
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QEventLoop>
+#include <QFile>
+#include <QImage>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QRunnable>
+#include <QSaveFile>
+#include <QStandardPaths>
+
+#include <atomic>
+#include <memory>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+
+constexpr int transferTimeout = 30000;
+
+/**
+ * Fetches one cover on a thread of the provider's pool and reports it with
+ * done(). Owned and deleted by the pool (autoDelete).
+ *
+ * It is deliberately not the QQuickImageResponse itself: the pixmap reader
+ * deletes a response as soon as it has handled finished(), on its own
+ * thread. A response that emits finished() from a pool thread is still
+ * inside QMetaObject::activate() when that happens.
+ */
+class SubsonicCoverJob : public QObject, public QRunnable
+{
+    Q_OBJECT
+
+public:
+    SubsonicCoverJob(QString coverArtId, const QSize &requestedSize, std::shared_ptr<const std::atomic_bool> cancelled)
+        : mCoverArtId(std::move(coverArtId))
+        , mRequestedSize(requestedSize)
+        , mCancelled(std::move(cancelled))
+    {
+    }
+
+    void run() override
+    {
+        QImage image;
+        load(image);
+        Q_EMIT done(image, mErrorMessage);
+    }
+
+Q_SIGNALS:
+    void done(const QImage &image, const QString &errorMessage);
+
+private:
+    void load(QImage &image)
+    {
+        // the delegate that asked for it is gone already (fast scrolling)
+        if (mCancelled->load()) {
+            mErrorMessage = u"Cancelled"_s;
+            return;
+        }
+
+        const auto settings = SubsonicApi::settings();
+        const int size = std::max(mRequestedSize.width(), mRequestedSize.height());
+
+        const auto cacheFileName = cachePath(settings, size);
+        QByteArray imageData;
+
+        QFile cacheFile(cacheFileName);
+        if (!cacheFileName.isEmpty() && cacheFile.open(QIODevice::ReadOnly)) {
+            imageData = cacheFile.readAll();
+        }
+
+        if (imageData.isEmpty()) {
+            if (mCancelled->load()) {
+                mErrorMessage = u"Cancelled"_s;
+                return;
+            }
+
+            imageData = download(settings, size);
+            if (!imageData.isEmpty() && !cacheFileName.isEmpty()) {
+                QDir().mkpath(QFileInfo(cacheFileName).absolutePath());
+                QSaveFile saveFile(cacheFileName);
+                if (saveFile.open(QIODevice::WriteOnly)) {
+                    saveFile.write(imageData);
+                    saveFile.commit();
+                }
+            }
+        }
+
+        if (imageData.isEmpty()) {
+            if (mErrorMessage.isEmpty()) {
+                mErrorMessage = u"No cover art for "_s + mCoverArtId;
+            }
+            return;
+        }
+
+        image = QImage::fromData(imageData);
+        if (image.isNull()) {
+            mErrorMessage = u"Invalid cover art image for "_s + mCoverArtId;
+            return;
+        }
+
+        if (size > 0 && (image.width() > size || image.height() > size)) {
+            image = image.scaled(size, size, Qt::KeepAspectRatio, Qt::SmoothTransformation);
+        }
+    }
+
+    QString cachePath(const SubsonicApi::Settings &settings, int size) const
+    {
+        const auto cacheRoot = QStandardPaths::writableLocation(QStandardPaths::CacheLocation);
+        if (cacheRoot.isEmpty() || !settings.serverUrl.isValid()) {
+            return {};
+        }
+
+        const auto key = QCryptographicHash::hash(QByteArray{settings.serverUrl.toEncoded() + '\n' + mCoverArtId.toUtf8() + '\n' + QByteArray::number(size)},
+                                                  QCryptographicHash::Sha1)
+                             .toHex();
+        return cacheRoot + u"/subsonic-covers/"_s + QString::fromLatin1(key);
+    }
+
+    QByteArray download(const SubsonicApi::Settings &settings, int size)
+    {
+        if (!settings.isUsable()) {
+            mErrorMessage = u"Subsonic server is not configured"_s;
+            return {};
+        }
+
+        QNetworkAccessManager networkManager;
+        QNetworkRequest request(SubsonicApi::coverArtDownloadUrl(mCoverArtId, settings, size));
+        request.setTransferTimeout(transferTimeout);
+        request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::NoLessSafeRedirectPolicy);
+
+        QEventLoop loop;
+        auto reply = networkManager.get(request);
+        QObject::connect(reply, &QNetworkReply::finished, &loop, &QEventLoop::quit);
+        loop.exec();
+
+        QByteArray result;
+        const auto contentType = reply->header(QNetworkRequest::ContentTypeHeader).toString();
+        if (reply->error() != QNetworkReply::NoError) {
+            mErrorMessage = reply->errorString();
+            qCDebug(orgKdeElisaSubsonic()) << "getCoverArt failed for" << mCoverArtId << reply->errorString();
+        } else if (contentType.startsWith(u"application/json"_s) || contentType.startsWith(u"text/xml"_s) || contentType.startsWith(u"application/xml"_s)) {
+            // a subsonic-response error document instead of an image
+            mErrorMessage = u"Server returned an error for cover art "_s + mCoverArtId;
+        } else {
+            result = reply->readAll();
+        }
+
+        delete reply;
+        return result;
+    }
+
+    QString mCoverArtId;
+    QSize mRequestedSize;
+    std::shared_ptr<const std::atomic_bool> mCancelled;
+    QString mErrorMessage;
+};
+
+/**
+ * Lives in the pixmap reader thread that called requestImageResponse() and
+ * emits finished() only from there, after the job's result arrived through
+ * a queued connection.
+ */
+class SubsonicImageResponse : public QQuickImageResponse
+{
+    Q_OBJECT
+
+public:
+    SubsonicImageResponse(const QString &coverArtId, const QSize &requestedSize, QThreadPool &pool)
+    {
+        auto job = new SubsonicCoverJob(coverArtId, requestedSize, mCancelled);
+        connect(job, &SubsonicCoverJob::done, this, &SubsonicImageResponse::handleDone, Qt::QueuedConnection);
+        pool.start(job);
+    }
+
+    [[nodiscard]] QQuickTextureFactory *textureFactory() const override
+    {
+        return QQuickTextureFactory::textureFactoryForImage(mImage);
+    }
+
+    [[nodiscard]] QString errorString() const override
+    {
+        return mErrorMessage;
+    }
+
+    void cancel() override
+    {
+        // the job still reports back, so finished() is emitted in any case
+        mCancelled->store(true);
+    }
+
+private:
+    void handleDone(const QImage &image, const QString &errorMessage)
+    {
+        mImage = image;
+        mErrorMessage = errorMessage;
+        Q_EMIT finished();
+    }
+
+    std::shared_ptr<std::atomic_bool> mCancelled = std::make_shared<std::atomic_bool>(false);
+    QImage mImage;
+    QString mErrorMessage;
+};
+
+}
+
+SubsonicImageProvider::SubsonicImageProvider()
+    : QQuickAsyncImageProvider()
+{
+    mPool.setMaxThreadCount(4);
+}
+
+QQuickImageResponse *SubsonicImageProvider::requestImageResponse(const QString &id, const QSize &requestedSize)
+{
+    return new SubsonicImageResponse(QUrl::fromPercentEncoding(id.toUtf8()), requestedSize, mPool);
+}
+
+#include "subsonicimageprovider.moc"
