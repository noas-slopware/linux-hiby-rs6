+constexpr int transferTimeout = 30000;
+
+constexpr int albumListPageSize = 500;
+
+constexpr int maximumParallelAlbumRequests = 4;
+
+QString firstNonEmpty(std::initializer_list<QString> values)
+{
+    for (const auto &value : values) {
+        if (!value.isEmpty()) {
+            return value;
+        }
+    }
+    return {};
+}
+
+QString joinedArtistNames(const QJsonValue &artists)
+{
+    QStringList names;
+    const auto artistArray = artists.toArray();
+    for (const auto &artist : artistArray) {
+        const auto name = artist.toObject().value("name"_L1).toString();
+        if (!name.isEmpty()) {
+            names.push_back(name);
+        }
+    }
+    return names.join(u", "_s);
+}
+
+}
+
+SubsonicListener::SubsonicListener(QObject *parent)
+    : QObject(parent)
+{
+}
+
+SubsonicListener::~SubsonicListener() = default;
+
+DataTypes::TrackDataType
+SubsonicListener::trackFromSong(const QJsonObject &song, const QUrl &serverUrl, const QString &albumArtistFallback, const QString &coverArtFallback)
+{
+    DataTypes::TrackDataType track;
+
+    const auto id = song.value("id"_L1).toString();
+    const auto mediaType = song.value("type"_L1).toString();
+    if (id.isEmpty() || song.value("isDir"_L1).toBool() || song.value("isVideo"_L1).toBool() || mediaType == u"video"_s || mediaType == u"podcast"_s) {
+        return track;
+    }
+
+    const auto title = song.value("title"_L1).toString();
+    const auto artist = firstNonEmpty({song.value("displayArtist"_L1).toString(), song.value("artist"_L1).toString()});
+    const auto album = song.value("album"_L1).toString();
+    const auto albumArtist =
+        firstNonEmpty({song.value("displayAlbumArtist"_L1).toString(), joinedArtistNames(song.value("albumArtists"_L1)), albumArtistFallback, artist});
+
+    track[DataTypes::ResourceRole] = SubsonicApi::streamUrl(serverUrl, id);
+    track[DataTypes::ElementTypeRole] = ElisaUtils::Track;
+    track[DataTypes::TitleRole] = title.isEmpty() ? id : title;
+    track[DataTypes::DurationRole] = QTime::fromMSecsSinceStartOfDay(std::max(0, song.value("duration"_L1).toInt()) * 1000);
+    track[DataTypes::RatingRole] = std::clamp(song.value("userRating"_L1).toInt() * 2, 0, 10);
+    track[DataTypes::HasEmbeddedCover] = false;
+
+    if (!artist.isEmpty()) {
+        track[DataTypes::ArtistRole] = artist;
+    }
+    if (!album.isEmpty()) {
+        track[DataTypes::AlbumRole] = album;
+    }
+    if (!albumArtist.isEmpty()) {
+        track[DataTypes::AlbumArtistRole] = albumArtist;
+    }
+    if (const auto trackNumber = song.value("track"_L1).toInt(); trackNumber > 0) {
+        track[DataTypes::TrackNumberRole] = trackNumber;
+    }
+    if (const auto discNumber = song.value("discNumber"_L1).toInt(); discNumber > 0) {
+        track[DataTypes::DiscNumberRole] = discNumber;
+    }
+    if (const auto year = song.value("year"_L1).toInt(); year > 0) {
+        track[DataTypes::YearRole] = year;
+    }
+    if (const auto genre = song.value("genre"_L1).toString(); !genre.isEmpty()) {
+        track[DataTypes::GenreRole] = genre;
+    }
+    if (const auto composer = song.value("displayComposer"_L1).toString(); !composer.isEmpty()) {
+        track[DataTypes::ComposerRole] = composer;
+    }
+    if (const auto comment = song.value("comment"_L1).toString(); !comment.isEmpty()) {
+        track[DataTypes::CommentRole] = comment;
+    }
+    if (const auto bitRate = song.value("bitRate"_L1).toInt(); bitRate > 0) {
+        // the API reports kbit/s, Elisa stores bit/s
+        track[DataTypes::BitRateRole] = bitRate * 1000;
+    }
+    if (const auto sampleRate = song.value("samplingRate"_L1).toInt(); sampleRate > 0) {
+        track[DataTypes::SampleRateRole] = sampleRate;
+    }
+    if (const auto channels = song.value("channelCount"_L1).toInt(); channels > 0) {
+        track[DataTypes::ChannelsRole] = channels;
+    }
+
+    const auto coverArt = firstNonEmpty({song.value("coverArt"_L1).toString(), coverArtFallback});
+    if (!coverArt.isEmpty()) {
+        track[DataTypes::ImageUrlRole] = SubsonicApi::coverImageUrl(coverArt);
+    }
+
+    const auto created = QDateTime::fromString(song.value("created"_L1).toString(), Qt::ISODateWithMs);
+    if (created.isValid()) {
+        track[DataTypes::FileModificationTime] = created;
+    }
+
+    return track;
+}
+
+QNetworkAccessManager *SubsonicListener::networkManager()
+{
+    // created lazily so that it lives in the listener thread
+    if (!mNetworkManager) {
+        mNetworkManager = new QNetworkAccessManager(this);
+    }
+    return mNetworkManager;
+}
+
+void SubsonicListener::get(const SubsonicApi::Settings &settings,
+                           QLatin1StringView method,
+                           const QUrlQuery &query,
+                           const JsonHandler &onSuccess,
+                           const ErrorHandler &onError)
+{
+    const auto url = SubsonicApi::authenticated(SubsonicApi::methodUrl(settings.serverUrl, method, query), settings, true);
+
+    QNetworkRequest request(url);
+    request.setTransferTimeout(transferTimeout);
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::NoLessSafeRedirectPolicy);
+
+    auto reply = networkManager()->get(request);
+    const auto methodName = QString{method};
+
+    connect(reply, &QNetworkReply::finished, this, [this, reply, methodName, onSuccess, onError]() {
+        reply->deleteLater();
+
+        if (mStopRequested) {
+            return;
+        }
+
+        if (reply->error() != QNetworkReply::NoError) {
+            onError(methodName + u": "_s + reply->errorString());
+            return;
+        }
+
+        QJsonParseError parseError;
+        const auto document = QJsonDocument::fromJson(reply->readAll(), &parseError);
+        if (parseError.error != QJsonParseError::NoError) {
+            onError(methodName + u": invalid JSON: "_s + parseError.errorString());
+            return;
+        }
+
+        const auto response = document.object().value("subsonic-response"_L1).toObject();
+        if (response.value("status"_L1).toString() != u"ok"_s) {
+            const auto error = response.value("error"_L1).toObject();
+            onError(methodName + u": error "_s + QString::number(error.value("code"_L1).toInt()) + u" "_s + error.value("message"_L1).toString());
+            return;
+        }
+
+        onSuccess(response);
+    });
+}
+
+void SubsonicListener::refresh()
+{
+    if (mStopRequested) {
+        return;
+    }
+
+    const auto settings = SubsonicApi::settings();
+
+    if (!settings.isUsable()) {
+        // stop any running listing
+        ++mSyncGeneration;
+        if (mSyncRunning) {
+            mSyncRunning = false;
+            Q_EMIT indexingFinished();
+        }
+        mRefreshQueued = false;
+
+        if (!settings.enabled) {
+            // the source was switched off: drop what it imported
+            mLastCompleteListing.clear();
+            if (mHaveDatabaseSnapshot) {
+                applyRemovals();
+            } else {
+                mDiffPending = true;
+                Q_EMIT askRestoredTracks();
+            }
+        }
+        return;
+    }
+
+    if (mSyncRunning) {
+        mRefreshQueued = true;
+        return;
+    }
+
+    mSyncSettings = settings;
+    startSync();
+}
+
+void SubsonicListener::setIndexedTracks(const QHash<QUrl, QDateTime> &allTracks)
+{
+    mKnownTracks.clear();
+    for (auto it = allTracks.keyBegin(); it != allTracks.keyEnd(); ++it) {
+        if (SubsonicApi::isStreamUrl(*it)) {
+            mKnownTracks.insert(*it);
+        }
+    }
+    mHaveDatabaseSnapshot = true;
+
+    if (mDiffPending) {
+        mDiffPending = false;
+        applyRemovals();
+    } else if (!SubsonicApi::settings().enabled && !mKnownTracks.isEmpty()) {
+        mLastCompleteListing.clear();
+        applyRemovals();
+    }
+}
+
+void SubsonicListener::databaseCleaned()
+{
+    mKnownTracks.clear();
+    mLastCompleteListing.clear();
+    mHaveDatabaseSnapshot = true;
+    mDiffPending = false;
+
+    if (mSyncRunning) {
+        // tracks inserted so far are gone, start over
+        mSyncRunning = false;
+        ++mSyncGeneration;
+        Q_EMIT indexingFinished();
+    }
+
+    refresh();
+}
+
+void SubsonicListener::startSync()
+{
+    ++mSyncGeneration;
+    mSyncRunning = true;
+    mSyncFailed = false;
+    mFetchedTracks.clear();
+    mPendingAlbumIds.clear();
+    mAlbumRequestsInFlight = 0;
+
+    qCInfo(orgKdeElisaSubsonic()) << "listing" << mSyncSettings.serverUrl.toDisplayString();
+
+    Q_EMIT indexingStarted();
+
+    const auto generation = mSyncGeneration;
+    get(
+        mSyncSettings,
+        "ping"_L1,
+        {},
+        [this, generation](const QJsonObject &response) {
+            if (generation != mSyncGeneration) {
+                return;
+            }
+            if (response.value("openSubsonic"_L1).toBool()) {
+                // OpenSubsonic servers must return everything for an empty search3 query
+                fetchSongsPage(0);
+            } else {
+                fetchAlbumListPage(0);
+            }
+        },
+        [this, generation](const QString &message) {
+            if (generation != mSyncGeneration) {
+                return;
+            }
+            qCWarning(orgKdeElisaSubsonic()) << "server not reachable, keeping the existing tracks:" << message;
+            finishSync(false);
+        });
+}
+
+void SubsonicListener::fetchSongsPage(int offset)
+{
+    QUrlQuery query;
+    query.addQueryItem(u"query"_s, QString{});
+    query.addQueryItem(u"artistCount"_s, u"0"_s);
+    query.addQueryItem(u"albumCount"_s, u"0"_s);
+    query.addQueryItem(u"songCount"_s, QString::number(SubsonicApi::songPageSize));
+    query.addQueryItem(u"songOffset"_s, QString::number(offset));
+
+    const auto generation = mSyncGeneration;
+    get(
+        mSyncSettings,
+        "search3"_L1,
+        query,
+        [this, generation, offset](const QJsonObject &response) {
+            if (generation != mSyncGeneration) {
+                return;
+            }
+
+            const auto songs = response.value("searchResult3"_L1).toObject().value("song"_L1).toArray();
+            if (offset == 0 && songs.isEmpty()) {
+                qCInfo(orgKdeElisaSubsonic()) << "empty search3 listing, falling back to album listing";
+                fetchAlbumListPage(0);
+                return;
+            }
+
+            DataTypes::ListTrackDataType tracks;
+            tracks.reserve(songs.size());
+            for (const auto &song : songs) {
+                auto track = trackFromSong(song.toObject(), mSyncSettings.serverUrl);
+                if (track.isValid()) {
+                    tracks.push_back(std::move(track));
+                }
+            }
+            addTracks(tracks);
+
+            if (songs.isEmpty()) {
+                finishSync(true);
+            } else {
+                // continue until an empty page: servers may cap the page size
+                fetchSongsPage(offset + static_cast<int>(songs.size()));
+            }
+        },
+        [this, generation](const QString &message) {
+            if (generation != mSyncGeneration) {
+                return;
+            }
+            qCWarning(orgKdeElisaSubsonic()) << "listing failed:" << message;
+            finishSync(false);
+        });
+}
+
+void SubsonicListener::fetchAlbumListPage(int offset)
+{
+    QUrlQuery query;
+    query.addQueryItem(u"type"_s, u"alphabeticalByName"_s);
+    query.addQueryItem(u"size"_s, QString::number(albumListPageSize));
+    query.addQueryItem(u"offset"_s, QString::number(offset));
+
+    const auto generation = mSyncGeneration;
+    get(
+        mSyncSettings,
+        "getAlbumList2"_L1,
+        query,
+        [this, generation, offset](const QJsonObject &response) {
+            if (generation != mSyncGeneration) {
+                return;
+            }
+
+            const auto albums = response.value("albumList2"_L1).toObject().value("album"_L1).toArray();
+            for (const auto &album : albums) {
+                const auto albumId = album.toObject().value("id"_L1).toString();
+                if (!albumId.isEmpty()) {
+                    mPendingAlbumIds.push_back(albumId);
+                }
+            }
+
+            if (albums.isEmpty()) {
+                fetchNextAlbums();
+            } else {
+                fetchAlbumListPage(offset + static_cast<int>(albums.size()));
+            }
+        },
+        [this, generation](const QString &message) {
+            if (generation != mSyncGeneration) {
+                return;
+            }
+            qCWarning(orgKdeElisaSubsonic()) << "album listing failed:" << message;
+            finishSync(false);
+        });
+}
+
+void SubsonicListener::fetchNextAlbums()
+{
+    while (mAlbumRequestsInFlight < maximumParallelAlbumRequests && !mPendingAlbumIds.isEmpty()) {
+        const auto albumId = mPendingAlbumIds.takeFirst();
+        ++mAlbumRequestsInFlight;
+
+        QUrlQuery query;
+        query.addQueryItem(u"id"_s, QString::fromLatin1(QUrl::toPercentEncoding(albumId)));
+
+        const auto generation = mSyncGeneration;
+        get(
+            mSyncSettings,
+            "getAlbum"_L1,
+            query,
+            [this, generation](const QJsonObject &response) {
+                if (generation != mSyncGeneration) {
+                    return;
+                }
+                --mAlbumRequestsInFlight;
+
+                const auto album = response.value("album"_L1).toObject();
+                const auto albumArtist = firstNonEmpty({album.value("displayArtist"_L1).toString(), album.value("artist"_L1).toString()});
+                const auto coverArt = album.value("coverArt"_L1).toString();
+                const auto songs = album.value("song"_L1).toArray();
+
+                DataTypes::ListTrackDataType tracks;
+                tracks.reserve(songs.size());
+                for (const auto &song : songs) {
+                    auto track = trackFromSong(song.toObject(), mSyncSettings.serverUrl, albumArtist, coverArt);
+                    if (track.isValid()) {
+                        tracks.push_back(std::move(track));
+                    }
+                }
+                addTracks(tracks);
+
+                fetchNextAlbums();
+            },
+            [this, generation](const QString &message) {
+                if (generation != mSyncGeneration) {
+                    return;
+                }
+                --mAlbumRequestsInFlight;
+                mSyncFailed = true;
+                qCWarning(orgKdeElisaSubsonic()) << "album failed:" << message;
+
+                fetchNextAlbums();
+            });
+    }
+
+    if (mPendingAlbumIds.isEmpty() && mAlbumRequestsInFlight == 0) {
+        finishSync(!mSyncFailed);
+    }
+}
+
+void SubsonicListener::addTracks(const DataTypes::ListTrackDataType &tracks)
+{
+    if (tracks.isEmpty() || mStopRequested) {
+        return;
+    }
+
+    for (const auto &track : tracks) {
+        mFetchedTracks.insert(track.resourceURI());
+    }
+
+    Q_EMIT tracksList(tracks);
+}
+
+void SubsonicListener::finishSync(bool complete)
+{
+    if (!mSyncRunning) {
+        return;
+    }
+    mSyncRunning = false;
+
+    qCInfo(orgKdeElisaSubsonic()) << "listing finished:" << mFetchedTracks.size() << "tracks" << (complete ? "" : "(incomplete)");
+
+    if (complete) {
+        mLastCompleteListing = mFetchedTracks;
+        if (mHaveDatabaseSnapshot) {
+            applyRemovals();
+        } else {
+            mDiffPending = true;
+            Q_EMIT askRestoredTracks();
+        }
+    }
+
+    Q_EMIT indexingFinished();
+
+    if (mRefreshQueued) {
+        mRefreshQueued = false;
+        refresh();
+    }
+}
+
+void SubsonicListener::applyRemovals()
+{
+    QList<QUrl> removedTracks;
+    for (const auto &track : std::as_const(mKnownTracks)) {
+        if (!mLastCompleteListing.contains(track)) {
+            removedTracks.push_back(track);
+        }
+    }
+
+    mKnownTracks = mLastCompleteListing;
+
+    if (!removedTracks.isEmpty() && !mStopRequested) {
+        qCInfo(orgKdeElisaSubsonic()) << "removing" << removedTracks.size() << "tracks no longer on the server";
+        Q_EMIT removedTracksList(removedTracks);
+    }
+}
+
+void SubsonicListener::trackStartedPlaying(const QUrl &url, const QDateTime &time)
+{
+    if (!SubsonicApi::isStreamUrl(url)) {
+        return;
+    }
+
+    // also emitted when resuming from pause: keep the first start time
+    if (!mPlayStartTimes.contains(url)) {
+        mPlayStartTimes.insert(url, time);
+    }
+    scrobble(url, time, false);
+}
+
+void SubsonicListener::trackFinishedPlaying(const QUrl &url, const QDateTime &time)
+{
+    if (!SubsonicApi::isStreamUrl(url)) {
+        return;
+    }
+
+    const auto startTime = mPlayStartTimes.take(url);
+    scrobble(url, startTime.isValid() ? startTime : time, true);
+}
+
+void SubsonicListener::scrobble(const QUrl &url, const QDateTime &time, bool submission)
+{
+    const auto settings = SubsonicApi::settings();
+    if (!settings.isUsable() || !SubsonicApi::belongsToServer(url, settings.serverUrl) || mStopRequested) {
+        return;
+    }
+
+    QUrlQuery query;
+    query.addQueryItem(u"id"_s, QString::fromLatin1(QUrl::toPercentEncoding(SubsonicApi::songId(url))));
+    query.addQueryItem(u"time"_s, QString::number(time.toMSecsSinceEpoch()));
+    query.addQueryItem(u"submission"_s, submission ? u"true"_s : u"false"_s);
+
+    get(
+        settings,
+        "scrobble"_L1,
+        query,
+        [](const QJsonObject &) { },
+        [submission](const QString &message) {
+            qCWarning(orgKdeElisaSubsonic()) << (submission ? "scrobble" : "now playing") << "failed:" << message;
+        });
+}
+
+void SubsonicListener::applicationAboutToQuit()
+{
+    mStopRequested = true;
+}
+
+#include "moc_subsoniclistener.cpp"
