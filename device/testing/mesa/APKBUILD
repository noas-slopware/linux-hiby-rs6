_dri_driverdir=/usr/lib/dri
_gallium_drivers="r300,r600,radeonsi,nouveau,llvmpipe,virgl,zink"
_vulkan_drivers="amd,swrast"
_vulkan_layers="device-select,overlay"

# extra gallium per arch
case "$CARCH" in
x86*)
	_gallium_drivers="$_gallium_drivers,svga,i915,iris,crocus"
	;;
armhf|armv7)
	_gallium_drivers="$_gallium_drivers,vc4,v3d,freedreno,lima,panfrost,etnaviv,tegra"
	_gallium_drivers="${_gallium_drivers//r300,}"
	;;
aarch64)
	_gallium_drivers="$_gallium_drivers,vc4,v3d,freedreno,lima,panfrost,etnaviv,tegra,asahi,svga"
	_gallium_drivers="${_gallium_drivers//r300,}"
	;;
riscv64)
	_gallium_drivers="${_gallium_drivers//r300,}"
	;;
loongarch64)
	_gallium_drivers="$_gallium_drivers,i915,iris,crocus"
	_gallium_drivers="${_gallium_drivers//r300,}"
esac

# extra vulkan per arch
case "$CARCH" in
x86*|loongarch64)
	_vulkan_drivers="$_vulkan_drivers,intel,intel_hasvk,nouveau,virtio"
	_vulkan_layers="$_vulkan_layers,intel-nullhw"
	subpackages="
		$subpackages
		$pkgname-vulkan-intel:_vulkan
		$pkgname-vulkan-nouveau:_vulkan
		$pkgname-vulkan-virtio:_vulkan
		"
	;;
aarch64)
	_vulkan_drivers="$_vulkan_drivers,asahi,broadcom,freedreno,imagination,intel,nouveau,panfrost,virtio"
	subpackages="
		$subpackages
		$pkgname-vulkan-asahi:_vulkan
		$pkgname-vulkan-broadcom:_vulkan
		$pkgname-vulkan-freedreno:_vulkan
		$pkgname-vulkan-imagination:_vulkan
		$pkgname-vulkan-intel:_vulkan
		$pkgname-vulkan-nouveau:_vulkan
		$pkgname-vulkan-panfrost:_vulkan
		$pkgname-vulkan-virtio:_vulkan
		"
	;;
esac

_intel_rt=disabled
case "$CARCH" in
	x86_64) _intel_rt=enabled ;;
esac

case "$CARCH" in
x86)
	# lto fails on x86 only
	# mostly:
	# https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/21371
	# https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/21180
	_lto=false
	;;
*)
	# ~5% smaller
	# disable temporarily until resolved:
	# https://gitlab.freedesktop.org/mesa/mesa/-/issues/11846
	_lto=false
	;;
esac

case "$CARCH" in
armv7|aarch64|x86|x86_64|loongarch64)
	_rusticl=true
	makedepends="
		$makedepends
		clang$_llvmver-dev
		libclc-dev~$_llvmver
		rust
		rust-bindgen
		spirv-llvm-translator-dev
		"
	subpackages="
		$subpackages
		$pkgname-rusticl
		"
	;;
armhf)
	# still requires clc for panfrost (https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/32720)
	makedepends="
		$makedepends
		clang$_llvmver-dev
		libclc-dev~$_llvmver
		rust
		rust-bindgen
		spirv-llvm-translator-dev
		"
	_rusticl=false
	;;
*)
	_rusticl=false
	;;
esac

prepare() {
	default_prepare

	cd subprojects/

	rm -f paste-1-rs.wrap proc-macro2-1-rs.wrap quote-1-rs.wrap syn-2-rs.wrap unicode-ident-1-rs.wrap rustc-hash-2-rs.wrap

	mv "$srcdir/paste-$_paste_version" paste-1-rs
	mv "$srcdir/proc-macro2-$_proc_macro2_version" proc-macro2-1-rs
	mv "$srcdir/quote-$_quote_version" quote-1-rs
	mv "$srcdir/syn-$_syn_version" syn-2-rs
	mv "$srcdir/unicode-ident-$_unicode_ident_version" unicode-ident-1-rs
	mv "$srcdir/rustc-hash-$_rustc_hash_version" rustc-hash-2-rs

	cp packagefiles/paste-1-rs/meson.build paste-1-rs/
	cp packagefiles/proc-macro2-1-rs/meson.build proc-macro2-1-rs/
	cp packagefiles/quote-1-rs/meson.build quote-1-rs/
	cp packagefiles/syn-2-rs/meson.build syn-2-rs/
	cp packagefiles/unicode-ident-1-rs/meson.build unicode-ident-1-rs/
	cp packagefiles/rustc-hash-2-rs/meson.build rustc-hash-2-rs/
}

# Cross compiling (pmbootstrap pmb:cross-native2, CHOST != CBUILD):
# - mesa_clc and vtn_bindgen2 run on the build machine while building, so they
#   are built natively first and passed in with -Dmesa-clc=system.
# - rustc gets the target via the cross file, and meson builds everything that
#   is native: true (proc-macro crates and their syn/quote/proc-macro2
#   dependencies) with the build machine's rustc.
# - the aarch64 llvm-config cannot run here, so the native one is used with its
#   paths pointed into the sysroot.
_cross_setup() {
	local native_tools="$srcdir"/native-tools
	mkdir -p "$native_tools"/bin

	(
		unset CROSS_COMPILE PKG_CONFIG_PATH PKG_CONFIG_SYSROOT_DIR
		export CC="${HOSTCC:-gcc}" CXX="${HOSTCXX:-g++}" LD="${HOSTLD:-ld}"
		export CFLAGS="$HOSTCFLAGS" CXXFLAGS="$HOSTCXXFLAGS"
		export CPPFLAGS="$HOSTCPPFLAGS" LDFLAGS="$HOSTLDFLAGS"
		export PATH="$PATH:/usr/lib/llvm$_llvmver/bin"
		meson setup \
			--prefix=/usr \
			--buildtype=plain \
			--wrap-mode=nodownload \
			-Dllvm=enabled \
			-Dshared-llvm=enabled \
			-Dmesa-clc=enabled \
			-Dinstall-mesa-clc=true \
			-Dprecomp-compiler=enabled \
			-Dinstall-precomp-compiler=true \
			-Dgallium-drivers=panfrost,asahi \
			-Dvulkan-drivers=imagination \
			-Dplatforms= \
			-Dglx=disabled \
			-Dgbm=disabled \
			-Degl=disabled \
			-Dgles1=disabled \
			-Dgles2=disabled \
			-Dopengl=false \
			-Dgallium-rusticl=false \
			-Dbuild-tests=false \
			-Dvalgrind=disabled \
			-Dlibunwind=disabled \
			. output-native
		meson compile -C output-native mesa_clc vtn_bindgen2 \
			pco_clc asahi_clc panfrost_compile
	)
	find output-native -type f \( -name mesa_clc -o -name vtn_bindgen2 \
		-o -name pco_clc -o -name asahi_clc -o -name panfrost_compile \) \
		-exec install -Dm755 -t "$native_tools"/bin {} +

	cat > "$native_tools"/llvm-config <<-EOF
	#!/bin/sh
	/usr/lib/llvm$_llvmver/bin/llvm-config "\$@" \\
		| sed -e "s|/usr/lib/llvm$_llvmver|$CBUILDROOT/usr/lib/llvm$_llvmver|g"
	EOF
	chmod +x "$native_tools"/llvm-config

	# The native rust package only ships the x86_64 standard library. The
	# aarch64 one comes from the rust package in the sysroot: merge both into
	# one rustc sysroot, so it can compile for the target and load the native
	# proc macros.
	local triple="${CROSS_COMPILE%-}" rust_sysroot="$srcdir"/rust-sysroot
	mkdir -p "$rust_sysroot"/lib/rustlib
	ln -s /usr/lib/rustlib/* "$rust_sysroot"/lib/rustlib/
	ln -s "$CBUILDROOT"/usr/lib/rustlib/$triple "$rust_sysroot"/lib/rustlib/

	cat > "$native_tools"/rust.cross <<-EOF
	[binaries]
	rust = ['rustc', '--target', '$triple', '--sysroot', '$rust_sysroot']
	llvm-config = '$native_tools/llvm-config'
	[built-in options]
	rust_link_args = ['--sysroot=$CBUILDROOT']
	EOF

	export PATH="$native_tools/bin:$PATH"
	_meson_cross_args="--cross-file $native_tools/rust.cross"
	_mesa_clc=system
	_precomp=system
}

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		_cross_setup
	fi

	# use -g1 to generate less debug info:
	# 485 MiB -> ~80 MiB
	export CFLAGS="$CFLAGS -O2 -g1"
	export CXXFLAGS="$CXXFLAGS -O2 -g1"
	export CPPFLAGS="$CPPFLAGS -O2 -g1"

	case "$CARCH" in
	armhf|armv7)
		# gnu2 tlsdesc is broken in binutils, see
		# https://gitlab.alpinelinux.org/alpine/aports/-/issues/14140
		# and
		# https://gitlab.freedesktop.org/mesa/mesa/-/issues/13236
		export CFLAGS="$CFLAGS -mtls-dialect=gnu"
		export CXXFLAGS="$CXXFLAGS -mtls-dialect=gnu"
		;;
	esac

	PATH="$PATH:/usr/lib/llvm$_llvmver/bin" \
	abuild-meson \
		-Db_ndebug=true \
		-Db_lto=$_lto \
		-Dallow-kcmp=enabled \
		-Dexpat=enabled \
		-Dintel-rt=$_intel_rt \
		-Dshader-cache=enabled \
		-Dxlib-lease=enabled \
		-Dxmlconfig=enabled \
		-Dzstd=enabled \
		-Dbackend_max_links=2 \
		-Dbuild-tests="$(want_check && echo true || echo false)" \
		-Ddri-drivers-path=$_dri_driverdir \
		-Dgallium-drivers=$_gallium_drivers \
		-Dvulkan-drivers=$_vulkan_drivers \
		-Dvulkan-layers=$_vulkan_layers \
		-Damdgpu-virtio=true \
		-Dfreedreno-kmds=msm,virtio \
		-Dplatforms=x11,wayland \
		-Dllvm=enabled \
		-Dshared-llvm=enabled \
		-Dgbm=enabled \
		-Dglx=dri \
		-Dopengl=true \
		-Dgles1=enabled \
		-Dgles2=enabled \
		-Degl=enabled \
		-Dgallium-extra-hud=true \
		-Dgallium-rusticl=$_rusticl \
		${_mesa_clc:+-Dmesa-clc=$_mesa_clc} \
		${_precomp:+-Dprecomp-compiler=$_precomp} \
		-Dgallium-rusticl-enable-drivers=auto,freedreno \
		-Dgallium-va=enabled \
		-Drust_std=2021 \
		-Dvideo-codecs=all \
		$_meson_cross_args \
		. output

	# Print config
	meson configure --no-pager output

	meson compile -C output
}

# Tests workarounds
case "$CARCH" in
armhf|armv7|riscv64|loongarch64|ppc64le)
	# https://gitlab.alpinelinux.org/alpine/aports/-/issues/16525
	_tests_opts="$_tests_opts --no-suite mesa:llvmpipe"
	;;
s390x|ppc64)
	# https://gitlab.freedesktop.org/mesa/mesa/-/issues/9507
	# mesa:amd / ac_surface_modifier_test timeouts (CI perf issue I assume)
	_tests_opts="$_tests_opts --no-suite mesa:gallium --no-suite mesa:llvmpipe --no-suite mesa:amd"
	;;
esac

check() {
	LC_ALL=C.UTF=8 meson test --print-errorlogs $_tests_opts -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

egl() {
	pkgdesc="Mesa libEGL runtime libraries"
	# gles is not directly needed but GTK+mesa throws errors when egl
	# is installed without gles
	# https://gitlab.alpinelinux.org/alpine/aports/-/issues/15510#note_531887
	depends="mesa=$pkgver-r$pkgrel mesa-gles=$pkgver-r$pkgrel"

	amove usr/lib/libEGL.so*
}

gl() {
	pkgdesc="Mesa libGL runtime libraries"
	depends="mesa=$pkgver-r$pkgrel"

	amove usr/lib/libGL.so*
}

gles() {
	pkgdesc="Mesa libGLESv2 runtime libraries"
	depends="mesa=$pkgver-r$pkgrel"

	amove usr/lib/libGLES*.so*
}

gbm() {
	pkgdesc="Mesa gbm library"
	depends="mesa=$pkgver-r$pkgrel"

	amove usr/lib/libgbm.so.*
}

rusticl() {
	pkgdesc="Mesa OpenCL driver"
	depends="mesa=$pkgver-r$pkgrel clang$_llvmver-headers libclc~$_llvmver"

	amove usr/lib/libRusticlOpenCL.so.*
	amove etc/OpenCL/vendors/
}

# Move links referencing the same file to the subpackage.
# Usage: _mv_links <base directory> <example>
# where <example> is one of the libraries covered by the megadriver.
# The example is used to find other links that point to the same file.
_mv_links() {
	install -d "$subpkgdir"/$1
	find -L "$pkgdir"/$1 -samefile "$pkgdir"/$1/$2 -print0 \
		| xargs -0 -I{} mv {} "$subpkgdir"/$1/
}

_mv_vulkan() {
	local i
	for i in "$@"; do
		amove usr/lib/libvulkan_$i*.so
		amove usr/share/vulkan/icd.d/${i}_*.*
	done
}

# Mesa uses "megadrivers" where multiple drivers are linked into one shared
# library. This library is then hard-linked to separate files (one for each driver).
# Each subpackage contains one megadriver so that all the hard-links are preserved.

_gallium() {
	pkgdesc="Mesa gallium DRI drivers"
	depends="mesa=$pkgver-r$pkgrel"

	# libgallium_dri.so
	_mv_links $_dri_driverdir swrast_dri.so
}

_va() {
	local n=${subpkgname##*-va-}
	pkgdesc="Mesa $n VAAPI drivers"
	depends="mesa=$pkgver-r$pkgrel libva"

	case $n in
	gallium)
		# libgallium_drv_video.so
		_mv_links /usr/lib/dri radeonsi_drv_video.so ;;
	esac
}

_vulkan() {
	local n=${subpkgname##*-vulkan-}
	pkgdesc="Mesa Vulkan API driver for $n"
	depends="mesa=$pkgver-r$pkgrel"

	case $n in
	ati)
		_mv_vulkan radeon ;;
	asahi)
		_mv_vulkan asahi ;;
	imagination)
		_mv_vulkan powervr_mesa ;;
	intel)
		_mv_vulkan intel ;;
	broadcom)
		_mv_vulkan broadcom ;;
	freedreno)
		_mv_vulkan freedreno ;;
	nouveau)
		_mv_vulkan nouveau ;;
	panfrost)
		_mv_vulkan panfrost ;;
	swrast)
		_mv_vulkan lvp ;;
	virtio)
		_mv_vulkan virtio ;;
	esac
}

_vulkan_layers() {
	pkgdesc="collection of vulkan layers from mesa"
	depends="python3"

	# Remove this after the release of the next stable (3.14)
	# it originally was claed layer as it only packaged the
	# overlay one but now it also packages device-select and
	# intel-nullhw (on x86*)
	provides="$pkgname-vulkan-layer=$pkgver-r$pkgrel"
	replaces="$pkgname-vulkan-layer=$pkgver-r$pkgrel"

	amove usr/share/vulkan/explicit_layer.d
	amove usr/share/vulkan/implicit_layer.d
	amove usr/lib/libVkLayer_*.so
	amove usr/bin/mesa-overlay-control.py
}

