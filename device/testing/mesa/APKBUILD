# Alpine main/mesa 26.2.5-r0 + 0101-0103 (Mesa MR !45465, Fabricio Akio: A508 rendering fixes) and
# 0104 (A509/A512 RB_CCU_CNTL from the RS6's stock Adreno 512 driver) and 0105 (A508/A509/A512
# highest bank bit, ECO registers and 2D blits programmed like the stock driver) and 0106 (A8
# read as A8 in 2D SCALE blits; fixes Qt text): Adreno 512 rendering artifacts (mesa#8442).
# pkgrel above Alpine so this wins.
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=mesa
pkgver=26.2.5
pkgrel=3
pkgdesc="Mesa DRI OpenGL library"
url="https://www.mesa3d.org"
arch="all"
license="MIT AND SGI-B-2.0 AND BSL-1.0"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-dri-gallium:_gallium
	$pkgname-va-gallium:_va
	$pkgname-egl
	$pkgname-gl
	$pkgname-gles
	$pkgname-gbm
	$pkgname-vulkan-ati:_vulkan
	$pkgname-vulkan-swrast:_vulkan
	$pkgname-vulkan-layers:_vulkan_layers
	"
_llvmver=23
depends_dev="
	libdrm-dev
	libxdamage-dev
	libxshmfence-dev
	"
# pmbootstrap resolves build dependencies without evaluating the $CARCH case
# below, so the aarch64 (rusticl, clc) deps are listed explicitly. This package
# is cross-compiled with pmb:cross-native2: makedepends_build is installed in
# the native chroot (tools and native llvm/clang for mesa_clc), makedepends_host
# in the aarch64 sysroot (libraries to link against).
makedepends_build="
	binutils
	bison
	cbindgen
	clang$_llvmver-dev
	expat-dev
	findutils
	flex
	gettext
	glslang
	glslang-dev
	libtool
	libxml2-dev
	llvm$_llvmver-dev
	meson
	py3-cparser
	py3-mako
	py3-packaging
	py3-ply
	py3-yaml
	python3
	rust
	rust-bindgen
	spirv-llvm-translator-dev
	spirv-tools-dev
	wayland-dev
	wayland-protocols
	zlib-dev
	zstd
	zstd-dev
	"
makedepends_host="
	$depends_dev
	clang$_llvmver-dev
	elfutils-dev
	eudev-dev
	expat-dev
	libclc-dev~$_llvmver
	libdisplay-info-dev
	libva-dev
	libx11-dev
	libxfixes-dev
	libxml2-dev
	libxrandr-dev
	libxxf86vm-dev
	llvm$_llvmver-dev
