	spirv-tools-dev
	vulkan-loader-dev
	wayland-dev
	wayland-protocols
	xorgproto
	zlib-dev
	zstd-dev
	"
makedepends="$makedepends_build $makedepends_host"
_paste_version="1.0.14"
_proc_macro2_version="1.0.86"
