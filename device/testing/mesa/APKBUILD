_syn_version="2.0.68"
_unicode_ident_version="1.0.12"
_rustc_hash_version="2.1.1"
source="https://mesa.freedesktop.org/archive/mesa-${pkgver/_/-}.tar.xz
	paste-$_paste_version.tar.gz::https://static.crates.io/crates/paste/paste-$_paste_version.crate
	proc-macro2-$_proc_macro2_version.tar.gz::https://static.crates.io/crates/proc-macro2/proc-macro2-$_proc_macro2_version.crate
	quote-$_quote_version.tar.gz::https://static.crates.io/crates/quote/quote-$_quote_version.crate
	syn-$_syn_version.tar.gz::https://static.crates.io/crates/syn/syn-$_syn_version.crate
	unicode-ident-$_unicode_ident_version.tar.gz::https://static.crates.io/crates/unicode-ident/unicode-ident-$_unicode_ident_version.crate
	rustc-hash-$_rustc_hash_version.tar.gz::https://static.crates.io/crates/rustc-hash/rustc-hash-$_rustc_hash_version.crate
	23575.patch
	riscv64-tls.patch
	0101-freedreno-a5xx-Use-the-blob-s-RB_CCU_CNTL-values-on-A508.patch
	0102-freedreno-a5xx-Don-t-2D-copy-between-linear-surfaces-on-A508.patch
	0103-freedreno-a5xx-Re-emit-fragment-textures-when-the-fragment-program-changes.patch
	0104-freedreno-a5xx-Use-the-blob-s-RB_CCU_CNTL-values-on-A509-and-A512.patch
	0105-freedreno-a5xx-Program-the-A508-A509-A512-the-way-Qualcomm-s-driver-does.patch
	0106-freedreno-a5xx-Read-A8-as-A8-in-SCALE-blits.patch
	llvm23.patch
	"
builddir="$srcdir/mesa-${pkgver/_/-}"
