+/* Tiled addresses are swizzled by the highest DDR bank bit (13..16), and the
+ * RB, TPL1 and UCHE each carry it in their mode registers as (bit - 13).  The
+ * kernel programs all three at boot for its SoC; the UCHE keeps that value,
+ * so the two we rewrite in every command stream must encode the same bit.
+ * The A530 traces this code was written from came from msm8996 (bit 15);
+ * SDM660's A512 has bit 14.
+ */
+static inline uint32_t
+fd5_hbb_bits(const struct fd_screen *screen)
+{
+   return (screen->highest_bank_bit - 13) & 3;
+}
+
+static inline uint32_t
+fd5_rb_mode_cntl(const struct fd_screen *screen)
+{
+   return 0x40 | (fd5_hbb_bits(screen) << 1);
+}
+
+static inline uint32_t
+fd5_tpl1_mode_cntl(const struct fd_screen *screen)
+{
+   return 0x444 | (fd5_hbb_bits(screen) << 7);
+}
