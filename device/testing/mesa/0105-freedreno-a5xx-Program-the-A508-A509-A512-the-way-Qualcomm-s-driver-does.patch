+	<bitset name="a5xx_2d_src_surf_info" inline="yes">
+		<bitfield name="COLOR_FORMAT" low="0" high="7" type="a5xx_tex_fmt"/>
+		<bitfield name="TILE_MODE" low="8" high="9" type="a5xx_tile_mode"/>
+		<bitfield name="COLOR_SWAP" low="10" high="11" type="a3xx_color_swap"/>
+		<bitfield name="FLAGS" pos="12" type="boolean"/>
+		<bitfield name="SRGB" pos="13" type="boolean"/>
+		<bitfield name="SAMPLES" low="14" high="15" type="a3xx_msaa_samples"/>
+		<bitfield name="FILTER" pos="16" type="boolean"/>
+		<bitfield name="SAMPLES_AVERAGE" pos="18" type="boolean"/>
+		<bitfield name="UNK20" pos="20" type="boolean"/>
+		<bitfield name="UNK22" pos="22" type="boolean"/>
+	</bitset>
+	<reg32 offset="0x2000" name="SP_PS_2D_SRC_INFO" type="a5xx_2d_src_surf_info"/>
+	<reg32 offset="0x2001" name="SP_PS_2D_SRC_SIZE">
+		<bitfield name="WIDTH" low="0" high="14" type="uint"/>
+		<bitfield name="HEIGHT" low="15" high="29" type="uint"/>
+	</reg32>
+	<reg64 offset="0x2002" name="SP_PS_2D_SRC" type="address"/>
+	<reg32 offset="0x2004" name="SP_PS_2D_SRC_PITCH">
+		<bitfield name="PITCH" low="3" high="23" type="uint"/>
+	</reg32>
+	<reg64 offset="0x2005" name="SP_PS_2D_SRC_PLANE1" type="address"/>
+	<reg32 offset="0x2007" name="SP_PS_2D_SRC_PLANE_PITCH" shr="4" type="uint"/>
+	<reg64 offset="0x2008" name="SP_PS_2D_SRC_PLANE2" type="address"/>
