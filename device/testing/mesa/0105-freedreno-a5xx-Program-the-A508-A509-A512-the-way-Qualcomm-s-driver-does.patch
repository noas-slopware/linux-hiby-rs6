 static void
-emit_setup(struct fd_ringbuffer *ring)
+emit_setup(struct fd_context *ctx, struct fd_ringbuffer *ring)
 {
    OUT_PKT4(ring, REG_A5XX_RB_RENDER_CNTL, 1);
    OUT_RING(ring, 0x00000008);
@@ -200,14 +200,16 @@ emit_setup(struct fd_ringbuffer *ring)
    OUT_PKT4(ring, REG_A5XX_RB_CNTL, 1);
    OUT_RING(ring, A5XX_RB_CNTL_BYPASS);
 
+   /* Only the bank bit; the A530 traces had bit 15 (0x4): */
    OUT_PKT4(ring, REG_A5XX_RB_MODE_CNTL, 1);
-   OUT_RING(ring, 0x00000004); /* RB_MODE_CNTL */
+   OUT_RING(ring, fd5_hbb_bits(ctx->screen) << 1); /* RB_MODE_CNTL */
 
    OUT_PKT4(ring, REG_A5XX_SP_MODE_CNTL, 1);
    OUT_RING(ring, 0x0000000c); /* SP_MODE_CNTL */
 
+   /* 0x244 plus the bank bit, 0x344 in the A530 traces: */
    OUT_PKT4(ring, REG_A5XX_TPL1_MODE_CNTL, 1);
-   OUT_RING(ring, 0x00000344); /* TPL1_MODE_CNTL */
+   OUT_RING(ring, 0x244 | (fd5_hbb_bits(ctx->screen) << 7)); /* TPL1_MODE_CNTL */
 
    OUT_PKT4(ring, REG_A5XX_HLSQ_MODE_CNTL, 1);
    OUT_RING(ring, 0x00000002); /* HLSQ_MODE_CNTL */
@@ -216,11 +218,188 @@ emit_setup(struct fd_ringbuffer *ring)
    OUT_RING(ring, 0x00000181); /* GRAS_CL_CNTL */
 }
 
+/* One side of a 2D-engine blit: what RB_2D_SRC/DST_INFO describe, plus the
+ * texture view of it that a SCALE blit's source needs.
+ */
+struct blit_surf {
+   struct fd_bo *bo;
+   uint32_t offset;
+   enum a5xx_color_fmt cfmt;
+   enum a5xx_tex_fmt tfmt;
+   enum a5xx_tile_mode tile;
+   enum a3xx_color_swap swap;
+   uint32_t pitch;       /* bytes */
+   uint32_t array_pitch; /* bytes */
+   uint32_t width, height;
+};
+
+static uint32_t
+surf_info(const struct blit_surf *s)
+{
+   return A5XX_RB_2D_SRC_INFO_COLOR_FORMAT(s->cfmt) |
+          A5XX_RB_2D_SRC_INFO_TILE_MODE(s->tile) |
+          A5XX_RB_2D_SRC_INFO_COLOR_SWAP(s->swap);
+}
+
+/* RB_2D_SRC_SIZE/DST_SIZE: the pitch, and in the upper half what the A530
+ * traces showed as a layer pitch.  Qualcomm's driver writes the surface's
+ * height there (A5xBltDevice::SetA2dSrcBuffer), which the traces could not
+ * tell apart: a layer pitch of height rows of 128 bytes encodes the same.
+ * A SCALE blit gets the height, as the TP reads the source as a texture.
+ */
+static uint32_t
+surf_size(const struct blit_surf *s, bool scale)
+{
+   if (scale)
+      return A5XX_RB_2D_SRC_SIZE_PITCH(s->pitch) | (s->height << 17);
+   return A5XX_RB_2D_SRC_SIZE_PITCH(s->pitch) |
+          A5XX_RB_2D_SRC_SIZE_ARRAY_PITCH(s->array_pitch);
+}
+
+static void
+emit_src(struct fd_ringbuffer *ring, const struct blit_surf *s, bool scale)
+{
+   OUT_PKT4(ring, REG_A5XX_RB_2D_SRC_INFO, 9);
+   OUT_RING(ring, surf_info(s));
+   OUT_RELOC(ring, s->bo, s->offset, 0, 0); /* RB_2D_SRC_LO/HI */
+   OUT_RING(ring, surf_size(s, scale));
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+
+   OUT_PKT4(ring, REG_A5XX_GRAS_2D_SRC_INFO, 1);
+   OUT_RING(ring, surf_info(s));
+
+   if (!scale)
+      return;
+
+   /* The TP's view of the source, read with the pixel-exact sampling of a
+    * nearest, unscaled SCALE blit.  The two UNK bits are always set.
+    */
+   OUT_PKT4(ring, REG_A5XX_SP_PS_2D_SRC_INFO, 10);
+   OUT_RING(ring, A5XX_SP_PS_2D_SRC_INFO_COLOR_FORMAT(s->tfmt) |
+                     A5XX_SP_PS_2D_SRC_INFO_TILE_MODE(s->tile) |
+                     A5XX_SP_PS_2D_SRC_INFO_COLOR_SWAP(s->swap) |
+                     A5XX_SP_PS_2D_SRC_INFO_UNK20 |
+                     A5XX_SP_PS_2D_SRC_INFO_UNK22);
+   OUT_RING(ring, A5XX_SP_PS_2D_SRC_SIZE_WIDTH(s->width) |
+                     A5XX_SP_PS_2D_SRC_SIZE_HEIGHT(s->height));
+   OUT_RELOC(ring, s->bo, s->offset, 0, 0); /* SP_PS_2D_SRC_LO/HI */
+   OUT_RING(ring, A5XX_SP_PS_2D_SRC_PITCH_PITCH(s->pitch));
+   OUT_RING(ring, 0x00000000); /* SP_PS_2D_SRC_PLANE1_LO */
+   OUT_RING(ring, 0x00000000); /* SP_PS_2D_SRC_PLANE1_HI */
+   OUT_RING(ring, 0x00000000); /* SP_PS_2D_SRC_PLANE_PITCH */
+   OUT_RING(ring, 0x00000000); /* SP_PS_2D_SRC_PLANE2_LO */
+   OUT_RING(ring, 0x00000000); /* SP_PS_2D_SRC_PLANE2_HI */
+}
+
+static void
+emit_dst(struct fd_ringbuffer *ring, const struct blit_surf *s, bool scale)
+{
+   OUT_PKT4(ring, REG_A5XX_RB_2D_DST_INFO, 9);
+   OUT_RING(ring, surf_info(s));
+   OUT_RELOC(ring, s->bo, s->offset, 0, 0); /* RB_2D_DST_LO/HI */
+   OUT_RING(ring, surf_size(s, scale));
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+   OUT_RING(ring, 0x00000000);
+
+   OUT_PKT4(ring, REG_A5XX_GRAS_2D_DST_INFO, 1);
+   OUT_RING(ring, surf_info(s));
+}
+
+/* A SCALE blit converts through one of five intermediate formats, chosen by
+ * the source and destination formats (A5xBltDevice::A5xA2dGetIMF): RGBA8 for
+ * 8-bit unorm colour, RGBA16F for 16-bit float and RGBA32F for everything
+ * else, each of which carries the formats we send through it exactly.  (The
+ * other two are sRGB and snorm: we copy sRGB surfaces as their linear format
+ * instead, and leave snorm to the 3D path, as Qualcomm's driver copies those
+ * as sint.  Integer formats take yet another route, their own format with
+ * the SINT/UINT bits, which also stays with the 3D path.)  Its index goes
+ * into the BLIT_CNTLs, with bit 31 set only for RGBA8, and the format into
+ * SP_2D_DST_FORMAT.
+ */
+static uint32_t
+blit_dst_format(enum pipe_format fmt, uint32_t *imf)
+{
+   const struct util_format_description *desc = util_format_description(fmt);
+   enum a5xx_color_fmt out;
+   unsigned bits = 0;
+   uint32_t v = 0;
+
+   for (unsigned i = 0; i < desc->nr_channels; i++)
+      bits = MAX2(bits, desc->channel[i].size);
+
+   if (util_format_is_float16(fmt) || fmt == PIPE_FORMAT_R11G11B10_FLOAT) {
+      *imf = 3;
+      out = RB5_R16G16B16A16_FLOAT;
+   } else if (util_format_is_unorm(fmt) && bits <= 8) {
+      *imf = 0;
+      out = RB5_R8G8B8A8_UNORM;
+   } else {
+      *imf = 4;
+      out = RB5_R32G32B32A32_FLOAT;
+   }
+
+   v = A5XX_SP_2D_DST_FORMAT_COLOR_FORMAT(out);
+   if (bits <= 9)
+      v |= A5XX_SP_2D_DST_FORMAT_NORM8;
+
+   return v;
+}
+
+static void
+emit_blit_cmd(struct fd_ringbuffer *ring, bool scale, enum pipe_format fmt,
+              unsigned sx1, unsigned sy1, unsigned sx2, unsigned sy2,
+              unsigned dx1, unsigned dy1, unsigned dx2, unsigned dy2)
+{
+   if (scale) {
+      uint32_t imf;
+      uint32_t dst_format = blit_dst_format(fmt, &imf);
+      uint32_t blit_cntl = 0x06000000 | (imf << 28) | COND(imf == 0, 0x80000000);
+
+      OUT_PKT4(ring, REG_A5XX_RB_2D_BLIT_CNTL, 1);
+      OUT_RING(ring, blit_cntl);
+
+      OUT_PKT4(ring, REG_A5XX_GRAS_2D_BLIT_CNTL, 1);
+      OUT_RING(ring, blit_cntl);
+
+      OUT_PKT4(ring, REG_A5XX_SP_2D_DST_FORMAT, 1);
+      OUT_RING(ring, dst_format);
+
+      /* 9 for a COPY, 1 for a SCALE (A5xWriteGrasA2dPartitionCntl0): */
+      OUT_PKT4(ring, REG_A5XX_UNKNOWN_2184, 1);
+      OUT_RING(ring, 0x00000001);
+
+      OUT_PKT4(ring, REG_A5XX_UNKNOWN_2183, 1);
+      OUT_RING(ring, 0x00000000);
+   }
+
+   OUT_PKT7(ring, CP_BLIT, 5);
+   OUT_RING(ring, CP_BLIT_0_OP(scale ? BLIT_OP_SCALE : BLIT_OP_COPY));
+   OUT_RING(ring, CP_BLIT_1_SRC_X1(sx1) | CP_BLIT_1_SRC_Y1(sy1));
+   OUT_RING(ring, CP_BLIT_2_SRC_X2(sx2) | CP_BLIT_2_SRC_Y2(sy2));
+   OUT_RING(ring, CP_BLIT_3_DST_X1(dx1) | CP_BLIT_3_DST_Y1(dy1));
+   OUT_RING(ring, CP_BLIT_4_DST_X2(dx2) | CP_BLIT_4_DST_Y2(dy2));
+}
+
+static void
+emit_render_mode(struct fd_ringbuffer *ring, enum render_mode_cmd mode)
+{
+   OUT_PKT7(ring, CP_SET_RENDER_MODE, 1);
+   OUT_RING(ring, CP_SET_RENDER_MODE_0_MODE(mode));
+}
+
 /* buffers need to be handled specially since x/width can exceed the bounds
  * supported by hw.. if necessary decompose into (potentially) two 2D blits
  */
 static void
-emit_blit_buffer(struct fd_ringbuffer *ring, const struct pipe_blit_info *info)
+emit_blit_buffer(struct fd_ringbuffer *ring, const struct pipe_blit_info *info,
