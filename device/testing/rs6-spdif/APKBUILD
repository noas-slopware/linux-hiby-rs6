# Maintainer: Noa Himesaka <himesaka@noa.codes>
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=rs6-spdif
pkgver=1.0
pkgrel=0
pkgdesc="HiBy RS6 coaxial S/PDIF output: ALSA IEC 60958 encoder plugin and output jack controls"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
makedepends="alsa-lib-dev meson"
checkdepends="python3"
source="
	meson.build
	meson_options.txt
	50-rs6-spdif.conf
	iec958.c
	iec958.h
	rs6-target.c
	rs6-target.h
	pcm_rs6_spdif.c
	ctl_rs6_jack.c
	bmc-decode.h
	test-encoder.c
	rs6-spdif-encode.c
	spdif_ref.py
	test-ref.py
	test-plugin.c
	test-target.c
	test-alsa.conf.in
	"
builddir="$srcdir"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	# encoder vs the docs' vectors, the stock HAL transliteration and a spec encoder, and
	# the plugin end to end through alsa-lib; test-target needs a sound card and skips here
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}
