# Maintainer: Noa Himesaka <himesaka@noa.codes>
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=rs6-dac-plasma
pkgver=1.0
pkgrel=4
pkgdesc="HiBy RS6 DAC controls for Plasma Mobile: System Settings page and quick setting"
url="https://nura.eco"
arch="aarch64"
license="MIT"
depends="
	device-hiby-rs6>=1-r11
	kcmutils
	kde-cli-tools
	kirigami
	kirigami-addons
	libkscreen
	plasma-mobile
	qt6-qtdeclarative
	"
makedepends="
	alsa-lib-dev
	cmake
	extra-cmake-modules
	kcmutils-dev
	kcoreaddons-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	samurai
	"
install_if="device-hiby-rs6 plasma-mobile"
options="!check" # no test suite; checked on the device
source="
	CMakeLists.txt
	dac-control.h
	dac-control.cpp
	kcm.cpp
	kcm_rs6dac.json
	kcm-main.qml
	quicksetting-metadata.json
	quicksetting-main.qml
	display-rotation.h
	display-rotation.cpp
	rotate-metadata.json
	rotate-main.qml
	"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	# abuild sources are flat; lay out the tree CMake and kcmutils_add_qml_kcm (ui/) expect
	mkdir -p "$builddir"/ui "$builddir"/quicksetting/contents/ui
	default_prepare
	cp "$srcdir"/CMakeLists.txt "$srcdir"/dac-control.h "$srcdir"/dac-control.cpp \
		"$srcdir"/kcm.cpp "$srcdir"/kcm_rs6dac.json \
		"$srcdir"/display-rotation.h "$srcdir"/display-rotation.cpp "$builddir"/
	cp "$srcdir"/kcm-main.qml "$builddir"/ui/main.qml
	cp "$srcdir"/quicksetting-metadata.json "$builddir"/quicksetting/metadata.json
	cp "$srcdir"/quicksetting-main.qml "$builddir"/quicksetting/contents/ui/main.qml
	mkdir -p "$builddir"/rotate/contents/ui
	cp "$srcdir"/rotate-metadata.json "$builddir"/rotate/metadata.json
	cp "$srcdir"/rotate-main.qml "$builddir"/rotate/contents/ui/main.qml
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
