# Forked from Alpine aports community/elisa (26.08.2-r0) for the HiBy RS6:
# adds a Subsonic/OpenSubsonic (Navidrome) music source and a bit-perfect
# output setting, decodes embedded covers at the requested size instead
# of full resolution, emits cover responses' finished() on the pixmap reader
# thread (use-after-free when scrolling fast) and filters on the search
# field's displayText (input method preedit). pkgrel is above Alpine's so
# this build wins.
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=elisa
pkgver=26.08.2
pkgrel=6
# armhf blocked by extra-cmake-modules
arch="all !armhf"
url="https://kde.org/applications/multimedia/org.kde.elisa"
pkgdesc="A simple music player aiming to provide a nice experience for its users"
license="LGPL-3.0-or-later"
depends="
	kirigami
	kirigami-addons
	qqc2-desktop-style
	qt6-qtbase-sqlite
	vlc
	"
makedepends="
	baloo-dev
	extra-cmake-modules
	kcmutils-dev
	kconfig-dev
	kconfigwidgets-dev
	kcoreaddons-dev
	kcrash-dev
	kdbusaddons-dev
	kdeclarative-dev
	kdoctools-dev
	kfilemetadata-dev
	ki18n-dev
	kio-dev
	kirigami-dev
	kirigami-addons-dev
	kpackage-dev
	kxmlgui-dev
	qqc2-desktop-style-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtmultimedia-dev
	qt6-qtsvg-dev
	samurai
	vlc-dev
	"
checkdepends="
	cmd:dbus-run-session
	xvfb-run
	"
# check() needs dbus + xvfb running inside the (cross) build chroot
options="!check"
subpackages="$pkgname-lang"
_repo_url="https://invent.kde.org/multimedia/elisa.git"
source="https://download.kde.org/stable/release-service/$pkgver/src/elisa-$pkgver.tar.xz
	0001-Add-a-Subsonic-OpenSubsonic-Navidrome-music-source.patch
	0002-Add-a-bit-perfect-output-setting.patch
	0003-Open-mobile-drawers-after-the-tap.patch
	0004-Decode-embedded-covers-at-the-requested-size.patch
	0005-Do-not-scale-cover-sourceSize-by-the-device-pixel-ratio-twice.patch
	0006-Emit-finished-of-embedded-cover-responses-on-the-pixmap-reader-thread.patch
	0007-Filter-the-views-on-the-text-the-search-field-shows.patch
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING=ON
	cmake --build build
}

check() {
	dbus-run-session -- xvfb-run -a ctest --test-dir build -E "databaseInterfaceTest"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

