# Reference: <https://nura.eco/devicepkg/>
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=device-hiby-rs6
pkgdesc="HiBy RS6"
pkgver=1
pkgrel=24
url="https://nura.eco"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-hiby-rs6
	firmware-qcom-adreno-a530
	linux-postmarketos-qcom-sdm660
	mkbootimg
	postmarketos-base
	postmarketos-bootsplash
	postmarketos-plymouth-themes
	rs6-spdif
	soc-qcom-sdm660
	soc-qcom-sdm660-rproc
"
makedepends="alsa-lib-dev devicepkg-dev ffmpeg-dev linux-headers"
subpackages="$pkgname-systemd:_systemd $pkgname-firefox:_firefox"
# Firmware comes from firmware-hiby-rs6 (stock slot B blobs), not from the partitions:
# Nura owns the whole user area (tools/repartition-nura.sh on the main branch), no msm-firmware-loader.
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	ucm-card.conf
	ucm-HiFi.conf
	pipewire-rs6.conf
	wireplumber-rs6.conf
	wireplumber-exclusive-takeover.lua
	wireplumber-output-handover.lua
	pipewire-pulse-rs6.conf
	udev-rs6-no-ssc.rules
	plasmaparc
	kwinrc
	nura-swap.service
	90-hiby-rs6-perf.rules
	hiby-rs6-perf.conf
	hiby-rs6-shutdown.conf
	hiby-rs6-shutdown-target.conf
	firefox-v4l2-fix.c
	firefox-hiby-rs6
	firefox-hiby-rs6.js
	firefox-hiby-rs6.desktop
	firefox-hiby-rs6-env.conf
	firefox-hiby-rs6-plasma-env.sh
	rs6-touchboost.c
	rs6-touchboost.service
	darwinctl.c
	darwinctl.tmpfiles
	darwinctl-restore.service
	rs6-vt-lock.c
	rs6-vt-lock.service
	logind-hiby-rs6.conf
"

build() {
	devicepkg_build $startdir $pkgname

	# plain cc so the shim builds the same on any distro (musl or glibc)
	${CC:-cc} $CFLAGS -shared -fPIC -Wall -o "$srcdir"/firefox-v4l2-fix.so "$srcdir"/firefox-v4l2-fix.c \
		$(pkg-config --cflags libavcodec) -ldl -lpthread $LDFLAGS
	${CC:-cc} $CFLAGS -Wall -o "$srcdir"/rs6-touchboost "$srcdir"/rs6-touchboost.c $LDFLAGS
	${CC:-cc} $CFLAGS -Wall -o "$srcdir"/darwinctl "$srcdir"/darwinctl.c -lasound $LDFLAGS
	${CC:-cc} $CFLAGS -Wall -o "$srcdir"/rs6-vt-lock "$srcdir"/rs6-vt-lock.c $LDFLAGS
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/ucm-card.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sdm660/HiBy RS6.conf"
	install -Dm644 "$srcdir"/ucm-HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/HiBy/RS6/HiFi.conf
	install -Dm644 "$srcdir"/pipewire-rs6.conf \
		"$pkgdir"/usr/share/pipewire/pipewire.conf.d/50-hiby-rs6.conf
	install -Dm644 "$srcdir"/wireplumber-rs6.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/50-hiby-rs6.conf
	install -Dm644 "$srcdir"/wireplumber-exclusive-takeover.lua \
		"$pkgdir"/usr/share/wireplumber/scripts/hiby-rs6/exclusive-takeover.lua
	install -Dm644 "$srcdir"/wireplumber-output-handover.lua \
		"$pkgdir"/usr/share/wireplumber/scripts/hiby-rs6/output-handover.lua
	install -Dm644 "$srcdir"/pipewire-pulse-rs6.conf \
		"$pkgdir"/usr/share/pipewire/pipewire-pulse.conf.d/50-hiby-rs6.conf
	install -Dm644 "$srcdir"/udev-rs6-no-ssc.rules \
		"$pkgdir"/usr/lib/udev/rules.d/91-hiby-rs6-no-ssc.rules
	install -Dm644 "$srcdir"/plasmaparc "$pkgdir"/etc/xdg/plasmaparc
	install -Dm644 "$srcdir"/kwinrc "$pkgdir"/etc/xdg/kwinrc
	install -Dm644 "$srcdir"/90-hiby-rs6-perf.rules -t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm755 "$srcdir"/rs6-touchboost "$pkgdir"/usr/lib/hiby-rs6/rs6-touchboost
	# the DAC filter from the command line (Darwin filters: firmware-hiby-rs6)
	install -Dm755 "$srcdir"/darwinctl "$pkgdir"/usr/bin/darwinctl
	install -Dm755 "$srcdir"/rs6-vt-lock "$pkgdir"/usr/libexec/rs6-vt-lock
	install -Dm644 "$srcdir"/darwinctl.tmpfiles "$pkgdir"/usr/lib/tmpfiles.d/darwinctl.conf
}

_systemd() {
	pkgdesc="$pkgdesc (systemd: 8 GiB swap on nura_swap1 + nura_swap2, cellular services masked)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/nura-swap.service -t "$subpkgdir"/usr/lib/systemd/system/
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/swap.target.wants
	ln -s ../nura-swap.service "$subpkgdir"/usr/lib/systemd/system/swap.target.wants/nura-swap.service

	# no cellular on a DAP: the modem DSP stays (WCN3990 Wi-Fi runs on it), the modem
	# management and its "no signal" indicator do not
	mkdir -p "$subpkgdir"/etc/systemd/system
	for u in ModemManager.service msm-modem-uim-selection.service; do
		ln -s /dev/null "$subpkgdir"/etc/systemd/system/$u
	done

	install -Dm644 "$srcdir"/hiby-rs6-perf.conf -t "$subpkgdir"/usr/lib/tmpfiles.d/

	install -Dm644 "$srcdir"/darwinctl-restore.service -t "$subpkgdir"/usr/lib/systemd/system/
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/sound.target.wants
	ln -s ../darwinctl-restore.service \
		"$subpkgdir"/usr/lib/systemd/system/sound.target.wants/darwinctl-restore.service

	install -Dm644 "$srcdir"/rs6-touchboost.service -t "$subpkgdir"/usr/lib/systemd/system/
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../rs6-touchboost.service "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/rs6-touchboost.service

	# No X11 helpers: Plasma Mobile has no X11 tray or global menu to proxy, and these two are
	# X11 clients, so running them made KWin start Xwayland at every login (KWin starts it on
	# the first X11 connection; an X11 app still gets it on demand)
	mkdir -p "$subpkgdir"/etc/systemd/user
	for u in plasma-xembedsniproxy.service plasma-gmenudbusmenuproxy.service; do
		ln -s /dev/null "$subpkgdir"/etc/systemd/user/$u
	done

	# one VT: no gettys on the others, and VT switching locked once the session is up
	install -Dm644 "$srcdir"/logind-hiby-rs6.conf "$subpkgdir"/usr/lib/systemd/logind.conf.d/50-hiby-rs6.conf
	install -Dm644 "$srcdir"/rs6-vt-lock.service -t "$subpkgdir"/usr/lib/systemd/system/
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/graphical.target.wants
	ln -s ../rs6-vt-lock.service "$subpkgdir"/usr/lib/systemd/system/graphical.target.wants/rs6-vt-lock.service

	# shutdown/reboot can never hang: stop timeouts, forced targets, watchdog in the last stage
	install -Dm644 "$srcdir"/hiby-rs6-shutdown.conf \
		"$subpkgdir"/usr/lib/systemd/system.conf.d/50-hiby-rs6-shutdown.conf
	for t in poweroff reboot halt; do
		install -Dm644 "$srcdir"/hiby-rs6-shutdown-target.conf \
			"$subpkgdir"/usr/lib/systemd/system/$t.target.d/50-hiby-rs6.conf
	done
}

_firefox() {
	pkgdesc="$pkgdesc (Firefox: Venus V4L2 hardware video decoding, display defaults)"
	install_if="$pkgname=$pkgver-r$pkgrel firefox"
	depends="ffmpeg-libavcodec"
	install -Dm755 "$srcdir"/firefox-v4l2-fix.so "$subpkgdir"/usr/lib/hiby-rs6/firefox-v4l2-fix.so
	install -Dm755 "$srcdir"/firefox-hiby-rs6 "$subpkgdir"/usr/lib/hiby-rs6/firefox
	# our firefox.desktop, found ahead of Firefox's own through XDG_DATA_DIRS
	install -Dm644 "$srcdir"/firefox-hiby-rs6.desktop \
		"$subpkgdir"/usr/share/hiby-rs6/applications/firefox.desktop
	install -Dm644 "$srcdir"/firefox-hiby-rs6-env.conf \
		"$subpkgdir"/usr/lib/environment.d/60-hiby-rs6-firefox.conf
	# Plasma only keeps XDG_* variables it got from its own env scripts
	install -Dm644 "$srcdir"/firefox-hiby-rs6-plasma-env.sh \
		"$subpkgdir"/etc/xdg/plasma-workspace/env/hiby-rs6-firefox.sh
	install -Dm644 "$srcdir"/firefox-hiby-rs6.js \
		"$subpkgdir"/usr/lib/firefox/defaults/pref/hiby-rs6.js
}

