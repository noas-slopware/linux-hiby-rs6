d4c863c34b27cc810638093815a52dfcba77a030ff65389675dbd836f073d6071fb0307d166a3cf4dca936364b2c4c3163248e4e2d6ebfb740ea01d797577246  0001-Retry-instead-of-crashing-when-the-notification-server-fails.patch
"
