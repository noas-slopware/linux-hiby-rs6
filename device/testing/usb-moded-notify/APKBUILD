# Forked from Alpine aports community/usb-moded-notify (0.4.2-r1) for the HiBy RS6:
# keep running and retry (backoff, or as soon as a server takes the name) when
# the notification server is missing or not answering, instead of exiting on
# the GError and being crash-looped by systemd's Restart=on-failure every ~26 s.
# pkgrel is above Alpine's so this build wins.
# Contributor: Clayton Craft <clayton@craftyguy.net>
maintainer="Noa Himesaka <himesaka@noa.codes>"
pkgname=usb-moded-notify
pkgver=0.4.2
pkgrel=2
pkgdesc="Simple daemon for handling usb-moded dialog events with notifications"
url="https://gitlab.postmarketos.org/postmarketOS/usb-moded-notify"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	py3-dbus
	py3-gobject3
	python3
	"
makedepends="just"
subpackages="$pkgname-openrc $pkgname-systemd"
source="https://gitlab.postmarketos.org/postmarketOS/usb-moded-notify/-/archive/$pkgver/usb-moded-notify-$pkgver.tar.gz
	0001-Retry-instead-of-crashing-when-the-notification-server-fails.patch
	"
options="!check" # no tests

package() {
	PREFIX=/usr DESTDIR="$pkgdir" just install
}

sha512sums="
