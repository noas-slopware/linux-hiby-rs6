+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/sharp,ls050t1sx18.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sharp LS050T1SX18 5.0" FullHD DSI video mode panel
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description:
+  1080x1920 MIPI DSI video mode panel, used in the HiBy RS6. The panel needs
+  the LCD bias regulators (lab/ibb) to be enabled by the driver in addition to
+  its logic supplies.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: sharp,ls050t1sx18
+
+  reg:
+    maxItems: 1
+
+  backlight: true
+  port: true
+
+  reset-gpios:
+    maxItems: 1
+
+  vddio-supply:
+    description: I/O supply voltage
+
+  vdd-supply:
+    description: Panel logic supply voltage
+
+  lab-supply:
+    description: Positive LCD bias supply (LAB)
+
+  ibb-supply:
+    description: Negative LCD bias supply (IBB)
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vddio-supply
+  - vdd-supply
+  - lab-supply
+  - ibb-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "sharp,ls050t1sx18";
+            reg = <0>;
+            reset-gpios = <&tlmm 53 GPIO_ACTIVE_LOW>;
+            vddio-supply = <&vreg_l11a_1p8>;
+            vdd-supply = <&vreg_l3b_3p3>;
+            lab-supply = <&lcdb_fixed>;
+            ibb-supply = <&lcdb_fixed>;
+            backlight = <&backlight>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&mdss_dsi0_out>;
+                };
+            };
+        };
+    };
+...
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
