diff --git a/drivers/gpu/drm/panel/panel-sharp-ls050t1sx18.c b/drivers/gpu/drm/panel/panel-sharp-ls050t1sx18.c
new file mode 100644
index 000000000..2068e9df6
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-sharp-ls050t1sx18.c
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2026 Noa Himesaka <himesaka@noa.codes>
+// Sharp LS050T1SX18 1080x1920 video-mode panel, as used in the HiBy RS6.
+// Generated with linux-mdss-dsi-panel-driver-generator from the stock RS6 1.80 device tree:
+//   Copyright (c) 2013, The Linux Foundation. All rights reserved.
+
+#include <linux/delay.h>
+#include <linux/device-id/of.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct ls050t1sx18 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+static const struct regulator_bulk_data ls050t1sx18_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vdd" },
+	{ .supply = "lab" },
+	{ .supply = "ibb" },
+};
+
+static inline struct ls050t1sx18 *to_ls050t1sx18(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct ls050t1sx18, panel);
+}
+
+static void ls050t1sx18_reset(struct ls050t1sx18 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(48);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(48);
+}
+
+static int ls050t1sx18_on(struct ls050t1sx18 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd4, 0x04);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int ls050t1sx18_off(struct ls050t1sx18 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int ls050t1sx18_prepare(struct drm_panel *panel)
+{
+	struct ls050t1sx18 *ctx = to_ls050t1sx18(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ls050t1sx18_supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ls050t1sx18_reset(ctx);
+
+	ret = ls050t1sx18_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ls050t1sx18_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int ls050t1sx18_unprepare(struct drm_panel *panel)
+{
+	struct ls050t1sx18 *ctx = to_ls050t1sx18(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = ls050t1sx18_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ls050t1sx18_supplies), ctx->supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode ls050t1sx18_mode = {
+	.clock = (1080 + 96 + 8 + 56) * (1920 + 4 + 2 + 4) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 96,
+	.hsync_end = 1080 + 96 + 8,
+	.htotal = 1080 + 96 + 8 + 56,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 4,
+	.vsync_end = 1920 + 4 + 2,
+	.vtotal = 1920 + 4 + 2 + 4,
+	.width_mm = 62,
+	.height_mm = 111,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int ls050t1sx18_get_modes(struct drm_panel *panel,
+				 struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &ls050t1sx18_mode);
+}
+
+static const struct drm_panel_funcs ls050t1sx18_panel_funcs = {
+	.prepare = ls050t1sx18_prepare,
+	.unprepare = ls050t1sx18_unprepare,
+	.get_modes = ls050t1sx18_get_modes,
+};
+
+static int ls050t1sx18_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct ls050t1sx18 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct ls050t1sx18, panel,
+				   &ls050t1sx18_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(ls050t1sx18_supplies),
+					    ls050t1sx18_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_VIDEO_HSE | MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	ret = devm_drm_panel_add(dev, &ctx->panel);
+	if (ret)
+		return ret;
+
+	return devm_mipi_dsi_attach(dev, dsi);
+}
+
+static const struct of_device_id ls050t1sx18_of_match[] = {
+	{ .compatible = "sharp,ls050t1sx18" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ls050t1sx18_of_match);
+
+static struct mipi_dsi_driver ls050t1sx18_driver = {
+	.probe = ls050t1sx18_probe,
+	.driver = {
+		.name = "panel-sharp-ls050t1sx18",
+		.of_match_table = ls050t1sx18_of_match,
+	},
+};
+module_mipi_dsi_driver(ls050t1sx18_driver);
+
+MODULE_AUTHOR("Noa Himesaka <himesaka@noa.codes>");
+MODULE_DESCRIPTION("DRM driver for the Sharp LS050T1SX18 1080p video mode DSI panel");
+MODULE_LICENSE("GPL");
