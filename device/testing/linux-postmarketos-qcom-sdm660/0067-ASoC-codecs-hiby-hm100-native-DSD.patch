+			ret = hm100_stream_setup(h, h->dsd);
+			if (!ret && h->running)
 				set(h->run, 1);
 		}
 		if (!ret && h->running)
@@ -1079,9 +1197,40 @@ static unsigned int fe_rate(struct snd_pcm_substream *substream, struct snd_pcm_
 	return rate;
 }
 
+/* the BE is fixed up to S16 too; native DSD is an FE format, as stock's DSD_U16_LE BE params */
+static snd_pcm_format_t fe_format(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *be = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dpcm *dpcm;
+	snd_pcm_format_t fmt = params_format(params);
+
+	for_each_dpcm_fe(be, substream->stream, dpcm)
+		fmt = params_format(&dpcm->fe->dpcm[substream->stream].hw_params);
+	return fmt;
+}
+
+/*
+ * DSD bit rate of a native DSD FE format, 0 for PCM: frame rate x bits per channel and frame,
+ * the ALSA convention (DSD_U32 at 88200 = DSD64). Stock's HAL opened DSD_U16_LE at half that
+ * and wrote two of its frames per declared one; its rate << 5 is the same DSD rate.
+ */
+static bool fe_is_dsd(snd_pcm_format_t fmt)
+{
+	return pcm_format_to_bits(fmt) & (SNDRV_PCM_FMTBIT_DSD_U8 | SNDRV_PCM_FMTBIT_DSD_U16_LE |
+					  SNDRV_PCM_FMTBIT_DSD_U16_BE | SNDRV_PCM_FMTBIT_DSD_U32_LE |
+					  SNDRV_PCM_FMTBIT_DSD_U32_BE);
+}
+
+static unsigned int fe_dsd_rate(snd_pcm_format_t fmt, unsigned int rate)
+{
+	return fe_is_dsd(fmt) ? rate * snd_pcm_format_physical_width(fmt) : 0;
+}
+
 /*
  * bytes per FE frame of a PCM format: 8 for S32_LE stereo (the I2S word pairs), 4 for
- * S16_LE stereo.
+ * S16_LE stereo. 0 for native DSD, which never takes a spdif_table word: tested on its own,
+ * since snd_pcm_format_linear() is true for the DSD formats (they are "unsigned", signd 0).
  */
 static unsigned int fe_frame_bytes(struct snd_pcm_substream *substream,
 				   struct snd_pcm_hw_params *params)
@@ -1094,7 +1243,7 @@ static unsigned int fe_frame_bytes(struct snd_pcm_substream *substream,
 	for_each_dpcm_fe(be, substream->stream, dpcm)
 		p = &dpcm->fe->dpcm[substream->stream].hw_params;
 	width = params_physical_width(p);
-	if (!snd_pcm_format_linear(params_format(p)) || width <= 0)
+	if (fe_is_dsd(params_format(p)) || !snd_pcm_format_linear(params_format(p)) || width <= 0)
 		return 0;
 	return width / 8 * params_channels(p);
 }
@@ -1122,13 +1271,22 @@ static int hm100_hw_params(struct snd_pcm_substream *substream, struct snd_pcm_h
 {
 	struct hm100 *h = snd_soc_component_get_drvdata(dai->component);
 	unsigned int rate = fe_rate(substream, params);
-	int w = rate_word(rate), t, ret = 0;
+	unsigned int dsd = fe_dsd_rate(fe_format(substream, params), rate);
+	int w = rate_word(dsd ?: rate), t, ret = 0;
 
 	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
 		return 0;
-	if (w < 0) {
-		dev_err(h->dev, "rate %u not supported\n", rate);
-		return w;
+	/*
+	 * A DSD stream needs a DSD rate word (mode 2): DSD64..512. q6asm-dai's hw rule offers
+	 * DSD only at those FE rates, so the DSD case is not reached from MultiMedia1; PCM
+	 * still is (the FE takes 8000..32000, the BE fixup hides rate_min).
+	 */
+	if (w < 0 || !!dsd != ((w & 3) == 2)) {
+		if (dsd)
+			dev_dbg(h->dev, "DSD rate %u not supported\n", dsd);
+		else
+			dev_err(h->dev, "PCM rate %u not supported\n", rate);
+		return -EINVAL;
 	}
 
 	cancel_delayed_work_sync(&h->idle_work);
@@ -1156,7 +1314,7 @@ static int hm100_hw_params(struct snd_pcm_substream *substream, struct snd_pcm_h
 	}
 	h->want = t;
 	h->streaming = true;
-	h->rate = rate;
+	h->rate = dsd ?: rate;
 	/*
 	 * S/PDIF cells (hm100_startup): 16 bytes per S/PDIF frame, so S32_LE at 2 fs or S16_LE
 	 * at 4 fs. A rate with no spdif_table entry (PipeWire's probe of a plain stream at
@@ -1164,17 +1322,15 @@ static int hm100_hw_params(struct snd_pcm_substream *substream, struct snd_pcm_h
 	 * the clocks at the stream's rate, where stock ran off the table to 384k.
 	 */
 	h->spdif_fs = 0;
-	if (h->spdif) {
+	if (h->spdif && !dsd) {
 		unsigned int n = rate * fe_frame_bytes(substream, params);
 
 		if (n % 16 == 0 && spdif_word(n / 16) >= 0)
 			h->spdif_fs = n / 16;
 	}
-	if (h->powered) {
-		gpo_set(h, IOB35B, 0);	/* hm100_set_gpo(pcm_dsd_sel, 0) */
-		set(h->run, 0);		/* hm100_set_samplerate: hm100_stop, reg0 */
-		reg_write(h, 0, stream_word(h));
-	}
+	/* design, pcm_dsd_sel, reg0 (native DSD on Spdif: mode 2, the S/PDIF pin quiet) */
+	if (h->powered)
+		ret = hm100_stream_setup(h, dsd);
 out:
 	if (ret) {		/* a failed load: the target is off, no hw_free follows */
 		h->streaming = false;
@@ -1575,6 +1731,38 @@ static int nos_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
 	return 1;
 }
 
+/*
+ * stock vendor_func "dsd_mode mdsd|dsd" (Settings "DSD filter": Darwin Default = mdsd, the
+ * DSD design; Darwin 1 = dsd, the PCM design in reg0 mode 2). Applies from the next stream.
+ */
+static const char * const dsd_mode_texts[] = { "mdsd", "dsd" };
+static SOC_ENUM_SINGLE_EXT_DECL(dsd_mode_enum, dsd_mode_texts);
+
+static int dsd_mode_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct hm100 *h = snd_soc_component_get_drvdata(snd_kcontrol_chip(kc));
+
+	uc->value.enumerated.item[0] = h->dsd_mode;
+	return 0;
+}
+
+static int dsd_mode_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uc)
+{
+	struct hm100 *h = snd_soc_component_get_drvdata(snd_kcontrol_chip(kc));
+	unsigned int v = uc->value.enumerated.item[0];
+	int ret = 0;
+
+	if (v >= ARRAY_SIZE(dsd_mode_texts))
+		return -EINVAL;
+	mutex_lock(&h->lock);
+	if (v != h->dsd_mode) {
+		h->dsd_mode = v;
+		ret = 1;
+	}
+	mutex_unlock(&h->lock);
+	return ret;
+}
