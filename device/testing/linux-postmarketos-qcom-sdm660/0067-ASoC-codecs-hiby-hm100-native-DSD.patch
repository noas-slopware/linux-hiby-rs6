 static void njw_power_on(struct hm100 *h, u16 insel)
 {
@@ -886,9 +1004,9 @@ static void hm100_output_switch(struct hm100 *h, int t)
 		 * Spdif, so the pin stays quiet.
 		 */
 		if (!ret && h->streaming) {
-			set(h->run, 0);
-			reg_write(h, 0, stream_word(h));
-			if (h->running)
