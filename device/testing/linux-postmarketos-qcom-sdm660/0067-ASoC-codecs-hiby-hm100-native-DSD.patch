 static void hiby_target_poweroff(struct hm100 *h, int t);
 
+/*
+ * stock hiby_target_poweron_mute (the body of mute_work) for the target that is on, and
+ * mark the mute for the next unmute work
+ */
+static void hiby_target_mute(struct hm100 *h)
+{
+	switch (h->target) {
+	case T_LO:
+	case T_BALLO:
+		hiby_iv_mute(h, 1);
+		break;
+	case T_PO:
+		hiby_iv_mute(h, 1);
+		hiby_po_mute(h, 1);
+		break;
+	case T_BAL:
+		hiby_iv_mute(h, 1);
+		set(h->line_mute, 0);
+		set(h->lpf_mute, 0);
+		gpo_set(h, IOB29B, 1);
+		break;
+	}
+	h->mute_pending = true;
+}
+
+/*
+ * stock hm100_program_by_hw_param: load another design only if it is not the one in SRAM:
+ * jtag-select 0, load, jtag-select 1, hm100_enable_init (our 0x0120 init, load_flash pulse,
+ * FIR). Called with the target on: rails, NJW and amps stay powered through the load, while
+ * the FPGA pins that carry iv_mute, hp_mute and the amp/LPF enables are unconfigured (GW1N:
+ * high-Z with weak pull-ups during configuration).
+ * Not stock: mute first, synchronously (mute_work's body, plus the SoC-side LO/BAL-LO mutes
+ * that stock's power-on sets before its own load and that hold while the FPGA has no
+ * design), so the pins go from driven muted to pulled up; hm100_enable_init writes the reg1
+ * shadow, mutes included, and only the unmute work of a started stream opens the output.
+ * A failed load powers the target off and fails the stream; no retry before the next open.
+ */
+static int hm100_program_design(struct hm100 *h, int design)
+{
+	int ret;
+
+	if (design == h->design)
+		return 0;
+	hiby_target_mute(h);
+	if (h->target == T_LO)
+		hiby_lo_mute(h, 1);
+	else if (h->target == T_BALLO)
+		hiby_bal_lo_mute(h, 1);
+	hiby_delay(10);		/* as hiby_output_poweroff after its mute */
+	set(h->jtag_sel, 0);
+	ret = hm100_load(h, design);
+	set(h->jtag_sel, 1);
+	if (ret) {
+		dev_err(h->dev, "design %d load failed (%d), target %d off until the next open\n",
+			design, ret, h->target);
+		h->design = -1;
+		hiby_target_poweroff(h, h->target);
+		h->load_failed = true;
+		return ret;
+	}
+	hm100_enable_init(h);
+	h->design = design;
+	return 0;
+}
+
+/*
+ * stock hiby_snd_hw_params once the target is on: design, pcm_dsd_sel and reg0 of the stream.
+ * DSD: dsd_mode "mdsd" loads the DSD design, "dsd" keeps the PCM one (reg0 mode 2 only); when
+ * no stream has played since boot, 1 ms of the 44.1k frame with RUN high comes first (stock
+ * first_dsd_play, which PCM streams set as well). PCM: back to the PCM design, IOB35B 0.
+ * dsd_compensate changes the NJW volume when the stream kind changes. Also run again for an
+ * open stream when an output switch has powered the FPGA up anew.
+ */
+static int hm100_stream_setup(struct hm100 *h, bool dsd)
+{
+	int ret;
+
+	ret = hm100_program_design(h, dsd && h->dsd_mode == 0);
+	if (ret)
+		return ret;
+	if (dsd != h->dsd && h->dsd_comp)	/* lrch_volume_imm_set(target, l, r, 0) */
+		queue_delayed_work(system_dfl_wq, &h->volume_work, 0);
+	WRITE_ONCE(h->dsd, dsd);	/* read by hm100_trigger */
+	if (dsd && !h->played) {
+		set(h->run, 0);		/* hm100_set_samplerate(44100) */
+		reg_write(h, 0, rate_word(44100));
+		set(h->run, 1);		/* hm100_start */
+		udelay(1000);
+		set(h->run, 0);		/* hm100_stop */
+	}
+	h->played = true;
+	gpo_set(h, IOB35B, dsd);	/* hm100_set_gpo(pcm_dsd_sel, dsd) */
+	set(h->run, 0);			/* hm100_set_samplerate: hm100_stop, reg0 */
+	reg_write(h, 0, stream_word(h));	/* DSD: h->rate is the DSD rate, no S/PDIF word */
+	return 0;
+}
