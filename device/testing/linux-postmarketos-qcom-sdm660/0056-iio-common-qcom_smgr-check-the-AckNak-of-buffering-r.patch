 drivers/iio/common/qcom_smgr/qmi/sns_smgr.c |  39 +++++
 drivers/iio/common/qcom_smgr/qmi/sns_smgr.h |  23 +++
 3 files changed, 212 insertions(+), 19 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index 68b7e4cb8..63d04515a 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -243,9 +243,73 @@ static u16 qcom_smgr_default_sample_rate(const struct qcom_smgr_data_type_item *
 	return min_t(u16, SMGR_DEFAULT_SAMPLE_RATE_HZ, dt->max_sample_rate);
 }
 
-static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
-				       struct qcom_smgr_sensor *sensor,
-				       bool enable)
+/*
+ * Turn the AckNak of a buffering response into an error code. ACK_MODIFIED
+ * means SMGR substituted a parameter and runs the report anyway; the stock
+ * HAL logs it only at debug level, so does this. NAK_REPORT_ID answers a
+ * DELETE of a report SMGR does not have, which is what the DELETE wanted.
+ */
+static int qcom_smgr_check_buffering_resp(struct qcom_smgr *smgr,
+					  struct qcom_smgr_sensor *sensor,
+					  bool enable, u16 sample_rate,
+					  const struct sns_smgr_buffering_resp *resp)
+{
+	u8 reason = resp->reasons_len ? resp->reasons[0].reason : 0;
+
+	switch (resp->ack_nak) {
+	case SNS_SMGR_RESPONSE_ACK_SUCCESS:
+		break;
+	case SNS_SMGR_RESPONSE_ACK_MODIFIED:
+		dev_dbg(smgr->dev,
+			"0x%02x: %u Hz report added with changes, reason %u\n",
+			sensor->id, sample_rate, reason);
+		break;
+	case SNS_SMGR_RESPONSE_NAK_REPORT_ID:
+		if (!enable) {
+			dev_dbg(smgr->dev, "0x%02x: no report to delete\n",
+				sensor->id);
+			return 0;
+		}
+		fallthrough;
+	default:
+		if (enable)
+			dev_warn(smgr->dev,
+				 "0x%02x: SMGR refused a %u Hz report: ack_nak %u, reason %u, result 0x%x\n",
+				 sensor->id, sample_rate, resp->ack_nak, reason,
+				 resp->result);
+		else
+			dev_warn(smgr->dev,
+				 "0x%02x: SMGR refused to delete the report: ack_nak %u, reason %u, result 0x%x\n",
+				 sensor->id, resp->ack_nak, reason, resp->result);
+
+		switch (resp->ack_nak) {
+		case SNS_SMGR_RESPONSE_NAK_RESOURCES:
+			return -EBUSY;
+		case SNS_SMGR_RESPONSE_NAK_NO_ITEMS:
+			return -EINVAL;
+		default:
+			return -EREMOTEIO;
+		}
+	}
+
+	if (resp->result) {
+		dev_warn(smgr->dev, "0x%02x: buffering request failed: 0x%x\n",
+			 sensor->id, resp->result);
+		return -EREMOTEIO;
+	}
+
+	return 0;
+}
+
+/*
+ * Send one buffering ADD (at @sample_rate) or DELETE. Returns 0 if SMGR
+ * accepted it. @rejected tells an answer from SMGR saying no apart from a
+ * request that never got one.
+ */
+static int qcom_smgr_send_buffering(struct qcom_smgr *smgr,
+				    struct qcom_smgr_sensor *sensor,
+				    bool enable, u16 sample_rate,
+				    bool *rejected)
 {
 	struct sns_smgr_buffering_req req = {
 		/*
@@ -257,9 +321,10 @@ static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 	};
 	struct sns_smgr_buffering_resp resp = {};
 	struct qmi_txn txn;
-	u16 sample_rate = 0;
 	int ret;
 
+	*rejected = false;
+
 	if (enable) {
 		req.action = SNS_SMGR_BUFFERING_ACTION_ADD;
 
@@ -277,10 +342,6 @@ static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 		 * every report contains only 1 sample. This gives us the lowest
 		 * latency.
 		 */
-		sample_rate = sensor->data_types[0].cur_sample_rate;
-		if (sample_rate == 0)
-			sample_rate = qcom_smgr_default_sample_rate(&sensor->data_types[0]);
-
 		req.report_rate = sample_rate * SMGR_REPORT_RATE_HZ;
 
 		req.item_len = 1;
@@ -318,20 +379,90 @@ static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 	}
 
 	ret = qmi_txn_wait(&txn, 5 * HZ);
-	if (ret < 0)
+	if (ret < 0) {
+		dev_err(smgr->dev, "No buffering response: %d\n", ret);
 		return ret;
+	}
 
-	/* Check the response */
-	if (resp.result) {
-		dev_err(smgr->dev, "Buffering request failed: 0x%x\n",
-			resp.result);
-		return -EREMOTEIO;
+	ret = qcom_smgr_check_buffering_resp(smgr, sensor, enable, sample_rate,
+					     &resp);
+	*rejected = ret != 0;
+
+	return ret;
+}
+
+/* Remove the report of @sensor. A DELETE keeps cur_sample_rate for the next ADD. */
+static int qcom_smgr_stop_report(struct qcom_smgr *smgr,
+				 struct qcom_smgr_sensor *sensor)
+{
+	bool rejected;
+
+	return qcom_smgr_send_buffering(smgr, sensor, false, 0, &rejected);
+}
+
+/*
+ * Add the report of @sensor at its cur_sample_rate. If SMGR refuses that
+ * rate, fall back to the default rate, then to each native rate, then to the
+ * maximum, so a rate SMGR does not take never leaves the sensor without
+ * reports. cur_sample_rate is the rate that runs afterwards.
+ */
+static int qcom_smgr_start_report(struct qcom_smgr *smgr,
+				  struct qcom_smgr_sensor *sensor)
+{
+	struct qcom_smgr_data_type_item *dt = &sensor->data_types[0];
+	u16 tried[SNS_SMGR_NATIVE_SAMPLE_RATES_MAX_LEN + 3];
+	unsigned int n = 0, i, k;
+	u16 first, rate;
+	bool rejected;
+	int ret;
+
+	first = dt->cur_sample_rate;
+	if (first == 0)
+		first = qcom_smgr_default_sample_rate(dt);
+
+	ret = qcom_smgr_send_buffering(smgr, sensor, true, first, &rejected);
+	if (!ret) {
+		dt->cur_sample_rate = first;
+		return 0;
 	}
+	if (!rejected)
+		return ret;
 
-	/* Keep track of requested sample rate */
-	sensor->data_types[0].cur_sample_rate = sample_rate;
+	tried[n++] = first;
 
-	return 0;
+	/* i == 0: the default rate, 1..count: the native rates, last: max */
+	for (i = 0; i <= dt->native_sample_rate_count + 1; i++) {
+		if (i == 0)
+			rate = qcom_smgr_default_sample_rate(dt);
+		else if (i <= dt->native_sample_rate_count)
+			rate = dt->native_sample_rates[i - 1];
+		else
+			rate = dt->max_sample_rate;
+
+		if (rate == 0 || rate > dt->max_sample_rate)
+			continue;
+		for (k = 0; k < n && tried[k] != rate; k++)
+			;
+		if (k < n || n == ARRAY_SIZE(tried))
+			continue;
+		tried[n++] = rate;
+
+		ret = qcom_smgr_send_buffering(smgr, sensor, true, rate,
+					       &rejected);
+		if (!ret) {
+			dev_warn(smgr->dev, "0x%02x: streaming at %u Hz instead of %u Hz\n",
+				 sensor->id, rate, first);
+			dt->cur_sample_rate = rate;
+			return 0;
+		}
+		if (!rejected)
+			return ret;
+	}
+
+	dev_err(smgr->dev, "0x%02x: SMGR refused every sampling rate\n",
+		sensor->id);
+
+	return ret;
 }
 
 static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
@@ -407,7 +538,7 @@ static int qcom_smgr_sensor_postenable(struct iio_dev *iio_dev)
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
 	struct qcom_smgr_sensor *sensor = priv->sensor;
 
-	return qcom_smgr_request_buffering(smgr, sensor, true);
+	return qcom_smgr_start_report(smgr, sensor);
 }
 
 static int qcom_smgr_sensor_postdisable(struct iio_dev *iio_dev)
@@ -416,7 +547,7 @@ static int qcom_smgr_sensor_postdisable(struct iio_dev *iio_dev)
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
 	struct qcom_smgr_sensor *sensor = priv->sensor;
 
-	return qcom_smgr_request_buffering(smgr, sensor, false);
+	return qcom_smgr_stop_report(smgr, sensor);
 }
 
