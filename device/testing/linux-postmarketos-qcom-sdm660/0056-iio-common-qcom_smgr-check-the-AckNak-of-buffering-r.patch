+	{
+		.data_type = QMI_STRUCT,
+		.elem_len = SNS_SMGR_MAX_NUM_REASONS,
+		.elem_size = sizeof(struct sns_smgr_reason_pair),
+		.array_type = VAR_LEN_ARRAY,
+		.tlv_type = 0x12,
+		.offset = offsetof(struct sns_smgr_buffering_resp, reasons),
+		.ei_array = sns_smgr_reason_pair_ei,
