diff --git a/drivers/iio/common/qcom_smgr/qmi/sns_smgr.h b/drivers/iio/common/qcom_smgr/qmi/sns_smgr.h
index 68d30b154..ce386c1ed 100644
--- a/drivers/iio/common/qcom_smgr/qmi/sns_smgr.h
+++ b/drivers/iio/common/qcom_smgr/qmi/sns_smgr.h
@@ -49,6 +49,21 @@
 #define SNS_SMGR_BUFFERING_REPORT_MAX_INDICES	5
 #define SNS_SMGR_BUFFERING_REPORT_MAX_SAMPLES	100
 
+/*
+ * AckNak of a buffering response (SNS_SMGR_RESPONSE_*_V01). The stock sensors
+ * HAL (SMGRSensor::processBufferingResp) takes anything above ACK_MODIFIED as
+ * an error, except NAK_REPORT_ID, the answer to a DELETE of a report SMGR
+ * does not have.
+ */
+#define SNS_SMGR_RESPONSE_ACK_SUCCESS		0
+#define SNS_SMGR_RESPONSE_ACK_MODIFIED		1
+#define SNS_SMGR_RESPONSE_NAK_RESOURCES		2
+#define SNS_SMGR_RESPONSE_NAK_REPORT_ID		3
+#define SNS_SMGR_RESPONSE_NAK_NO_ITEMS		4
+
+/* Reason pairs a buffering response carries at most (TLV 0x12) */
+#define SNS_SMGR_MAX_NUM_REASONS		10
+
 enum sns_smgr_buffering_action {
 	SNS_SMGR_BUFFERING_ACTION_ADD	 = 1,
 	SNS_SMGR_BUFFERING_ACTION_DELETE = 2,
@@ -133,10 +148,18 @@ struct sns_smgr_buffering_req {
 	struct sns_smgr_buffering_req_notify_suspend notify_suspend;
 };
 
+/* Why SMGR changed or dropped item @item_num of the request */
+struct sns_smgr_reason_pair {
+	u8 item_num;
+	u8 reason;
+};
+
 struct sns_smgr_buffering_resp {
 	u16 result;
 	u8 report_id;
 	u8 ack_nak;
+	u8 reasons_len;
+	struct sns_smgr_reason_pair reasons[SNS_SMGR_MAX_NUM_REASONS];
 };
 
 /* Which samples of a report belong to one requested item */
