+	ret = qmi_handle_init(&smgr->sns_smgr_hdl, SNS_SMGR_MAX_MSG_LEN, NULL,
 			      qcom_smgr_msg_handlers);
 	if (ret < 0) {
 		dev_err(smgr->dev,
