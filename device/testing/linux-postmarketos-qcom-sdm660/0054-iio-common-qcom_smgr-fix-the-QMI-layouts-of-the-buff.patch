+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -9,6 +9,7 @@
 #include <linux/iio/common/qcom_smgr.h>
 #include <linux/iio/iio.h>
 #include <linux/math64.h>
+#include <linux/minmax.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -320,31 +321,52 @@ static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
 {
 	struct qcom_smgr *smgr =
 		container_of(hdl, struct qcom_smgr, sns_smgr_hdl);
-	struct sns_smgr_buffering_report_ind *ind =
-		(struct sns_smgr_buffering_report_ind *)data;
-	struct qcom_smgr_sensor *sensor;
+	const struct sns_smgr_buffering_report_ind *ind = data;
+	const struct sns_smgr_buffering_report_index *idx;
+	struct qcom_smgr_sensor *sensor = NULL;
+	struct {
+		u32 values[3];
+		aligned_s64 timestamp;
+	} scan = { };
+	unsigned int end, j;
+	u32 timestamp;
 	u8 i;
 
 	for (i = 0; i < smgr->sensor_count; ++i) {
-		sensor = &smgr->sensors[i];
-
 		/* Find sensor matching report */
-		if (sensor->id != ind->report_id)
+		if (smgr->sensors[i].id == ind->report_id) {
+			sensor = &smgr->sensors[i];
+			break;
+		}
+	}
+
+	/* Unknown report, or the corresponding driver was unloaded */
+	if (!sensor || !sensor->iio_dev)
+		return;
+
+	for (i = 0; i < ind->indices_len; i++) {
+		idx = &ind->indices[i];
+
+		if (idx->data_type != SNS_SMGR_DATA_TYPE_PRIMARY)
 			continue;
 
-		if (!sensor->iio_dev)
-			/* Corresponding driver was unloaded. Ignore remaining reports. */
-			return;
+		end = min_t(unsigned int,
+			    idx->first_sample_idx + idx->sample_count,
+			    ind->samples_len);
 
 		/*
-		 * Since we are matching report rate with sample rate, we only
-		 * get a single sample in every report.
+		 * Each sample carries its distance in SSC ticks from the
+		 * previous one, starting at the index timestamp (the first
+		 * sample's offset is part of the sum, as in the stock HAL).
 		 */
-		iio_push_to_buffers_with_timestamp(sensor->iio_dev,
-						   ind->samples[0].values,
-						   ind->metadata.timestamp);
-
-		break;
+		timestamp = idx->first_sample_timestamp;
+		for (j = idx->first_sample_idx; j < end; j++) {
+			timestamp += ind->samples[j].timestamp_offset;
+			memcpy(scan.values, ind->samples[j].values,
+			       sizeof(scan.values));
+			iio_push_to_buffers_with_ts(sensor->iio_dev, &scan,
+						    sizeof(scan), timestamp);
+		}
 	}
 }
 
