From a062fbbfeda6a06c8fb57a9e039824dd28c42ebb Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Thu, 22 Oct 2026 12:24:18 +0900
Subject: [PATCH 63/94] ASoC: qcom: q6asm-dai: offer DSD at the DSD rates only

The DAC plays DSD64 to DSD512 only, i.e. DSD_U32 at 88200, 176400,
352800 and 705600 Hz, but the FE offered DSD at any rate from 8000 to
768000, which the codec could only refuse in hw_params. Add two hw
rules on these DAIs: with only DSD formats left, only the DSD rates,
and with none of the DSD rates left, no DSD formats, so that neither a
format-first nor a rate-first negotiation offers DSD at another rate.

Assisted-by: Claude:claude-opus-5-5
Claude-Session: https://claude.ai/code/session_01SXjPGasJxD6XRYU1J9jsnW
---
 sound/soc/qcom/qdsp6/q6asm-dai.c | 65 +++++++++++++++++++++++++++++++-
 1 file changed, 64 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/qdsp6/q6asm-dai.c b/sound/soc/qcom/qdsp6/q6asm-dai.c
index 6fe589ab6..7dae7de6e 100644
--- a/sound/soc/qcom/qdsp6/q6asm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6asm-dai.c
@@ -442,6 +442,54 @@ static int q6asm_dai_trigger(struct snd_soc_component *component,
 	return ret;
 }
 
+/*
+ * The DAC plays DSD64/128/256/512 only (hiby-hm100 rate_table, mode 2 words): DSD_U32 at the
+ * DSD rate / 32. Two rules, so neither a format-first nor a rate-first negotiation offers DSD
+ * at another rate.
+ */
+static const unsigned int q6asm_dai_dsd_rates[] = { 88200, 176400, 352800, 705600 };
+
+static bool q6asm_dai_only_dsd(const struct snd_mask *fmt)
+{
+	snd_pcm_format_t f;
+
+	pcm_for_each_format(f)
+		if (snd_mask_test_format(fmt, f) && !(pcm_format_to_bits(f) & Q6ASM_DAI_DSD_FORMATS))
+			return false;
+	return true;
+}
+
+/* rate from format: only DSD formats left, only the DSD rates */
+static int q6asm_dai_rule_dsd_rate(struct snd_pcm_hw_params *params, struct snd_pcm_hw_rule *rule)
+{
+	struct snd_interval *rate = hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE);
+
+	if (!q6asm_dai_only_dsd(hw_param_mask_c(params, SNDRV_PCM_HW_PARAM_FORMAT)))
+		return 0;
+	return snd_interval_list(rate, ARRAY_SIZE(q6asm_dai_dsd_rates), q6asm_dai_dsd_rates, 0);
+}
+
+/* format from rate: none of the DSD rates left, no DSD formats */
+static int q6asm_dai_rule_dsd_format(struct snd_pcm_hw_params *params, struct snd_pcm_hw_rule *rule)
+{
+	const struct snd_interval *rate = hw_param_interval_c(params, SNDRV_PCM_HW_PARAM_RATE);
+	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+	int i, changed = 0;
+
+	for (i = 0; i < ARRAY_SIZE(q6asm_dai_dsd_rates); i++)
+		if (snd_interval_test(rate, q6asm_dai_dsd_rates[i]))
+			return 0;
+	if (snd_mask_test_format(fmt, SNDRV_PCM_FORMAT_DSD_U32_LE)) {
+		snd_mask_reset(fmt, (__force unsigned int)SNDRV_PCM_FORMAT_DSD_U32_LE);
+		changed = 1;
+	}
+	if (snd_mask_test_format(fmt, SNDRV_PCM_FORMAT_DSD_U32_BE)) {
+		snd_mask_reset(fmt, (__force unsigned int)SNDRV_PCM_FORMAT_DSD_U32_BE);
+		changed = 1;
+	}
+	return snd_mask_empty(fmt) ? -EINVAL : changed;
+}
+
 static int q6asm_dai_open(struct snd_soc_component *component,
 			  struct snd_pcm_substream *substream)
 {
@@ -521,9 +569,24 @@ static int q6asm_dai_open(struct snd_soc_component *component,
 		snd_soc_set_runtime_hwparams(substream, &q6asm_dai_hardware_playback);
 		runtime->dma_bytes = q6asm_dai_hardware_playback.buffer_bytes_max;
 		/* S32 = samples (word pairs), S16 = raw pre-split words; never S24 to the DAC */
-		if (pdata->split_s32[stream_id])
+		if (pdata->split_s32[stream_id]) {
 			runtime->hw.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S32_LE |
 					      Q6ASM_DAI_DSD_FORMATS;
+			ret = snd_pcm_hw_rule_add(runtime, 0, SNDRV_PCM_HW_PARAM_RATE,
+						  q6asm_dai_rule_dsd_rate, NULL,
+						  SNDRV_PCM_HW_PARAM_FORMAT, -1);
+			if (!ret)
+				ret = snd_pcm_hw_rule_add(runtime, 0, SNDRV_PCM_HW_PARAM_FORMAT,
+							  q6asm_dai_rule_dsd_format, NULL,
+							  SNDRV_PCM_HW_PARAM_RATE, -1);
+			if (ret < 0) {
+				dev_err(dev, "DSD rate rules: %d\n", ret);
+				q6asm_audio_client_free(prtd->audio_client);
+				runtime->private_data = NULL;
+				kfree(prtd);
+				return ret;
+			}
+		}
 	} else {
 		snd_soc_set_runtime_hwparams(substream, &q6asm_dai_hardware_capture);
 		runtime->dma_bytes = q6asm_dai_hardware_capture.buffer_bytes_max;
