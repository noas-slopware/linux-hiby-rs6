+++ b/Documentation/devicetree/bindings/opp/opp-v2-qcom-osm.yaml
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/opp/opp-v2-qcom-osm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm OSM CPU OPP
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+allOf:
+  - $ref: opp-v2-base.yaml#
+
+description:
+  CPU OPP table of a cluster whose OSM (Operating State Manager) look-up
+  table is programmed by the OS, as on SDM630/SDM636/SDM660 where the
+  boot firmware leaves it empty. Next to the frequency, every OPP carries
+  the raw OSM fields of its look-up table entry, and its CPR corner through
+  required-opps.
+
+properties:
+  compatible:
+    const: operating-points-v2-qcom-osm
+
+  opp-shared: true
+
+patternProperties:
+  '^opp-?[0-9]+$':
+    type: object
+    additionalProperties: false
+
+    properties:
+      opp-hz: true
+
+      opp-supported-hw: true
+
+      required-opps: true
+
+      turbo-mode: true
+
+      qcom,pll-override:
+        description:
+          PLL override word of this frequency's OSM look-up table entry.
+        $ref: /schemas/types.yaml#/definitions/uint32
+
+      qcom,spare-data:
+        description:
+          Spare data field of this frequency's OSM look-up table entry.
+          Defaults to 0 if absent.
+        $ref: /schemas/types.yaml#/definitions/uint32
+
+      qcom,pll-div:
+        description:
+          Divider field of this frequency's OSM look-up table entry.
+          Defaults to 0 if absent.
+        $ref: /schemas/types.yaml#/definitions/uint32
+
+    required:
+      - opp-hz
+      - required-opps
+      - qcom,pll-override
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    opp-table {
+        compatible = "operating-points-v2-qcom-osm";
+        opp-shared;
+
+        opp-300000000 {
+            opp-hz = /bits/ 64 <300000000>;
+            required-opps = <&cprh_opp1>;
+            qcom,pll-override = <0x1200020>;
+            qcom,spare-data = <1>;
+        };
+
+        opp-633600000 {
+            opp-hz = /bits/ 64 <633600000>;
+            required-opps = <&cprh_opp2>;
+            qcom,pll-override = <0x3200020>;
+            qcom,spare-data = <1>;
+            qcom,pll-div = <1>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/power/avs/qcom,cprh.yaml b/Documentation/devicetree/bindings/power/avs/qcom,cprh.yaml
new file mode 100644
index 000000000..70c139ad0
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/avs/qcom,cprh.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/avs/qcom,cprh.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Core Power Reduction Hardened (CPRh)
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description: |
+  CPRh is the hardware-managed variant of Core Power Reduction found on the
+  application CPU clusters of some Qualcomm SoCs. The OS programs the voltage
+  and quotient tables, computed from fuse data, and the hardware (OSM) then
+  requests voltages from the PMIC on its own, so the regulator is not accessed
+  by the OS. Each register region is one CPR thread (CPU cluster).
+
+  The OPP table referenced by operating-points-v2 holds the virtual corners
+  (operating-points-v2-qcom-level). The CPU OPP tables select a corner with
+  required-opps.
+
+properties:
+  compatible:
+    enum:
+      - qcom,msm8998-cprh
+      - qcom,sdm630-cprh
+      - qcom,sdm660-cprh
+
+  reg:
+    minItems: 1
+    maxItems: 2
+    description: Register region of each CPR thread, in thread order.
+
+  clocks:
+    items:
+      - description: Reference clock.
+
+  clock-names:
+    items:
+      - const: ref
+
+  operating-points-v2:
+    description: Phandle to the OPP table of virtual corners.
+
+  power-domains:
+    maxItems: 1
+    description: Parent power domain providing the voltage rail.
+
+  '#power-domain-cells':
+    const: 1
+
+  nvmem-cells:
+    minItems: 2
+    maxItems: 64
+    description: Fuse cells holding speed bin, fuse revision and per-thread
+      quotients, quotient offsets, initial voltages and ring oscillator
+      selections.
+
+  nvmem-cell-names:
+    minItems: 2
+    maxItems: 64
+    items:
+      anyOf:
+        - enum:
+            - cpr_speed_bin
+            - cpr_fuse_revision
+        - pattern: '^cpr[0-9]_(quotient[1-9]|quotient_offset[2-9]|init_voltage[1-9]|ring_osc[1-9])$'
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - operating-points-v2
+  - '#power-domain-cells'
+  - nvmem-cells
+  - nvmem-cell-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,gcc-sdm660.h>
+    #include <dt-bindings/power/qcom-rpmpd.h>
+
+    power-controller@179c8000 {
+        compatible = "qcom,sdm660-cprh";
+        reg = <0x179c8000 0x4000>, <0x179c4000 0x4000>;
+
+        clocks = <&gcc GCC_HMSS_RBCPR_CLK>;
+        clock-names = "ref";
+
+        operating-points-v2 = <&cprh_opp_table>;
+        power-domains = <&rpmpd SDM660_VDDCX_AO>;
+        #power-domain-cells = <1>;
+
+        nvmem-cells = <&cpr_efuse_speedbin>, <&cpr_fuse_revision>;
+        nvmem-cell-names = "cpr_speed_bin", "cpr_fuse_revision";
+    };
