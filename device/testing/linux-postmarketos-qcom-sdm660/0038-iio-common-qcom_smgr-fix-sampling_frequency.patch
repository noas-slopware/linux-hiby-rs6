From 7c2117b334ca5fafcf125b790bb6759bbcac0f49 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Wed, 21 Oct 2026 18:25:02 +0900
Subject: [PATCH 38/94] iio: common: qcom_smgr: fix sampling_frequency

Default to the highest native rate of the sensor capped by what SMGR
reports, use the rate in sampling_frequency for buffering with one
sample per report, read back the rate buffering will use, and keep the
available-rates array in priv: the IIO core formats it after
read_avail() returns.

Assisted-by: Claude:claude-opus-5-5
Claude-Session: https://claude.ai/code/session_01SXjPGasJxD6XRYU1J9jsnW
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 62 +++++++++++++++---------
 include/linux/iio/common/qcom_smgr.h     |  3 ++
 2 files changed, 42 insertions(+), 23 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index c81698464..17d32e227 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -205,6 +205,23 @@ static int qcom_smgr_request_single_sensor_info(struct qcom_smgr *smgr,
 	return 0;
 }
 
+/*
+ * Default to the highest rate the sensor supports natively, capped by
+ * the maximum SMGR reports, which may be lower.
+ */
+static u16 qcom_smgr_default_sample_rate(const struct qcom_smgr_data_type_item *dt)
+{
+	u16 rate = 0;
+
+	if (dt->native_sample_rates && dt->native_sample_rate_count)
+		rate = dt->native_sample_rates[dt->native_sample_rate_count - 1];
+
+	if (rate == 0 || rate > dt->max_sample_rate)
+		rate = dt->max_sample_rate;
+
+	return rate;
+}
+
 static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 				       struct qcom_smgr_sensor *sensor,
 				       bool enable)
@@ -234,22 +251,14 @@ static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 		 * A report cannot have 0 samples, therefore report rate cannot
 		 * be higher than sample rate.
 		 *
-		 * Fow now we default to the maximum sample rate and set the
-		 * report rate such that every report contains only 1 sample.
-		 * This gives us the lowest latency.
+		 * Use the rate in sampling_frequency (by default the highest
+		 * native rate SMGR allows) and set the report rate such that
+		 * every report contains only 1 sample. This gives us the lowest
+		 * latency.
 		 */
-		if (sensor->data_types[0].native_sample_rates)
-			sample_rate = sensor->data_types[0].native_sample_rates
-					[sensor->data_types[0]
-						 .native_sample_rate_count - 1];
-
-		/*
-		 * SMGR may support a lower maximum sample rate than natively
-		 * supported by the sensor.
-		 */
-		if (sample_rate == 0 ||
-		    sample_rate > sensor->data_types[0].max_sample_rate)
-			sample_rate = sensor->data_types[0].max_sample_rate;
+		sample_rate = sensor->data_types[0].cur_sample_rate;
+		if (sample_rate == 0)
+			sample_rate = qcom_smgr_default_sample_rate(&sensor->data_types[0]);
 
 		req.report_rate = sample_rate * SMGR_REPORT_RATE_HZ;
 
@@ -433,6 +442,9 @@ static int qcom_smgr_iio_write_raw(struct iio_dev *iio_dev,
 
 	switch (mask) {
 	case IIO_CHAN_INFO_SAMP_FREQ:
+		if (val < 1 || val > priv->sensor->data_types[0].max_sample_rate)
+			return -EINVAL;
+
 		priv->sensor->data_types[0].cur_sample_rate = val;
 
 		/*
@@ -454,15 +466,19 @@ static int qcom_smgr_iio_read_avail(struct iio_dev *iio_dev,
 				    long mask)
 {
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
-	const int samp_freq_vals[3] = {
-		1, 1, priv->sensor->data_types[0].cur_sample_rate
-	};
 
 	switch (mask) {
 	case IIO_CHAN_INFO_SAMP_FREQ:
+		/*
+		 * The IIO core formats *vals after we return, so the array must
+		 * outlive this call: keep it in priv, not on the stack.
+		 */
+		priv->samp_freq_avail[0] = 1;
+		priv->samp_freq_avail[1] = 1;
+		priv->samp_freq_avail[2] = priv->sensor->data_types[0].max_sample_rate;
 		*type = IIO_VAL_INT;
-		*vals = samp_freq_vals;
-		*length = ARRAY_SIZE(samp_freq_vals);
+		*vals = priv->samp_freq_avail;
+		*length = ARRAY_SIZE(priv->samp_freq_avail);
 		return IIO_AVAIL_RANGE;
 	}
 
@@ -546,9 +562,9 @@ static int qcom_smgr_probe(struct qrtr_device *qdev)
 		}
 
 		for (j = 0; j < smgr->sensors[i].data_type_count; j++) {
-			/* Default to maximum sample rate */
-			smgr->sensors[i].data_types->cur_sample_rate =
-				smgr->sensors[i].data_types->max_sample_rate;
+			/* sampling_frequency reads back the rate buffering will use */
+			smgr->sensors[i].data_types[j].cur_sample_rate =
+				qcom_smgr_default_sample_rate(&smgr->sensors[i].data_types[j]);
 
 			dev_info(smgr->dev, "0x%02x,%d: %s %s\n",
 				smgr->sensors[i].id, j,
diff --git a/include/linux/iio/common/qcom_smgr.h b/include/linux/iio/common/qcom_smgr.h
index 756cb83e2..e53c1d7a5 100644
--- a/include/linux/iio/common/qcom_smgr.h
+++ b/include/linux/iio/common/qcom_smgr.h
@@ -55,6 +55,9 @@ struct qcom_smgr_sensor {
 
 struct qcom_smgr_iio_priv {
 	struct qcom_smgr_sensor *sensor;
+
+	/* min, step, max for in_*_sampling_frequency_available */
+	int samp_freq_avail[3];
 };
 
 extern const struct iio_buffer_setup_ops qcom_smgr_buffer_ops;
