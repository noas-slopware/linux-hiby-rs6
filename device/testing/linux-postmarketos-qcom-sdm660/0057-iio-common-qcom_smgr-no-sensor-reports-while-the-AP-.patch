 EXPORT_SYMBOL_GPL(qcom_smgr_iio_ext_info);
 
+/*
+ * A non-wakeup sensor has no business waking the AP during system suspend:
+ * remove the SMGR report of every streaming sensor before suspend and add it
+ * back afterwards. The IIO buffers stay enabled, so readers carry on as if
+ * nothing happened. Buffer enables and disables in between only update
+ * the streaming state, which is what gets restored.
+ */
+static void qcom_smgr_resume_reports(struct qcom_smgr *smgr)
+{
+	struct qcom_smgr_sensor *sensor;
+	u8 i;
+
+	lockdep_assert_held(&smgr->lock);
+
+	smgr->suspended = false;
+	smgr->armed = false;
+
+	for (i = 0; i < smgr->sensor_count; i++) {
+		sensor = &smgr->sensors[i];
+
+		if (sensor->streaming && qcom_smgr_start_report(smgr, sensor))
+			dev_err(smgr->dev,
+				"Failed to restart reports of 0x%02x after suspend\n",
+				sensor->id);
+	}
+}
+
+static int qcom_smgr_pm_suspend(struct notifier_block *nb,
+				unsigned long event, void *unused)
+{
+	struct qcom_smgr *smgr = container_of(nb, struct qcom_smgr, suspend_nb);
+	struct qcom_smgr_sensor *sensor;
+	u8 i;
+
+	if (event == PM_POST_SUSPEND) {
+		/*
+		 * pm_notifier_call_chain_robust() sends PM_POST_SUSPEND only
+		 * to the notifiers that ran before the one that failed
+		 * PM_SUSPEND_PREPARE, in the same order. If that kept it from
+		 * the resume notifier (not armed), add the reports back here.
+		 * After a normal suspend the resume notifier does it, later.
+		 */
+		guard(mutex)(&smgr->lock);
+		if (smgr->suspended && !smgr->armed)
+			qcom_smgr_resume_reports(smgr);
+		return NOTIFY_DONE;
+	}
+
+	if (event != PM_SUSPEND_PREPARE)
+		return NOTIFY_DONE;
+
+	guard(mutex)(&smgr->lock);
+
+	smgr->suspended = true;
+	smgr->armed = false;
+
+	for (i = 0; i < smgr->sensor_count; i++) {
+		sensor = &smgr->sensors[i];
+
+		if (sensor->streaming && qcom_smgr_stop_report(smgr, sensor))
+			dev_err(smgr->dev,
+				"Failed to stop reports of 0x%02x for suspend\n",
+				sensor->id);
+	}
+
+	return NOTIFY_DONE;
+}
+
+static int qcom_smgr_pm_resume(struct notifier_block *nb,
+			       unsigned long event, void *unused)
+{
+	struct qcom_smgr *smgr = container_of(nb, struct qcom_smgr, resume_nb);
+
+	if (event != PM_SUSPEND_PREPARE && event != PM_POST_SUSPEND)
+		return NOTIFY_DONE;
+
+	guard(mutex)(&smgr->lock);
+
+	if (event == PM_SUSPEND_PREPARE)
+		/* Every notifier before this one prepared: POST_SUSPEND comes here */
+		smgr->armed = true;
+	else if (smgr->suspended)
+		qcom_smgr_resume_reports(smgr);
+
+	return NOTIFY_DONE;
+}
+
 static int qcom_smgr_probe(struct qrtr_device *qdev)
 {
 	struct qcom_smgr *smgr;
@@ -699,6 +872,10 @@ static int qcom_smgr_probe(struct qrtr_device *qdev)
 
 	smgr->dev = &qdev->dev;
 
+	ret = devm_mutex_init(&qdev->dev, &smgr->lock);
+	if (ret)
+		return ret;
+
 	smgr->sns_smgr_info.sq_family = AF_QIPCRTR;
 	smgr->sns_smgr_info.sq_node = qdev->node;
 	smgr->sns_smgr_info.sq_port = qdev->port;
@@ -747,6 +924,14 @@ static int qcom_smgr_probe(struct qrtr_device *qdev)
 		qcom_smgr_register_sensor(smgr, &smgr->sensors[i]);
 	}
 
+	smgr->suspend_nb.notifier_call = qcom_smgr_pm_suspend;
+	smgr->suspend_nb.priority = SMGR_PM_SUSPEND_PRIORITY;
+	register_pm_notifier(&smgr->suspend_nb);
+
+	smgr->resume_nb.notifier_call = qcom_smgr_pm_resume;
+	smgr->resume_nb.priority = SMGR_PM_RESUME_PRIORITY;
+	register_pm_notifier(&smgr->resume_nb);
+
 	return 0;
 }
 
@@ -754,6 +939,9 @@ static void qcom_smgr_remove(struct qrtr_device *qdev)
 {
 	struct qcom_smgr *smgr = dev_get_drvdata(&qdev->dev);
 
+	unregister_pm_notifier(&smgr->resume_nb);
+	unregister_pm_notifier(&smgr->suspend_nb);
+
 	qmi_handle_release(&smgr->sns_smgr_hdl);
 }
 
