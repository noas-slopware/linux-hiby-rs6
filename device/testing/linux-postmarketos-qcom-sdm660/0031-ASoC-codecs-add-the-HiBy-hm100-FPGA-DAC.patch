+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/hiby,hm100.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiBy HM100 FPGA DAC with NJW1195A volume
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description:
+  Digital audio path of the HiBy RS6, a Gowin FPGA acting as DAC. The FPGA is
+  configured by bit-banging a JTAG-like bus on GPIOs (shared with the NJW1195A
+  volume chip), and its sample data is loaded over SPI. The driver switches
+  the shared pins between the "jtag" (plain GPIO) and "spi" (SPI function)
+  pinctrl states. It requests the firmware files hiby/rs6/hm100-pcm.bin and
+  hiby/rs6/hm100-fir-default.bin.
+
+allOf:
+  - $ref: dai-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: hiby,hm100
+
+  reg:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+  pinctrl-names:
+    items:
+      - const: jtag
+      - const: spi
+
+  pinctrl-0: true
+  pinctrl-1: true
+
+  sdo-gpios:
+    maxItems: 1
+    description: Serial data out of the bit-banged control bus.
+
+  tdo-gpios:
+    maxItems: 1
+    description: Serial data in from the FPGA (JTAG TDO), read as input.
+
+  cs-gpios:
+    maxItems: 1
+    description: Chip select of the bit-banged control bus.
+
+  clk-gpios:
+    maxItems: 1
+    description: Clock of the bit-banged control bus.
+
+  run-gpios:
+    maxItems: 1
+    description: Run/reset line of the FPGA.
+
+  share-select-gpios:
+    maxItems: 1
+    description: Selects the NJW1195A volume chip on the shared control bus.
+
+  vol-power-gpios:
+    maxItems: 1
+    description: Power enable of the volume chip.
+
+  dac-power1-gpios:
+    maxItems: 1
+    description: First DAC power rail enable.
+
+  dac-power2-gpios:
+    maxItems: 1
+    description: Second DAC power rail enable.
+
+  hp-bal-select-gpios:
+    maxItems: 1
+    description: Selects the balanced headphone output.
+
+  lpf-select-gpios:
+    maxItems: 1
+    description: Selects the output low-pass filter.
+
+  jtag-select-gpios:
+    maxItems: 1
+    description: Routes the shared pins to the FPGA JTAG interface.
+
+  power-gpios:
+    maxItems: 1
+    description: FPGA power enable.
+
+  lpf-mute-gpios:
+    maxItems: 1
+    description: Mutes the low-pass filter stage.
+
+  line-mute-gpios:
+    maxItems: 1
+    description: Mutes the line output.
+
+  po-power-gpios:
+    maxItems: 1
+    description: Power enable of the output stage.
+
+  balance-detect-gpios:
+    maxItems: 1
+    description: Balanced headphone jack detect, high when plugged.
+
+  balance-lo-detect-gpios:
+    maxItems: 1
+    description: Balanced line out jack detect, high when plugged.
+
+  headset-detect-gpios:
+    maxItems: 1
+    description: Headphone jack detect, high when plugged.
+
+  lineout-detect-gpios:
+    maxItems: 1
+    description: Line out jack detect, high when plugged.
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+  - pinctrl-names
+  - pinctrl-0
+  - pinctrl-1
+  - sdo-gpios
+  - tdo-gpios
+  - cs-gpios
+  - clk-gpios
+  - run-gpios
+  - share-select-gpios
+  - vol-power-gpios
+  - dac-power1-gpios
+  - dac-power2-gpios
+  - hp-bal-select-gpios
+  - lpf-select-gpios
+  - jtag-select-gpios
+  - power-gpios
+  - lpf-mute-gpios
+  - line-mute-gpios
+  - po-power-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        fpga@0 {
+            compatible = "hiby,hm100";
+            reg = <0>;
+            spi-max-frequency = <10000000>;
+            #sound-dai-cells = <0>;
+            pinctrl-names = "jtag", "spi";
+            pinctrl-0 = <&hm100_jtag>;
+            pinctrl-1 = <&hm100_jtag_as_spi>;
+            sdo-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+            tdo-gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
+            cs-gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
+            clk-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+            run-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+            share-select-gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
+            vol-power-gpios = <&tlmm 15 GPIO_ACTIVE_HIGH>;
+            dac-power1-gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
+            hp-bal-select-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+            lpf-select-gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
+            dac-power2-gpios = <&tlmm 40 GPIO_ACTIVE_HIGH>;
+            jtag-select-gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+            power-gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
+            lpf-mute-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
+            line-mute-gpios = <&tlmm 76 GPIO_ACTIVE_HIGH>;
+            po-power-gpios = <&pm660_gpios 13 GPIO_ACTIVE_HIGH>;
+            balance-detect-gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
+            balance-lo-detect-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+            headset-detect-gpios = <&tlmm 41 GPIO_ACTIVE_HIGH>;
+            lineout-detect-gpios = <&tlmm 14 GPIO_ACTIVE_HIGH>;
+        };
+    };
+...
