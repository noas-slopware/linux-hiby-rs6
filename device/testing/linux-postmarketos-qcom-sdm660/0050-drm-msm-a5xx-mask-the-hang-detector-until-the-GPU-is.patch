From 3a942a8d00e7230090f6ed0bcd604fbe0ca9e85f Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Thu, 22 Oct 2026 12:20:34 +0900
Subject: [PATCH 50/94] drm/msm/a5xx: mask the hang detector until the GPU is
 reset

The hang detector keeps firing every few ms until the reset, and each
interrupt asked for another recovery. Turn the RBBM interrupts off as
a6xx does; hw_init enables them again. Also print the fence the GPU
completed next to the last submitted one.

Assisted-by: Claude:claude-mythos-5-1
Assisted-by: Claude:claude-opus-5-5
Claude-Session: https://claude.ai/code/session_01SXjPGasJxD6XRYU1J9jsnW
---
 drivers/gpu/drm/msm/adreno/a5xx_gpu.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
index 612efc666..a771e9f08 100644
--- a/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a5xx_gpu.c
@@ -1238,8 +1238,9 @@ static void a5xx_fault_detect_irq(struct msm_gpu *gpu)
 	if (gpu_read(gpu, REG_A5XX_RBBM_STATUS3) & BIT(24))
 		return;
 
-	DRM_DEV_ERROR(dev->dev, "gpu fault ring %d fence %x status %8.8X rb %4.4x/%4.4x ib1 %16.16llX/%4.4x ib2 %16.16llX/%4.4x\n",
+	DRM_DEV_ERROR(dev->dev, "gpu fault ring %d fence %x completed %x status %8.8X rb %4.4x/%4.4x ib1 %16.16llX/%4.4x ib2 %16.16llX/%4.4x\n",
 		ring ? ring->id : -1, ring ? ring->fctx->last_fence : 0,
+		ring ? ring->memptrs->fence : 0,
 		gpu_read(gpu, REG_A5XX_RBBM_STATUS),
 		gpu_read(gpu, REG_A5XX_CP_RB_RPTR),
 		gpu_read(gpu, REG_A5XX_CP_RB_WPTR),
@@ -1251,6 +1252,13 @@ static void a5xx_fault_detect_irq(struct msm_gpu *gpu)
 	/* Turn off the hangcheck timer to keep it from bothering us */
 	timer_delete(&gpu->hangcheck_timer);
 
+	/*
+	 * Turn off interrupts to avoid triggering recovery again: the hang
+	 * detector keeps firing every few ms until the reset, which re-enables
+	 * them from hw_init.
+	 */
+	gpu_write(gpu, REG_A5XX_RBBM_INT_0_MASK, 0);
+
 	msm_gpu_hw_fault(gpu);
 }
 
