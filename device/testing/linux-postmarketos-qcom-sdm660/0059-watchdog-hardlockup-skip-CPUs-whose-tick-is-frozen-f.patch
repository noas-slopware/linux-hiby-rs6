From 3f11bbf5eb23bfef4ed33e73c07bf13447e30348 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Thu, 22 Oct 2026 12:23:46 +0900
Subject: [PATCH 59/94] watchdog/hardlockup: skip CPUs whose tick is frozen for
 s2idle

In suspend to idle, CPUs whose tick is frozen do not run their watchdog
hrtimer, while a CPU woken by an interrupt does and checks its buddy.
Monotonic time only runs while a CPU is awake, so on a device woken
often in s2idle the buddy detector reported a hard lockup for a CPU
that was simply asleep (the RS6, after three missed checks of about
4.2 s each).

Mark a CPU frozen from tick_freeze() to tick_unfreeze(), and while a
system suspend is in progress reset its counters instead of checking
it. The unfreeze touches it, so a CPU needs the usual number of missed
checks after the thaw before it is reported. A CPU that never comes
back from s2idle is still reported once the system has resumed.

Assisted-by: Claude:claude-opus-5-5
Claude-Session: https://claude.ai/code/session_01SXjPGasJxD6XRYU1J9jsnW
---
 include/linux/nmi.h       |  5 +++++
 kernel/time/tick-common.c |  4 ++++
 kernel/watchdog.c         | 45 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 54 insertions(+)

diff --git a/include/linux/nmi.h b/include/linux/nmi.h
index bc1162895..16562aa58 100644
--- a/include/linux/nmi.h
+++ b/include/linux/nmi.h
@@ -99,6 +99,11 @@ static inline void arch_touch_nmi_watchdog(void) { }
 #if defined(CONFIG_HARDLOCKUP_DETECTOR_COUNTS_HRTIMER)
 void watchdog_hardlockup_touch_cpu(unsigned int cpu);
 void watchdog_hardlockup_check(unsigned int cpu, struct pt_regs *regs);
+void watchdog_hardlockup_tick_freeze(void);
+void watchdog_hardlockup_tick_unfreeze(void);
+#else
+static inline void watchdog_hardlockup_tick_freeze(void) { }
+static inline void watchdog_hardlockup_tick_unfreeze(void) { }
 #endif
 
 #if defined(CONFIG_HARDLOCKUP_DETECTOR_PERF)
diff --git a/kernel/time/tick-common.c b/kernel/time/tick-common.c
index 6a9198a42..b6481976f 100644
--- a/kernel/time/tick-common.c
+++ b/kernel/time/tick-common.c
@@ -520,6 +520,8 @@ void tick_freeze(void)
 {
 	raw_spin_lock(&tick_freeze_lock);
 
+	watchdog_hardlockup_tick_freeze();
+
 	tick_freeze_depth++;
 	if (tick_freeze_depth == num_online_cpus()) {
 		trace_suspend_resume(TPS("timekeeping_freeze"),
@@ -579,6 +581,8 @@ void tick_unfreeze(void)
 		tick_resume_local();
 	}
 
+	watchdog_hardlockup_tick_unfreeze();
+
 	tick_freeze_depth--;
 
 	raw_spin_unlock(&tick_freeze_lock);
diff --git a/kernel/watchdog.c b/kernel/watchdog.c
index 87dd5e0f6..0fe2c3ae3 100644
--- a/kernel/watchdog.c
+++ b/kernel/watchdog.c
@@ -23,6 +23,7 @@
 #include <linux/module.h>
 #include <linux/nmi.h>
 #include <linux/stop_machine.h>
+#include <linux/suspend.h>
 #include <linux/sysctl.h>
 #include <linux/tick.h>
 #include <linux/sys_info.h>
@@ -147,6 +148,7 @@ static DEFINE_PER_CPU(int, hrtimer_interrupts_saved);
 static DEFINE_PER_CPU(int, hrtimer_interrupts_missed);
 static DEFINE_PER_CPU(bool, watchdog_hardlockup_warned);
 static DEFINE_PER_CPU(bool, watchdog_hardlockup_touched);
+static DEFINE_PER_CPU(bool, watchdog_hardlockup_frozen);
 static unsigned long hard_lockup_nmi_warn;
 
 notrace void arch_touch_nmi_watchdog(void)
@@ -167,6 +169,43 @@ void watchdog_hardlockup_touch_cpu(unsigned int cpu)
 	per_cpu(watchdog_hardlockup_touched, cpu) = true;
 }
 
+/**
+ * watchdog_hardlockup_tick_freeze - The local tick is frozen for suspend to idle
+ *
+ * Called by tick_freeze() with interrupts disabled. Until the matching
+ * watchdog_hardlockup_tick_unfreeze(), this CPU does not run its watchdog
+ * hrtimer on purpose, while other CPUs may keep waking up for interrupts and
+ * checking it.
+ */
+void watchdog_hardlockup_tick_freeze(void)
+{
+	WRITE_ONCE(*this_cpu_ptr(&watchdog_hardlockup_frozen), true);
+}
+
+/**
+ * watchdog_hardlockup_tick_unfreeze - The local tick runs again
+ *
+ * Called by tick_unfreeze() with interrupts disabled. The hrtimer has not
+ * caught up yet, so the next check of this CPU is skipped as well.
+ */
+void watchdog_hardlockup_tick_unfreeze(void)
+{
+	__this_cpu_write(watchdog_hardlockup_touched, true);
+	WRITE_ONCE(*this_cpu_ptr(&watchdog_hardlockup_frozen), false);
+}
+
+/*
+ * A CPU whose tick is frozen for suspend to idle is not locked up, however
+ * long it stays there. Only trust the flag while a system suspend is in
+ * progress, so that a CPU which never comes back from suspend to idle is
+ * still reported once the system has resumed.
+ */
+static bool watchdog_hardlockup_is_frozen(unsigned int cpu)
+{
+	return READ_ONCE(per_cpu(watchdog_hardlockup_frozen, cpu)) &&
+	       pm_suspend_in_progress();
+}
+
 static void watchdog_hardlockup_update_reset(unsigned int cpu)
 {
 	int hrint = atomic_read(&per_cpu(hrtimer_interrupts, cpu));
@@ -216,6 +255,12 @@ void watchdog_hardlockup_check(unsigned int cpu, struct pt_regs *regs)
 		return;
 	}
 
+	/* Start counting misses again once the CPU leaves suspend to idle */
+	if (watchdog_hardlockup_is_frozen(cpu)) {
+		watchdog_hardlockup_update_reset(cpu);
+		return;
+	}
+
 	hardlockup_all_cpu_backtrace = (hardlockup_si_mask & SYS_INFO_ALL_BT) ?
 					1 : sysctl_hardlockup_all_cpu_backtrace;
 	/*
