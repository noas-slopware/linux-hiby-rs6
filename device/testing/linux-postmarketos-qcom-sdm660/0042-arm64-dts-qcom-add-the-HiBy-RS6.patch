+/*
+ * hm100 FPGA DAC + NJW1195A: the SRAM data phase goes over blsp_spi3 (stock hbc3000_ram, 10 MHz).
+ * The QUP has no pinctrl of its own, like stock; the driver muxes gpio8/11 to blsp_spi3 only for
+ * the data phase (stock hm100_jtag_as_spi) and back to GPIO (stock hm100_jtag_active) afterwards.
+ * gpio8-11 are then the bit-banged control bus shared with the NJW1195A (gpio13 selects it).
+ */
+&soc {
+	blsp_spi3: spi@c177000 {
+		compatible = "qcom,spi-qup-v2.2.1";
+		reg = <0x0c177000 0x600>;
+		interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc GCC_BLSP1_QUP3_SPI_APPS_CLK>, <&gcc GCC_BLSP1_AHB_CLK>;
+		clock-names = "core", "iface";
+		dmas = <&blsp1_dma 8>, <&blsp1_dma 9>;
+		dma-names = "tx", "rx";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		hm100: fpga@0 {
+			compatible = "hiby,hm100";
+			reg = <0>;
+			spi-max-frequency = <10000000>;
+			#sound-dai-cells = <0>;
+			sdo-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+			tdo-gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
+			cs-gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
+			clk-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+			run-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+			share-select-gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
+			vol-power-gpios = <&tlmm 15 GPIO_ACTIVE_HIGH>;
+			dac-power1-gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
+			hp-bal-select-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+			lpf-select-gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
+			dac-power2-gpios = <&tlmm 40 GPIO_ACTIVE_HIGH>;
+			jtag-select-gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+			power-gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
+			lpf-mute-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
+			line-mute-gpios = <&tlmm 76 GPIO_ACTIVE_HIGH>;
+			po-power-gpios = <&pm660_gpios 13 GPIO_ACTIVE_HIGH>;
+			/* stock hiby,sa_sound_switch jacks (high = plugged), report_only_one in this order */
+			balance-detect-gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
+			balance-lo-detect-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+			headset-detect-gpios = <&tlmm 41 GPIO_ACTIVE_HIGH>;
+			lineout-detect-gpios = <&tlmm 14 GPIO_ACTIVE_HIGH>;
+			pinctrl-names = "jtag", "spi";
+			pinctrl-0 = <&hm100_jtag>;
+			pinctrl-1 = <&hm100_jtag_as_spi>;
+		};
+	};
+};
+
+&tlmm {
+	/* stock hm100_jtag_active */
+	hm100_jtag: hm100-jtag-state {
+		pins = "gpio8", "gpio9", "gpio10", "gpio11", "gpio44";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/* stock hm100_jtag_as_spi */
+	hm100_jtag_as_spi: hm100-jtag-as-spi-state {
+		pins = "gpio8", "gpio11";
+		function = "blsp_spi3";
+		drive-strength = <6>;
+		bias-disable;
+	};
+};
