+/*
+ * PMIC GPIOs as the stock qpnp-pin nodes set them up at probe (mode, pull, vin-sel, src-sel,
+ * out-strength; whatever stock leaves unset stays as the hardware has it). qpnp-pin
+ * out-strength 1 is PMIC_GPIO_STRENGTH_LOW here, pull 5 is no pull, pull 0 is 30 uA up; an
+ * output with src-sel 0 and invert 0 drives low. Pins nothing in mainline requests are hogged.
+ */
+&pm660_gpios {
+	/*
+	 * Keep gpio4 last: power-source 1 needs a 2-VIN pad subtype; if this one has only one
+	 * VIN the state fails with -EINVAL (dev_err only) and the pins before it are already set.
+	 */
+	pinctrl-0 = <&pm660_gpio2_default>, <&pm660_gpio3_default>,
+		    <&pm660_gpio11_default>, <&po_pwr_en_default>,
+		    <&pm660_gpio4_default>;
+	pinctrl-names = "default";
+
+	/* stock gpio@c100: master-en 0 */
+	pm660_gpio2_default: gpio2-default-state {
+		pins = "gpio2";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		bias-high-impedance;
+	};
+
+	/* stock gpio@c200: output, pull-down, vin 0, src-sel 2, out-strength 2, master-en 0 */
+	pm660_gpio3_default: gpio3-default-state {
+		pins = "gpio3";
+		function = PMIC_GPIO_FUNC_FUNC1;
+		output-enable;
+		input-disable;
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+		/*
+		 * master-en 0 is high-Z here. Stock also writes pull-down, which does
+		 * nothing on a disabled pad, and generic pinconf allows one bias.
+		 */
+		bias-high-impedance;
+	};
+
+	/* stock gpio@ca00: input, 30 uA pull-up (qcom,pull 0), vin 0, src-sel 0, out-strength 1 */
+	pm660_gpio11_default: gpio11-default-state {
+		pins = "gpio11";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		input-enable;
+		output-disable;
+		bias-pull-up;
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+
+	/*
+	 * stock gpio@cc00 (hiby,po_pwr_en, the hm100 po-power-gpios): output low, no pull,
+	 * vin 0, src-sel 0. Hogged like qpnp-pin does it, not put on the hm100 node: that one
+	 * has only the driver-switched "jtag"/"spi" states, which would re-apply it each swap.
+	 */
+	po_pwr_en_default: po-pwr-en-default-state {
+		pins = "gpio13";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		output-low;
+		input-disable;
+		bias-disable;
+		power-source = <0>;
+	};
+
+	/* stock gpio@c300: input, vin-sel 1, src-sel 0, master-en 1 (no pull given) */
+	pm660_gpio4_default: gpio4-default-state {
+		pins = "gpio4";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		input-enable;
+		output-disable;
+		power-source = <1>;
+	};
+};
+
+&pm660l_gpios {
+	pinctrl-0 = <&pm660l_gpio3_default>, <&pm660l_gpio4_default>;
+	pinctrl-names = "default";
+
+	/* stock gpio@c200: output low, no pull, vin 0, src-sel 0 */
+	pm660l_gpio3_default: gpio3-default-state {
+		pins = "gpio3";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		output-low;
+		input-disable;
+		bias-disable;
+		power-source = <0>;
+	};
+
+	/* stock gpio@c300: input, 30 uA pull-up, vin 0, src-sel 0, out-strength 1 */
+	pm660l_gpio4_default: gpio4-default-state {
+		pins = "gpio4";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		input-enable;
+		output-disable;
+		bias-pull-up;
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+
+	/* stock gpio@c500: output CMOS, src-sel 2 (LPG), no pull, vin 0, out-strength 1; the bootloader leaves it high */
+	bl_pwm_default: bl-pwm-default-state {
+		pins = "gpio6";
+		function = PMIC_GPIO_FUNC_FUNC1;
+		output-low;
+		input-disable;
+		drive-push-pull;
+		bias-disable;
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+
+	/* stock gpio@c600: input, 30 uA pull-up, vin 0, src-sel 0, out-strength 1 */
+	vol_up_default: vol-up-default-state {
+		pins = "gpio7";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		bias-pull-up;
+		input-enable;
+		output-disable;
+		power-source = <0>;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+
+	/* stock gpio@c700 (lp5562 enable): output low, no pull, vin 0, src-sel 0 */
+	lp5562_en_default: lp5562-en-default-state {
+		pins = "gpio8";
+		function = PMIC_GPIO_FUNC_NORMAL;
+		output-low;
+		input-disable;
+		bias-disable;
+		power-source = <0>;
+	};
+};
