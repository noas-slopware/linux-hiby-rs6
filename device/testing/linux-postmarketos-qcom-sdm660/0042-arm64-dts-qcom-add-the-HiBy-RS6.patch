+/*
+ * Audio: q6 MultiMedia1 -> SEC_MI2S_RX (gpio24 sck, gpio25 ws, gpio26 sd0) -> hm100 FPGA DAC.
+ * The FPGA is the bit/frame clock provider (stock zeroes msm_is_mi2s_master at probe; AFE
+ * ws_src external). The FE media format, the ADM and the AFE run at 384000 whatever the track
+ * rate (stock hiby_fixed_samplerate), so the DSP never resamples; the hm100 codec gets the track
+ * rate for reg0.
+ */
+
+/*
+ * Stock puts sec_mi2s_{,sd0_,sd1_}{active,sleep} on the CPU DAI (msm-dai-q6-mi2s-sec, "default" /
+ * "sleep") and idles in sleep. Here the CPU DAI component is q6afedai: ASoC selects "sleep" on
+ * component devices once the card is up and whenever they go idle, and "default" on PCM open.
+ */
+&q6afedai {
+	pinctrl-0 = <&sec_mi2s_active>, <&sec_mi2s_sd0_active>, <&sec_mi2s_sd1_active>;
+	pinctrl-1 = <&sec_mi2s_sleep>, <&sec_mi2s_sd0_sleep>, <&sec_mi2s_sd1_sleep>;
+	pinctrl-names = "default", "sleep";
+
+	dai@12 {
+		reg = <SECONDARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		/* the DAC clocks the I2S at the track rate; ASM/ADM/AFE stay at 384000 */
+		qcom,fixed-rate = <384000>;
+		/* S32 in, sent as hi/lo S16 word pairs like the stock HAL output callback */
+		qcom,s32-as-s16-pairs;
+	};
+};
+
+&sound {
+	compatible = "qcom,sdm660-sndcard";
+	model = "HiBy RS6";
+	qcom,sec-mi2s-clock-consumer;
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	sec-mi2s-dai-link {
+		link-name = "SEC MI2S Playback";
+
+		cpu {
+			sound-dai = <&q6afedai SECONDARY_MI2S_RX>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&hm100>;
+		};
+	};
+};
