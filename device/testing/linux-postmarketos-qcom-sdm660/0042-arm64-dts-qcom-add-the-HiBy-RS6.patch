+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2026, Noa Himesaka <himesaka@noa.codes>
+ *
+ * HiBy RS6 digital audio player. Based on sdm660-xiaomi-lavender-common.dtsi.
+ * Board facts come from the stock 1.80 device tree ("SDM 660 PM660 + PM660L +
+ * RS6 MTP"); see docs/hardware.md in the porting repo.
+ */
+
+/dts-v1/;
+
+#include "sdm660.dtsi"
+#include "pm660.dtsi"
+#include "pm660l.dtsi"
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/input/gpio-keys.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+
+/delete-node/ &zap_shader_region;
+
+/ {
+	model = "HiBy RS6";
+	compatible = "hiby,rs6", "qcom,sdm660";
+	chassis-type = "handset";
+
+	/* Stock ABL picks the appended DTB by these, copied from the stock DT. */
+	qcom,msm-id = <0x13d 0x0>;
+	qcom,board-id = <0x8 0x0>;
+	qcom,pmic-id = <0x1001b 0x101011a 0x0 0x0 0x1001b 0x201011a 0x0 0x0 0x1001b 0x102001a 0x0 0x0>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer0: framebuffer@9d400000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x9d400000 0 (1080 * 1920 * 4)>;
+			width = <1080>;
+			height = <1920>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+
+			/*
+			 * Keep the scan-out path of the bootloader's splash alive until msm takes over
+			 * (~10 s, module); otherwise "clk: Disabling unused clocks" at ~1.2 s starves
+			 * the panel while the backlight is still on, and it drifts into colour bands.
+			 */
+			clocks = <&mmcc MDSS_AHB_CLK>,
+				 <&mmcc MDSS_AXI_CLK>,
+				 <&mmcc MDSS_VSYNC_CLK>,
+				 <&mmcc MDSS_MDP_CLK>,
+				 <&mmcc MDSS_BYTE0_CLK>,
+				 <&mmcc MDSS_BYTE0_INTF_CLK>,
+				 <&mmcc MNOC_AHB_CLK>,
+				 <&mmcc MISC_AHB_CLK>,
+				 <&mmcc MDSS_PCLK0_CLK>,
+				 <&mmcc MDSS_ESC0_CLK>;
+			power-domains = <&mmcc MDSS_GDSC>,
+					<&rpmpd RPMPD_VDDCX>;
+		};
+	};
+
+	battery: battery {
+		compatible = "simple-battery";
+
+		/* 4500 mAh per HiBy's spec sheet */
+		charge-full-design-microamp-hours = <4500000>;
+		voltage-min-design-microvolt = <3400000>;
+		/* Stock smb2 runs the cell at 4.35 V / 3 A (live power_supply dump) */
+		voltage-max-design-microvolt = <4350000>;
+		constant-charge-voltage-max-microvolt = <4350000>;
+		constant-charge-current-max-microamp = <3000000>;
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * Placeholder for the PM660L LCDB (stock: lab/ibb 4.6-6.0 V) until
+	 * there is a driver; the bootloader leaves it on.
+	 */
+	lcdb_fixed: lcdb-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "lcdb";
+		regulator-min-microvolt = <5400000>;
+		regulator-max-microvolt = <5400000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* Stock: bl_ctrl_pwm on PM660L LPG channel 4 (pwm@b400), 370 us period */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		/* stock: LPG4 (pwm@b400), 370 us, out through pm660l GPIO6 in func1 (src-sel 2) */
+		pwms = <&pm660l_lpg 3 370000>;
+		pinctrl-0 = <&bl_pwm_default>;
+		pinctrl-names = "default";
+		brightness-levels = <0 4095>;
+		num-interpolated-steps = <4095>;
+		default-brightness-level = <1600>;
+	};
+
+	/* volume wheel; directions and codes from the stock ring_keys node */
+	ring-keys {
+		compatible = "hiby,ring-keys";
+		clockwise-gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		anticlockwise-gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&ring_keys_default>;
+		pinctrl-names = "default";
+
+		key-volume-down {
+			linux,code = <KEY_VOLUMEDOWN>;
+			hiby,direction = <1>;
+		};
+
+		key-volume-up {
+			linux,code = <KEY_VOLUMEUP>;
+			hiby,direction = <2>;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&vol_up_default>, <&play_pause_default>;
+		pinctrl-names = "default";
+
+		/* stock gpio-keys.kl: key 115 -> MEDIA_PREVIOUS (the knob is the volume) */
+		key-previous {
+			label = "Previous";
+			gpios = <&pm660l_gpios 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_PREVIOUSSONG>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+
+		key-playpause {
+			label = "Play Pause";
+			gpios = <&tlmm 56 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_PLAYPAUSE>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* free in the stock map (dfps_data_mem ends at 0x9f800000); same spot as lavender */
+		ramoops@a0000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xa0000000 0x0 0x400000>;
+			console-size = <0x20000>;
+			record-size = <0x20000>;
+			ftrace-size = <0x0>;
+			pmsg-size = <0x20000>;
+		};
+
+		framebuffer_mem: memory@9d400000 {
+			reg = <0x0 0x9d400000 0x0 0x23ff000>;
+			no-map;
+		};
+
+		/* same address as lavender; stock loads a512_zap via kgsl-hyp into a dynamic region */
+		zap_shader_region: gpu@fc400000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0xfc400000 0x0 0x2000>;
+			no-map;
+		};
+	};
+
+	/*
+	 * CPU OPPs: the stock OSM LUT (qcom,clk-cpu-osm) for speed bin 1.
+	 * The bin is inferred, not fuse-read: stock cpufreq tops out at
+	 * pwrcl 1843.2 MHz and perfcl 2208 MHz, and 2208 MHz is the perfcl
+	 * top only in speed bin 1.  Virtual corner N -> cprh_oppN.
+	 */
+	/* qcom,pwrcl-speedbin1-v0 */
+	pwrcl_opp_table: opp-table-pwrcl {
+		compatible = "operating-points-v2-qcom-osm";
+		opp-shared;
+
+		opp-300000000 {
+			opp-hz = /bits/ 64 <300000000>;
+			required-opps = <&cprh_opp1>;
+			qcom,pll-override = <0x1200020>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-633600000 {
+			opp-hz = /bits/ 64 <633600000>;
+			required-opps = <&cprh_opp2>;
+			qcom,pll-override = <0x3200020>;
+			qcom,spare-data = <1>;
+			qcom,pll-div = <1>;
+		};
+
+		opp-902400000 {
+			opp-hz = /bits/ 64 <902400000>;
+			required-opps = <&cprh_opp3>;
+			qcom,pll-override = <0x4260026>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-1113600000 {
+			opp-hz = /bits/ 64 <1113600000>;
+			required-opps = <&cprh_opp4>;
+			qcom,pll-override = <0x52e002e>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1401600000 {
+			opp-hz = /bits/ 64 <1401600000>;
+			required-opps = <&cprh_opp5>;
+			qcom,pll-override = <0x73a003a>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1536000000 {
+			opp-hz = /bits/ 64 <1536000000>;
+			required-opps = <&cprh_opp6>;
+			qcom,pll-override = <0x8400040>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1747200000 {
+			opp-hz = /bits/ 64 <1747200000>;
+			required-opps = <&cprh_opp7>;
+			qcom,pll-override = <0x9480048>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1843200000 {
+			opp-hz = /bits/ 64 <1843200000>;
+			required-opps = <&cprh_opp8>;
+			qcom,pll-override = <0x94c004c>;
+			qcom,spare-data = <3>;
+		};
+	};
+
+	/* qcom,perfcl-speedbin1-v0 */
+	perfcl_opp_table: opp-table-perfcl {
+		compatible = "operating-points-v2-qcom-osm";
+		opp-shared;
+
+		opp-300000000 {
+			opp-hz = /bits/ 64 <300000000>;
+			required-opps = <&cprh_opp1>;
+			qcom,pll-override = <0x1200020>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-1113600000 {
+			opp-hz = /bits/ 64 <1113600000>;
+			required-opps = <&cprh_opp2>;
+			qcom,pll-override = <0x52e002e>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-1401600000 {
+			opp-hz = /bits/ 64 <1401600000>;
+			required-opps = <&cprh_opp3>;
+			qcom,pll-override = <0x73a003a>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1747200000 {
+			opp-hz = /bits/ 64 <1747200000>;
+			required-opps = <&cprh_opp4>;
+			qcom,pll-override = <0x9480048>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1958400000 {
+			opp-hz = /bits/ 64 <1958400000>;
+			required-opps = <&cprh_opp5>;
+			qcom,pll-override = <0xa510051>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-2150400000 {
+			opp-hz = /bits/ 64 <2150400000>;
+			required-opps = <&cprh_opp6>;
+			qcom,pll-override = <0xb590059>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-2208000000 {
+			opp-hz = /bits/ 64 <2208000000>;
+			required-opps = <&cprh_opp7>;
+			qcom,pll-override = <0xb5c005c>;
+			qcom,spare-data = <3>;
+		};
+	};
+};
+
+&adreno_gpu {
+	/*
+	 * Soak 2026-10-20: 60 kmscube render/idle cycles (1-45 s idle, runtime suspend each
+	 * time) without a reset. Two earlier resets after a bare first open on an older build
+	 * were not reproducible; a third came from reading debugfs dri/1/gpu (state dump).
+	 */
+	status = "okay";
+};
+
+&adreno_gpu_zap {
+	firmware-name = "a512_zap.mbn";
+	memory-region = <&zap_shader_region>;
+};
+
+&apc_cprh {
+	status = "okay";
+};
+
+&blsp2_uart1 {
+	status = "okay";
+
+	/*
+	 * Stock bt_wcn3990: core l9a, pa l6a, ldo l19a, chip-pwd bob. Its HS-UART is
+	 * uart@c1af000 (msm-hsuart-v14, gpio16-19), i.e. this blsp2_uart1.
+	 */
+	bluetooth {
+		compatible = "qcom,wcn3990-bt";
+		/*
+		 * Stock has no vddio (l13a is the LPDDR4 rail, left to the RPM). Voltages are
+		 * stock's qca,bt-vdd-{core,pa,ldo}-voltage-level, voted only while BT is on.
+		 * Stock's fourth supply, chip-pwd on bob pin1 (3.6 V), has no mainline equivalent.
+		 */
+		vddxo-supply = <&vreg_l9a_1p8>;
+		vddxo-microvolt = <1800000 1900000>;
+		vddrf-supply = <&vreg_l6a_1p3>;
+		vddrf-microvolt = <1304000 1370000>;
+		vddch0-supply = <&vreg_l19a_3p3>;
+		vddch0-microvolt = <3312000 3400000>;
+		max-speed = <3200000>;
+	};
+};
+
+/* stock blsp2_uart1_{tx,rxcts,rfr}_active: all four pins no pull, 2 mA */
+&blsp2_uart1_default {
+	rx-pins {
+		/delete-property/ bias-pull-up;
+		bias-disable;
+	};
+
+	cts-pins {
+		/delete-property/ bias-pull-down;
+		bias-disable;
+	};
+};
+
+&blsp_i2c1 {
+	status = "okay";
+
+	touchscreen@14 {
+		compatible = "goodix,gt1151";
+		reg = <0x14>;
+
+		interrupts-extended = <&tlmm 67 IRQ_TYPE_EDGE_FALLING>;
+		irq-gpios = <&tlmm 67 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&tlmm 66 GPIO_ACTIVE_HIGH>;
+
+		AVDD28-supply = <&vreg_l3b_3p3>;
+
+		pinctrl-0 = <&ts_int_default>, <&ts_reset_default>;
+		pinctrl-names = "default";
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+		touchscreen-inverted-y;
+	};
+};
+
+&blsp_i2c6 {
+	status = "okay";
+
+	fuel-gauge@62 {
+		compatible = "cellwise,cw2015";
+		reg = <0x62>;
+
+		/* Stock "config-data", 16 u32 split into bytes */
+		cellwise,battery-profile = /bits/ 8 <
+			0x17 0x67 0x71 0x67 0x67 0x64 0x63 0x59
+			0x66 0x6b 0x43 0x53 0x55 0x59 0x45 0x39
+			0x30 0x29 0x23 0x1b 0x1e 0x2b 0x3e 0x4c
+			0x38 0x18 0x0c 0xcd 0x36 0x56 0x64 0x80
+			0x89 0x8b 0x8e 0x8c 0x3c 0x19 0x79 0x30
+			0x0a 0x35 0x16 0x41 0x6d 0x9a 0xaa 0x0d
+			0x22 0x6a 0x9c 0xc6 0x80 0x64 0x69 0xcb
+			0x2f 0x00 0x64 0xa5 0xb5 0x08 0x40 0x49
+		>;
+		monitored-battery = <&battery>;
+		power-supplies = <&pm660_charger>;
+	};
+
+	led-controller@30 {
+		compatible = "ti,lp5562";
+		reg = <0x30>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		clock-mode = /bits/ 8 <1>;
+		enable-gpios = <&pm660l_gpios 8 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&lp5562_en_default>;
+		pinctrl-names = "default";
+
+		led@0 {
+			reg = <0>;
+			chan-name = "R";
+			color = <LED_COLOR_ID_RED>;
+			led-cur = /bits/ 8 <0x20>;
+			max-cur = /bits/ 8 <0x60>;
+		};
+
+		led@1 {
+			reg = <1>;
+			chan-name = "G";
+			color = <LED_COLOR_ID_GREEN>;
+			led-cur = /bits/ 8 <0x20>;
+			max-cur = /bits/ 8 <0x60>;
+		};
+
+		led@2 {
+			reg = <2>;
+			chan-name = "B";
+			color = <LED_COLOR_ID_BLUE>;
+			led-cur = /bits/ 8 <0x20>;
+			max-cur = /bits/ 8 <0x60>;
+		};
+
+		led@3 {
+			reg = <3>;
+			chan-name = "W";
+			color = <LED_COLOR_ID_WHITE>;
+			led-cur = /bits/ 8 <0x20>;
+			max-cur = /bits/ 8 <0x60>;
+		};
+	};
+};
+
+/*
+ * cpu@100-103 = gold (perfcl, apc1, OSM domain 1); cpu@0-3 = silver (pwrcl).
+ * The PSCI domain (idle hierarchy, sdm660.dtsi) must stay first: the cpuidle
+ * code takes domain idle states from power-domains[0]. The CPRh thread is
+ * found by its "cpr" name.
+ */
+&cpu0 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&cpu_pd0>, <&apc_cprh 1>;
+	power-domain-names = "psci", "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu1 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&cpu_pd1>, <&apc_cprh 1>;
+	power-domain-names = "psci", "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu2 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&cpu_pd2>, <&apc_cprh 1>;
+	power-domain-names = "psci", "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu3 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&cpu_pd3>, <&apc_cprh 1>;
+	power-domain-names = "psci", "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu4 {
+	operating-points-v2 = <&pwrcl_opp_table>;
+	power-domains = <&cpu_pd4>, <&apc_cprh 0>;
+	power-domain-names = "psci", "cpr";
+	qcom,freq-domain = <&cpufreq_hw 0>;
+};
+
+&cpu5 {
+	operating-points-v2 = <&pwrcl_opp_table>;
+	power-domains = <&cpu_pd5>, <&apc_cprh 0>;
