+&tlmm {
+	/* stock sec_mi2s_active, sec_mi2s_sd0_active, sec_mi2s_sd1_active */
+	sec_mi2s_active: sec-mi2s-active-state {
+		pins = "gpio24", "gpio25";
+		function = "sec_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	sec_mi2s_sd0_active: sec-mi2s-sd0-active-state {
+		pins = "gpio26";
+		function = "sec_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	sec_mi2s_sd1_active: sec-mi2s-sd1-active-state {
+		pins = "gpio27";
+		function = "sec_mi2s";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	/* stock sec_mi2s_sleep (its input-enable clears OE, i.e. output-disable here) */
+	sec_mi2s_sleep: sec-mi2s-sleep-state {
+		pins = "gpio24", "gpio25";
+		function = "sec_mi2s";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-disable;
+	};
+
+	/* stock sec_mi2s_sd0_sleep */
+	sec_mi2s_sd0_sleep: sec-mi2s-sd0-sleep-state {
+		pins = "gpio26";
+		function = "sec_mi2s";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	/* stock sec_mi2s_sd1_sleep */
+	sec_mi2s_sd1_sleep: sec-mi2s-sd1-sleep-state {
+		pins = "gpio27";
+		function = "sec_mi2s";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
