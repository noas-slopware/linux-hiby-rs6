+/*
+ * stock hm100_set_samplerate with spdif_enabled: spdif_table {rate, f0, f1, f2}, mode 1 (the
+ * FPGA forwards SD to its S/PDIF pin). The rate is the S/PDIF frame rate fs: a frame is 16
+ * bytes of biphase-mark cells, BCLK 128 fs. Stock runs off the end to 384k for any other rate.
+ */
+static const struct { u32 rate; u8 f0, f1, f2; } spdif_table[] = {
+	{ 44100, 0, 0, 2 }, { 48000, 1, 0, 2 }, { 88200, 0, 0, 1 }, { 96000, 1, 0, 1 },
+	{ 176400, 0, 0, 0 }, { 192000, 1, 0, 0 }, { 352800, 0, 0, 5 }, { 384000, 1, 0, 5 },
+};
+
+static int spdif_word(unsigned int fs)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(spdif_table); i++)
+		if (spdif_table[i].rate == fs)
+			return spdif_table[i].f0 << 9 | (spdif_table[i].f1 & 3) << 7 |
+			       (spdif_table[i].f2 & 0xf) << 3 | 1;
+	return -EINVAL;
+}
+
+/* reg0 of the open PCM-format stream: its S/PDIF word, else the PCM word of the FE rate */
+static int stream_word(struct hm100 *h)
+{
+	return h->spdif_fs ? spdif_word(h->spdif_fs) : rate_word(h->rate);
+}
