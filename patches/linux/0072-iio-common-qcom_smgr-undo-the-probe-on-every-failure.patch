From 2a2288014dee9639d0d530d9242f023a36c50368 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Thu, 22 Oct 2026 13:02:37 +0900
Subject: [PATCH 72/94] iio: common: qcom_smgr: undo the probe on every
 failure, in order

Probe never released the QMI handle when a sensor info request failed,
ignored the sensor registration and PM notifier registration results,
and did not check the sensor array and string allocations. Remove
released the QMI handle first, before devres unregistered the sensor
devices, whose buffer disable still sends a DELETE through that handle,
and devres freed the sensor array while the handle could still deliver
a report indication that looks the sensor up in it.

Undo everything through devres, so a failed probe and a remove take the
same path in reverse: the PM notifiers, then the sensor devices, then
the QMI handle and only after it the sensor array, which is no longer
device managed for that reason. Fail the probe when a sensor device or
a PM notifier cannot be registered (a sensor type without a driver is
still skipped) or an allocation fails.

Assisted-by: Claude:claude-opus-5-5
Claude-Session: https://claude.ai/code/session_01SXjPGasJxD6XRYU1J9jsnW
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 93 ++++++++++++++++++------
 1 file changed, 71 insertions(+), 22 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index 2bbfc61d9..5dd913a11 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -147,9 +147,14 @@ static int qcom_smgr_request_all_sensor_info(struct qcom_smgr *smgr,
 		return -EREMOTEIO;
 	}
 
-	*sensors = devm_kzalloc(smgr->dev,
-				sizeof(struct qcom_smgr_sensor) * resp.item_len,
-				GFP_KERNEL);
+	/*
+	 * Not device managed: the report handler looks sensors up in here as
+	 * long as the QMI handle lives, see qcom_smgr_release_qmi().
+	 */
+	*sensors = kcalloc(resp.item_len, sizeof(struct qcom_smgr_sensor),
+			   GFP_KERNEL);
+	if (!*sensors)
+		return -ENOMEM;
 
 	for (i = 0; i < resp.item_len; ++i) {
 		(*sensors)[i].id = resp.items[i].id;
@@ -218,6 +223,8 @@ static int qcom_smgr_request_single_sensor_info(struct qcom_smgr *smgr,
 			smgr->dev, resp.data_types[i].name, GFP_KERNEL);
 		sensor->data_types[i].vendor = devm_kstrdup_const(
 			smgr->dev, resp.data_types[i].vendor, GFP_KERNEL);
+		if (!sensor->data_types[i].name || !sensor->data_types[i].vendor)
+			return -ENOMEM;
 
 		sensor->data_types[i].range = resp.data_types[i].range;
 
@@ -941,6 +948,53 @@ static int qcom_smgr_pm_resume(struct notifier_block *nb,
 	return NOTIFY_DONE;
 }
 
+/*
+ * Last of the teardown, after the sensor devices disabled their buffers
+ * (which still talk to SMGR): no report indication can come in after the
+ * handle is released, so the sensors it looks reports up in can go too.
+ */
+static void qcom_smgr_release_qmi(void *data)
+{
+	struct qcom_smgr *smgr = data;
+
+	qmi_handle_release(&smgr->sns_smgr_hdl);
+	kfree(smgr->sensors);
+}
+
+static void qcom_smgr_unregister_pm_notifiers(void *data)
+{
+	struct qcom_smgr *smgr = data;
+
+	unregister_pm_notifier(&smgr->resume_nb);
+	unregister_pm_notifier(&smgr->suspend_nb);
+}
+
+static int qcom_smgr_register_pm_notifiers(struct qcom_smgr *smgr)
+{
+	int ret;
+
+	smgr->suspend_nb.notifier_call = qcom_smgr_pm_suspend;
+	smgr->suspend_nb.priority = SMGR_PM_SUSPEND_PRIORITY;
+	ret = register_pm_notifier(&smgr->suspend_nb);
+	if (ret)
+		return ret;
+
+	smgr->resume_nb.notifier_call = qcom_smgr_pm_resume;
+	smgr->resume_nb.priority = SMGR_PM_RESUME_PRIORITY;
+	ret = register_pm_notifier(&smgr->resume_nb);
+	if (ret) {
+		unregister_pm_notifier(&smgr->suspend_nb);
+		return ret;
+	}
+
+	return devm_add_action_or_reset(smgr->dev,
+					qcom_smgr_unregister_pm_notifiers, smgr);
+}
+
+/*
+ * Everything is undone by devres, in reverse: the PM notifiers, the sensor
+ * devices (whose buffers send their last DELETE), then the QMI handle.
+ */
 static int qcom_smgr_probe(struct qrtr_device *qdev)
 {
 	struct qcom_smgr *smgr;
@@ -972,6 +1026,10 @@ static int qcom_smgr_probe(struct qrtr_device *qdev)
 		return ret;
 	}
 
+	ret = devm_add_action_or_reset(smgr->dev, qcom_smgr_release_qmi, smgr);
+	if (ret)
+		return ret;
+
 	ret = qcom_smgr_request_all_sensor_info(smgr, &smgr->sensors);
 	if (ret < 0) {
 		dev_err(smgr->dev, "Failed to get available sensors: %pe\n",
@@ -1004,30 +1062,22 @@ static int qcom_smgr_probe(struct qrtr_device *qdev)
 				smgr->sensors[i].data_types[j].cur_sample_rate);
 		}
 
-		qcom_smgr_register_sensor(smgr, &smgr->sensors[i]);
+		/* a sensor type without a driver is left alone */
+		ret = qcom_smgr_register_sensor(smgr, &smgr->sensors[i]);
+		if (ret && ret != -ENODEV)
+			return ret;
 	}
 
-	smgr->suspend_nb.notifier_call = qcom_smgr_pm_suspend;
-	smgr->suspend_nb.priority = SMGR_PM_SUSPEND_PRIORITY;
-	register_pm_notifier(&smgr->suspend_nb);
-
-	smgr->resume_nb.notifier_call = qcom_smgr_pm_resume;
-	smgr->resume_nb.priority = SMGR_PM_RESUME_PRIORITY;
-	register_pm_notifier(&smgr->resume_nb);
+	ret = qcom_smgr_register_pm_notifiers(smgr);
+	if (ret) {
+		dev_err(smgr->dev, "Failed to register PM notifiers: %pe\n",
+			ERR_PTR(ret));
+		return ret;
+	}
 
 	return 0;
 }
 
-static void qcom_smgr_remove(struct qrtr_device *qdev)
-{
-	struct qcom_smgr *smgr = dev_get_drvdata(&qdev->dev);
-
-	unregister_pm_notifier(&smgr->resume_nb);
-	unregister_pm_notifier(&smgr->suspend_nb);
-
-	qmi_handle_release(&smgr->sns_smgr_hdl);
-}
-
 static const struct qrtr_device_id qcom_smgr_qrtr_match[] = {
 	{
 		.service = SNS_SMGR_QMI_SVC_ID,
@@ -1040,7 +1090,6 @@ MODULE_DEVICE_TABLE(qrtr, qcom_smgr_qrtr_match);
 
 static struct qrtr_driver qcom_smgr_driver = {
 	.probe = qcom_smgr_probe,
-	.remove = qcom_smgr_remove,
 	.id_table = qcom_smgr_qrtr_match,
 	.driver	= {
 		.name = "qcom_smgr",
