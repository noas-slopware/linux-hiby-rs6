+/*
+ * MPM (MSM Power Manager) wakeup interrupt controller, from the stock
+ * qcom,mpm@7781b8 node (qcom,mpm-v2):
+ *   vMPM: reg 0x7781b8, inside the RPM message RAM at 0x778000. Its layout
+ *     (64-bit wakeup timer, then ENABLE, FALLING, RISING, POLARITY and STATUS
+ *     banks of 3 words for 0x60 pins) is the one stock msm_mpm_enter_sleep()
+ *     writes and irq-qcom-mpm.c uses.
+ *   ipc: 0x17911008 bit 1 (qcom,ipc-bit-offset), APCS IPC channel 1.
+ *   interrupts: <0 0xab 1>, SPI 171 rising edge.
+ *   qcom,gic-map pairs are <MPM pin, GIC hwirq>, hwirq = SPI + 32 (the 0xff
+ *     "no pin" entries start at hwirq 0x10, PPIs). Below as SPIs, with the
+ *     interrupt each one carries in the stock DT. Pins 79/81 (SPI 347,
+ *     dwc3 qusb2_phy) and 80/82 (SPI 348, usb2 qusb2_phy) share a GIC line,
+ *     which qcom,mpm-pin-map cannot express, so they are left out; USB plug
+ *     wakeup comes from the PM660 charger and Type-C blocks over SPMI.
+ *   qcom,gpio-map is pinctrl-sdm660.c's sdm660_mpm_map, entry for entry.
+ */
+/ {
+	mpm: interrupt-controller {
+		compatible = "qcom,mpm";
+		qcom,rpm-msg-ram = <&apss_mpm>;
+		interrupts = <GIC_SPI 171 IRQ_TYPE_EDGE_RISING>;
+		mboxes = <&apcs_glb 1>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		#power-domain-cells = <0>;
+		interrupt-parent = <&intc>;
+		qcom,mpm-pin-count = <96>;
+		qcom,mpm-pin-map = <2 184>,	/* tsens uplow */
+				   <52 243>,	/* dwc3 ss_phy_irq */
+				   <61 177>,	/* wcd9xxx-irq (lpass) */
+				   <87 326>,	/* SPMI periph_irq */
+				   <91 487>;	/* no consumer in the stock DT */
+	};
+};
+
+&rpm_msg_ram {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	ranges = <0 0x00778000 0x7000>;
+
+	apss_mpm: sram@1b8 {
+		reg = <0x1b8 0x48>;
+	};
