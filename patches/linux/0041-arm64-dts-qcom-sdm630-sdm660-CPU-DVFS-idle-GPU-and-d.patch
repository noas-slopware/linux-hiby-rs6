+/*
+ * CPU and cluster (L2) idle, laid out for PSCI OS-initiated mode.
+ *
+ * The SDM660 PSCI firmware runs in OSI mode: SET_SUSPEND_MODE(PC) is DENIED
+ * ("failed to set PC mode: -3", the same pair of boot messages SC8280XP
+ * prints before switching to OSI fine). The vendor 4.4 kernel never switches
+ * modes; its lpm-levels driver composes OSI requests itself. In
+ * psci_enter_sleep()/get_cluster_id() (stock RS6 kernel, read in Ghidra) the
+ * power_state is
+ *
+ *   is_reset(CPU level) << 30 | affinity level << 24 | L2 mode << 4 | CPU mode
+ *
+ * where only the last CPU of a cluster adds an L2 mode, and every cluster
+ * level that is not the default (L2 WFI) adds 1 to the affinity level.
+ * CPU modes: 1 WFI, 2 retention, 3 power collapse. L2 modes: 2 dynamic
+ * retention, 3 retention, 4 power collapse (qcom,lpm-levels in the stock DT).
+ * The flat sdm630.dtsi cluster states (0x400000f2..f4: L2 field 0xf, affinity
+ * level 0, requested by any CPU) are not in that encoding and the firmware
+ * fails them at once. In s2idle that left the gold CPUs spinning through
+ * cpuidle with their tick running while silver slept, which the RS6 showed
+ * as hard-lockup and RCU stall reports. They are replaced by the hierarchy
+ * below: the CPU states stay per-CPU and the L2 states hang off one PSCI
+ * domain per cluster, which genpd only powers off once every CPU of the
+ * cluster is in CPU power collapse. With the domain parameter replacing the CPU one in
+ * __psci_enter_domain_idle_state(), each L2 state carries the full request
+ * the last CPU makes: CPU PC (is_reset, mode 3), affinity level 1, L2 mode.
+ * CPU retention is not a reset state in lpm-levels, hence 0x00000002.
+ *
+ * Timings come from the same stock qcom,lpm-levels nodes:
+ *   exit-latency-us  = qcom,latency-us
+ *   entry-latency-us = qcom,time-overhead - qcom,latency-us
+ *   min-residency-us = the level's min_residency as the vendor driver
+ *                      computes it from qcom,ss-power/energy-overhead/
+ *                      time-overhead (parse_cpu_levels(), parse_cluster(),
+ *                      set_optimum_cpu_residency(): one more than the
+ *                      shallower level's break-even residency).
+ * SM6115 (also Kryo 260) uses the same latencies for the states it shares.
+ *
+ * The system (CCI) level is the stock "system-pc" level: psci-mode 3 at
+ * qcom,psci-mode-shift 8, the level above both L2 levels, so affinity level 2
+ * on top of CPU PC and L2 PC: 0x42000343. Its timings use the same rules
+ * (latency 4506, time-overhead 15337, and system-wfi's break-even residency
+ * of 2156 us is below system-pc's time-overhead, so min_residency is
+ * 15337 + 1). Stock only enters it with qcom,min-child-idx = 3 (both
+ * clusters in L2 PC), which genpd gives here as well: the system domain's
+ * residency is longer than either L2 PC's, so by the time the CPU governor
+ * picks it each cluster has already picked L2 PC. It has qcom,notify-rpm:
+ * before the last CPU goes down, stock writes the next timer event into the
+ * vMPM, copies the wakeup interrupt setup there and kicks RPM through the
+ * APCS IPC register (msm_mpm_enter_sleep(), cluster_prepare()). Here the MPM
+ * is the parent of the system domain and does the same in its genpd
+ * power_off (irq-qcom-mpm.c), so RPM is told exactly when this state is
+ * picked. Dropping the system level alone: delete system_pd's
+ * domain-idle-states and power-domains together, never only the states.
+ */
+&pwr_cpu_sleep_0 {
+	arm,psci-suspend-param = <0x00000002>;
+	entry-latency-us = <109>;
+	exit-latency-us = <63>;
+	min-residency-us = <173>;
+};
+
+&pwr_cpu_sleep_1 {
+	entry-latency-us = <290>;
+	exit-latency-us = <376>;
+	min-residency-us = <2010>;
+};
+
+&perf_cpu_sleep_0 {
+	arm,psci-suspend-param = <0x00000002>;
+	entry-latency-us = <121>;
+	exit-latency-us = <60>;
+	min-residency-us = <192>;
+};
+
+&perf_cpu_sleep_1 {
+	entry-latency-us = <297>;
+	exit-latency-us = <324>;
+	min-residency-us = <2411>;
+};
+
+/delete-node/ &pwr_cluster_sleep_0;
+/delete-node/ &pwr_cluster_sleep_1;
