From daa8ae42230c30694b43ef5a27dee56d028b0f43 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Wed, 18 Nov 2026 00:05:51 +0900
Subject: [PATCH 95/95] media: venus: vdec: Signal EOS with a real buffer on
 HFI 3XX

V4L2_DEC_CMD_STOP is implemented by queueing an empty input buffer with
HFI_BUFFERFLAG_EOS at the dummy device address 0xdeadb000. The HFI 3XX
firmware of SDM660 (qcom/venus-4.4) takes that address as a fatal
session error:

  qcom-venus cc00000.video-codec: session error: event id:1001 (deadb000)

Every frame still queued is lost, the capture queue reports POLLERR and
FFmpeg's v4l2m2m decoders abort at the end of every stream (mpv hangs
there: at the end of a video and whenever a looping file starts over).
A NULL address, as sent for old IRIS2 firmware, is ignored instead: the
frames come out, but no buffer with the EOS flag does, and the drain
never ends.

The downstream driver for this firmware signals EOS with an empty
buffer that is actually mapped. Do the same on HFI 3XX: allocate one
page per decoder instance the first time a drain is asked for, send its
device address with alloc_len set and a tag that matches no queued
buffer, and free it when the instance is closed. The struct member goes
at the end of venus_inst.

On a HiBy RS6 (SDM660), 1080x1920 H.264 and VP9 decoded to the end with
FFmpeg's h264_v4l2m2m/vp9_v4l2m2m: 240 of 240 frames, 0 decode errors,
exit 0 (before: abort at frame 185 and 142); mpv with hwdec=v4l2m2m-copy
reaches the end of file and loops, and the kernel logs no session error.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/venus/core.h |  4 ++++
 drivers/media/platform/qcom/venus/vdec.c | 25 ++++++++++++++++++++++--
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index 46705a666..038332065 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -455,6 +455,8 @@ enum venus_inst_modes {
  * @pic_struct:		bitstream progressive vs interlaced
  * @next_buf_last: a flag to mark next queued capture buffer as last
  * @drain_active:	Drain sequence is in progress
+ * @eos_buf:	empty input buffer the decoder signals EOS with (HFI 3XX)
+ * @eos_buf_da:	its device address
  * @flags:	bitmask flags describing current instance mode
  * @dpb_ids:	DPB buffer ID's
  */
@@ -528,6 +530,8 @@ struct venus_inst {
 	bool drain_active;
 	enum venus_inst_modes flags;
 	struct ida dpb_ids;
+	void *eos_buf;
+	dma_addr_t eos_buf_da;
 };
 
 #define IS_V1(core)	((core)->res->hfi_version == HFI_VERSION_1XX)
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 6a43ea191..9e87ecf03 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -4,6 +4,7 @@
  * Copyright (C) 2017 Linaro Ltd.
  */
 #include <linux/clk.h>
+#include <linux/dma-mapping.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
@@ -572,12 +573,30 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 		/* Send NULL EOS addr for only IRIS2 (SM8250),for firmware <= 1.0.87.
 		 * SC7280 also reports "1.0.<hash>" parsed as 1.0.0; restricting to IRIS2
 		 * avoids misapplying this quirk and breaking VP9 decode on SC7280.
+		 *
+		 * HFI 3XX firmware (SDM660's venus-4.4) takes the dummy address
+		 * as a fatal session error (event 0x1001 with deadb000), and
+		 * ignores a NULL one, so the drain never ends: it gets a real,
+		 * mapped, empty buffer, as its downstream driver sends. Its tag
+		 * matches no queued buffer.
 		 */
 
-		if (IS_IRIS2(inst->core) && is_fw_rev_or_older(inst->core, 1, 0, 87))
+		if (IS_IRIS2(inst->core) && is_fw_rev_or_older(inst->core, 1, 0, 87)) {
 			fdata.device_addr = 0;
-		else
+		} else if (IS_V3(inst->core)) {
+			if (!inst->eos_buf)
+				inst->eos_buf = dma_alloc_coherent(inst->core->dev, SZ_4K,
+								   &inst->eos_buf_da, GFP_KERNEL);
+			if (!inst->eos_buf) {
+				ret = -ENOMEM;
+				goto unlock;
+			}
+			fdata.device_addr = inst->eos_buf_da;
+			fdata.alloc_len = SZ_4K;
+			fdata.clnt_data = U32_MAX;
+		} else {
 			fdata.device_addr = 0xdeadb000;
+		}
 
 		ret = hfi_session_process_buf(inst, &fdata);
 
@@ -1765,6 +1784,8 @@ static int vdec_close(struct file *file)
 	ida_destroy(&inst->dpb_ids);
 	vdec_pm_put(inst, false);
 
+	if (inst->eos_buf)
+		dma_free_coherent(inst->core->dev, SZ_4K, inst->eos_buf, inst->eos_buf_da);
 	kfree(inst);
 	return 0;
 }
