+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/hiby,ring-keys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiBy RS6 volume wheel (ring keys)
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description:
+  Two-phase quadrature volume wheel of the HiBy RS6. Each rotation step is
+  decoded from the clockwise and anticlockwise GPIO edges and reported as a
+  key press of the child node whose direction matches.
+
+properties:
+  compatible:
+    const: hiby,ring-keys
+
+  clockwise-gpios:
+    maxItems: 1
+    description: GPIO of the clockwise phase, read as input and used as interrupt.
+
+  anticlockwise-gpios:
+    maxItems: 1
+    description: GPIO of the anticlockwise phase, read as input and used as interrupt.
+
+  wakeup-source: true
+
+patternProperties:
+  '^key-':
+    type: object
+    $ref: input.yaml#
+    description: A key reported for one rotation direction.
+    unevaluatedProperties: false
+
+    properties:
+      linux,code: true
+
+      hiby,direction:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        enum: [1, 2]
+        description:
+          Rotation direction this key is reported for. 1 is the direction of
+          the volume down key and 2 of the volume up key in the stock firmware.
+
+    required:
+      - linux,code
+      - hiby,direction
+
+required:
+  - compatible
+  - clockwise-gpios
+  - anticlockwise-gpios
+
+allOf:
+  - $ref: input.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/input/linux-event-codes.h>
+
+    ring-keys {
+        compatible = "hiby,ring-keys";
+        clockwise-gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+        anticlockwise-gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
+
+        key-volume-down {
+            linux,code = <KEY_VOLUMEDOWN>;
+            hiby,direction = <1>;
+        };
+
+        key-volume-up {
+            linux,code = <KEY_VOLUMEUP>;
+            hiby,direction = <2>;
+        };
+    };
+...
