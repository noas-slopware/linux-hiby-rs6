From 36e708974fa9e88ced11e8098a37be6741f4e7a4 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Thu, 22 Oct 2026 12:21:09 +0900
Subject: [PATCH 52/94] soc: qcom: smp2p: tell the remote through "sleepstate"
 when the AP sleeps

An outbound entry named "sleepstate" tells the remote processor whether
the application processor is awake. The sensor subsystem on Qualcomm
DSPs uses it to hold back the sensor indications a client asked not to
receive while the AP is suspended.

Set BIT(12), "AP awake", when the entry is set up, clear it from a PM
notifier on PM_SUSPEND_PREPARE and set it again on PM_POST_SUSPEND,
each followed by 25 ms for the remote to act on it: the bit, polarity
and delay of the RS6's stock smp2p_sleepstate driver.

Assisted-by: Claude:claude-opus-5-5
Claude-Session: https://claude.ai/code/session_01SXjPGasJxD6XRYU1J9jsnW
---
 drivers/soc/qcom/smp2p.c | 55 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/drivers/soc/qcom/smp2p.c b/drivers/soc/qcom/smp2p.c
index af0ceeaf6..dcd13e9b9 100644
--- a/drivers/soc/qcom/smp2p.c
+++ b/drivers/soc/qcom/smp2p.c
@@ -4,6 +4,7 @@
  * Copyright (c) 2012-2013, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/delay.h>
 #include <linux/interrupt.h>
 #include <linux/list.h>
 #include <linux/io.h>
@@ -20,6 +21,7 @@
 #include <linux/soc/qcom/smem.h>
 #include <linux/soc/qcom/smem_state.h>
 #include <linux/spinlock.h>
+#include <linux/suspend.h>
 
 /*
  * The Shared Memory Point to Point (SMP2P) protocol facilitates communication
@@ -40,6 +42,11 @@
  * V2 of SMP2P allows remote processors to write to outbound smp2p items before
  * the full smp2p connection is negotiated. This is important for processors
  * started before linux runs.
+ *
+ * An outbound entry named "sleepstate" tells the remote processor whether the
+ * application processor is awake. The sensor subsystems on Qualcomm DSPs use
+ * it to hold back sensor indications that a client asked not to receive while
+ * the application processor is suspended.
  */
 
 #define SMP2P_MAX_ENTRY 16
@@ -49,6 +56,11 @@
 #define SMP2P_FLAGS_RESTART_DONE_BIT 0
 #define SMP2P_FLAGS_RESTART_ACK_BIT 1
 
+#define SMP2P_SLEEPSTATE_NAME "sleepstate"
+#define SMP2P_SLEEPSTATE_AWAKE BIT(12)
+/* Time given to the remote processor to act on a sleepstate change */
+#define SMP2P_SLEEPSTATE_DELAY_MS 25
+
 #define SMP2P_MAGIC 0x504d5324
 #define SMP2P_ALL_FEATURES	SMP2P_FEATURE_SSR_ACK
 #define MAX_VERSION 2
@@ -137,6 +149,8 @@ struct smp2p_entry {
  * @mbox_chan:	apcs ipc mailbox channel handle
  * @inbound:	list of inbound entries
  * @outbound:	list of outbound entries
+ * @sleepstate:	outbound "sleepstate" entry, if any
+ * @pm_nb:	system suspend notifier driving @sleepstate
  */
 struct qcom_smp2p {
 	struct device *dev;
@@ -164,6 +178,9 @@ struct qcom_smp2p {
 
 	struct list_head inbound;
 	struct list_head outbound;
+
+	struct smp2p_entry *sleepstate;
+	struct notifier_block pm_nb;
 };
 
 #define CREATE_TRACE_POINTS
@@ -516,6 +533,28 @@ static const struct qcom_smem_state_ops smp2p_state_ops = {
 	.update_bits = smp2p_update_bits,
 };
 
+static int qcom_smp2p_sleepstate_notify(struct notifier_block *nb,
+					unsigned long event, void *unused)
+{
+	struct qcom_smp2p *smp2p = container_of(nb, struct qcom_smp2p, pm_nb);
+
+	switch (event) {
+	case PM_SUSPEND_PREPARE:
+		smp2p_update_bits(smp2p->sleepstate, SMP2P_SLEEPSTATE_AWAKE, 0);
+		break;
+	case PM_POST_SUSPEND:
+		smp2p_update_bits(smp2p->sleepstate, SMP2P_SLEEPSTATE_AWAKE,
+				  SMP2P_SLEEPSTATE_AWAKE);
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	msleep(SMP2P_SLEEPSTATE_DELAY_MS);
+
+	return NOTIFY_DONE;
+}
+
 static int qcom_smp2p_outbound_entry(struct qcom_smp2p *smp2p,
 				     struct smp2p_entry *entry,
 				     struct device_node *node)
@@ -532,6 +571,12 @@ static int qcom_smp2p_outbound_entry(struct qcom_smp2p *smp2p,
 
 	out->valid_entries++;
 
+	/* The application processor is awake until the first suspend */
+	if (!strcmp(entry->name, SMP2P_SLEEPSTATE_NAME)) {
+		writel(SMP2P_SLEEPSTATE_AWAKE, entry->value);
+		smp2p->sleepstate = entry;
+	}
+
 	entry->state = qcom_smem_state_register(node, &smp2p_state_ops, entry);
 	if (IS_ERR(entry->state)) {
 		dev_err(smp2p->dev, "failed to register qcom_smem_state\n");
@@ -740,6 +785,13 @@ static int qcom_smp2p_probe(struct platform_device *pdev)
 	if (ret)
 		goto set_wake_irq_fail;
 
+	if (smp2p->sleepstate) {
+		smp2p->pm_nb.notifier_call = qcom_smp2p_sleepstate_notify;
+		ret = register_pm_notifier(&smp2p->pm_nb);
+		if (ret)
+			goto set_wake_irq_fail;
+	}
+
 	return 0;
 
 set_wake_irq_fail:
@@ -769,6 +821,9 @@ static void qcom_smp2p_remove(struct platform_device *pdev)
 	struct qcom_smp2p *smp2p = platform_get_drvdata(pdev);
 	struct smp2p_entry *entry;
 
+	if (smp2p->sleepstate)
+		unregister_pm_notifier(&smp2p->pm_nb);
+
 	dev_pm_clear_wake_irq(&pdev->dev);
 
 	list_for_each_entry(entry, &smp2p->inbound, node)
