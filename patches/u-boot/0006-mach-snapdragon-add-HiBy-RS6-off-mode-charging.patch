 arch/arm/mach-snapdragon/Makefile      |   1 +
 arch/arm/mach-snapdragon/rs6_charger.c | 322 +++++++++++++++++++++++++
 board/qualcomm/hiby-rs6.config         |   2 +
 4 files changed, 335 insertions(+)
 create mode 100644 arch/arm/mach-snapdragon/rs6_charger.c
 create mode 100644 board/qualcomm/hiby-rs6.config

diff --git a/arch/arm/mach-snapdragon/Kconfig b/arch/arm/mach-snapdragon/Kconfig
index 38a69aa3..1689a337 100644
--- a/arch/arm/mach-snapdragon/Kconfig
+++ b/arch/arm/mach-snapdragon/Kconfig
@@ -49,4 +49,14 @@ config CMD_QCOM_DEBUG
 	  Enable Qualcomm specific U-Boot commands for debugging, such as dumping
 	  various regulator settings or efuses.
 
+config QCOM_HIBY_RS6_CHARGER
+	bool "HiBy RS6 off-mode charging screen"
+	depends on DM_I2C && DM_PMIC && VIDEO && BUTTON && EVENT
+	default n
+	help
+	  On the HiBy RS6 (compatible "hiby,rs6"), stay in U-Boot when the PMIC
+	  powered the board on only because a charger was plugged in: show the
+	  battery level on a button press, boot on a long power-key press and
+	  power off when the charger is removed. Does nothing on other boards.
+
 endif
