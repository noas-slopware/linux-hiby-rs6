# Maintainer: Noa Himesaka <himesaka@noa.codes>
# HiBy RS6 ([rs6] repo): linux-msm diag-router, as Nura's qcom-diag 0_git20250324 (same commit and
# systemd unit). The SDM660 modem's watchdog kills the MPSS ("dog_hb.c: Task starvation: diag") when
# nothing drains its diag channel, and the WCN3990 Wi-Fi firmware dies with it.
pkgname=qcom-diag
pkgver=0_git20250324
pkgrel=2
_commit=29277ef0bcbe22468a3836b796dc525ba6df87f3
pkgdesc="Routing of diagnostics related messages between host and various subsystems"
arch=(aarch64)
url="https://github.com/linux-msm/diag"
license=(BSD-3-Clause)
depends=(glibc systemd-libs qrtr)
makedepends=(linux-api-headers systemd)
source=("diag-$_commit.tar.gz::https://github.com/linux-msm/diag/archive/$_commit.tar.gz"
        diag-router.service)
sha512sums=('19987ed217edc783fcf215b61d969d4d77c3b018db63b70543f925134100345000b434a340cec1b2494da54b66c3b39874924b174d0b4ed8fffe716b6046f6fb'
            'eea56a7d10c97410e8be9b67b378f3656dc0d3c72e1c0051ac852375625b6ebcc745e2a8026948986fdf5f151cea7e67a7e10d3c4920d6665486e09f545a4311')

build() {
  cd diag-$_commit
  make prefix=/usr all
}

package() {
  cd diag-$_commit
  make prefix=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
  install -Dm644 "$srcdir"/diag-router.service -t "$pkgdir"/usr/lib/systemd/system/
}
